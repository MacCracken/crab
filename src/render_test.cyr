# crab render_test — HOST harness + SELF-CHECKING pixel proof for the dhancha LIST port (0.4.10).
# Exit code = failed checks. Also dumps the BGRA surface for a python→PNG eyeball.
#
# ⭐⭐ WHAT THIS EXISTS TO PROVE. Before 0.4.10 a pane was a `BOX_V` of at most 7 rows: entry 8 and
# beyond were not drawn AND could not be selected — `crab_maxsel` clamped the down-arrow at 7, so in
# a 40-file directory 33 files were unreachable. The checks below use a 12-entry pane in a viewport
# that fits ~6, which is exactly the case the old code could not represent.
#
# ⚠ These are PIXEL checks, not state checks. "crab stopped hand-rolling its list" is a claim about
# what reaches the screen; asserting that `dh_list_select` stored an integer would prove nothing
# about whether the operator can see which file is selected.

include "src/ui.cyr"

var g_fails = 0;
var g_n = 0;

fn check(got, want): i64 {
    g_n = g_n + 1;
    if (got == want) { return 0; }
    g_fails = g_fails + 1;
    var o = alloc(64);
    var t = "  check #";
    var i = 0; var w2 = 0;
    while (load8(t + i) != 0) { store8(o + w2, load8(t + i)); w2 = w2 + 1; i = i + 1; }
    w2 = w2 + crab_u2s(o + w2, g_n);
    store8(o + w2, 10); syscall(1, 1, o, w2 + 1);
    return 1;
}

# Write one 64-byte readdir record: name (NUL-terminated) at +0, type at +63.
fn rt_entry(buf, i, name, is_dir): i64 {
    var rec = buf + i * 64;
    var k = 0;
    while (load8(name + k) != 0) { store8(rec + k, load8(name + k)); k = k + 1; }
    store8(rec + k, 0);
    store8(rec + 63, is_dir);
    return 0;
}

# Is any pixel on screen row `y`, scanning x in [x0, x1), equal to `col`?
# ⚠ A BAND, NOT A SCAN LINE. `rt_row_has` samples ONE y, which is fine for a filled rectangle (the
# selection highlight) and fragile for TEXT: whether a glyph has a lit pixel at one particular row
# depends on the letterform, so a correct build can fail. Text assertions scan the row's whole band.
fn rt_band_has(sds, y0, y1, x0, x1, col): i64 {
    var y = y0;
    while (y < y1) {
        if (rt_row_has(sds, y, x0, x1, col) == 1) { return 1; }
        y = y + 1;
    }
    return 0;
}

fn rt_row_has(sds, y, x0, x1, col): i64 {
    var x = x0;
    while (x < x1) {
        if (sd_surface_pixel_at(sds, x, y) == col) { return 1; }
        x = x + 1;
    }
    return 0;
}

fn main(): i64 {
    # ⭐ ONE RENDER-STATE RECORD FOR THE WHOLE HARNESS, re-`reset` and refilled before each
    # render below — the record is a carrier, not a scenario, so reusing it is correct and it keeps
    # every scenario's setup visible at its own call site.
    var rs = crab_rs();
    alloc_init();
    var lbuf = alloc(16 * 64); var rbuf = alloc(16 * 64);
    var a0 = "aethersafha"; rt_entry(lbuf, 0, a0, 0);
    var a1 = "puka";        rt_entry(lbuf, 1, a1, 0);
    var a2 = "crab";        rt_entry(lbuf, 2, a2, 0);
    var b0 = "bin";         rt_entry(rbuf, 0, b0, 1);
    var b1 = "boot";        rt_entry(rbuf, 1, b1, 1);
    var b2 = "readme.md";   rt_entry(rbuf, 2, b2, 0);
    var lp = "/bin"; var rp = "/";

    # mock sizes + mtimes (parallel to the entries): files get a byte size, dirs -1.
    # mtimes are unix epochs (2026-07-10 ~= 1783900800) so the status line has a date.
    var lsizes = alloc(16 * 8); var rsizes = alloc(16 * 8);
    store64(lsizes + 0, 14995144); store64(lsizes + 8, 80784); store64(lsizes + 16, 301896);
    store64(rsizes + 0, 4096);     store64(rsizes + 8, 4096);  store64(rsizes + 16, 512);
    var lmtimes = alloc(16 * 8); var rmtimes = alloc(16 * 8);
    store64(lmtimes + 0, 1783900800); store64(lmtimes + 8, 1783900800); store64(lmtimes + 16, 1783900800);
    store64(rmtimes + 0, 1783900800); store64(rmtimes + 8, 1783900800); store64(rmtimes + 16, 1783900800);

    # ⚠ 640, NOT 380 — every assertion below is about TWO panes side by side, and at 380 crab now
    # renders one pane plus the A/B switcher (M4's ratification of the canvas's small-window
    # question). At 380 `crab_rlst` is 0 and reading a row out of it segfaults. 640 is the first
    # width `crab_two_panes_fit` admits; the solo layout gets its own checks at the end of this file.
    var w = 640; var h = 220;
    var sl = alloc(8); store64(sl, 0);
    var sr = alloc(8); store64(sr, 0);
    # ⛔ TWO SURFACES, DELIBERATELY. Since dhancha 0.9.14 a DhSurface owns and REUSES its sadish
    # render target, so two renders into one surface return the same object and the second overwrites
    # the first. This harness holds BOTH frames live — it asserts on `sds`, then renders `sds2` and
    # asserts on that, and then dumps `sds` at the very end, AFTER `sds2` exists. One shared target
    # would make the dump show the wrong picture, silently.
    var surf1 = dh_surface_new(w, h);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, lbuf, 3, lp, lsizes, lmtimes, CRAB_PANE_OK, 0, 1, sl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, sr);
    var sds = crab_render(surf1, 0, rs);

    # ---- the ACTIVE pane's selection is accented, the inactive pane's is muted --------------
    # ⛔ THE ONE QUESTION A TWO-PANE FILE MANAGER MUST ANSWER ON SCREEN: which pane do my arrow keys
    # drive. Two accented rows cannot answer it. crab used to decide this itself; dhancha 0.9.8 now
    # decides it from focus, and this pair of checks is what proves the app did not keep a second,
    # disagreeing copy of the rule.
    var accent = dh_theme_accent();
    var line = dh_theme_line();
    var midl = (w - 6) / 4;                  # a column inside the left pane
    var midr = w - midl;                     # ...and inside the right one
    # ⚠ THE SCAN LINES ARE READ FROM THE LAYOUT, NOT HARDCODED (*#32*). They used to be literals —
    # 67 and 41 — encoding "path header 28 px, then 26 px rows". Adding the NAME/SIZE/MODIFIED
    # column header moved every row down, and those literals would have quietly begun sampling the
    # header instead of the row they name. Reading the laid-out row keeps the assertion honest about
    # WHICH row it is looking at.
    var lsely = dh_widget_y(dh_list_row_at(crab_llst, 1)) + 13;   # left pane, sel_l = 1
    var rsely = dh_widget_y(dh_list_row_at(crab_rlst, 0)) + 13;   # right pane, sel_r = 0
    check(rt_row_has(sds, lsely, 4, midl + 40, accent), 1);
    # right pane, sel_r = 0 and NOT active -> muted, and NOT accented
    check(rt_row_has(sds, rsely, midr - 40, w - 4, line), 1);
    check(rt_row_has(sds, rsely, midr - 40, w - 4, accent), 0);

    # ---- ⭐⭐ AND THE ACCENTED ROW'S TEXT IS STILL READABLE (dhancha 0.9.20, rupa 0.1.5) --------
    # ⛔ THE HIGHLIGHT USED TO ERASE THE ROW IT HIGHLIGHTED. The selected row is filled with `accent`
    # and its label was drawn in the theme's primary `ink` — on MUDRA dark, 0xE7E9EF on 0x00E5FF is a
    # contrast ratio of **1.27:1**. The one row the operator is looking at was the one row that could
    # not be read. rupa now publishes `on-accent` and dhancha paints the focused selection's text
    # with it; this is crab confirming it arrived, at the pixel.
    # ⚠ Bare 0xRRGGBB: glyph pixels are stored with alpha 0xFF, but `sd_surface_pixel_at` rebuilds
    # from b/g/r and drops the alpha byte.
    var on_acc = dh_theme_on_accent();
    var ink = dh_theme_ink();
    check(rt_band_has(sds, lsely - 12, lsely + 12, 4, midl + 40, on_acc), 1);   # on-accent ink
    check(rt_band_has(sds, lsely - 12, lsely + 12, 4, midl + 40, ink), 0);      # ...and NOT primary ink
    # ⛔ THE CONTROL. Without it a build that painted EVERY row in on-accent would pass the pair
    # above and be just as wrong — the unselected right pane must still use the primary ink.
    check(rt_band_has(sds, rsely - 12, rsely + 12, midr - 40, w - 4, ink), 1);
    # ⚠ AND THE MIRROR OF THAT CONTROL CANNOT BE WRITTEN HERE, WHICH IS WORTH SAYING RATHER THAN
    # QUIETLY OMITTING. "the right pane has NO on-accent pixels" looks like the obvious companion
    # check, but on MUDRA dark `on-accent` is 0x0B0C0E — the SAME value as `bg`, deliberately, since
    # the legible ink on a bright cyan fill just is the carbon void. Scanning any pane for it finds
    # background, so the check fails against correct code. The `ink` line above carries the control.

    # ---- ⛔ THE CASE THE OLD CODE COULD NOT REPRESENT: 12 entries, ~6 visible ---------------
    var big = alloc(16 * 64);
    var bsz = alloc(16 * 8);
    var bmt = alloc(16 * 8);
    var i = 0;
    while (i < 12) {
        var nm = "entry";
        rt_entry(big, i, nm, 0);
        store64(bsz + i * 8, 100 + i);
        store64(bmt + i * 8, 1783900800);
        i = i + 1;
    }
    # `crab_maxsel` must reach the LAST entry, not row 7. This is the reachability half.
    check(crab_maxsel(12), 11);
    check(crab_maxsel(40), 39);
    check(crab_maxsel(0), 0);

    # Select the last entry. The pane must SCROLL to it — with the old cap this index could not be
    # selected at all, and with a non-scrolling box it would be laid out below the viewport.
    var s2 = alloc(8); store64(s2, 0);
    var s3 = alloc(8); store64(s3, 0);
    var surf2 = dh_surface_new(w, h);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, big, 12, lp, bsz, bmt, CRAB_PANE_OK, 0, 11, s2);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, s3);
    var sds2 = crab_render(surf2, 0, rs);
    # ⚠ AND THE TWO REALLY ARE DISTINCT — the guard on the paragraph above. If a future change made
    # `crab_render` share one target again, every assertion below would silently be reading `sds2`
    # while the checks above had already passed against a picture that no longer exists.
    check(sds2 == sds, 0);
    # ⚠ THE SCROLL OFFSET IS NONZERO — the proof that the list moved rather than silently truncating.
    check(load64(s2) > 0, 1);
    # ...and the accented selection is visible SOMEWHERE inside the pane's viewport.
    var seen = 0;
    var y = 28;
    while (y < h - 24) {
        if (rt_row_has(sds2, y, 4, midl + 40, accent) == 1) { seen = 1; }
        y = y + 1;
    }
    check(seen, 1);
    # ⛔ AND NOTHING PAINTS BELOW THE PANE. The status line owns the bottom 24px; a row escaping the
    # list's viewport would land on it. This is the clip half of dhancha 0.9.7 seen from the app.
    check(rt_row_has(sds2, h - 6, 4, midl + 40, accent), 0);

    # A pane scrolled to the last entry must NOT still be at offset 0 while claiming to show it.
    check(load64(s2) >= 26, 1);              # at least one row's worth of scroll

    # --- M4: the empty-pane notice is DRAWN, not merely returned ----------------------------------
    # ⛔⛔ `crab_pane_state_label` returning the right string proves nothing about the picture. The
    # notice is built inside `crab_pane` behind a `count == 0` arm, and the ways it can be right in
    # the unit test and wrong on screen are exactly the ways this file exists to catch: added to the
    # wrong parent, clipped by the list's viewport, drawn in the background colour, or laid out
    # under the status line. So it is asserted where it renders.
    # ⚠ `rt_band_has`, NOT `rt_row_has` — this is TEXT. Whether a glyph lights any given scan line
    # depends on the letterform, which is the trap already recorded at the top of this file.
    var s4 = alloc(8); store64(s4, 0);
    var s5 = alloc(8); store64(s5, 0);
    var surf3 = dh_surface_new(w, h);
    var e0 = alloc(CRAB_REC_SZ);
    var esz = alloc(8); var emt = alloc(8);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, e0, 0, lp, esz, emt, CRAB_PANE_GONE, 0, 0, s4);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, s5);
    var sds3 = crab_render(surf3, 0, rs);
    check(sds3 == sds, 0);
    check(sds3 == sds2, 0);
    # The notice sits in the first row slot: below the 28px path header and the 18px column header.
    var noteink = 0;
    if (rt_band_has(sds3, 46, 46 + 26, 4, midl - 4, ink) == 1) { noteink = 1; }
    check(noteink, 1);                       # SOMETHING is written where the first row would be
    # ⛔ AND IT IS NOT SELECTABLE. `dh_list_select` is skipped when `count == 0`, so no accent may
    # appear anywhere in that pane — a highlighted notice reads as a file with that name, and Enter
    # on it would descend into nothing.
    var noteaccent = 0;
    var ny = 28;
    while (ny < h - 24) {
        if (rt_row_has(sds3, ny, 4, midl - 4, accent) == 1) { noteaccent = 1; }
        ny = ny + 1;
    }
    check(noteaccent, 0);
    # ⚠ THE RIGHT PANE IS UNAFFECTED — the notice belongs to the pane whose listing failed, and a
    # state leaking across panes is exactly what the parameters (rather than a global) prevent.
    var rightrows = 0;
    if (rt_band_has(sds3, 46, 46 + 26, midr + 4, w - 4, ink) == 1) { rightrows = 1; }
    check(rightrows, 1);

    # --- M4: the SOLO layout, at the shipped default window ---------------------------------------
    # ⛔⛔ THE PANE THAT IS NOT SHOWN MUST NOT BE HIT-TESTABLE. `crab_hit` walks parents comparing
    # against `crab_llst` / `crab_rlst`; if the hidden pane were rendered off-screen instead of not
    # at all, clicks would land in a pane nobody can see. Asserting the list pointer is 0 is the
    # cheapest statement of "it was not built", and it is what makes `crab_hit`'s `node != 0` loop
    # safe against a null list.
    var ssl = alloc(8); store64(ssl, 0);
    var ssr = alloc(8); store64(ssr, 0);
    var ssurf = dh_surface_new(380, 220);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, lbuf, 3, lp, lsizes, lmtimes, CRAB_PANE_OK, 0, 1, ssl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, ssr);
    var ssds = crab_render(ssurf, 0, rs);
    check(ssds != 0, 1);
    check(crab_llst != 0, 1);                # active_pane 0 -> the LEFT pane is the one drawn
    check(crab_rlst, 0);                     # ...and the right pane was never built
    # ⚠ THE SOLO PANE SPANS THE FULL WIDTH, so a click where the right pane used to be is now inside
    # the LEFT one — and must report pane 0. (An earlier revision of this check asserted the click
    # found nothing, which was testing the two-pane geometry that solo mode replaces.)
    var shb = alloc(16);
    check(crab_hit(380 - 40, 60, shb), 1);
    check(load64(shb), 0);                   # pane 0 — never the pane that was not drawn
    # ⭐ AND THE OTHER HALF OF THE SWITCH: active_pane 1 draws B and leaves A unbuilt.
    var ssurf2 = dh_surface_new(380, 220);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, lbuf, 3, lp, lsizes, lmtimes, CRAB_PANE_OK, 0, 1, ssl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, ssr);
    crab_rs_chrome(rs, 1, 0, 0, 0, 0, 0, "");
    crab_render(ssurf2, 0, rs);
    check(crab_rlst != 0, 1);
    check(crab_llst, 0);

    # ---- M5: the preview column occupies its own band, and refuses when it cannot ----------
    # ⛔ A LAYOUT ASSERTION, NOT A COLOUR ONE. crab names no colour (ADR 0001) — it reads
    # `dh_theme_panel()` and asks whether those pixels are WHERE the column should be. Asserting a
    # literal would be crab claiming a palette it does not own, and the check would break the next
    # time the compositor's theme moved rather than the next time crab's layout did.
    # ⚠ THE PROBE IS 760 PX WIDE so the preview fits alongside two panes: `crab_two_panes_fit` needs
    # 600 px of pane area and the column takes 153, so two panes plus a preview need 753.
    var pvl = alloc(8); store64(pvl, 0);
    var pvr2 = alloc(8); store64(pvr2, 0);
    var pvsurf = dh_surface_new(760, 240);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, lbuf, 3, lp, lsizes, lmtimes, CRAB_PANE_OK, 0, 0, pvl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, pvr2);
    crab_rs_preview(rs, 1);
    var pvds = crab_render(pvsurf, 0, rs);
    check(pvds != 0, 1);
    # ⭐ THE COLUMN IS THE RIGHTMOST BAND. Its header is a panel-coloured bar CRAB_PV_HDR_H tall,
    # starting CRAB_PV_W from the right edge — so panel pixels must appear there.
    var pvpanel = dh_theme_panel();
    check(rt_band_has(pvds, 2, CRAB_PV_HDR_H - 2, 760 - CRAB_PV_W + 4, 758, pvpanel), 1);
    # ⛔ AND THE PANES REALLY GAVE THE WIDTH UP, which is the half a "the column drew" check misses.
    # `crab_hit` walks the laid-out tree, so a click inside the preview band must resolve to NO pane
    # — if the panes had kept their full width the click would land in the right-hand one and the
    # column would merely be painted over a pane that still owns those pixels.
    var pvhb = alloc(16);
    check(crab_hit(760 - 40, 80, pvhb), 0);
    # ...while a click just LEFT of the column is still inside a pane.
    check(crab_hit(760 - CRAB_PV_W - 20, 80, pvhb), 1);
    # ⚠ TWO PANES SURVIVE AT THIS WIDTH — 760 - 153 = 607, which clears the 600 px two-pane floor.
    check(crab_llst != 0, 1);
    check(crab_rlst != 0, 1);

    # ---- M5: the thumbnail really reaches the surface --------------------------------------
    # ⛔ A CANVAS THAT DOES NOT PAINT IS INDISTINGUISHABLE FROM ONE THAT WAS NEVER BUILT, and both
    # look like "no thumbnail for this file" — which is a legitimate state. So this asserts an exact
    # colour crab could not have produced any other way: 0x00A0B0C0, present nowhere in the theme.
    # ⚠ IT ALSO PROVES THE BYTE ORDER. The buffer is written B=0xC0, G=0xB0, R=0xA0, and
    # `sd_surface_pixel_at` returns 0x00RRGGBB — so a red/blue swap in `crab_thumb_draw` yields
    # 0x00C0B0A0 and fails here rather than shipping a picture that merely looks wrong.
    var fake = alloc(CRAB_THUMB_BYTES);
    var fi = 0;
    while (fi < CRAB_THUMB_W * CRAB_THUMB_H) {
        store8(fake + fi * 4, 0xC0);         # B
        store8(fake + fi * 4 + 1, 0xB0);     # G
        store8(fake + fi * 4 + 2, 0xA0);     # R
        store8(fake + fi * 4 + 3, 255);
        fi = fi + 1;
    }
    var tbuf = alloc(16 * CRAB_REC_SZ);
    rt_entry(tbuf, 0, "shot.png", 0);
    var tz = alloc(64); var tm = alloc(64);
    store64(tz, 1024); store64(tm, 1756600000);
    var tsl = alloc(8); store64(tsl, 0);
    var tsr = alloc(8); store64(tsr, 0);
    # ⚠ 400 px TALL, NOT 300, AND THE FIRST DRAFT WAS 300 AND FAILED. The preview column stacks a
    # 28 px header, four label/value pairs at 18 px each and a 72 px thumbnail band — 280 px of
    # content against the 276 px a 300 px window leaves after the status line. The thumbnail was
    # laid out past the bottom and clipped away, which reads exactly like "the canvas never
    # painted". Size a fixture against what it has to hold.
    var tsurf = dh_surface_new(760, 400);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, tbuf, 1, lp, tz, tm, CRAB_PANE_OK, 0, 0, tsl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, tsr);
    crab_rs_preview(rs, 1);
    crab_rs_dims(rs, 4096, 2160);
    crab_rs_thumb(rs, fake, CRAB_TH_OK);
    var tds = crab_render(tsurf, 0, rs);
    check(tds != 0, 1);
    check(rt_band_has(tds, 0, 399, 760 - CRAB_PV_W, 759, 0x00A0B0C0), 1);
    # ⛔ AND IT IS CONFINED TO THE PREVIEW COLUMN. A canvas that ignored its clip would paint over
    # the panes, and `dh_draw_widget` cannot clip pixels it did not write — the toolkit's own note
    # says so. This is the half that proves the clip was honoured.
    # ⛔ THE BOUNDARY IS DERIVED, AND A FIRST DRAFT GUESSED IT WRONG. It assumed the column hugs the
    # right edge at `w - CRAB_PV_W` (607). It does not: `panes` is a BOX_H holding [pane, pane,
    # preview], so the panes take `2 * panew` from the left and the preview follows them — measured
    # at x=600, with the remaining 7 px falling off the right as edge padding. Re-derive the layout
    # from the same arithmetic `crab_render` uses rather than assuming where a column ends up.
    var tpw = (760 - CRAB_PV_W - CRAB_PANE_GAP) / 2;
    check(rt_band_has(tds, 0, 399, 0, tpw + tpw - 1, 0x00A0B0C0), 0);

    # ⛔ THE CLIP TEST IN `crab_thumb_draw` IS UNEXERCISED DEFENCE, AND THIS SAYS SO RATHER THAN
    # PRETENDING OTHERWISE. It is required — `dh_draw_widget` cannot clip pixels it did not write,
    # so a canvas that ignored its clip would paint over its neighbours and the toolkit could not
    # stop it. But deleting the clip comparisons leaves this suite GREEN, because no fixture here
    # produces a canvas laid out partially outside its column: dhancha's BOX_V compresses its
    # children rather than overflowing them, so the canvas is either fully inside the clip or not
    # laid out at all. Two attempts to build such a fixture (a 300 px window, then 220 px) both
    # failed to discriminate — the first because the content simply fitted.
    # ⇒ Measured, not assumed, and left in the code: the guard costs four comparisons per pixel and
    # is the difference between a bug and a corrupted window the day a layout change makes it
    # reachable. ⚠ This is the same honest label `poll_test`'s zeroing assertion carries in dhancha.

    # ⚠ AND A NON-OK STATE PAINTS NO PICTURE, whatever is in the buffer — the state is what decides,
    # not the pointer, so a stale buffer from a previous selection cannot leak onto a file that
    # could not be decoded.
    var tsurf2 = dh_surface_new(760, 400);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, tbuf, 1, lp, tz, tm, CRAB_PANE_OK, 0, 0, tsl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, tsr);
    crab_rs_preview(rs, 1);
    crab_rs_thumb(rs, fake, CRAB_TH_TOO_BIG);
    var tds2 = crab_render(tsurf2, 0, rs);
    check(tds2 != 0, 1);
    check(rt_band_has(tds2, 0, 399, 760 - CRAB_PV_W, 759, 0x00A0B0C0), 0);

    # ⭐ THE REFUSAL, at a window too narrow to honour the toggle. The operator's WANT is still 1;
    # `crab_preview_fit` is what says no, and nothing of the column may appear.
    var nsurf2 = dh_surface_new(280, 220);
    crab_rs_reset(rs);
    crab_rs_pane(rs, 0, lbuf, 3, lp, lsizes, lmtimes, CRAB_PANE_OK, 0, 0, pvl);
    crab_rs_pane(rs, 1, rbuf, 3, rp, rsizes, rmtimes, CRAB_PANE_OK, 0, 0, pvr2);
    crab_rs_preview(rs, 1);
    var nds = crab_render(nsurf2, 0, rs);
    check(nds != 0, 1);
    # ⛔ THE WHOLE WIDTH STILL BELONGS TO THE PANE — the click that would have hit the column hits
    # the solo pane instead. This is the assertion that a refused preview costs no pixels; a check
    # for "no panel colour on the right" would find the PANE's own panel background and pass
    # vacuously, which is the same trap `on-accent` sets on MUDRA dark.
    check(crab_hit(280 - 10, 80, pvhb), 1);
    check(load64(pvhb), 0);

    var pix = sd_surface_pixels(sds);
    var path = "build/crab-render.bin";
    var fd = syscall(2, path, 577, 420);
    if (fd >= 0) { syscall(1, fd, pix, w * h * 4); syscall(3, fd); }
    var ok = "crab render_test: dumped 640x220 BGRA to build/crab-render.bin\n";
    syscall(1, 1, ok, strlen(ok));
    # ⛔ REPORT THE COUNT, NOT JUST THE FAILURES. This harness returned `g_fails` and printed only the
    # dump line, so it exited **0** whether it ran 26 checks or none — and the handoff has quoted a
    # check count for three cuts that nothing in the program actually printed. A refactor that
    # dropped an assertion, or an early `return` that skipped a block, was indistinguishable from a
    # clean run. Now the number is on stdout and a drop is visible without reading the source.
    # ⚠ This is the same discipline as the mutation rule: an assertion you cannot observe FAILING —
    # or, here, cannot observe RUNNING — is not evidence.
    var cbuf = alloc(64);
    var cl = 0;
    var tag = "crab render_test: ";
    while (load8(tag + cl) != 0) { store8(cbuf + cl, load8(tag + cl)); cl = cl + 1; }
    cl = cl + crab_u2s(cbuf + cl, g_n);
    var mid = " checks, ";
    var mi = 0;
    while (load8(mid + mi) != 0) { store8(cbuf + cl, load8(mid + mi)); cl = cl + 1; mi = mi + 1; }
    cl = cl + crab_u2s(cbuf + cl, g_fails);
    var tail = " failed\n";
    var ti = 0;
    while (load8(tail + ti) != 0) { store8(cbuf + cl, load8(tail + ti)); cl = cl + 1; ti = ti + 1; }
    store8(cbuf + cl, 0);
    syscall(1, 1, cbuf, cl);
    return g_fails;
}

fn _entry(): i64 { var r = main(); syscall(60, r); return 0; }
_entry();
