# crab — the APPLICATION LAYER: everything `main()` does that is not the event loop.
#
# ⛔⛔ THIS FILE EXISTS FOR ONE REASON: `src/main.cyr` ENDS IN `_entry();`, SO INCLUDING IT FROM A
# TEST WOULD RUN THE APP. Every function here used to live there, which meant **none of it was
# reachable from `tests/crab.tcyr`** — no assertion could touch the readdir parser, the stat layer,
# descend, ascend, or the premultiplied surface flag. `src/path.cyr` was carved out of the same file
# at 0.5.0 for the same reason, after a P1 memory-safety repair landed somewhere the suite could not
# see; this is that extraction finished rather than repeated.
#
# ⇒ `main.cyr` now holds `main()` and `_entry()` and nothing else. Anything added to crab that is not
# literally the event loop belongs HERE, where it can be asserted on.
#
# ⚠ THE RESIDUAL GAP IS IRREDUCIBLE AND IS NOT PRETENDED AWAY: `main()` itself still cannot be called
# from a suite that would then run the app. The mitigation is architectural rather than test-shaped —
# `crab_render` installs the frame arena and calls `dh_frame_begin()` itself (see `src/ui.cyr`), so
# the setup `main()` used to own and could have forgotten is no longer `main()`'s to forget.

include "src/ui.cyr"

fn crab_say(s): i64 { return syscall(SYS_WRITE, 1, s, strlen(s)); }

# ⛔ ONE cap for the readdir buffer AND the readdir call. It was the literal `32` in seven places —
# the call plus six allocations — so raising the cap without finding every allocation writes past
# the buffer, and raising an allocation without the call changes nothing. Keep them derived.
#
# ⚠ 32 was not enough for a REAL root. Iron 2026-08-19: `/` held **114** entries after a few burns
# (run outputs land there), so crab showed 32 and silently dropped 82 — a file the shell's `ls`
# listed was simply absent from the pane, which reads as a filesystem fault rather than a cap.
#
# ⭐ 256 -> 1024 (M3 *#02*, agnos 1.56.50). The design canvas shows **812 items** in a pane, so 256
# was below the number the design itself asks for. Records are 64 B, so 1024 entries is a 64 KB pane
# buffer — two panes plus their size/mtime arrays is ~160 KB, against a bump allocator that never
# frees, paid once at startup rather than per frame.
# ⛔ RAISING THE CAP DOES NOT MAKE THE CAP HONEST, WHICH IS THE ACTUAL DEFECT. A directory bigger
# than any cap still exists; what changed is that crab can now SAY how much it is not showing,
# because `#101 readdir_at` lets the walk continue past the buffer without storing.
enum CrabDir {
    CRAB_MAX_ENTRIES = 1024;
    # ⚠ Records per `readdir_at` call. Bounds the syscall's write to the pane buffer; it is not the
    # pane cap. 64 records = 4 KB, which is also the counting scratch below.
    CRAB_READDIR_BATCH = 64;
    # ⛔⛔ THE BACKSTOP ON A `#101` WALK, AND IT IS THE SECOND GUARD, NOT THE FIRST. The kernel's
    # I/O-error paths (`agnos/kernel/core/ext2.cyr`) `store64(cursor_uva, pos)` with `pos` UNCHANGED
    # and `return count` — which may be 0, and 0 is NOT negative. A persistent block-read failure
    # therefore satisfies `k >= 0` and `cur != -1` forever, and crab spins in a syscall loop with no
    # output at all: a hang, not a crash, and nothing in the suite can see it.
    # ⇒ The precise guard is the stall test at each call site — `k == 0` AND the cursor did not move.
    # This cap exists for the case that test cannot see: a cursor that advances while yielding
    # nothing. It is deliberately FAR above any legitimate walk (4096 calls x 64 records = 262,144
    # entries) so that reaching it is always a fault, never a big directory.
    CRAB_READDIR_STEPS_MAX = 4096;
    # ⭐⭐ THE HARDCODED `CRAB_SYS_READDIR_AT = 101` IS GONE (2026-08-30). It was an interim with a
    # stated expiry — "switch to `sys_readdir_at` and delete this constant the moment crab's pin
    # moves to >= 6.5.36" — and that condition is met: **cyrius 6.5.36 is released**, crab pins it,
    # and `lib/syscalls_x86_64_agnos.cyr` now vendors `sys_readdir_at(path, buf, max, cursor)`.
    # ⚠ crab was the FIRST consumer to exercise that wrapper. agnos's own `rdat.cyr` proves the
    # kernel contract but calls the raw number, so until this change nothing had ever called the
    # cyrius peer — it was asserted to compile, never to run. A QEMU run proves it; this is not
    # iron-only, and nothing here needs hardware to be believed.
    # ⛔ A consumer hard-coding a syscall number is the bug class agnos's roadmap tracks; do not
    # reintroduce one. If a needed wrapper is missing, file it upstream and pin the interim to an
    # explicit expiry, as this one was.
    # ⚠ M4's copy buffer. 4 KiB matches the readdir counting scratch and one ext2 block; it is a
    # throughput knob and nothing else, since every read is drained by a bounded write loop.
    CRAB_COPY_CHUNK = 4096;
}

# True number of entries the last listing's directory holds, which is NOT the number stored when the
# directory is bigger than the pane buffer. -1 when it was not determined.
var crab_dir_total = 0 - 1;

fn crab_listing_total(): i64 { return crab_dir_total; }

# ⭐ THE LAST LISTING'S KERNEL ERROR, 0 WHEN IT SUCCEEDED (M4). `crab_readdir_into` clamps its return
# to >= 0 — deliberately, because every caller uses it as a loop bound — so before this the reason a
# pane was empty could not survive the call. An empty directory and a vanished one were the same
# answer, and the pane drew the same blank for both.
# ⛔ READ IT NEXT TO THE LISTING THAT SET IT. It is overwritten by every readdir, and crab lists two
# panes, so a read deferred to render time reports the right pane's error for both. `main.cyr`
# captures it into the pane's own state immediately after each `crab_readdir_into`.
var crab_dir_err = 0;

fn crab_listing_err(): i64 { return crab_dir_err; }

# ⚠ `CRAB_REC_SZ` / `CRAB_REC_TYPE` / `CRAB_PATH_MAX` / `CRAB_NAME_MAX`, and the bounded path helpers
# `crab_strcpy_n` / `crab_join_n`, live in `src/path.cyr` (pulled in via `src/ui.cyr` above). They are
# there and not here for ONE reason: `tests/crab.tcyr` includes `ui.cyr`, never `main.cyr`, so
# anything defined in this file CANNOT BE TESTED. The 0.5.0 path-overflow fix is the reason that
# stopped being acceptable — a P1 memory-safety repair with no reachable test is a repair on trust.

# ⭐⭐ `AE-6` — crab's surface is PREMULTIPLIED, unconditionally.
#
# This is what routes crab through agnos `gpu_shader_op #92` op 0x01 — a real per-pixel
# `out = src + dst * (1 - src_a)` on the shader cores — instead of `#87`, a byte mover with no ALU that can
# only copy. The blend is the one operation CP-DMA structurally cannot do, and it had no client at all.
#
# ⭐ crab satisfies the op's precondition by construction: sadish's `sd_alpha_of()` maps a bare `sd_rgb`
# value's 0 byte to 255 and `draw.cyr` stores that, so every pixel crab produces is **alpha 255**. At
# a == 255 premultiplied and straight alpha are the same bytes, so the surface is trivially premultiplied
# and the blend collapses to `out = src + dst*0 = src`. `tests/crab.tcyr` asserts `a == 255 && c <= a` on
# every pixel of the production render, with negative controls, so the precondition is a gate and not a
# hope. [[feedback_audit_re_derive_dont_validate_comments]]
#
# ⚠ A boot whose GPU cannot run the shader is handled in the COMPOSITOR, per window: `ae_gpu_present_frame`
# falls back to `#87` for a premultiplied surface when the envelope is absent, which is exact at alpha 255.
# Nothing is conditional here, and there is no arm — the client states what its pixels ARE and the
# compositor decides how to draw them.
fn crab_surface_flags(): i64 {
    return SETU_SURF_PREMULTIPLIED | SETU_SURF_FULL_KEYS;
}

# ⭐⭐ `SETU_SURF_FULL_KEYS` (M2, *deferral #06*) — crab now asks for key RELEASES as well as presses.
# The compositor honours it per surface: `win_set_keymode(win, flags & SETU_SURF_FULL_KEYS)` at
# CREATE_SURFACE, and `setu_srv_forward_key` then sets `mods` to **1 = press / 0 = release**. A
# press-only surface (the default) receives presses only, with `mods` always 0.
#
# ⛔⛔ ASKING FOR IT WITHOUT GATING ON IT MAKES EVERY KEY ACT TWICE, AND THAT IS NOT A GUESS — the
# compositor carries the burn. aethersafha `src/main.cyr`: *"every key acted on BOTH edges. Measured
# on the 2026-08-18 burn: three F3 presses produced SIX `theme switched` lines, and the launcher moved
# its selection twice per keypress, which is what made choosing an app hard."* For crab that would be
# two rows per Down, and Enter descending twice — the second descend landing wherever the first left
# the selection.
#
# ⚠ THE GATE IS ONLY CORRECT BECAUSE THE FLAG IS REQUESTED, and the two must move together. On a
# press-only surface `mods` is 0 for a PRESS, so a client that asked for press-only and then gated on
# `mods == 1` would act on nothing at all. That coupling is why this predicate sits beside
# `crab_surface_flags` rather than in the event loop.
fn crab_key_acts(mods): i64 {
    if (mods == 1) { return 1; }
    return 0;
}

# ⭐⭐ HELD-KEY REPEAT (M2, *deferral #06* second half), AND IT NEEDED NO KERNEL CHANGE.
# ⛔ AN EARLIER NOTE HERE CLAIMED IT WAS BLOCKED ON agnos FOR WANT OF A BOUNDED WAIT. THAT WAS WRONG,
# and it was wrong because it read syscall SIGNATURES and stopped there: `#14 pause` takes no timeout
# argument, so it looked unbounded. Its kernel comment says otherwise in as many words — *"Do ONE SAFE
# (IF=1) hlt so a device IRQ (e.g. NIC RX) **or the 100 Hz timer** wakes it"* — and MEASURED on a real
# kernel, `sys_pause()` returns in **0-4 ms**. It is already a bounded wait; nothing needed adding.
# ⇒ Repeat is a clock check in the idle path, not a new primitive.
#
# ⚠ bhumi does not repeat FOR us and says so: *"forwarding a repeat as another press delivers a key
# the user never pressed again. Repeat is policy, not drain."* On agnos it diffs HID reports into
# edges, so a held key is exactly one press and one release. The policy is here.
enum CrabRepeat {
    CRAB_REPEAT_DELAY_MS = 400;      # hold this long before the first repeat
    CRAB_REPEAT_INTERVAL_MS = 60;    # then this often
}

# Does this key repeat while held? -> 1 yes, 0 no.
#
# ⛔ ONLY MOVEMENT REPEATS. Enter descends and Backspace ascends: repeating those walks the operator
# through the filesystem at 16 directories a second on one held key, and every step re-readdirs and
# re-stats. A pane switch (Left/Right) repeating is merely useless — it lands on the same pane. The
# keys where repeat is what the operator MEANT are the ones that move a selection one row at a time.
fn crab_key_repeats(usage): i64 {
    if (usage == 0x52) { return 1; }        # Up
    if (usage == 0x51) { return 1; }        # Down
    if (usage == 0x0E) { return 1; }        # k
    if (usage == 0x0D) { return 1; }        # j
    return 0;
}

# Is a repeat due? `held_ms` = how long the key has been down, `since_last` = since the last action.
# -> 1 fire, 0 wait.
#
# ⚠ THE DELAY EXISTS SO A DELIBERATE SINGLE PRESS IS NOT A BURST. Without it every tap moves several
# rows, which reads as the selection overshooting rather than as repeat working.
fn crab_repeat_due(held_ms, since_last): i64 {
    if (held_ms < CRAB_REPEAT_DELAY_MS) { return 0; }
    if (since_last < CRAB_REPEAT_INTERVAL_MS) { return 0; }
    return 1;
}

# ⭐⭐ RESIZE POLICY (M2). The compositor ASKS via `WINDOW_CONFIGURE`; deciding whether to adopt the
# ask is policy, and it lives here rather than in `main.cyr` for the reason this whole file exists —
# nothing in `main.cyr` is reachable from a test. The plumbing (resize the surface, swap the shm
# buffer, re-attach, re-commit) stays there because it is syscalls; the *decision* is here.
enum CrabWindow {
    CRAB_DIM_MAX = 4096;                 # per-axis sanity bound
    # ⛔⛔ THIS WAS 16 MB ("the framebuffer's own size") AND THAT NUMBER WAS INVENTED, NOT DERIVED.
    # QEMU found it: on a maximize the compositor asked for a full-screen surface, crab's policy said
    # yes, and `setu_buf_create` then failed — because the kernel's shm caps are
    #   `SHM_MAX_SIZE     = 2,097,152`  (2 MB)  — syscall `#71`, pmm-backed: ONE 2 MB page per buffer
    #   `SHM_GPU_MAX_SIZE = 33,554,432` (32 MB) — syscall `#86`, one slot of the GPU carveout
    # `setu_buf_create` asks `#86` first and falls back to `#71`, so **which cap applies depends on
    # whether the machine has a GPU carveout — and under QEMU it does not.** A client cannot query
    # which backing it got.
    # ⇒ THE CAP HERE IS THE ABSURDITY BOUND, NOT THE ANSWER. It is the highest any backing could ever
    # provide; the real arbiter is whether `setu_buf_create` succeeds, and `main.cyr` now survives a
    # refusal instead of guessing. Guessing was the bug.
    CRAB_SURFACE_BYTES_MAX = 33554432;   # agnos SHM_GPU_MAX_SIZE — the ceiling of any backing
}

# Byte size of a `w` x `h` BGRA surface, or **-1** when the extent is not one we will honour.
#
# ⛔ THE CAPS ARE NOT DEFENSIVE PADDING, THEY ARE WHAT MAKES OVERFLOW UNREACHABLE. `w * h * 4` on
# attacker-or-compositor-supplied dimensions is a multiplication crab then uses to size a shm slot
# and to bound a `setu_buf_write`. Bounding each axis at 4096 caps the product at 67 MB — far inside
# i64 — so there is no wrap to reason about, and the byte cap then bounds the slot itself.
# ⚠ A `#86` GPU-visible slot is a scarce, system-wide resource: there are **16**. Honouring an absurd
# ask would spend one on a surface nothing can composite.
fn crab_surface_bytes(w, h): i64 {
    if (w <= 0) { return 0 - 1; }
    if (h <= 0) { return 0 - 1; }
    if (w > CRAB_DIM_MAX) { return 0 - 1; }
    if (h > CRAB_DIM_MAX) { return 0 - 1; }
    var n = w * h * 4;
    if (n > CRAB_SURFACE_BYTES_MAX) { return 0 - 1; }
    return n;
}

# ⭐⭐ POINTER POLICY (M2, *deferral #05*). Like the resize policy above, the DECISION lives here so a
# test can reach it; the geometry is in `src/ui.cyr` and the syscall plumbing in `src/main.cyr`.
#
# ⛔⛔ AND crab OWNS ITS INTERACTION STATE — IT DOES NOT USE `dh_dispatch`. Operator ruling
# 2026-08-27, and the reason is structural: `dh_dispatch` tracks a press by storing a **widget
# pointer** (`_dh_press`), and crab rebuilds its whole tree every frame with `dh_frame_begin()`
# rewinding the arena and clearing exactly those pointers. A press and its release are separated by a
# rebuild, so the press target no longer exists. dhancha 0.9.15 says it outright — *cross-frame widget
# identity and a per-frame arena are mutually exclusive by construction* — and press/release tracking
# IS cross-frame widget identity. ⇒ crab tracks **pane index + row index**, which survive a rebuild
# because they are its own model rather than the toolkit's. The toolkit supplies geometry only.
enum CrabPointer {
    CRAB_DOUBLECLICK_MS = 400;
    CRAB_SCROLL_ROWS = 3;         # rows the selection moves per wheel detent
    # ⚠ Manhattan pointer travel before a press becomes a DRAG rather than a click. Same idea as
    # dhancha's `DH_DRAG_THRESHOLD`, and the same value — a hand resting on a mouse jitters by a
    # pixel or two, and a drag that triggers on jitter would move files on an intended click.
    CRAB_DRAG_THRESHOLD = 4;
}

# =================================================================================================
# M4 — MULTI-SELECT. Marks, and the queue that lets one stepped transfer serve many files.
# =================================================================================================
#
# ⛔ MARKS ARE A BYTE PER ENTRY, PARALLEL TO THE RECORD BUFFER, and they are cleared by every
# re-listing. A mark is an INDEX, and an index means nothing once the directory has been read again:
# entries move when the sort mode changes, and disappear when a file is deleted. A stale mark set
# would act on whatever now occupies that row, which is the worst possible failure for a delete.
# ⚠ Marks are separate from the CURSOR (`sel_l`/`sel_r`). The cursor is where the keyboard is; marks
# are what the next verb acts on. With nothing marked, the verbs act on the cursor — so an operator
# who never presses Space never sees a difference.

# ⭐⭐ THE QUEUE HOLDS NAMES, NOT INDICES, AND THAT IS THE WHOLE REASON IT EXISTS. A multi-file copy
# re-lists both panes after each file, so any index captured when the operator pressed `c` is wrong
# by the time the second file starts. Names survive a re-listing; indices do not.
# ⚠ Allocated lazily and ONCE — `CRAB_MAX_ENTRIES * CRAB_NAME_MAX` is 64 KB, which is real, so a
# crab that never multi-selects never pays it.
var crab_q = 0;
var crab_qn = 0;
var crab_qi = 0;

fn crab_queue_buf(): i64 {
    if (crab_q == 0) { crab_q = alloc(CRAB_MAX_ENTRIES * CRAB_NAME_MAX); }
    return crab_q;
}

# @public — load the marked entries' NAMES into the queue. -> how many were queued.
fn crab_queue_marked(buf, marks, count): i64 {
    var q = crab_queue_buf();
    crab_qn = 0;
    crab_qi = 0;
    if (q == 0) { return 0; }
    var i = 0;
    while (i < count) {
        if (load8(marks + i) != 0) {
            crab_strcpy_n(q + crab_qn * CRAB_NAME_MAX, buf + i * CRAB_REC_SZ, CRAB_NAME_MAX);
            crab_qn = crab_qn + 1;
        }
        i = i + 1;
    }
    return crab_qn;
}

# @public — the next queued name, or 0 when the queue is spent. Advances.
fn crab_queue_next(): i64 {
    if (crab_q == 0) { return 0; }
    if (crab_qi >= crab_qn) { return 0; }
    var p = crab_q + crab_qi * CRAB_NAME_MAX;
    crab_qi = crab_qi + 1;
    return p;
}

# @public — how many entries are still waiting (excluding the one in flight).
fn crab_queue_left(): i64 {
    if (crab_q == 0) { return 0; }
    if (crab_qi >= crab_qn) { return 0; }
    return crab_qn - crab_qi;
}

fn crab_queue_reset(): i64 { crab_qn = 0; crab_qi = 0; return 0; }

# ⭐ THE QUEUE'S DESTINATION IS CAPTURED WHEN IT STARTS, NOT READ FROM THE PANE EACH TIME. A
# multi-file transfer spans many idle ticks, and the operator can navigate either pane while it runs
# — reading `lpath`/`rpath` at each step would send the second file somewhere the first did not go.
var crab_qkind = 0;
var crab_qsrc = 0;
var crab_qdst = 0;

fn crab_queue_dirs(kind, srcdir, dstdir): i64 {
    if (crab_qsrc == 0) { crab_qsrc = alloc(CRAB_PATH_MAX); }
    if (crab_qdst == 0) { crab_qdst = alloc(CRAB_PATH_MAX); }
    if (crab_qsrc == 0) { return 0 - 1; }
    if (crab_qdst == 0) { return 0 - 1; }
    crab_qkind = kind;
    crab_strcpy_n(crab_qsrc, srcdir, CRAB_PATH_MAX);
    crab_strcpy_n(crab_qdst, dstdir, CRAB_PATH_MAX);
    return 0;
}

fn crab_queue_kind(): i64 { return crab_qkind; }
fn crab_queue_srcdir(): i64 { return crab_qsrc; }
fn crab_queue_dstdir(): i64 { return crab_qdst; }

# @public — start the next queued transfer, if any. -> 1 = started, 0 = queue spent, <0 = every
# remaining entry was refused, and this is the LAST refusal.
#
# ⛔⛔ THIS SAID "A REFUSAL DOES NOT STOP THE QUEUE" FOR FOUR RELEASES WHILE DOING THE OPPOSITE, and
# the comment is why nobody looked. It started ONE entry and returned the refusal, so the idle tick
# (`src/main.cyr`, the `crab_op_active() == 1` arm) saw `more != 1`, reported, and stopped — and
# with nothing in flight that arm is never entered again, so the rest of the queue was abandoned
# where it stood. **Marking ten files with the first already present at the destination transferred
# none of the other nine**, which is the exact case the prose promised was handled.
# ⇒ The loop is the contract. A refusal consumes its entry and the queue moves on.
# ⚠ THE RETURN IS STILL A SINGLE VALUE, so per-entry refusals are not individually reported — the
# caller sees the last one only when NOTHING could be started. That is a deliberate narrowing of the
# old shape rather than a new report channel: the tray is one line, and a per-entry log belongs with
# a real transfer report. What matters here is that entry two is attempted.
fn crab_queue_advance(scr1, scr2, statbuf): i64 {
    var last = 0;
    var nm = crab_queue_next();
    while (nm != 0) {
        var rc = crab_copy_begin(crab_qkind, crab_qsrc, nm, crab_qdst, scr1, scr2, statbuf);
        if (rc == CRAB_FS_OK) { return 1; }
        # ⛔ EBUSY IS NOT A PER-ENTRY REFUSAL AND MUST NOT BE SKIPPED PAST. It means a transfer is
        # already in flight, so consuming the rest of the queue against it would discard every
        # remaining entry without attempting one. Report it and leave the queue where it is.
        if (rc == CRAB_FS_EBUSY) { return rc; }
        last = rc;
        nm = crab_queue_next();
    }
    return last;
}

# @public — has a press travelled far enough to be a drag? 1 = drag, 0 = still a click.
#
# ⭐⭐ crab IMPLEMENTS DRAG ITSELF, AND THAT IS NOT A WORKAROUND — IT IS THE SAME DECISION crab
# ALREADY MADE FOR EVERY OTHER POINTER GESTURE. dhancha synthesizes `DRAG_START`/`_MOVE`/`_DROP`/
# `_END` inside `dh_dispatch`, which crab does not use (ruling 2026-08-27, see the ⛔ above): the
# toolkit tracks a press as a **widget pointer**, and crab rebuilds its whole tree every frame with
# the arena rewinding underneath it. Double-click hit that wall first and was solved by tracking
# **pane index + row index**; the wheel likewise. Drag is the third gesture and takes the same shape.
# ⇒ The toolkit supplies geometry (`dh_hit_test` via `crab_hit`); crab supplies identity that
# survives a frame. dhancha 0.9.21 made its own drag refuse to half-fire under an arena, which is
# correct for dhancha and simply not the path crab takes.
fn crab_drag_started(x0, y0, x, y): i64 {
    var dx = x - x0;
    if (dx < 0) { dx = 0 - dx; }
    var dy = y - y0;
    if (dy < 0) { dy = 0 - dy; }
    if ((dx + dy) >= CRAB_DRAG_THRESHOLD) { return 1; }
    return 0;
}

# @public — is this drop a real cross-pane transfer? 1 = do it, 0 = ignore.
#
# ⛔ A DROP INSIDE THE SOURCE PANE IS NOT A TRANSFER, and must not be treated as one. Dragging a row
# a few pixels within its own pane is how an operator scrubs a selection or changes their mind; a
# copy or move there would either refuse with `CRAB_FS_ESAME` (noise) or, worse, act on a
# same-named file. The destination has to be the OTHER pane.
# ⚠ `-1` is `crab_hit`'s "no pane here" answer, and it must not compare equal to anything.
fn crab_drag_targets(frompane, topane): i64 {
    if (frompane < 0) { return 0; }
    if (topane < 0) { return 0; }
    if (frompane == topane) { return 0; }
    return 1;
}

# @public — what should `c` / `m` actually DO? One of the `CRAB_PLAN_*` answers.
#
# ⛔⛔ THIS EXISTS BECAUSE THE DECISION IT REPLACES WAS UNREACHABLE BY EVERY TEST crab HAS. It lived
# inline in `src/main.cyr`'s key dispatch, which sits inside a single `#ifdef CYRIUS_TARGET_AGNOS`
# spanning lines 263–1484 with **no `#else`** — so the host build does not compile it, nothing
# includes `main.cyr`, and the suite cannot call it. Two data-affecting defects shipped in that
# branch and no assertion in 1,138 could have caught either:
#   - `m` on a folder ran `CRAB_OP_CTREE`, a COPY, and reported `copying folder...`;
#   - the marked set was read only in the not-a-folder arm, so a cursor resting on a FOLDER
#     silently discarded every mark.
# ⇒ Lifting the decision here is the same move `crab_drag_targets`, `crab_two_panes_fit` and
# `crab_walk_retry_as_dir` already made: the event loop keeps the wiring, the RULE becomes a pure
# function the suite can interrogate. What remains untestable is that `main.cyr` still calls it —
# the irreducible gap, identical in shape to the idle-tick wiring.
#
# ⛔ THE ORDER OF THE TWO TESTS IS THE WHOLE POINT. Marks are consulted FIRST, unconditionally,
# because marks outrank the cursor. The cursor's type only decides anything when nothing is marked.
# ⚠ A MARKED FOLDER IS NOT A RECURSIVE COPY. It goes to the queue like any other marked entry and is
# refused there by `crab_copy_begin`'s `EISDIR` guard, which `crab_queue_advance` skips past. Making
# a mark mean "recurse" would make one keystroke mean two very different amounts of work depending
# on data the operator cannot see from the row.
fn crab_transfer_plan(is_move, marked, cursor_is_dir): i64 {
    if (marked > 0) { return CRAB_PLAN_QUEUE; }
    if (cursor_is_dir == 0) { return CRAB_PLAN_SINGLE; }
    # ⛔ NO `CRAB_OP_MTREE` EXISTS — the walk kinds are IDLE/COPY/MOVE/CTREE/DTREE — so there is no
    # source-removing tree walk to dispatch to. Refusing out loud is the honest answer; running a
    # copy and calling it a move is not.
    if (is_move != 0) { return CRAB_PLAN_NOMOVEDIR; }
    return CRAB_PLAN_TREE;
}

# Where the selection lands after a wheel delta, clamped to [0, count-1]. -> the new index.
#
# ⛔⛔ THE WHEEL MOVES THE SELECTION, NOT THE VIEW, AND THAT IS A DESIGN CHOICE WITH A REASON.
# `crab_render` restores each pane's scroll offset and then calls `dh_list_scroll_to_sel`, which
# enforces "the selection is visible" — so a free-scrolled view would be snapped back on the very next
# frame by the machinery that makes keyboard navigation work. Decoupling them means revisiting the
# scroll round-trip, which is load-bearing and heavily documented (`src/ui.cyr`).
# ⇒ Moving the selection makes the view follow for free and fights nothing. ⚠ It is NOT what every
# file manager does — a detached view-scroll is the other reasonable answer, and it is a separate
# change rather than a tweak.
# ⚠ SIGN: positive delta is wheel-UP (away from the user), which moves toward index 0.
fn crab_scroll_sel(sel, count, delta): i64 {
    if (count <= 0) { return 0; }
    var n = sel - delta * CRAB_SCROLL_ROWS;
    if (n < 0) { n = 0; }
    if (n > count - 1) { n = count - 1; }
    return n;
}

# Is this click the second half of a double-click? -> 1 double, 0 single.
#
# ⚠ SAME ROW, SAME PANE, AND INSIDE THE WINDOW. Two clicks on different rows are two selections, not
# an activation — treating them as a double would descend into whichever row happened to be second.
# ⛔ A NEGATIVE INTERVAL IS NEVER A DOUBLE-CLICK. `clock_now_ms` is monotonic on agnos (bound to
# uptime, `#40`), so `dt < 0` should be impossible — which is exactly why it must not be *assumed*.
# If the clock ever moves backwards, guessing "double" would descend into a directory the operator
# only clicked once, and a wrong descend is indistinguishable from a misclick after the fact.
fn crab_is_double(prev_pane, prev_row, prev_ms, pane, row, ms): i64 {
    if (prev_row < 0) { return 0; }              # no previous click to pair with
    if (row < 0) { return 0; }
    if (prev_pane != pane) { return 0; }
    if (prev_row != row) { return 0; }
    var dt = ms - prev_ms;
    if (dt < 0) { return 0; }
    if (dt > CRAB_DOUBLECLICK_MS) { return 0; }
    return 1;
}

# Log a resize outcome with its extent. ⚠ "resized" on its own proves an event arrived, not that the
# surface actually grew — and the two look identical in a serial log, which is how a harness scores a
# pass for a test it never performed. The NUMBERS are the oracle.
fn crab_log_extent(tag, w, h): i64 {
    var d = alloc(24);
    crab_say(tag);
    crab_u2s(d, w); crab_say(d); crab_say("x");
    crab_u2s(d, h); crab_say(d); crab_say("\n");
    return 0;
}

# Should a `WINDOW_CONFIGURE` ask be adopted? -> 1 adopt, 0 ignore.
#
# ⛔ A DEGENERATE ASK IS REFUSED, NOT CLAMPED. The compositor asking is not the same as the ask being
# usable, and a 0-wide pane is not a smaller pane — it is a divide-by-zero waiting in the layout.
# ⚠ AND AN ASK FOR THE SIZE WE ALREADY HAVE IS IGNORED. A compositor is free to re-send CONFIGURE
# with the current extent; adopting it would close and re-create a scarce `#86` shm slot, throw away
# the cached render target, and re-ATTACH — every time, for no change on screen.
fn crab_resize_wanted(cur_w, cur_h, ask_w, ask_h): i64 {
    if (crab_surface_bytes(ask_w, ask_h) < 0) { return 0; }
    if (ask_w == cur_w) {
        if (ask_h == cur_h) { return 0; }
    }
    return 1;
}

# ============================================================================================
# ⭐⭐ SORTING (M3, *deferral #33*) — the pane rendered raw readdir order, which is ON-DISK order
# ============================================================================================
# A directory listing in creation-or-wherever-ext2-put-it order is not a browser. This is the
# comparison and the sort; `src/main.cyr` calls it after every listing.
#
# ⛔ DIRECTORIES FIRST, UNCONDITIONALLY, and it is a separate axis from the sort key rather than a
# mode of it. Every file manager does this and the reason is navigational: directories are where you
# GO, files are what you act on, and interleaving them by name means hunting for the one folder in a
# hundred files. Making it optional would be a setting nobody turns off.
#
# ⛔⛔ DOTFILES ARE **NOT** HIDDEN, DELIBERATELY. Hiding them is the other half of what a file manager
# usually does — and it is only safe when there is a way to reveal them. crab has no "show hidden"
# affordance and no settings surface to put one on, so hiding would make files that exist
# unreachable and unmentioned, with the operator given no reason to suspect it. ⚠ A file manager that
# silently omits files is worse than one that shows too many. They sort naturally: `.` is 0x2E, ahead
# of every letter, so they cluster at the top of their group.
# ⚠ MODULE STATE, not a parameter threaded through every listing. `crab_descend` / `crab_ascend`
# already take nine arguments each and are called from four places; adding a tenth for a value that
# is global to the session buys nothing. It is read by the sort and written by one key.
var crab_sort_mode = 0;                          # CRAB_SORT_NAME

# Advance to the next sort mode, wrapping. -> the new mode.
fn crab_sort_cycle(): i64 {
    crab_sort_mode = crab_sort_mode + 1;
    if (crab_sort_mode >= CrabSort.CRAB_SORT_MODES) { crab_sort_mode = 0; }
    return crab_sort_mode;
}

fn crab_sort_mode_get(): i64 { return crab_sort_mode; }

# The mode's name, for the serial log — a number alone cannot be checked by a harness reading a log.
fn crab_sort_name(mode): i64 {
    if (mode == CrabSort.CRAB_SORT_SIZE) { return "size"; }
    if (mode == CrabSort.CRAB_SORT_MTIME) { return "modified"; }
    if (mode == CrabSort.CRAB_SORT_KIND) { return "kind"; }
    return "name";
}

enum CrabSort {
    CRAB_SORT_NAME  = 0;     # A-Z, case-insensitive
    CRAB_SORT_SIZE  = 1;     # largest first
    CRAB_SORT_MTIME = 2;     # newest first
    CRAB_SORT_KIND  = 3;     # by extension, then name
    CRAB_SORT_MODES = 4;     # how many there are — the cycle wraps on this
}

# Fold one ASCII byte to lower case. Bytes outside A-Z pass through, so this is safe on UTF-8
# continuation bytes (all >= 0x80) rather than corrupting them.
fn crab_lower(c): i64 {
    if (c >= 65) {
        if (c <= 90) { return c + 32; }
    }
    return c;
}

# Compare two NUL-terminated names. -> <0, 0, >0.
#
# ⚠ CASE-INSENSITIVE FIRST, THEN CASE-SENSITIVE AS A TIEBREAK. `README.md` sorting a hundred rows
# from `readme.md` is the thing byte-order gets wrong and operators notice immediately. The
# second pass exists so the order is TOTAL: without it `a` and `A` compare equal, and a stable sort
# would then leave them in readdir order — which is on-disk order, i.e. the thing this replaces.
fn crab_name_cmp(a, b): i64 {
    var i = 0;
    var ca = crab_lower(load8(a));
    var cb = crab_lower(load8(b));
    while (ca == cb) {
        if (ca == 0) { i = 0 - 1; }              # both names ended: equal when case-folded
        if (i < 0) { ca = 0; cb = 0; break; }
        i = i + 1;
        ca = crab_lower(load8(a + i));
        cb = crab_lower(load8(b + i));
    }
    if (ca != cb) { return ca - cb; }
    # Case-folded equal — fall back to RAW bytes so the order is total. Without this `a` and `A` tie,
    # and a stable sort then leaves them in readdir order, i.e. on-disk order — the thing this file
    # exists to replace.
    var j = 0;
    var ra = load8(a);
    var rb = load8(b);
    while (ra == rb) {
        if (ra == 0) { return 0; }
        j = j + 1;
        ra = load8(a + j);
        rb = load8(b + j);
    }
    return ra - rb;
}

# The extension of a name: the offset just past the LAST '.', or the name length when there is none.
# ⚠ A LEADING dot is not an extension. `.bashrc` is a dotfile named `bashrc`, not a file of type
# `bashrc` — starting the scan at 1 is what keeps every dotfile from sorting into its own "kind".
fn crab_ext_at(name): i64 {
    var n = 0;
    while (load8(name + n) != 0) { n = n + 1; }
    var dot = n;
    var i = 1;
    while (i < n) {
        if (load8(name + i) == 46) { dot = i + 1; }
        i = i + 1;
    }
    return dot;
}

# Compare entries `i` and `j`. -> <0 if i sorts first, >0 if j does, 0 if genuinely tied.
fn crab_entry_cmp(buf, sizes, mtimes, i, j, mode): i64 {
    var ri = buf + i * CRAB_REC_SZ;
    var rj = buf + j * CRAB_REC_SZ;
    # ⛔ THE DIRECTORY AXIS RUNS FIRST AND OUTRANKS THE KEY. Sorting by size with directories mixed in
    # is meaningless anyway — a directory's size is the entry itself, not its contents.
    var di = 0; if (load8(ri + CRAB_REC_TYPE) == 1) { di = 1; }
    var dj = 0; if (load8(rj + CRAB_REC_TYPE) == 1) { dj = 1; }
    if (di != dj) { return dj - di; }              # 1 (dir) sorts before 0 (file)

    if (mode == CRAB_SORT_SIZE) {
        var si = load64(sizes + i * 8);
        var sj = load64(sizes + j * 8);
        # ⚠ THE -1 GUARD IS UNEXERCISED UNDER THE CURRENT ORDER, AND SAYING SO BEATS THE CONFIDENT
        # CLAIM THAT WAS HERE. The first draft asserted it stopped unstattable entries leading a
        # largest-first list. That is FALSE: -1 is the smallest value, so largest-first already sinks
        # them. Mutation proved it — deleting these two lines fails nothing.
        # ⇒ Kept, because the moment a smallest-first or oldest-first order exists (column headers,
        # M3 *#32*) -1 leads the list and reads as a sorting bug. Explicit intent for the cost of two
        # comparisons, labelled as defence rather than sold as a fix.
        if (si < 0) { if (sj >= 0) { return 1; } }
        if (sj < 0) { if (si >= 0) { return 0 - 1; } }
        if (si != sj) {
            if (si > sj) { return 0 - 1; }         # largest first
            return 1;
        }
    }
    if (mode == CRAB_SORT_MTIME) {
        var mi = load64(mtimes + i * 8);
        var mj = load64(mtimes + j * 8);
        if (mi < 0) { if (mj >= 0) { return 1; } }
        if (mj < 0) { if (mi >= 0) { return 0 - 1; } }
        if (mi != mj) {
            if (mi > mj) { return 0 - 1; }         # newest first
            return 1;
        }
    }
    if (mode == CRAB_SORT_KIND) {
        var ei = crab_ext_at(ri);
        var ej = crab_ext_at(rj);
        var ce = crab_name_cmp(ri + ei, rj + ej);
        if (ce != 0) { return ce; }
    }
    # NAME is the default and every other mode's tiebreak, so a tie is never left to readdir order.
    return crab_name_cmp(ri, rj);
}

# ⭐⭐ THE SORT'S SCRATCH, ALLOCATED ONCE FOR THE PROCESS. Two index arrays and one record.
#
# ⛔ `alloc` IS A BUMP ALLOCATOR WITH NO `free()`, AND THIS USED TO BE PER CALL. The insertion sort
# below took its 64-byte swap slot with a bare `alloc(CRAB_REC_SZ)` inside the function — and the
# function runs once per listing, i.e. on every descend and every ascend. That is 64 bytes leaked
# per keypress, forever, in the allocator whose per-frame cost four releases were spent driving to
# zero. Hoisting it here is not a micro-optimisation; it is the same rule the frame arena obeys.
# ⚠ 16 KB + 64 B, once, against the ~597 KB crab already pays at startup for the render target and
# the arena. A fixed cost instead of a per-keypress one, which is the whole pattern in this app.
var crab_sidx = 0;
var crab_stmp = 0;
var crab_srec = 0;

# -> the index scratch, or 0 if it could not be allocated (the caller then takes the slow path).
fn crab_sort_scratch(): i64 {
    if (crab_sidx == 0) {
        crab_sidx = alloc(CRAB_MAX_ENTRIES * 8);
        crab_stmp = alloc(CRAB_MAX_ENTRIES * 8);
        crab_srec = alloc(CRAB_REC_SZ);
        if (crab_stmp == 0) { crab_sidx = 0; }
        if (crab_srec == 0) { crab_sidx = 0; }
    }
    return crab_sidx;
}

# Sort `count` entries in place by insertion — STABLE, O(n^2), and now the FALLBACK rather than the
# path. Kept, not deleted, for two reasons: it is what runs if the scratch above cannot be had, so
# the sort can never silently fail to sort; and it is the differential oracle the merge sort is
# tested against in `tests/crab.tcyr`, which is a stronger check than asserting either alone.
fn crab_sort_insertion(buf, sizes, mtimes, count, mode): i64 {
    if (count < 2) { return 0; }
    var scratch = crab_srec;
    if (scratch == 0) { scratch = alloc(CRAB_REC_SZ); }
    var i = 1;
    while (i < count) {
        var j = i;
        while (j > 0) {
            if (crab_entry_cmp(buf, sizes, mtimes, j - 1, j, mode) <= 0) { j = 0; }
            else {
                var a = buf + (j - 1) * CRAB_REC_SZ;
                var b = buf + j * CRAB_REC_SZ;
                var k = 0;
                while (k < CRAB_REC_SZ) { store8(scratch + k, load8(a + k)); k = k + 1; }
                k = 0;
                while (k < CRAB_REC_SZ) { store8(a + k, load8(b + k)); k = k + 1; }
                k = 0;
                while (k < CRAB_REC_SZ) { store8(b + k, load8(scratch + k)); k = k + 1; }
                var ts = load64(sizes + (j - 1) * 8);
                store64(sizes + (j - 1) * 8, load64(sizes + j * 8));
                store64(sizes + j * 8, ts);
                var tm = load64(mtimes + (j - 1) * 8);
                store64(mtimes + (j - 1) * 8, load64(mtimes + j * 8));
                store64(mtimes + j * 8, tm);
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Sort `count` entries in place, permuting the record, its size and its mtime together.
#
# ⛔ ALL THREE ARRAYS MOVE TOGETHER OR NONE DO. `sizes[i]` and `mtimes[i]` are parallel to record `i`;
# permuting the records alone would leave every row showing another file's size and date — and the
# status line reads the same index, so it would agree with the wrong answer confidently.
#
# ⛔⛔ THIS RUNS ON THE KEYSTROKE PATH, WHICH IS WHY IT IS NO LONGER O(n^2). It is called once per
# listing — so on every descend, every ascend, and twice more when `s` cycles the sort mode. The
# insertion sort above was justified by a comment reading "`CRAB_MAX_ENTRIES` is 256"; M3 *#02*
# raised the cap to 1024 and never re-derived it. Measured native x86_64, and agnos under QEMU is
# far slower:
#
#   | n    | random | reverse-sorted |
#   |------|--------|----------------|
#   | 256  |   6 ms |          14 ms |
#   | 1024 | 100 ms |         200 ms |
#
# M3 *#03* existed to remove ~280 ms from exactly this path by deferring the stat sweep; putting
# 200 ms back into it undoes that work in the place the operator feels it.
#
# ⭐ BOTTOM-UP MERGE SORT OVER AN INDEX ARRAY, THEN ONE PERMUTATION PASS. Two things make it fast,
# and the second matters more than the first at this record size:
#   - O(n log n) comparisons rather than O(n^2)  — 10,240 vs ~524,288 at the cap
#   - **n record moves rather than O(n^2) swaps**. The old inner loop moved 64 bytes ONE BYTE AT A
#     TIME, three times per swap. Sorting indices means the 64-byte payload is touched once per
#     entry, by the cycle-following pass at the end, and never during the sort itself.
#
# ⚠ STABILITY IS PRESERVED AND IS LOAD-BEARING. `crab_entry_cmp` returns 0 only for entries
# identical on every axis including raw name bytes, but NAME is every other mode's tiebreak, so a
# stable sort is what keeps a re-sort from reshuffling equal rows under the selection. The merge
# takes from the LEFT run on `<= 0`, which is the stability condition.
# ⚠ Comparisons all happen BEFORE the permutation, so `crab_entry_cmp`'s indices refer to the
# original arrays throughout the merge — which is the only reason indirect sorting is valid here.
fn crab_sort_entries(buf, sizes, mtimes, count, mode): i64 {
    if (count < 2) { return 0; }
    var idx = crab_sort_scratch();
    if (idx == 0) { return crab_sort_insertion(buf, sizes, mtimes, count, mode); }
    var tmp = crab_stmp;
    var rec = crab_srec;

    var i = 0;
    while (i < count) { store64(idx + i * 8, i); i = i + 1; }

    # --- merge runs of `width` until one run covers everything -------------------------------------
    var width = 1;
    while (width < count) {
        var lo = 0;
        while (lo < count) {
            var mid = lo + width;
            var hi = lo + width + width;
            if (mid > count) { mid = count; }
            if (hi > count) { hi = count; }
            var a = lo;
            var b = mid;
            var o = lo;
            while (o < hi) {
                var takea = 0;
                if (a >= mid) { takea = 0; }                 # left run spent — the rest is right
                else {
                    if (b >= hi) { takea = 1; }              # right run spent — the rest is left
                    else {
                        # ⚠ `<= 0`, not `< 0`. This single character is the stability of the sort.
                        if (crab_entry_cmp(buf, sizes, mtimes,
                            load64(idx + a * 8), load64(idx + b * 8), mode) <= 0) { takea = 1; }
                    }
                }
                if (takea != 0) { store64(tmp + o * 8, load64(idx + a * 8)); a = a + 1; }
                else { store64(tmp + o * 8, load64(idx + b * 8)); b = b + 1; }
                o = o + 1;
            }
            lo = lo + width + width;
        }
        i = 0;
        while (i < count) { store64(idx + i * 8, load64(tmp + i * 8)); i = i + 1; }
        width = width + width;
    }

    # --- apply the permutation: sorted[k] = original[idx[k]] ---------------------------------------
    # ⭐ CYCLE-FOLLOWING, so every record is written AT MOST ONCE. Walking `idx` and swapping instead
    # would move the same record repeatedly; following each cycle lifts one record out, shifts the
    # rest of its cycle down, and drops the saved one into the hole. `idx[k] = k` marks a slot done,
    # so no separate visited set is needed and the pass is O(n) with no extra memory.
    i = 0;
    while (i < count) {
        if (load64(idx + i * 8) != i) {
            var s = 0;
            while (s < CRAB_REC_SZ) { store8(rec + s, load8(buf + i * CRAB_REC_SZ + s)); s = s + 1; }
            var hs = load64(sizes + i * 8);
            var hm = load64(mtimes + i * 8);
            var slot = i;
            var nxt = load64(idx + slot * 8);
            while (nxt != i) {
                s = 0;
                while (s < CRAB_REC_SZ) {
                    store8(buf + slot * CRAB_REC_SZ + s, load8(buf + nxt * CRAB_REC_SZ + s));
                    s = s + 1;
                }
                store64(sizes + slot * 8, load64(sizes + nxt * 8));
                store64(mtimes + slot * 8, load64(mtimes + nxt * 8));
                store64(idx + slot * 8, slot);
                slot = nxt;
                nxt = load64(idx + slot * 8);
            }
            s = 0;
            while (s < CRAB_REC_SZ) { store8(buf + slot * CRAB_REC_SZ + s, load8(rec + s)); s = s + 1; }
            store64(sizes + slot * 8, hs);
            store64(mtimes + slot * 8, hm);
            store64(idx + slot * 8, slot);
        }
        i = i + 1;
    }
    return 0;
}

# =================================================================================================
# M4 — FILE OPERATIONS. The write layer: the first thing in crab that CHANGES the disk.
# =================================================================================================
#
# ⭐⭐ THE ROADMAP SAID "Gate: agnos write syscalls" AND THAT GATE DOES NOT EXIST. Every arm is real
# and mount-routed, and has been since agnos 1.41.3 — `open`#7 (`syscall.cyr:8496`), `mkdir`#9
# (`:8547`), `rmdir`#10 (`:8565`), `unlink`#30 (`:8849`), `rename`#31 (`:8879`) — and crab's ALREADY
# PINNED cyrius 6.5.35 vendors a wrapper for every one of them. No pin move was required.
# ⛔ THE TRAP THAT MAKES ANYONE RE-CHECKING THIS REACH THE WRONG ANSWER: agnos's own userland-ABI
# TABLE still describes mkdir and rmdir as "🔧 stub -> 0" and open as "initrd_open ONLY". The table
# is stale; the dispatcher is not. VERIFY AGAINST THE DISPATCHER, NEVER THE TABLE.
#
# ⛔⛔ THE TWO TARGETS DISAGREE ON EVERY SIGNATURE, AND THAT IS WHY THIS SHIM EXISTS. agnos takes an
# explicit length on every path (`sys_mkdir(path, pathlen)`); Linux takes a NUL-terminated path and
# a MODE in the same argument position (`sys_mkdir(path, mode)`). They are the same arity with
# different meanings, so a call written for one compiles clean against the other and does something
# else entirely — passing 0755 where a length belongs, or a length where permissions belong. Nothing
# in the type system catches it. ⇒ ONE shim per operation, and no other code in crab calls `sys_*`.
#
# ⭐ AND THE HOST ARM IS REAL, WHICH IS THE POINT. Unlike `#101` readdir — agnos-only, so the suite
# can never execute it — these ARE Linux syscalls on the host, so `tests/crab.tcyr` operates on a
# real temporary directory and asserts on real files. The refusal logic, the join, the overwrite
# guard and the copy loop are all exercised for real; only the agnos ABI arm is taken on trust.

fn crab_fs_mkdir_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, plen);
    #else
    return sys_mkdir(path, 0x1ED);                       # 0755
    #endif
}

fn crab_fs_rmdir_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, plen);
    #else
    return sys_rmdir(path);
    #endif
}

fn crab_fs_unlink_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path, plen);
    #else
    return sys_unlink(path);
    #endif
}

fn crab_fs_rename_raw(op, olen, np, nlen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rename(op, olen, np, nlen);
    #else
    return sys_rename(op, np);
    #endif
}

# Open for reading. -> fd, or negative.
fn crab_fs_open_r(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(path, plen, AO_RDONLY);
    #else
    return sys_open(path, O_RDONLY, 0);
    #endif
}

# Create-and-open for writing. -> fd, or negative.
#
# ⛔⛔ THERE IS NO `AO_EXCL` ON agnos, SO THE KERNEL CANNOT REFUSE AN OVERWRITE FOR US. Linux has
# `O_EXCL` and agnos's flag set stops at CREAT/TRUNC/APPEND/DIRECTORY — there is no exclusive-create
# bit to pass. A copy that relied on the open failing would therefore silently TRUNCATE the
# destination on agnos and correctly refuse on the host: the same code, opposite outcomes, and the
# dangerous one is the target that ships.
# ⇒ Every caller MUST establish absence with `crab_fs_exists` first. That check is the guard, not
# this flag word.
# ⚠ AND IT IS A TOCTOU WINDOW crab CANNOT CLOSE. Between the stat and this open, another process
# may create the file. crab is a single-user desktop file manager and the race needs a second
# writer to the same path in the same instant; it is disclosed rather than pretended away, and it
# closes for free the day agnos grows an exclusive-create flag.
fn crab_fs_open_w(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(path, plen, AO_WRONLY | AO_CREAT | AO_TRUNC);
    #else
    return sys_open(path, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);   # 0644
    #endif
}

# Does `path` resolve? 1 = yes, 0 = no.
#
# ⚠ THE ONLY QUESTION ASKED IS EXISTENCE, and `stat` is the only primitive both targets have for it.
# ⛔ IT FOLLOWS SYMLINKS. So a dangling symlink (the burn's `/sl_s`) reports as ABSENT here, and a
# copy onto it would replace the link — which is why the destination guard is stated as "resolves"
# rather than "is free".
# ⛔⛔ THAT IS NOW A CHOICE, NOT A LIMIT, AND THE COMMENT HERE SAID OTHERWISE FOR FOUR RELEASES.
# It read "its cyrius peer is still OPEN — there is no `sys_lstat` to call". **cyrius 6.5.37 shipped
# it**, and crab has vendored it since the 6.5.41 pin: `lib/syscalls_x86_64_agnos.cyr` declares
# `SYS_LSTAT = 102` and `fn sys_lstat(path, pathlen, statbuf)`, with host peers in
# `syscalls_x86_64_linux.cyr` (2-arg) and the macOS/aarch64 tables. cyrius's own issue is archived.
# ⚠ IT IS STILL NOT CALLED, deliberately: closing the gap is a `crab_fs_lstat` in exactly the
# `#ifdef` arity shape three lines below, plus a decision about what crab DOES with the answer
# (refuse? report? recreate the link?) — and that decision is the operator's, not this function's.
# ⇒ A gate that has closed upstream and is still written as a limit is how work stays parked after
# it became free. See also `crab_walk_step`'s type-byte gate, which must NOT start calling it.
fn crab_fs_exists(path, plen, statbuf): i64 {
    var rc = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    rc = sys_stat(path, plen, statbuf);
    #else
    rc = sys_stat(path, statbuf);
    #endif
    if (rc < 0) { return 0; }
    return 1;
}

# @public — the byte size of `path`, or -1 if it could not be stat'd.
#
# ⭐ NOTHING ASKED THIS BEFORE, WHICH IS WHY THE TRAY HAD NO DENOMINATOR. `crab_fs_exists` stats the
# DESTINATION for the overwrite guard and throws the statbuf away; the source was opened without ever
# being measured. A stepped copy needs the total up front or its bar can only be indeterminate.
# ⚠ -1 IS A FIRST-CLASS ANSWER, not a failure to handle: it flows into `CRAB_OP_TOTAL` and the bar
# renders indeterminate, which is precisely the state dhancha 0.9.22 added `den <= 0` for. On a host
# build it is the normal answer and the copy still runs.
fn crab_fs_stat_size(path, plen, statbuf): i64 {
    var rc = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    rc = sys_stat(path, plen, statbuf);
    #else
    rc = sys_stat(path, statbuf);
    #endif
    if (rc < 0) { return 0 - 1; }
    return load64(statbuf + STAT_SIZE);
}

# =================================================================================================
# M6 — PLACES. The sidebar's model, built HERE and not in the render path.
# =================================================================================================
#
# ⛔⛔ ONLY THE BUILDER LIVES HERE. The record LAYOUT and its accessors are in `ui.cyr`, because the
# render path must never call up into this file. `src/ui.cyr` is
# included BY this file, and both `render_test.cyr` and the suite include `ui.cyr` ALONE — so a
# sidebar that called `getenv` or `sys_stat` from `crab_sidebar` would compile through `main.cyr`
# and leave `render_test` with undefined symbols. That has happened five times in this codebase.
# ⇒ The model is built above and PASSED DOWN, exactly as the pane buffers are. `ui.cyr` renders
# what it is handed and asks the filesystem nothing.
#
# ⭐ A PLACE IS ONLY LISTED IF IT ACTUALLY EXISTS. Every candidate below is stat'd, and one that is
# not a directory is dropped. A sidebar that lists `Downloads` on a machine that has never had one
# is a row that does nothing, and the operator cannot tell it apart from a row that is broken.
# ⚠ `HOME` is read once from the environment. On agnos the compositor spawns crab, so the
# environment is whatever it staged — an absent `HOME` simply yields fewer places, never a crash.
# Append one place if `path` stats as a directory. -> the new count.
fn crab_place_add(dst, n, label, path, statbuf): i64 {
    if (n >= CRAB_PLACES_MAX) { return n; }
    if (path == 0) { return n; }
    if (load8(path) == 0) { return n; }
    var pl = crab_cstr_len(path, CRAB_PATH_MAX);
    if (pl < 0) { return n; }
    if (crab_fs_isdir(path, pl, statbuf) == 0) { return n; }
    var rec = dst + n * CRAB_PLACE_SZ;
    crab_strcpy_n(rec + CRAB_PLACE_LABEL, label, CRAB_NAME_MAX);
    crab_strcpy_n(rec + CRAB_PLACE_PATH, path, CRAB_PATH_MAX);
    return n + 1;
}

# @public — fill `dst` (CRAB_PLACES_MAX * CRAB_PLACE_SZ bytes) with the places that exist.
# -> how many were written.
#
# ⚠ ORDER IS FIXED AND MEANINGFUL: Home first because it is where an operator starts, then the
# well-known subdirectories in the order a desktop lists them, then Root last because it is the
# escape hatch rather than a destination. A sidebar whose rows move between runs is one nobody can
# build muscle memory against.
fn crab_places_build(dst, scr, statbuf): i64 {
    var n = 0;
    var home = getenv("HOME");
    n = crab_place_add(dst, n, "Home", home, statbuf);
    if (home != 0) {
        if (load8(home) != 0) {
            n = crab_places_sub(dst, n, home, "Desktop", scr, statbuf);
            n = crab_places_sub(dst, n, home, "Documents", scr, statbuf);
            n = crab_places_sub(dst, n, home, "Downloads", scr, statbuf);
            n = crab_places_sub(dst, n, home, "Pictures", scr, statbuf);
            n = crab_places_sub(dst, n, home, "Music", scr, statbuf);
        }
    }
    n = crab_place_add(dst, n, "Root", "/", statbuf);
    return n;
}

# Join `home`/`name` into `scr` and add it if it exists. -> the new count.
fn crab_places_sub(dst, n, home, name, scr, statbuf): i64 {
    if (crab_fs_path(scr, home, name) < 0) { return n; }
    return crab_place_add(dst, n, name, scr, statbuf);
}

# @public — is `path` a directory? 1 = yes, 0 = no or unstattable.
#
# ⛔ ASKED OF THE PATH, NOT OF A readdir RECORD, AND THAT IS THE POINT. Every other "is it a folder"
# test in crab reads `CRAB_REC_TYPE` off a listing record — which works only where a record is in
# hand. The transfer queue holds NAMES (`crab_queue_marked`), deliberately: a queue of indices into a
# buffer that the relist rebuilds is a queue of stale pointers. So the one caller that most needs the
# answer is the one that cannot ask a record for it.
# ⚠ 0 FOR AN UNSTATTABLE PATH, not -1. The caller is a guard deciding whether to refuse; a path that
# cannot be stat'd is not a directory crab knows about, and the open that follows will fail with its
# own named result. Folding "cannot tell" into "not a directory" keeps this a two-answer question.
# ⚠ `load64` over a 4-byte `st_mode` picks up `st_uid` in the high word on Linux (and `st_nlink` on
# macOS — see `lib/syscalls_macos.cyr:262`). The mask is what makes that harmless: S_IFMT lives in
# the low 16 bits on every target. Parens are explicit per crab's own mixed-expression rule.
fn crab_fs_isdir(path, plen, statbuf): i64 {
    var rc = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    rc = sys_stat(path, plen, statbuf);
    #else
    rc = sys_stat(path, statbuf);
    #endif
    if (rc < 0) { return 0; }
    if ((load64(statbuf + STAT_MODE) & 0xF000) == 0x4000) { return 1; }
    return 0;
}

# ⚠ Named results, because a bare -1 from six operations cannot be told apart at the call site and
# the status line has to say WHICH refusal happened.
enum CrabFs {
    CRAB_FS_OK       = 0;
    CRAB_FS_EBADNAME = -10;    # empty, ".", "..", contains '/', or unterminated
    CRAB_FS_ETOOLONG = -11;    # the joined path would not fit CRAB_PATH_MAX
    CRAB_FS_EEXIST   = -12;    # the destination resolves — crab never overwrites silently
    CRAB_FS_ESAME    = -13;    # source and destination are the same path
    CRAB_FS_ESYS     = -14;    # the kernel refused
    CRAB_FS_EIO      = -15;    # a copy failed part-way through
    CRAB_FS_ENOEXEC  = -16;    # not an executable, and crab has no handler for it
    CRAB_FS_ESPAWNLEN = -17;   # the path exceeds what `spawn_path` accepts
    CRAB_FS_EBUSY    = -18;    # a transfer is already in flight — crab runs one at a time
    CRAB_FS_ELOOP    = -19;    # the destination is inside the source tree
    CRAB_FS_EISDIR   = -20;    # a folder was handed to the single-entry copy, which cannot carry one
}

# ⚠ What `c` / `m` resolves to, as an answer the suite can assert on rather than a shape buried in
# an agnos-only key branch. See `crab_transfer_plan`.
enum CrabPlan {
    CRAB_PLAN_QUEUE     = 0;   # marks outrank the cursor — transfer the marked set
    CRAB_PLAN_TREE      = 1;   # nothing marked, cursor on a folder, COPY — recurse
    CRAB_PLAN_SINGLE    = 2;   # nothing marked, cursor on a file — the single-entry path
    CRAB_PLAN_NOMOVEDIR = 3;   # nothing marked, cursor on a folder, MOVE — refused; no MTREE exists
}

# @public — may crab act on this entry name? 1 = yes, 0 = refuse.
#
# ⛔⛔ THIS IS THE GUARD BETWEEN A KEYPRESS AND `unlink`, AND IT IS DELIBERATELY PARANOID ABOUT DATA
# crab DID NOT CREATE. `name` is a kernel readdir record. The refusals, and why each is here:
#   - EMPTY: joins to the parent directory itself, so "delete the selected entry" becomes "delete
#     the directory you are standing in".
#   - "." : the same thing, spelled differently.
#   - ".." : resolves to the PARENT. A delete would be one keystroke from removing the tree above
#     the pane, and a rename would move it.
#   - ANY '/' : an entry name cannot contain one — the record layout forbids it — so a slash means
#     the record is malformed or crafted. Accepting it turns `crab_join_n`'s single join into a
#     multi-segment path and lets a name escape its own directory.
#   - UNTERMINATED: no NUL within `CRAB_NAME_MAX`, so no length can be taken safely.
# ⚠ Dotfiles are NOT refused, and must not be. `.bashrc` is an ordinary file and crab shows it
# (dotfiles are deliberately never hidden); only the two navigation entries are special.
fn crab_name_ok(name): i64 {
    if (name == 0) { return 0; }
    var n = crab_cstr_len(name, CRAB_NAME_MAX);
    if (n <= 0) { return 0; }                            # -1 unterminated, 0 empty
    if (load8(name) == 46) {                             # '.'
        if (n == 1) { return 0; }                        # "."
        if (n == 2) { if (load8(name + 1) == 46) { return 0; } }   # ".."
    }
    var i = 0;
    while (i < n) {
        if (load8(name + i) == 47) { return 0; }         # '/' can never be inside an entry name
        i = i + 1;
    }
    return 1;
}

# Join `dir` + "/" + `name` into `dst` (cap CRAB_PATH_MAX), validating the name first.
# -> the joined length, or a CRAB_FS_* error.
fn crab_fs_path(dst, dir, name): i64 {
    if (crab_name_ok(name) == 0) { return CRAB_FS_EBADNAME; }
    if (crab_join_n(dst, CRAB_PATH_MAX, dir, name) < 0) { return CRAB_FS_ETOOLONG; }
    var l = crab_cstr_len(dst, CRAB_PATH_MAX);
    if (l < 0) { return CRAB_FS_ETOOLONG; }
    return l;
}

# @public — create directory `name` inside `dir`. -> CRAB_FS_OK or a CRAB_FS_* error.
fn crab_fs_mkdir(dir, name, pathscr, statbuf): i64 {
    var l = crab_fs_path(pathscr, dir, name);
    if (l < 0) { return l; }
    # ⛔ REFUSE A NAME ALREADY IN USE RATHER THAN LETTING THE KERNEL DECIDE. agnos's mkdir returns a
    # bare negative for every reason, so "it already exists" and "the disk is full" are one answer;
    # asking first is what lets the status line say which.
    if (crab_fs_exists(pathscr, l, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_mkdir_raw(pathscr, l) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# @public — delete entry `name` from `dir`. `is_dir` selects rmdir over unlink.
#
# ⛔⛔ THIS DOES NOT RECURSE, AND THAT IS A DECISION RATHER THAN A GAP. `rmdir` refuses a non-empty
# directory and crab reports that refusal; it does NOT walk the tree deleting as it goes. A
# recursive delete behind a single keypress is the one operation in a file manager that cannot be
# undone and cannot be interrupted, and crab has neither a progress surface to show it (the transfer
# tray is M4's gated item) nor a trash to make it reversible. ⇒ When crab can show what it is doing
# and stop, it can do this. Not before.
fn crab_fs_delete(dir, name, is_dir, pathscr): i64 {
    var l = crab_fs_path(pathscr, dir, name);
    if (l < 0) { return l; }
    var rc = 0;
    if (is_dir != 0) { rc = crab_fs_rmdir_raw(pathscr, l); }
    else { rc = crab_fs_unlink_raw(pathscr, l); }
    if (rc < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# @public — rename `oldname` to `newname`, both inside `dir`. Two scratch buffers, each CRAB_PATH_MAX.
#
# ⚠ BOTH NAMES ARE VALIDATED, not just the source. `newname` reaches this from a text field rather
# than from a readdir record, so it is the LESS trustworthy of the two — a typed "../x" is exactly
# the escape `crab_name_ok`'s slash refusal exists for.
fn crab_fs_rename(dir, oldname, newname, scr1, scr2, statbuf): i64 {
    var lo = crab_fs_path(scr1, dir, oldname);
    if (lo < 0) { return lo; }
    var ln2 = crab_fs_path(scr2, dir, newname);
    if (ln2 < 0) { return ln2; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ln2, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_rename_raw(scr1, lo, scr2, ln2) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# ⚠ ONE COPY BUFFER FOR THE PROCESS, allocated on first use — the same rule the sort scratch and the
# frame arena follow. `alloc` never frees, so a per-copy buffer would leak 4 KB per file copied.
var crab_cpbuf = 0;

fn crab_copy_buf(): i64 {
    if (crab_cpbuf == 0) { crab_cpbuf = alloc(CRAB_COPY_CHUNK); }
    return crab_cpbuf;
}

# @public — copy file `name` from `srcdir` into `dstdir`, keeping its name.
#
# ⛔ FILES ONLY. A directory reaching here would be opened and read as a byte stream, which on ext2
# yields raw dirent bytes — a "copy" that produces a corrupt file rather than a folder. The caller
# checks the record's type byte; this is the second line of that defence.
# ⛔ THE DESTINATION IS CHECKED BEFORE THE SOURCE IS OPENED, so a refused copy has not touched
# anything. See `crab_fs_open_w` for why the check and not the flag is what protects it.
# ⚠ A PART-WAY FAILURE LEAVES A PARTIAL FILE, AND IT IS REPORTED AS `CRAB_FS_EIO` RATHER THAN
# CLEANED UP. Unlinking a half-written destination is the right instinct and the wrong action here:
# the write failed, so the reason is very likely that the filesystem is unhappy, and issuing another
# write-path syscall into that is how a bad situation becomes a worse one. crab says so and leaves
# the evidence in place.
fn crab_fs_copy(srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = crab_fs_path(scr2, dstdir, name);
    if (ld < 0) { return ld; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
    var buf = crab_copy_buf();
    if (buf == 0) { return CRAB_FS_EIO; }
    var fin = crab_fs_open_r(scr1, ls);
    if (fin < 0) { return CRAB_FS_ESYS; }
    var fout = crab_fs_open_w(scr2, ld);
    if (fout < 0) { sys_close(fin); return CRAB_FS_ESYS; }
    var rc = CRAB_FS_OK;
    var going = 1;
    while (going == 1) {
        var got = sys_read(fin, buf, CRAB_COPY_CHUNK);
        if (got < 0) { rc = CRAB_FS_EIO; going = 0; }
        if (got == 0) { going = 0; }                     # EOF — the only clean way out
        if (got > 0) {
            # ⛔ A SHORT WRITE IS NOT AN ERROR, IT IS THE CONTRACT. `write` may take fewer bytes than
            # offered, so a single call whose result is only tested for negativity silently drops
            # the tail — and the copy reports success with a truncated file, which is the worst
            # failure this function has.
            var off = 0;
            while (off < got) {
                var put = sys_write(fout, buf + off, got - off);
                if (put <= 0) { rc = CRAB_FS_EIO; off = got; going = 0; }
                else { off = off + put; }
            }
        }
    }
    sys_close(fout);
    sys_close(fin);
    return rc;
}

# @public — move file `name` from `srcdir` to `dstdir`.
#
# ⭐ RENAME FIRST, COPY-THEN-DELETE ONLY IF IT REFUSES. `rename`#31 is atomic and works within one
# filesystem; across filesystems agnos refuses it, and the fallback is the only way across. Trying
# the cheap atomic path first means the common case (both panes on the same volume) never reads or
# writes a byte of the file.
# ⛔ THE DELETE HAPPENS ONLY AFTER THE COPY REPORTS OK, and never on `EEXIST`. A move that removed
# the source after a failed copy is data loss, and it is the single most destructive thing this
# file could get wrong.
fn crab_fs_move(srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = crab_fs_path(scr2, dstdir, name);
    if (ld < 0) { return ld; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_rename_raw(scr1, ls, scr2, ld) >= 0) { return CRAB_FS_OK; }
    var rc = crab_fs_copy(srcdir, name, dstdir, scr1, scr2, statbuf);
    if (rc != CRAB_FS_OK) { return rc; }
    # ⚠ Re-join: `crab_fs_copy` reused both scratch buffers, so `scr1` no longer holds the source.
    var ls2 = crab_fs_path(scr1, srcdir, name);
    if (ls2 < 0) { return ls2; }
    if (crab_fs_unlink_raw(scr1, ls2) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# ⭐⭐ STARTING PATHS FROM argv (M3, *deferral #11*). `/bin` and `/` were hardcoded smoke-test
# targets, and `args` sat declared in `[deps].stdlib` and never called.
#
# ⛔ AN UNUSABLE PATH IS REFUSED AND SAID OUT LOUD, not quietly swapped for the default. crab's
# readdir takes absolute paths; a relative one silently lists NOTHING, and an empty pane with no
# message reads as a broken filesystem rather than as a rejected argument. `src/main.cyr` logs the
# refusal and falls back.
# ⚠ THE LENGTH BOUND IS THE 0.5.0 P1's BOUND. `CRAB_PATH_MAX` sizes `lpath`/`rpath`/`pathscr`, and
# every descent grows the path from here — so a starting path at the very limit leaves no room to
# navigate. Refusing at the cap is the same discipline `crab_join_n` applies.
fn crab_path_usable(p): i64 {
    if (p == 0) { return 0; }
    # The absolute check subsumes the empty one: "" cannot begin with '/'. An explicit empty guard
    # was here and mutation testing showed it could not fail, so it is gone rather than decorative.
    if (load8(p) != 47) { return 0; }             # must be absolute — '/' is 47
    var n = 0;
    while (load8(p + n) != 0) {
        n = n + 1;
        if (n >= CRAB_PATH_MAX) { return 0; }     # would not fit, or is unterminated
    }
    return 1;
}

# ⭐⭐ SELECTION MEMORY (M3, *deferral #34*) — Backspace used to land you at the TOP of the parent.
# Ascending out of `/usr/local/bin` put the cursor on the parent's first entry, so the directory you
# had just left was somewhere below and you had to find it again. Every file manager returns you to
# it, and the reason is navigational: ascend-then-descend is how you move sideways between siblings.
#
# ⚠ TWO PURE HELPERS RATHER THAN A BIGGER `crab_ascend`. `crab_ascend` already takes six arguments and
# returns a count; threading "and also tell me where to put the cursor" through it means a seventh
# out-parameter and a second thing to get wrong. These are separately testable, and the second one is
# reused to make the sort key follow the selection instead of resetting it.

# Copy the last path segment of `path` into `out` (bounded by `cap`). -> its length, or -1.
#
# ⚠ THE ROOT HAS NO LEAF, and that is a real answer rather than an error. `/` is where ascending
# stops, so there is nothing to return to and the caller must leave the selection alone.
fn crab_leaf_name(path, out, cap): i64 {
    var n = 0;
    while (load8(path + n) != 0) { n = n + 1; }
    if (n <= 1) { return 0 - 1; }                 # "" or "/" — no leaf
    var last = 0;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    return crab_strcpy_n(out, path + last + 1, cap);
}

# Index of the entry named `name`, or -1 when it is not in the listing.
#
# ⚠ -1 IS THE HONEST ANSWER AND THE CALLER MUST HANDLE IT. The directory can genuinely be gone —
# deleted, renamed, or on a filesystem that changed under us between the two readdirs. Falling back
# to 0 there is right; guessing an index is not.
fn crab_index_of(buf, count, name): i64 {
    var i = 0;
    while (i < count) {
        var rec = buf + i * CRAB_REC_SZ;
        var k = 0;
        var same = 1;
        while (1 == 1) {
            var a = load8(rec + k);
            var b = load8(name + k);
            if (a != b) { same = 0; }
            if (same == 0) { break; }
            if (a == 0) { break; }
            k = k + 1;
        }
        if (same == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Log a navigation to serial (the smoke's dispositive gate — like "key received").
fn crab_log_cd(path): i64 {
    crab_say("crab: cd ");
    crab_say(path);
    crab_say("\n");
    return 0;
}

# --- path helpers for directory navigation (Enter descends, Backspace ascends) ---

# @public — what may a listing of `n` entries honestly say about being cut short?
#   0 = say NOTHING          — the listing is complete
#   1 = "showing n of total" — truncated, by a known amount
#   2 = "has more..."        — truncated, amount unknown
#
# ⛔⛔ A FULL BUFFER IS NOT A TRUNCATION. A directory of EXACTLY `CRAB_MAX_ENTRIES` entries is
# complete, and warning about it tells the operator files are missing when none are — the same lie
# as hiding them, and harder to disbelieve because it is stated outright. The shipped guard was
# `n >= CRAB_MAX_ENTRIES` alone, so it fired on that directory every time.
#
# ⛔ THE CURSOR IS NOT THE ORACLE EITHER, AND THAT IS THE NON-OBVIOUS PART. Testing `cur != -1`
# reads as the natural fix and does not work: `agnos/kernel/core/ext2.cyr:2412` PARKS the cursor on
# the record it declined to take — `store64(cursor_uva, blkbase + off)` — whenever the batch budget
# is reached, and only `:2440` (walked off the end) and `:2392` (start >= dir_size) ever store -1.
# At exactly the cap the final batch fills, so the cursor is parked rather than exhausted and a
# cursor test STILL reports the false truncation. The COUNT is what knows: the counting walk
# resumes from that parked cursor, takes `:2392` immediately, and adds nothing.
#
# ⚠ `total < 0` is genuinely unknown, not zero, and has three sources: the `#81` fallback (which has
# no cursor and so can never count), an I/O error during the counting walk, and the step cap. All
# three warrant the wordy line — crab knows it is not showing everything and cannot say how much.
fn crab_truncation_note(n, total): i64 {
    if (n < CRAB_MAX_ENTRIES) { return 0; }          # the buffer never filled — nothing to report
    if (total > n) { return 1; }                     # a real cut, with a number behind it
    if (total < 0) { return 2; }                     # a real cut, and the count is not trustworthy
    return 0;                                        # total == n: it filled the buffer exactly
}

# @public — did this `#101` step make no progress? 1 = stalled, 0 = keep walking.
#
# ⛔⛔ THIS PREDICATE IS A FUNCTION FOR ONE REASON: THE LOOPS THAT USE IT CANNOT BE TESTED.
# Both `#101` walks live inside `#ifdef CYRIUS_TARGET_AGNOS` and drive a raw syscall, so the host
# suite cannot reach either of them — which is exactly how a non-terminating loop shipped in the
# first place and sat through 253/0 green. Lifting the decision out gives the suite the part that
# can actually be wrong, on the same principle that made `src/path.cyr` a file.
# ⚠ `k == 0` ALONE IS NOT A STALL, and this is the whole subtlety. A batch can legitimately yield
# zero records while the cursor advances — a directory block holding only deleted entries. Breaking
# on the count alone would truncate such a listing silently, which is the 0.4.x cap bug wearing a
# new hat. Only zero-AND-unmoved is a fault.
# ⚠ `k < 0` is NOT this function's business: a negative is the kernel's own error signal and the
# callers act on it differently (the listing walk falls back to `#81`, the counter gives up).
# @public — an `unlink` just failed on an entry the record typed as a LEAF. Should the walk retry it
# as a DIRECTORY? 1 = yes.
#
# ⛔ LIFTED OUT AS A PREDICATE SO THE SUITE CAN ASSERT IT — the same answer this codebase gives for
# `crab_readdir_stalled`, `crab_walk_cursor_for` and `crab_truncation_note`: the DECISION is testable
# even when the situation that triggers it cannot be produced from a host test.
# ⚠ AND THE LIMIT IS STATED: reaching this needs a filesystem that answers `DT_UNKNOWN`, and the
# host's `getdents64` types directories correctly. So the arithmetic is pinned here; the wiring is
# held by review and by the ⛔ at the call site.
# ⛔ `== 0`, NOT `!= 1`. A byte that already said "directory" and still failed to unlink is a real
# error — retrying it as a directory would take the descend branch a second time and mask the
# failure behind a readdir that also fails, one step later and with a worse message.
fn crab_walk_retry_as_dir(typebyte): i64 {
    if (typebyte == 0) { return 1; }
    return 0;
}

fn crab_readdir_stalled(k, was, now): i64 {
    if (k != 0) { return 0; }                        # records came back — progress, by definition
    if (now != was) { return 0; }                    # cursor moved — progress through the dir file
    return 1;
}

# readdir `path` into `buf` (up to CRAB_MAX_ENTRIES records); returns the entry count (>= 0).
# agnos-only (sys_readdir is the #81 wrapper); on the host it yields 0 (mock panes).
#
# ⚠ A FULL BUFFER IS NOT A COMPLETE LISTING. `sys_readdir` returns what fit, so `n == max` cannot be
# told apart from "there were more" — it is the only truncation signal there is. SAY SO: a pane that
# quietly stops at the cap looks like the missing files do not exist.
# ⭐⭐ PAGED LISTING (M3 *#02*, agnos 1.56.50 `#101 readdir_at`). `#81` always starts at the top and
# stops at `max`, so a directory larger than the pane buffer was silently truncated. `#101` carries a
# cursor — the byte offset into the directory file — so the walk resumes.
# ⭐ AND WHEN THE BUFFER FILLS, THE WALK CONTINUES WITHOUT STORING, purely to count. That is what
# turns "there are more entries than are shown" into "showing 1024 of 3891". The extra pass costs
# nothing in the normal case because it only runs when the directory actually overflows the cap.
# ⛔ THE #81 FALLBACK IS NOT OPTIONAL. Against a kernel older than 1.56.50, `#101` is an unknown
# syscall and the dispatcher returns -1 — so without this, crab would show an EMPTY pane on every
# older kernel and look like a filesystem fault. The fallback triggers on any negative from the
# FIRST batch, which is exactly the "syscall not there" case.
fn crab_readdir_into(path, buf): i64 {
    var n = 0;
    crab_dir_total = 0 - 1;
    crab_dir_err = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    var cur[8];
    store64(&cur, 0);                                # 0 = start at the top of the directory
    var paged = 1;
    var steps = 0;
    while (load64(&cur) != (0 - 1)) {
        if (n >= CRAB_MAX_ENTRIES) { break; }
        if (steps >= CRAB_READDIR_STEPS_MAX) { break; }
        steps = steps + 1;
        var want = CRAB_MAX_ENTRIES - n;
        if (want > CRAB_READDIR_BATCH) { want = CRAB_READDIR_BATCH; }
        var was = load64(&cur);                      # the cursor BEFORE the call — the stall oracle
        var k = sys_readdir_at(path, buf + n * CRAB_REC_SZ, want, &cur);
        if (k < 0) {
            if (n == 0) { paged = 0; crab_dir_err = k; }   # #101 unavailable — take the old path
            break;
        }
        # ⛔ THE STALL GUARD. See `CRAB_READDIR_STEPS_MAX`. Zero records AND an unmoved cursor is the
        # kernel's I/O-error shape, and it is indistinguishable from it by return value alone — the
        # error path returns a non-negative count. Without this the loop never ends.
        # ⛔ `n >= CRAB_MAX_ENTRIES` ABOVE IS NOT A SECOND ESCAPE FROM THIS. `n` advances only by
        # `n = n + k`, and on a stall `k` is the zero — so that test can never become true either.
        # There is no safer half of this loop; both exits need the guard.
        if (crab_readdir_stalled(k, was, load64(&cur)) != 0) { break; }
        n = n + k;
    }
    if (paged == 0) {
        n = sys_readdir(path, buf, CRAB_MAX_ENTRIES);
        # ⛔ KEEP `#101`'s CLASSIFICATION WHEN IT MADE ONE, AND ONLY THEN. `-1` is the ambiguous code
        # — bad pointer, not ext2, or the syscall simply not existing on a kernel older than
        # 1.56.50 — so it says nothing about the PATH and must not become a pane state. `-2` (does
        # not resolve) and `-4` (not a directory) are real answers about the path, and `#81` has no
        # way to express either: it returns a bare negative for all of them.
        # ⚠ A SUCCESSFUL `#81` CLEARS THE ERROR. Reaching here means `#101` failed, and on an older
        # kernel it always will — so leaving its `-1` set would put every pane on such a kernel into
        # UNREAD while the fallback was listing the directory perfectly well.
        if (n < 0) {
            if (crab_dir_err == (0 - 1)) { crab_dir_err = n; }
            if (crab_dir_err == 0) { crab_dir_err = n; }
            n = 0;
        } else { crab_dir_err = 0; }
    }
    if (paged == 1) {
        crab_dir_total = n;
        # ⚠ Only when the buffer actually filled AND the directory has more. `cur` is the oracle for
        # "more remains", not `n >= cap` — a directory of exactly the cap is complete, not truncated.
        if (load64(&cur) != (0 - 1)) {
            var scratch[4096];                       # CRAB_READDIR_BATCH records, discarded
            var steps2 = 0;
            while (load64(&cur) != (0 - 1)) {
                # ⛔ Same stall shape as the listing walk above, and the same two guards. This loop
                # has NO buffer to fill, so it has no incidental bound at all — it walks to the end
                # of the directory by construction. Reaching the cap means the count is not
                # trustworthy, so it reports "unknown" (-1) rather than a total it cannot stand
                # behind: the truncation line then says "has more entries than are shown" instead of
                # quoting a wrong number, which is the honest failure.
                if (steps2 >= CRAB_READDIR_STEPS_MAX) { crab_dir_total = 0 - 1; break; }
                steps2 = steps2 + 1;
                var was2 = load64(&cur);
                var k2 = sys_readdir_at(path, &scratch, CRAB_READDIR_BATCH, &cur);
                if (k2 < 0) { crab_dir_total = 0 - 1; break; }
                if (crab_readdir_stalled(k2, was2, load64(&cur)) != 0) { crab_dir_total = 0 - 1; break; }
                crab_dir_total = crab_dir_total + k2;
            }
        }
    }
    #endif
    if (n < 0) { n = 0; }
    # ⚠ Defence in depth, not a known defect: the #81/#101 contracts bound the count by `max`, so this
    # clamp is unreachable today. It is here because `n` is used as a loop bound over a buffer sized
    # from the SAME constant — if the kernel contract ever drifts, the failure is a silent read past
    # lbuf/rbuf, and a one-line clamp is cheaper than the burn that would find it.
    if (n > CRAB_MAX_ENTRIES) { n = CRAB_MAX_ENTRIES; }
    # ⛔⛔ A FULL BUFFER IS NOT A TRUNCATION, AND `n >= cap` ALONE MUST NEVER DECIDE THIS. A directory
    # of EXACTLY `CRAB_MAX_ENTRIES` entries is complete; warning about it tells the operator that
    # files are missing when none are, which is the same lie as hiding them and harder to disbelieve
    # because it is stated. `crab_dir_total` is the oracle — the count the second walk actually made.
    #
    # ⛔ THE CURSOR IS NOT THE ORACLE, AND THE OBVIOUS FIX IS WRONG. It is natural to test
    # `cur != -1` here, and it does not work: `agnos/kernel/core/ext2.cyr:2412` PARKS the cursor on
    # the record it did not take — `store64(cursor_uva, blkbase + off)` — whenever the batch budget
    # is reached, and only line `:2440` (walked off the end) or `:2392` (start >= dir_size) ever
    # stores -1. So at exactly the cap the last batch fills, the cursor is left parked rather than
    # exhausted, and a cursor test still reports the false truncation. The COUNT is what knows:
    # the counting walk resumes from that parked cursor, immediately takes `:2392`, and adds 0.
    #
    # ⇒ Three states, and each says only what it can stand behind:
    #     total >  n  — genuinely truncated, and by a known amount    -> "showing n of total"
    #     total == n  — complete, and it exactly filled the buffer    -> SILENT
    #     total <  0  — unknown: the #81 fallback (no cursor at all), a counting-walk I/O error, or
    #                   the step cap                                  -> "has more", with no number
    var note = crab_truncation_note(n, crab_dir_total);
    if (note != 0) {
        crab_say("crab: WARNING listing truncated at the entry cap -- "); crab_say(path);
        # ⚠ The digit buffer is the only thing that can withhold the numbers, and the line must still
        # terminate if it does — an unterminated WARNING swallows the listing line that follows it.
        if ((note == 1) && (crab_sdig != 0)) {
            crab_say(" showing "); crab_u2s(crab_sdig, n); crab_say(crab_sdig);
            crab_say(" of "); crab_u2s(crab_sdig, crab_dir_total); crab_say(crab_sdig);
            crab_say("\n");
        } else {
            crab_say(" has more entries than are shown\n");
        }
    }
    # ⭐ ONE LINE PER LISTING, ALWAYS. This is the honest oracle for "did the pane see everything":
    # a COUNT, stated once. Inferring it by counting per-entry lines made the diagnostic itself the
    # cost being measured, and 114 console writes per navigation is what made crab feel slow.
    if (crab_sdig != 0) {
        crab_u2s(crab_sdig, n);
        crab_say("crab: listed "); crab_say(crab_sdig); crab_say(" entries in "); crab_say(path); crab_say("\n");
    }
    return n;
}

# stat every entry in `buf` (count records) and store its byte size in sizes[i]
# and mtime (unix seconds) in mtimes[i]; a stat failure stores -1 in both. On
# agnos each entry (files AND dirs) is stat'd (#33 — size @ +16, mtime @ +40 of
# the §4.1 struct) via its full path; on the host both stay -1 (mock render_test).
# Per-entry stat tracing: OFF unless CRAB_STAT_TRACE=1. `crab_sdig` is allocated ONCE — the old code
# called alloc(24) per entry with no free, so a session of navigating leaked 24 B per file listed.
var crab_stat_trace = 0;
var crab_sdig       = 0;

fn crab_stat_trace_init(): i64 {
    crab_sdig = alloc(24);
    var v = getenv("CRAB_STAT_TRACE");
    if (v == 0) { return 0; }
    if (load8(v) == 49) { crab_stat_trace = 1; }     # '1'
    return 0;
}

# ⭐⭐ DEFERRED STATTING (M3, *deferral #03*) — "get the stat storm off the keystroke path".
#
# ⭐ MEASURED FIRST, BECAUSE THIS COST WAS MISATTRIBUTED ONCE ALREADY. The 2026-08-19 iron report
# ("crab shows way more entries than before but is responding slower from inputs") looked like the
# listing and was in fact the per-entry NARRATION (see the trace gate below). So before restructuring
# anything, `crab_stat_all` was made to report its own cost on the one line per readdir that already
# existed. On agnos under QEMU: **50 ms for 45 entries in /bin, 10 ms for 7 in /** — about **1.1 ms
# per entry**, linear. At the `CRAB_MAX_ENTRIES` cap that is **~1.1 s of blocking syscalls** on the
# keystroke that descends or ascends.
# ⚠ THAT FIGURE IS 4x WHAT THIS COMMENT SAID UNTIL 0.8.0, AND THE NUMBER MOVED WITHOUT THE PROSE.
# It read "~280 ms at the cap of 256" — correct when written and left behind by M3 *#02*, which
# raised the cap to 1024 and re-derived nothing. A stale cost is worse than no cost: it is the
# number the next reader budgets against.
# ⚠ THOSE ARE QEMU FIGURES AND QEMU'S DISK EMULATION IS MUCH SLOWER THAN IRON. The per-entry
# linearity is the durable finding; the absolute number is an upper bound, not an iron measurement.
#
# ⭐ WHAT MAKES THE DEFERRAL SAFE: **dir-ness comes from the readdir record, not from stat**
# (`CRAB_REC_TYPE`). So directories-first ordering, the `/` row marker, NAME order and KIND order all
# work with **no stat data at all**. Only the size column, the status line, and SIZE/MTIME ordering
# need it. ⇒ The listing marks every entry pending and returns immediately; the event loop fills the
# sizes in bounded batches; and a sort that genuinely needs every size forces the sweep itself.
#
# ⛔ PENDING (-2) IS NOT THE SAME AS UNSTATTABLE (-1), AND CONFLATING THEM WOULD HIDE A BUG. An entry
# that is merely not reached yet would otherwise render identically to one whose stat FAILED — so an
# entry stuck pending forever (a batch loop that never completes) would look like a filesystem fault
# and be debugged as one.
fn crab_sz_pending(): i64 { return 0 - 2; }

# ⚠ 32 ENTRIES PER IDLE TICK IS A TRADE, AND BOTH SIDES ARE REAL. At the measured ~1.1 ms per entry
# a batch is ~35 ms, so a full 1024-entry directory fills over 32 ticks and delays event handling by
# at most one batch. (Eight ticks was the 256-entry figure; the cap moved and this
# comment did not.) Smaller batches are more responsive but redraw more often — and each redraw is a
# full surface render plus a buffer write, which is not free either.
enum CrabStat {
    CRAB_STAT_BATCH = 32;    # entries stat'd per idle tick
}

# Mark every entry as awaiting a stat. Cheap and O(count) with no syscalls — this is what the
# keystroke path pays instead of the sweep.
fn crab_stat_reset(sizes, mtimes, count): i64 {
    var i = 0;
    while (i < count) {
        store64(sizes + i * 8, 0 - 2);
        store64(mtimes + i * 8, 0 - 2);
        i = i + 1;
    }
    return 0;
}

# Index of the next entry still awaiting a stat at or after `from`, or -1 when none remain.
fn crab_stat_next_pending(sizes, count, from): i64 {
    var i = from;
    if (i < 0) { i = 0; }
    while (i < count) {
        if (load64(sizes + i * 8) == 0 - 2) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ⛔ SIZE AND MTIME ORDER CANNOT BE COMPUTED FROM PARTIAL DATA. Sorting while entries are still
# pending would order them by the -2 sentinel — every unstat'd file tying at the bottom, and the list
# visibly reshuffling as batches land. NAME and KIND read only the record, so they are free.
fn crab_sort_needs_stats(mode): i64 {
    if (mode == CRAB_SORT_SIZE) { return 1; }
    if (mode == CRAB_SORT_MTIME) { return 1; }
    return 0;
}

# stat ONE entry into sizes[i] / mtimes[i]. A stat failure — or a join that would not fit — stores -1
# in both, which is the honest "unstattable" answer and is distinct from the -2 pending marker.
fn crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf): i64 {
    var rec = buf + i * CRAB_REC_SZ;
    var sz = 0 - 1;                                  # stat-failure default
    var mt = 0 - 1;
    # ⛔ A TRUNCATED JOIN IS NOT A PATH — it names a DIFFERENT file, so statting it would report
    # someone else's size and mtime against this row. Unstattable is the honest answer.
    var jl = crab_join_n(pathscr, CRAB_PATH_MAX, path, rec);
    #ifdef CYRIUS_TARGET_AGNOS
    if ((jl >= 0) && (sys_stat(pathscr, strlen(pathscr), statbuf) == 0)) {
        sz = load64(statbuf + STAT_SIZE);            # agnos stat struct §4.1 — named, not a literal
        mt = load64(statbuf + STAT_MTIME);           # unix seconds
        # ⛔⛔ ONE CONSOLE LINE PER ENTRY IS A PER-NAVIGATION COST, AND THE CAP JUST GREW 8x.
        # This printed unconditionally for every entry and allocated 24 B for every entry — with
        # the old 32-entry cap that was 32 lines; on a real `/` (122 entries, iron 2026-08-30) it
        # is 122 writes to a console THREE PROCESSES SHARE UNSERIALISED, on every readdir, i.e.
        # every descend and every ascend. Iron 2026-08-19: "crab shows way more entries than
        # before but is responding slower from inputs." The listing was not the cost; narrating
        # it was.
        # ⇒ Bounded, and off by default. `CRAB_STAT_TRACE=1` in the environment brings it back
        # for a burn that actually needs the per-entry readout.
        if (crab_stat_trace == 1) {
            if (crab_sdig != 0) {
                crab_u2s(crab_sdig, sz);
                crab_say("crab: stat "); crab_say(rec); crab_say(" "); crab_say(crab_sdig); crab_say("\n");
            }
        }
    }
    #endif
    store64(sizes + i * 8, sz);
    store64(mtimes + i * 8, mt);
    return sz;
}

# stat at most `budget` still-pending entries, cheapest-index first. Returns how many were stat'd, so
# the caller knows whether a redraw is worth issuing and whether the sweep is finished.
# ⚠ THE BUDGET BOUNDS SYSCALLS, NOT ENTRIES SCANNED. The scan itself is a pointer walk over an array
# that is at most `CRAB_MAX_ENTRIES` long; the ~1.1 ms cost is entirely in `sys_stat`.
fn crab_stat_batch(path, buf, count, sizes, mtimes, pathscr, statbuf, budget): i64 {
    var done = 0;
    var i = 0;
    while ((done < budget) && (i < count)) {
        if (load64(sizes + i * 8) == 0 - 2) {
            crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf);
            done = done + 1;
        }
        i = i + 1;
    }
    return done;
}

# stat EVERY entry, synchronously. This is the storm, and it is now paid only where it is genuinely
# required: a SIZE or MTIME sort, which cannot order anything without all of the data.
fn crab_stat_all(path, buf, count, sizes, mtimes, pathscr, statbuf): i64 {
    var t0 = clock_now_ms();
    var i = 0;
    while (i < count) {
        crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf);
        i = i + 1;
    }
    # ⚠ ONE LINE PER SWEEP, NOT PER ENTRY — the per-entry trace is exactly the cost that made crab
    # feel slow on iron, so the measurement must not reintroduce it. On the host this reads 0 ms
    # because the stat body is `#ifdef CYRIUS_TARGET_AGNOS` and does nothing here.
    # ⚠ "stat-cost", NOT "stat" — `crab-listing-cap-test.py` counts per-entry trace lines with
    # `startswith("crab: stat ")` and asserts that count is 0 by default. A summary line sharing that
    # prefix would be counted as a per-entry trace and break an oracle that is currently honest.
    # ⛔ `crab_sdig` IS LAZILY ALLOCATED AND IS 0 UNTIL `crab_stat_trace_init` RUNS. The test suite
    # calls into here without it, so an unguarded `crab_u2s` writes to address 0 and faults — which
    # is exactly what the first version of this line did.
    if (crab_sdig == 0) { return 0; }
    crab_u2s(crab_sdig, clock_now_ms() - t0);
    crab_say("crab: stat-cost "); crab_say(crab_sdig); crab_say(" ms for ");
    crab_u2s(crab_sdig, count);
    crab_say(crab_sdig); crab_say(" entries in "); crab_say(path); crab_say("\n");
    return 0;
}

# ⭐ WHAT A LISTING PAYS. The keystroke path calls THIS, not `crab_stat_all`: pending marks are free,
# and the sweep happens only for an order that cannot be computed without it.
fn crab_stat_for_listing(path, buf, count, sizes, mtimes, pathscr, statbuf, mode): i64 {
    crab_stat_reset(sizes, mtimes, count);
    if (crab_sort_needs_stats(mode) == 1) {
        crab_stat_all(path, buf, count, sizes, mtimes, pathscr, statbuf);
        return 1;
    }
    return 0;
}

# Descend: if the selected entry (buf[sel], sel < count) is a directory, rewrite
# `path` in place to path/name, re-readdir into `buf`, and re-stat size+mtime.
# Returns the new entry count (>= 0), or -1 when the selection is not a dir / empty.
fn crab_descend(path, buf, sel, count, namescr, pathscr, sizes, mtimes, statbuf): i64 {
    if (count <= 0) { return -1; }
    if (sel < 0) { return -1; }
    if (sel >= count) { return -1; }                 # belt-and-braces: sel indexes a record below
    var rec = buf + sel * CRAB_REC_SZ;
    if (load8(rec + CRAB_REC_TYPE) != 1) { return -1; }     # type byte: 1 = dir
    if (crab_strcpy_n(namescr, rec, CRAB_NAME_MAX) < 0) { return -1; }   # name out before readdir overwrites buf
    # ⛔ REFUSE, do not truncate. Descending into a truncated path would readdir a directory the
    # operator did not select — silently, and with the pane header showing the name they DID select.
    if (crab_join_n(pathscr, CRAB_PATH_MAX, path, namescr) < 0) {
        crab_say("crab: path too long -- refusing to descend\n");
        return -1;
    }
    if (crab_strcpy_n(path, pathscr, CRAB_PATH_MAX) < 0) { return -1; }
    var n = crab_readdir_into(path, buf);
    # ⚠ AFTER the stat marks, never before — SIZE and MTIME order read arrays the stat fills, and
    # `crab_stat_for_listing` performs the full sweep for exactly those two modes.
    crab_stat_for_listing(path, buf, n, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, n, crab_sort_mode);
    return n;
}

# Ascend: truncate `path` in place to its parent directory, re-readdir into `buf`,
# and re-stat size+mtime. Returns the new entry count (>= 0), or -1 at the root "/".
# @public — re-read a pane's CURRENT directory in place (M4). -> the new entry count.
#
# ⛔⛔ AFTER A WRITE, BOTH PANES ARE STALE, NOT JUST THE ACTIVE ONE. A copy adds an entry to the
# other pane; a move adds one there and removes one here; a delete removes one here. crab's panes
# are snapshots taken at listing time, so an operation that changed the disk and re-listed only the
# pane the operator was looking at leaves the OTHER pane confidently showing a file that is gone —
# and Enter on it would descend into nothing.
# ⚠ This is `crab_ascend` minus the path surgery: same listing, same deferred stat marking, same
# sort. Kept as its own function rather than a flag on ascend, because "go up" and "look again" are
# different intentions and only one of them may move the pane.
fn crab_relist(path, buf, sizes, mtimes, pathscr, statbuf): i64 {
    # ⛔⛔ THE PREVIEW'S DIMENSION CACHE IS INVALIDATED HERE, AND HERE IS THE RIGHT PLACE. This
    # function runs after every write crab makes — rename, delete, copy, move, mkdir and the batch
    # sheet all end in a relist — so one call covers all of them, where invalidating at each call
    # site means six chances to forget and no gate that would notice.
    # ⚠ A NAVIGATION does not need it: the cache key is the full PATH, so descending or ascending
    # changes the key by construction and a stale entry cannot be hit.
    # ⛔ WHY IT MATTERS AT ALL: the cache is keyed on a NAME, and crab is a program that makes names
    # refer to different files. Renaming `b.png` over `a.png` leaves `a.png` gone and the cache
    # still holding its size.
    crab_pv_forget();
    crab_thumb_forget();
    var cnt = crab_readdir_into(path, buf);
    crab_stat_for_listing(path, buf, cnt, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, cnt, crab_sort_mode);
    return cnt;
}

# ⚠ agnos `spawn_path`#43 caps its path at **127 bytes** (ABI row 43), which is HALF `CRAB_PATH_MAX`.
# A path crab can list and stat is therefore not necessarily one it can launch, and the difference
# has to be reported rather than truncated — a truncated path is a different file, and this one gets
# EXECUTED.
enum CrabSpawn {
    CRAB_SPAWN_PATH_MAX = 127;
    CRAB_ELF_MAGIC_LEN  = 4;
}

# @public — does `path` begin with the ELF magic? 1 = yes, 0 = no, -1 = could not be read.
#
# ⛔⛔ THIS IS THE GUARD BETWEEN THE Enter KEY AND `spawn_path`. Enter already descends into
# directories; making it *run* the selected entry means one keystroke can execute whatever the
# cursor happens to be on. `spawn_path` loads a static ELF64 and refuses anything else — but
# refusing AFTER handing the kernel a file is not the same as not handing it over, and the operator
# deserves "crab cannot open that" rather than a spawn that fails somewhere inside the loader.
# ⚠ FOUR BYTES, READ AND CLOSED. Not a stat: the mode bits say what the filesystem permits, not what
# the file IS, and on a single-user always-root kernel the permit bits say almost nothing.
# ⚠ A SHORT READ IS NOT AN ELF. A file with fewer than four bytes cannot be one, and treating a
# short read as success is how an empty file reaches the loader.
fn crab_is_elf(path, plen): i64 {
    var fd = crab_fs_open_r(path, plen);
    if (fd < 0) { return -1; }
    var m = crab_elf_magic_buf();
    if (m == 0) { sys_close(fd); return -1; }
    var got = sys_read(fd, m, CRAB_ELF_MAGIC_LEN);
    sys_close(fd);
    if (got < CRAB_ELF_MAGIC_LEN) { return 0; }
    if (load8(m + 0) != 0x7F) { return 0; }
    if (load8(m + 1) != 69) { return 0; }              # 'E'
    if (load8(m + 2) != 76) { return 0; }              # 'L'
    if (load8(m + 3) != 70) { return 0; }              # 'F'
    return 1;
}

# ⚠ Four bytes, once for the process — the same rule the sort scratch and the copy buffer follow.
var crab_elfbuf = 0;

fn crab_elf_magic_buf(): i64 {
    if (crab_elfbuf == 0) { crab_elfbuf = alloc(CRAB_ELF_MAGIC_LEN); }
    return crab_elfbuf;
}

# ⭐⭐ THE PREVIEW'S IMAGE DIMENSIONS (M5) — a bounded header read, memoised on the entry it
# describes. `crab_img_dims` does the parsing and lives in `ui.cyr`; this is the half that needs a
# syscall and therefore cannot.
#
# ⛔⛔ MEMOISED BECAUSE THE RENDER PATH ASKS EVERY FRAME AND THE ANSWER COSTS AN open/read/close.
# crab re-renders after every handled event, so recomputing per frame would put a file read on the
# arrow-key path — which is precisely what M3 *#03* restructured the whole listing to remove, and
# for a much smaller saving than this. The cache key is (directory, name), so moving the selection
# to a different file invalidates it and moving it back re-reads.
# ⚠ IT IS A ONE-ENTRY CACHE, DELIBERATELY. The operator looks at one file at a time and the preview
# describes exactly one; an N-entry cache would need an eviction policy to serve a caller that does
# not exist. Same reasoning as the single operation record.
#
# ⛔ THE READ IS CAPPED AT `CRAB_PV_HDR_BUDGET`, AND THE CAP IS THE POINT. PNG, GIF and BMP put
# their dimensions in the first 26 bytes; only JPEG needs a scan, and its SOF sits past whatever
# EXIF the camera wrote. A budget answers "most JPEGs, cheaply" instead of "every JPEG, at the cost
# of reading a 40 MB raw file on a keystroke" — and a file whose header does not fit reports no
# dimensions rather than stalling the UI. ⚠ That is the same shape as the transfer tray's stepping
# and the deferred stat sweep: bounded work, and an honest "not known" when the bound is reached.
enum CrabPv {
    # ⚠ 64 KiB — one read syscall, and enough for the EXIF block a phone or camera writes ahead of
    # the JPEG frame header. Raising it buys rarer files at a linear cost on the selection path.
    CRAB_PV_HDR_BUDGET = 65536;
}

var crab_pv_buf = 0;
var crab_pv_key = 0;
var crab_pv_have = 0;
var crab_pv_w = 0;
var crab_pv_h = 0;
# ⭐ CAMERA and SHOT (M5) — read from the SAME 64 KiB header the dimensions come from, in the same
# pass. ⛔ A second read would double the syscalls on the selection path for data that is in a buffer
# crab already has, and would need its own memo to stay in step with this one.
var crab_pv_cam = 0;
var crab_pv_shot = 0;

# ⚠ Allocated once for the process — the same rule the sort scratch, the copy buffer and the ELF
# magic buffer follow, and for the same reason: `alloc` has no `free()`.
fn crab_pv_hdr_buf(): i64 {
    if (crab_pv_buf == 0) { crab_pv_buf = alloc(CRAB_PV_HDR_BUDGET); }
    return crab_pv_buf;
}

fn crab_pv_key_buf(): i64 {
    if (crab_pv_key == 0) { crab_pv_key = alloc(CRAB_PATH_MAX + CRAB_NAME_MAX + 4); }
    return crab_pv_key;
}

# @public — the selected entry's camera ("Make Model"), or "" if it has none. Cached alongside the
# dimensions and invalidated with them.
fn crab_preview_camera(): i64 {
    if (crab_pv_cam == 0) { crab_pv_cam = alloc(CRAB_EX_STR_MAX * 2 + 8); store8(crab_pv_cam, 0); }
    return crab_pv_cam;
}

# @public — when the shutter fired (`DateTimeOriginal`), falling back to the file's own EXIF
# `DateTime`. ⚠ The two are different questions — when the picture was TAKEN versus when this FILE
# was written — and an edited photo has a DateTime long after its DateTimeOriginal. The shutter is
# the one worth showing, so the fallback is a fallback and not a preference.
var crab_pv_raw = 0;
# ⚠ Scratch for the EXIF timestamp before it is reshaped. Allocated once, like everything else here.
fn crab_exif_raw_buf(): i64 {
    if (crab_pv_raw == 0) { crab_pv_raw = alloc(CRAB_EX_STR_MAX + 8); store8(crab_pv_raw, 0); }
    return crab_pv_raw;
}

fn crab_preview_shot(): i64 {
    if (crab_pv_shot == 0) { crab_pv_shot = alloc(CRAB_EX_STR_MAX + 8); store8(crab_pv_shot, 0); }
    return crab_pv_shot;
}

# @public — forget the cached dimensions. Call after anything that can change what a name refers to:
# a rename, a delete, a copy into the pane, or a re-listing.
# ⛔ A CACHE KEYED ON A NAME IS STALE THE MOMENT THE NAME MEANS A DIFFERENT FILE. crab renames and
# overwrites files itself, so this is not a theoretical staleness — it is a consequence of the write
# layer, and the invalidation is the write layer's job to call.
fn crab_pv_forget(): i64 {
    crab_pv_have = 0;
    crab_pv_w = 0;
    crab_pv_h = 0;
    var cb = crab_preview_camera();
    if (cb != 0) { store8(cb, 0); }
    var sb = crab_preview_shot();
    if (sb != 0) { store8(sb, 0); }
    var k = crab_pv_key_buf();
    if (k != 0) { store8(k, 0); }
    return 0;
}

# @public — the selected entry's pixel dimensions, or 0 if it has none crab can read.
# On 1, width is at `out + CRAB_IMG_W` and height at `out + CRAB_IMG_H`.
fn crab_preview_dims(dir, name, out, pathscr): i64 {
    if (out == 0) { return 0; }
    store64(out + CRAB_IMG_W, 0);
    store64(out + CRAB_IMG_H, 0);
    if (dir == 0) { return 0; }
    if (name == 0) { return 0; }
    # ⚠ THE EXTENSION IS ONLY A HINT, and it is used here to avoid OPENING every file the operator
    # arrows past — not to decide what the file is. `crab_img_dims` reads the signature bytes and
    # has the final say, so a `.png` full of JPEG is reported as the JPEG it is.
    if (crab_is_image(name) == 0) { return 0; }
    var key = crab_pv_key_buf();
    if (key == 0) { return 0; }
    var scr = pathscr;
    if (scr == 0) { return 0; }
    if (crab_fs_path(scr, dir, name) < 0) { return 0; }
    if (crab_streq_n(key, scr, CRAB_PATH_MAX) == 1) {
        # A cache hit, including the remembered NEGATIVE answer — re-reading a file crab already
        # failed to parse costs the same syscalls as reading one it can.
        if (crab_pv_have == 0) { return 0; }
        store64(out + CRAB_IMG_W, crab_pv_w);
        store64(out + CRAB_IMG_H, crab_pv_h);
        return 1;
    }
    crab_strcpy_n(key, scr, CRAB_PATH_MAX);
    crab_pv_have = 0;
    crab_pv_w = 0;
    crab_pv_h = 0;
    var camb = crab_preview_camera();
    var shotb = crab_preview_shot();
    if (camb != 0) { store8(camb, 0); }
    if (shotb != 0) { store8(shotb, 0); }
    var buf = crab_pv_hdr_buf();
    if (buf == 0) { return 0; }
    var fd = crab_fs_open_r(scr, crab_cstr_len(scr, CRAB_PATH_MAX));
    if (fd < 0) { return 0; }
    var got = sys_read(fd, buf, CRAB_PV_HDR_BUDGET);
    sys_close(fd);
    if (got <= 0) { return 0; }
    # ⭐ EXIF COMES OUT OF THE SAME BUFFER, BEFORE THE DIMENSION CHECK CAN RETURN. A file whose
    # header crab cannot make dimensions of may still carry a readable Make/Model — and more to the
    # point, doing it here means one read, one memo, and no way for the two to disagree about which
    # file they describe.
    if (camb != 0) {
        var mlen = crab_exif_str(buf, got, CRAB_EX_MAKE, camb, CRAB_EX_STR_MAX + 1);
        if (mlen == 1) {
            var ml = crab_cstr_len(camb, CRAB_EX_STR_MAX + 1);
            # ⚠ "Make Model" as one line, and the space is only added when both are present — a
            # trailing space on a camera with no model is a line that looks truncated.
            if (ml > 0) {
                if (ml < CRAB_EX_STR_MAX) {
                    store8(camb + ml, 32);
                    if (crab_exif_str(buf, got, CRAB_EX_MODEL, camb + ml + 1, CRAB_EX_STR_MAX) == 0) {
                        store8(camb + ml, 0);
                    }
                }
            }
        } else {
            # No Make: show the Model alone rather than nothing.
            crab_exif_str(buf, got, CRAB_EX_MODEL, camb, CRAB_EX_STR_MAX + 1);
        }
    }
    if (shotb != 0) {
        var raw = crab_exif_raw_buf();
        if (raw != 0) {
            store8(raw, 0);
            if (crab_exif_str(buf, got, CRAB_EX_DTORIG, raw, CRAB_EX_STR_MAX + 1) == 0) {
                crab_exif_str(buf, got, CRAB_EX_DATETIME, raw, CRAB_EX_STR_MAX + 1);
            }
            # ⚠ Reshaped into crab's own date format — see `crab_exif_when`. The two date rows in the
            # preview column are read together and must not disagree about what a date looks like.
            crab_exif_when(shotb, raw, CRAB_EX_STR_MAX + 1);
        }
    }
    if (crab_img_dims(buf, got, out) == 0) { return 0; }
    crab_pv_have = 1;
    crab_pv_w = load64(out + CRAB_IMG_W);
    crab_pv_h = load64(out + CRAB_IMG_H);
    return 1;
}

# ⭐⭐ THUMBNAILS (M5) — chitra decodes, crab downsamples, and the BUDGET is the whole design.
#
# ⛔⛔⛔ EVERY DECODE IS PERMANENT. THIS IS THE CONSTRAINT, NOT THE BINARY SIZE. Measured 2026-08-31:
# chitra makes **31 `alloc()` calls**, `chitra_image_free` is a **no-op** (`return 0;`), and cyrius's
# `alloc` is a bump allocator whose only reclaim is `alloc_reset()` — which rewinds the WHOLE heap
# and would invalidate crab's pane paths, readdir buffers, surface and client struct. So the bytes a
# decode spends are spent for the life of the process, and a second decode of the same file spends
# them again.
#
#   | source        | RGBA bytes | PERMANENT alloc | ratio |
#   |---------------|-----------:|----------------:|------:|
#   | 64x64         |     16,384 |          83,976 |  5.1x |
#   | 256x256       |    262,144 |         700,280 |  2.7x |
#   | 512x512       |  1,048,576 |       2,670,608 |  2.5x |
#   | 1024x1024     |  4,194,304 |      10,549,168 |  2.5x |
#   | 2048x2048     | 16,777,216 |      42,057,928 |  2.5x |
#
# ⇒ **~2.5x the RGBA size, never returned.** A file manager that decoded on every arrow key would
# exhaust a machine browsing one photo directory. Hence two budgets, and neither is optional.
#
# ⛔ BUDGET 1 — PER IMAGE, AND IT IS A PRE-CHECK. `chitra_image_decode_budget` reads the DECLARED
# dimensions out of the header and refuses before allocating anything: measured, a refusal costs
# **16 bytes**, against 26.6 MB for the same file decoded without it. That asymmetry is why crab
# never calls bare `chitra_image_decode`.
# ⛔ BUDGET 2 — PER SESSION, BECAUSE BUDGET 1 DOES NOT COMPOSE. A cap on one decode says nothing
# about a hundred of them. crab measures `alloc_used()` across each decode and stops thumbnailing
# once the cumulative spend passes `CRAB_THUMB_TOTAL_MAX`. ⚠ It reports that state rather than
# silently showing nothing — a feature that stops working without saying so reads as a bug.
#
# ⭐⭐ AND THE PER-IMAGE BUDGET KEEPS crab ON THE WORKING SIDE OF AN UPSTREAM DEFECT.
# ⚠ CORRECTED 2026-09-01 — THIS DESCRIBED A DEFECT THE DECLARED VERSION NO LONGER HAS. chitra
# **1.0.1** (the tag crab pins) refuses such a PNG **from the header, in under 64 KiB**, with its own
# `CHITRA_ERR_INFLATE_LIMIT`; it is 1.0.0 that spent 26,617,512 bytes to return a bare
# `CHITRA_ERR_INFLATE`. crab's behaviour is unchanged either way — the per-image budget already kept
# it clear of that cliff — but a comment asserting an upstream bug that has been fixed is how a
# budget gets called redundant and deleted. The history, for that reason:
# chitra 1.0.0 FAILED with `CHITRA_ERR_INFLATE` on any PNG whose decompressed scanline data exceeds
# **16 MiB** — bracketed exactly: 2200x2200 (14,522,200 B inflated) decodes, 2370x2370 (16,853,070)
# does not. That is ~5.6 megapixels of RGB, so an ordinary phone photo saved as PNG fails — and it
# fails EXPENSIVELY, spending 26.6 MB on the way to returning 0. chitra advertises
# `CHITRA_MAX_PIXELS = 16,777,216` (4096x4096), well past what actually works.
# ⇒ `CRAB_THUMB_MAX_RGBA` is 4 MB, and a 1024x1024 RGB PNG inflates to ~3.1 MB — comfortably under
# the cliff. crab cannot reach the bug. Filed upstream; see
# chitra/docs/development/issues/2026-08-31-inflate-fails-past-16mib.md.
enum CrabThumb {
    # ⛔ `CRAB_THUMB_W` / `_H` / `_BYTES` AND THE `CRAB_TH_*` STATES LIVE IN `src/ui.cyr`, NOT HERE,
    # and that is the include-order rule rather than a preference. `app.cyr` includes `ui.cyr`, so
    # the fold puts ui.cyr FIRST and anything declared here is invisible to it — while
    # `render_test.cyr` and the suite include `ui.cyr` ALONE. Declaring them here compiled fine
    # through `main.cyr` and left `render_test` with six undefined symbols. **Fourth time in this
    # project.** Anything the render path touches lives at or below `ui.cyr`.
    # ⚠ 4 MB of DECLARED RGBA ~ 1024x1024. Chosen against the table above (a ~10.5 MB permanent
    # spend) and against the 16 MiB inflate cliff, not for roundness.
    CRAB_THUMB_MAX_RGBA  = 4194304;
    # ⚠ 32 MB of cumulative permanent spend — about three 1024x1024 images, or forty 256x256 ones.
    # ⛔ NOT A GUESS AT WHAT IS SAFE, A LIMIT ON WHAT IS UNRECOVERABLE. When the allocator gains a
    # free(), or chitra takes an arena, this constant is the first thing that should be deleted.
    CRAB_THUMB_TOTAL_MAX = 33554432;
    CRAB_THUMB_FILE_MAX  = 4194304;        # bytes of the file crab will read to feed the decoder
}

var crab_th_buf = 0;
var crab_th_key = 0;
var crab_th_file = 0;
var crab_th_state = 0;
var crab_th_slot = 0 - 1;
var crab_th_spent = 0;

# @public — the 64x64 BGRA thumbnail buffer. Allocated ONCE for the process.
# ⚠ One buffer, not a cache of many: the preview describes ONE entry, and an N-entry cache would
# need an eviction policy for a caller that does not exist. Same reasoning as the operation record.
# @public — the 64x64 BGRA thumbnail for the entry `crab_thumb_step` was last asked about.
# ⛔ IT IS A CACHE SLOT, NOT A SCRATCH BUFFER (M5). The gallery needs dozens of thumbnails live at
# once, so a single buffer would have every cell showing the last one decoded. `crab_th_slot` records
# which entry the last step was ABOUT, so the preview shows that entry rather than whatever the idle
# tick happened to decode most recently while the operator was looking elsewhere.
fn crab_thumb_pixels(): i64 {
    var p = crab_tc_pixels(crab_th_slot);
    if (p != 0) { return p; }
    # No slot yet — hand back a zeroed scratch so a caller can draw nothing rather than deref 0.
    if (crab_th_buf == 0) {
        crab_th_buf = alloc(CRAB_THUMB_BYTES);
        if (crab_th_buf != 0) {
            var i = 0;
            while (i < CRAB_THUMB_BYTES) { store8(crab_th_buf + i, 0); i = i + 1; }
        }
    }
    return crab_th_buf;
}

# Record `st` for the slot the current step claimed, and return it. ⛔ EVERY exit after a claim goes
# through here: a slot left at `CRAB_TH_NONE` is a slot the next tick will try to decode again, which
# on a file that cannot be read is an infinite retry that also re-opens it.
fn crab_th_finish(st): i64 {
    crab_th_state = st;
    var b = crab_tc_base();
    if (b != 0) {
        if (crab_th_slot >= 0) {
            if (crab_th_slot < CRAB_TC_N) {
                store64(b + crab_th_slot * CRAB_TC_SLOT + CRAB_TC_STATE, st);
            }
        }
    }
    return st;
}

fn crab_thumb_state(): i64 { return crab_th_state; }

# @public — cumulative bytes this process has permanently spent on decodes. For the ⛔ above.
fn crab_thumb_spent(): i64 { return crab_th_spent; }

# @public — has the session's decode budget been exhausted? 1 = stop decoding.
#
# ⛔ LIFTED OUT AS A PREDICATE SO THE SUITE CAN ASSERT IT, which is the same answer this codebase
# gives for `crab_readdir_stalled`, `crab_walk_cursor_for` and `crab_truncation_note`: the DECISION
# is testable even when the situation that triggers it is not reachable from a test.
# ⚠ AND THE LIMIT OF THAT IS STATED RATHER THAN IMPLIED. This pins the boundary arithmetic — `>=`
# against `>`, which is the half that goes wrong quietly. It does NOT pin that `crab_thumb_step`
# still consults it: proving that needs a test that really spends 32 MB, and a suite that allocated
# 32 MB per run to check a guard would be a worse thing than the guard is a good one.
# ⛔ `>=`, NOT `>`. At exactly the ceiling the budget IS spent — a decode allowed at the boundary is
# one whose ~2.5x permanent cost lands entirely past it.
fn crab_thumb_over_budget(spent): i64 {
    if (spent >= CRAB_THUMB_TOTAL_MAX) { return 1; }
    return 0;
}

# @public — forget the cached thumbnail. Called from `crab_relist`, beside `crab_pv_forget`, for the
# same reason: the cache is keyed on a NAME and crab makes names refer to different files.
# ⚠ THE SPEND IS NOT FORGOTTEN, and must not be — those bytes are still gone. Resetting the counter
# here would turn the session budget into a per-directory one and the ceiling would never bind.
fn crab_thumb_forget(): i64 {
    crab_th_state = CRAB_TH_NONE;
    crab_th_slot = 0 - 1;
    crab_tc_clear();
    var k = crab_th_key;
    if (k != 0) { store8(k, 0); }
    return 0;
}

var crab_vis = 0;
# ⚠ Two cells for the gallery's visible index range, allocated once — `alloc` has no `free()`.
fn crab_vis_buf(): i64 {
    if (crab_vis == 0) { crab_vis = alloc(16); }
    return crab_vis;
}

fn crab_thumb_key_buf(): i64 {
    if (crab_th_key == 0) { crab_th_key = alloc(CRAB_PATH_MAX + 4); }
    return crab_th_key;
}

fn crab_thumb_file_buf(): i64 {
    if (crab_th_file == 0) { crab_th_file = alloc(CRAB_THUMB_FILE_MAX); }
    return crab_th_file;
}

# Box-average a decoded RGBA image down into the 64x64 BGRA thumbnail, preserving aspect ratio and
# letterboxing the remainder.
#
# ⛔ A BOX AVERAGE, NOT NEAREST-NEIGHBOUR. Point-sampling a 1024x1024 image down to 64 reads one
# source pixel in every 256 and throws the rest away, which turns fine detail into noise that
# changes as the thumbnail size changes. Averaging costs one pass over pixels already decoded — the
# expensive part is behind us — and is the difference between a thumbnail and a mistake.
# ⚠ NO OVERFLOW: each destination pixel averages at most 256 source pixels of at most 255 each, so
# the accumulator peaks at 65,280.
# ⛔ RGBA IN, BGRA OUT. chitra emits R,G,B,A; a sadish surface is B,G,R,A. Getting this wrong is a
# blue-and-red-swapped thumbnail that still looks like a picture, which is the kind of bug that ships.
fn crab_thumb_scale(src, sw, sh): i64 {
    var dst = crab_thumb_pixels();
    if (dst == 0) { return 0; }
    if (sw <= 0) { return 0; }
    if (sh <= 0) { return 0; }
    var i = 0;
    while (i < CRAB_THUMB_BYTES) { store8(dst + i, 0); i = i + 1; }
    # Fit inside the box, preserving aspect. ⚠ Integer maths throughout; a zero result is clamped to
    # 1 so a very wide or very tall image still draws a line rather than nothing.
    var dw = CRAB_THUMB_W;
    var dh = CRAB_THUMB_H;
    if (sw * CRAB_THUMB_H > sh * CRAB_THUMB_W) { dh = (sh * CRAB_THUMB_W) / sw; }
    else { dw = (sw * CRAB_THUMB_H) / sh; }
    if (dw < 1) { dw = 1; }
    if (dh < 1) { dh = 1; }
    var ox = (CRAB_THUMB_W - dw) / 2;
    var oy = (CRAB_THUMB_H - dh) / 2;
    var dy = 0;
    while (dy < dh) {
        var sy0 = (dy * sh) / dh;
        var sy1 = ((dy + 1) * sh) / dh;
        if (sy1 <= sy0) { sy1 = sy0 + 1; }
        if (sy1 > sh) { sy1 = sh; }
        var dx = 0;
        while (dx < dw) {
            var sx0 = (dx * sw) / dw;
            var sx1 = ((dx + 1) * sw) / dw;
            if (sx1 <= sx0) { sx1 = sx0 + 1; }
            if (sx1 > sw) { sx1 = sw; }
            var ar = 0; var ag = 0; var ab = 0; var n = 0;
            var yy = sy0;
            while (yy < sy1) {
                var xx = sx0;
                while (xx < sx1) {
                    var so = (yy * sw + xx) * 4;
                    ar = ar + load8(src + so);
                    ag = ag + load8(src + so + 1);
                    ab = ab + load8(src + so + 2);
                    n = n + 1;
                    xx = xx + 1;
                }
                yy = yy + 1;
            }
            if (n < 1) { n = 1; }
            var doff = ((oy + dy) * CRAB_THUMB_W + (ox + dx)) * 4;
            store8(dst + doff, ab / n);          # B
            store8(dst + doff + 1, ag / n);      # G
            store8(dst + doff + 2, ar / n);      # R
            # ⛔ OPAQUE, ALWAYS. crab's surface is declared `SETU_SURF_PREMULTIPLIED` and the AE-6
            # contract the suite gates is `a == 255` on every pixel. A thumbnail carrying a source
            # image's alpha would break that for the whole frame.
            store8(dst + doff + 3, 255);
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return 1;
}

# @public — produce the thumbnail for `dir`/`name` if there is not one already. -> CRAB_TH_*.
#
# ⛔ AT MOST ONE DECODE PER CALL, AND THE CALLER PUTS IT ON THE IDLE TICK. A decode is not resumable
# — chitra's entry point is one call that returns an image or does not — so "bounded work per tick"
# can only mean "at most one image per tick". That is the same shape as the stepped copy and the
# deferred stat sweep: the metadata appears immediately, the picture arrives a tick later, and the
# keystroke path never carries it.
fn crab_thumb_step(dir, name, pathscr): i64 {
    if (dir == 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    if (name == 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    if (crab_is_image(name) == 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    var key = crab_thumb_key_buf();
    if (key == 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    if (pathscr == 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    if (crab_fs_path(pathscr, dir, name) < 0) { crab_th_state = CRAB_TH_NONE; return crab_th_state; }
    # ⭐ THE CACHE ANSWERS FIRST — including a remembered REFUSAL, which must not be retried: a file
    # too big to decode is still too big on the next idle tick, and re-deciding it every tick would
    # be a spin that also re-reads the file.
    # ⚠ `crab_th_slot` is what `crab_thumb_pixels` reads, so the preview always shows the entry the
    # last step was ABOUT rather than whatever happened to be decoded most recently.
    var hit = crab_tc_find(pathscr);
    if (hit >= 0) {
        crab_th_slot = hit;
        crab_th_state = crab_tc_state(hit);
        return crab_th_state;
    }
    crab_strcpy_n(key, pathscr, CRAB_PATH_MAX);
    crab_th_slot = crab_tc_claim(pathscr);
    crab_th_state = CRAB_TH_NONE;
    # ⛔ THE SESSION CEILING IS CHECKED BEFORE THE FILE IS EVEN OPENED. Past it, no decode may run,
    # so there is nothing to gain by reading the bytes.
    if (crab_thumb_over_budget(crab_th_spent) == 1) { return crab_th_finish(CRAB_TH_SPENT); }
    var fbuf = crab_thumb_file_buf();
    if (fbuf == 0) { return crab_th_finish(CRAB_TH_BAD); }
    var fd = crab_fs_open_r(pathscr, crab_cstr_len(pathscr, CRAB_PATH_MAX));
    # ⚠ A file crab cannot open is recorded as BAD rather than left as NONE — otherwise the tick
    # retries it forever, opening a file it already knows it cannot read.
    if (fd < 0) { return crab_th_finish(CRAB_TH_BAD); }
    var got = sys_read(fd, fbuf, CRAB_THUMB_FILE_MAX);
    sys_close(fd);
    if (got <= 0) { return crab_th_finish(CRAB_TH_BAD); }
    var err = crab_thumb_err_buf();
    if (err == 0) { return crab_th_finish(CRAB_TH_BAD); }
    # ⭐ THE PRE-CHECKED ENTRY POINT. A refusal here costs 16 bytes; the same file through
    # `chitra_image_decode` costs up to 26 MB, permanently, to arrive at the same answer.
    var before = alloc_used();
    var img = chitra_image_decode_budget(fbuf, got, CRAB_THUMB_MAX_RGBA, err);
    crab_th_spent = crab_th_spent + (alloc_used() - before);
    if (img == 0) {
        # ⚠ TWO DIFFERENT NOTHINGS, AND THE OPERATOR IS TOLD WHICH. "too large" is a property of the
        # file and will never change; a decoder error is a property of this build and might.
        if (chitra_err_code(load64(err)) == CHITRA_ERR_BUDGET) { return crab_th_finish(CRAB_TH_TOO_BIG); }
        return crab_th_finish(CRAB_TH_BAD);
    }
    var iw = chitra_image_width(img);
    var ih = chitra_image_height(img);
    if (crab_thumb_scale(chitra_image_pixels(img), iw, ih) == 0) { return crab_th_finish(CRAB_TH_BAD); }
    # ⚠ CALLED FOR FORM, NOT FOR EFFECT — `chitra_image_free` is a no-op in 1.0.0 and reclaims
    # exactly 0 bytes (measured). It is called anyway so that the day it does something, crab
    # already does the right thing; the ⛔ at the top of this section is what stops anyone reading
    # this line as a reason to believe the memory came back.
    chitra_image_free(img);
    return crab_th_finish(CRAB_TH_OK);
}

var crab_th_err = 0;
fn crab_thumb_err_buf(): i64 {
    if (crab_th_err == 0) { crab_th_err = alloc(8); }
    return crab_th_err;
}

# @public — OPEN the selected entry (M4). -> CRAB_FS_OK or a CRAB_FS_* error.
#
# ⭐⭐ THIS IS THE SILENCE M4 EXISTS TO END. The roadmap's M4 section opens with "crab is a read-only
# browser. Enter on a file does nothing, silently." Doing nothing is defensible; doing nothing
# WITHOUT SAYING SO is what makes the app feel broken — the operator cannot tell a file crab will
# not open from a keypress crab did not receive.
#
# ⛔ "OPEN" MEANS "RUN" HERE, AND ONLY THAT, BECAUSE THERE IS NOTHING ELSE ON THIS SYSTEM YET. There
# is no handler registry, no MIME association and no daimon binding in the stack today, so a text
# file has nothing to be opened WITH. crab says that plainly rather than inventing an association.
# ⇒ When an association mechanism exists (M7's daimon arc is where it would live), this function is
# where it hooks in, and the ELF path becomes one arm of it rather than the whole thing.
#
# ⚠ NON-BLOCKING BY CONSTRUCTION. `spawn_path`#43 returns the new pid immediately and crab does not
# reap it — crab is a file manager, not a shell, and blocking the event loop on a child would freeze
# the pane while the child ran. The child is the compositor's problem once it is alive.
fn crab_fs_launch(dir, name, pathscr): i64 {
    var l = crab_fs_path(pathscr, dir, name);
    if (l < 0) { return l; }
    if (l > CRAB_SPAWN_PATH_MAX) { return CRAB_FS_ESPAWNLEN; }
    # ⛔⛔ SECURITY AUDIT F2 (2026-08-31) — SPAWN FIRST, EXPLAIN AFTERWARDS. THE ORDER IS THE FIX.
    # This used to read the ELF magic, close the file, and then call `spawn_path` — which opens it
    # again. Between those two opens the file could be replaced, so the bytes crab vetted were not
    # necessarily the bytes the kernel ran. A classic check-then-act race.
    # ⛔ IT CANNOT BE CLOSED BY SPAWNING THE DESCRIPTOR crab CHECKED: agnos has no `fexecve`, no
    # `execveat` and no fd-taking spawn — `spawn_path`(43) takes a path and nothing else (verified
    # against the ABI table, 2026-08-31).
    # ⇒ SO crab STOPS CHECKING FIRST. The kernel's `elf_load_from_file` already rejects a non-ELF,
    # which means the pre-check was never a security boundary — it duplicated a decision the kernel
    # makes anyway, and duplicating it EARLIER is precisely what created the window.
    # ⭐ The magic read moves to the FAILURE path, where it is a diagnostic rather than a gate: it
    # answers "why did that not run" for the operator, and nothing acts on it. **There is no window
    # left, because there is no longer a check to act on.**
    # ⚠ THE COST IS ONE WASTED SYSCALL when the operator hits Enter on a text file — the kernel
    # attempts a load and refuses. That is a mistake's price, not a hazard.
    var pid = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    pid = sys_spawn_path(pathscr, l);
    #endif
    if (pid >= 0) { return CRAB_FS_OK; }
    # ⚠ On the host there is no `spawn_path`, so this arm is always taken and the ELF read is what
    # the suite exercises. crab does NOT substitute fork+exec: a file manager that launches a real
    # process out of a unit test is a test that can hang a build machine.
    var isexe = crab_is_elf(pathscr, l);
    if (isexe == 0) { return CRAB_FS_ENOEXEC; }
    return CRAB_FS_ESYS;
}

# =================================================================================================
# M4 — THE STEPPED COPY. What makes a transfer tray possible at all.
# =================================================================================================
#
# ⛔⛔ A PROGRESS BAR OVER A BLOCKING CALL IS A DECORATION. `crab_fs_copy` runs its whole read/write
# loop inside the keypress branch, so the event loop draws NO FRAMES while it runs: a bar driven from
# it would render once at 0 %, never repaint, and vanish when the copy returned. The widget was never
# the gate — dhancha 0.9.22 shipped `PROGRESS` and this is still the work.
# ⇒ The copy becomes a state machine that does a bounded number of chunks per call and returns, and
# the EXISTING idle tick drives it — the same tick that already drains `crab_stat_batch` a bounded
# batch at a time and re-renders when it did work. No new loop, no new timing model.
#
# ⛔ THE RECORD IS `alloc`, NOT `dh_falloc`, AND THAT IS NOT A STYLE CHOICE. It holds two open file
# descriptors across many frames. `dh_falloc` draws from the frame arena, which `dh_frame_begin`
# rewinds every render — so the fds would be handed out as widget memory mid-transfer and the copy
# would write into a widget tree. Everything that outlives a frame is global; everything that does
# not is arena'd. This is the boundary.
# ⚠ Allocated ONCE for the process, like the sort scratch and the copy buffer. ONE TRANSFER AT A
# TIME, enforced by the `CRAB_OP_KIND != CRAB_OP_IDLE` -> `EBUSY` guard in `crab_copy_begin`.
# ⛔ THIS USED TO READ "crab copies a single file per keypress and has no multi-select, so a queue
# would be scaffolding for a caller that does not exist." BOTH HALVES DIED IN M4, and the queue it
# called hypothetical is `crab_queue_marked` / `crab_queue_next` / `crab_queue_advance` — 250 lines
# ABOVE this comment, in this same file. A marked set does not run concurrently; it is fed through
# this one record serially, the idle tick starting the next entry only when the current one ends.
enum CrabOp {
    CRAB_OP_IDLE   = 0;
    CRAB_OP_COPY   = 1;    # a plain copy
    CRAB_OP_MOVE   = 2;    # a copy whose source is unlinked on success
    CRAB_OP_CTREE  = 3;    # a RECURSIVE copy — parents first
    CRAB_OP_DTREE  = 4;    # a RECURSIVE delete — children first
    # ⚠ Chunks per idle tick. `CRAB_STAT_BATCH` is 32 entries at ~1.1 ms each; a 4 KiB chunk is far
    # cheaper, so 64 of them is a comparable slice of a tick rather than a number picked for looking
    # round. Bigger throws away the responsiveness this exists to buy.
    CRAB_COPY_STEP_CHUNKS = 64;
    # ⚠ Below this the elapsed time is dominated by the cost of starting, so a rate computed from it
    # is noise dressed as a measurement. Half a second is long enough for the figure to mean
    # something and short enough that a real transfer shows one almost immediately.
    CRAB_RATE_MIN_MS = 500;
    # Record layout. ⚠ Byte offsets, not a struct — same discipline as the readdir record.
    CRAB_OP_KIND   = 0;
    CRAB_OP_FIN    = 8;
    CRAB_OP_FOUT   = 16;
    CRAB_OP_DONE   = 24;   # bytes written so far
    CRAB_OP_TOTAL  = 32;   # bytes expected, or -1 = unknown (INDETERMINATE)
    CRAB_OP_NAME   = 40;   # CRAB_NAME_MAX bytes — the entry being moved, for the delete and the label
    CRAB_OP_SRC    = 104;  # CRAB_PATH_MAX bytes — the SOURCE path, kept for the move's unlink
    CRAB_OP_DST    = 360;  # CRAB_PATH_MAX bytes — the DESTINATION path, kept for a cancel's cleanup
    # ⚠ Rate/ETA state. `CRAB_OP_T0` is the ms the transfer STARTED; the rate is derived from the
    # whole run rather than from the last step, which is the difference between a number that settles
    # and one that flickers with every disk hiccup.
    CRAB_OP_T0     = 616;
    # ⭐⭐ THE WALK'S STATE (M4 recursion). An EXPLICIT stack, not language recursion: a recursive
    # function would blow the ring-3 stack on a deep tree AND could not be paused mid-way, which is
    # the whole requirement — a tree operation must yield to the idle tick like everything else.
    # ⚠ A SLOT HOLDS NO PATH. `sys_readdir_at` is path-based, not fd-based, so there is no directory
    # handle to retain: a level is a resume cursor plus the two path lengths a pop truncates back to.
    # The naive design — one entry buffer per level — is 64 KB PER LEVEL against a bump allocator
    # that never frees. 32 bytes is 2000x cheaper and is what makes this one static allocation.
    CRAB_OP_SROOT  = 624;    # + CRAB_PATH_MAX — the tree's source root, immutable for the run
    CRAB_OP_DROOT  = 880;    # + CRAB_PATH_MAX — its destination root ("" for a delete)
    CRAB_OP_CURS   = 1136;   # + CRAB_PATH_MAX — the LIVE source path: the level the walk stands in
    CRAB_OP_CURD   = 1392;   # + CRAB_PATH_MAX — the live destination path, moved in lockstep
    CRAB_OP_DEPTH  = 1648;
    CRAB_OP_FILES  = 1656;   # entries finished — the tray's numerator
    CRAB_OP_BYTES  = 1664;   # bytes moved across the WHOLE operation — the rate's numerator
    CRAB_OP_WSTEP  = 1672;   # walk steps taken — the backstop counter
    CRAB_OP_STACK  = 1680;   # CRAB_WALK_DEPTH_MAX * CRAB_WALK_SLOT
    CRAB_OP_SZ     = 5776;
    # ⛔ THE DEPTH BOUND IS DERIVED, NOT CHOSEN, AND IT IS PROVABLY UNREACHABLE. `CRAB_PATH_MAX` is
    # 256, root "/" is one character and every level costs at least two more, so `crab_join_n`
    # refuses at depth 127 before this clamp can fire. It exists so that if `CRAB_PATH_MAX` ever
    # moves, the failure is a bounds check rather than a stack overrun — the same defence-in-depth
    # as the unreachable entry-count clamp in `crab_readdir_into`.
    CRAB_WALK_DEPTH_MAX = 128;
    CRAB_WALK_SLOT      = 32;
    CRAB_WS_CUR         = 0;    # the cursor this level's current batch was read from
    CRAB_WS_SLEN        = 8;    # length of CURS at this level — what a pop truncates back to
    CRAB_WS_DLEN        = 16;   # length of CURD at this level (0 on a delete)
    CRAB_WS_IDX         = 24;   # records already consumed out of the current batch
    # ⚠ Directory entries per idle tick, alongside `CRAB_COPY_STEP_CHUNKS`. ⛔ A tick is EITHER 64
    # chunks of one file OR 32 entries, never both — so the tick cost is bounded by the larger, not
    # their sum. 32 matches `CRAB_STAT_BATCH` because an entry costs about the same: a stat plus a
    # mkdir, or a pair of opens.
    CRAB_WALK_STEP_ENTRIES = 32;
    # ⚠ The same shape and reasoning as `CRAB_READDIR_STEPS_MAX`: far above any legitimate walk, so
    # reaching it is always a fault and never a big tree.
    CRAB_WALK_STEPS_MAX = 262144;
}

var crab_op = 0;

fn crab_op_rec(): i64 {
    if (crab_op == 0) {
        crab_op = alloc(CRAB_OP_SZ);
        if (crab_op != 0) { store64(crab_op + CRAB_OP_KIND, CRAB_OP_IDLE); }
    }
    return crab_op;
}

# @public — is a transfer in flight? 1 = yes.
fn crab_op_active(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    if (load64(r + CRAB_OP_KIND) == CRAB_OP_IDLE) { return 0; }
    return 1;
}

# @public — bytes written so far, and the expected total (-1 = unknown). For the tray.
fn crab_op_done(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    return load64(r + CRAB_OP_DONE);
}

fn crab_op_total(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0 - 1; }
    return load64(r + CRAB_OP_TOTAL);
}

# @public — the name of the entry being transferred, or the empty string when idle.
fn crab_op_name(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return ""; }
    if (load64(r + CRAB_OP_KIND) == CRAB_OP_IDLE) { return ""; }
    return r + CRAB_OP_NAME;
}

# @public — bytes per second so far, or -1 when it cannot be said yet.
#
# ⛔ AVERAGED OVER THE WHOLE RUN, NOT THE LAST STEP. A per-step rate is recomputed from one idle
# tick's worth of I/O, so it swings with every disk hiccup and the operator reads a number that never
# settles. The run average is what "how fast is this going" actually means.
# ⛔ AND IT REFUSES TO ANSWER BEFORE IT CAN. Under `CRAB_RATE_MIN_MS` the elapsed time is dominated
# by the cost of starting, so the number would be noise dressed as a measurement — and a wrong rate
# is worse than none, because the operator plans around it. `crab_fs_copy` moves a small file in well
# under a second; those transfers finish having never claimed a rate at all, which is correct.
fn crab_op_rate(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0 - 1; }
    if (load64(r + CRAB_OP_KIND) == CRAB_OP_IDLE) { return 0 - 1; }
    var el = clock_now_ms() - load64(r + CRAB_OP_T0);
    if (el < CRAB_RATE_MIN_MS) { return 0 - 1; }
    var d = load64(r + CRAB_OP_DONE);
    if (d <= 0) { return 0 - 1; }
    # ⚠ Multiply then divide, and in THIS order: `d / el * 1000` truncates to zero for any transfer
    # slower than 1 byte per millisecond. ⛔ `d` is bounded by the file size and `el` by the run, so
    # `d * 1000` overflows only past ~9 petabytes.
    return d * 1000 / el;
}

# @public — seconds remaining at the current rate, or -1 when it cannot be said.
#
# ⚠ AN ETA NEEDS BOTH A RATE **AND** A TOTAL, and crab often has neither: an unstattable source gives
# no denominator, and a short transfer gives no trustworthy rate. Returning -1 for "I cannot say" is
# the same discipline as the indeterminate bar — the tray prints nothing rather than a guess.
fn crab_op_eta(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0 - 1; }
    var total = load64(r + CRAB_OP_TOTAL);
    if (total < 0) { return 0 - 1; }
    var rate = crab_op_rate();
    if (rate <= 0) { return 0 - 1; }
    var left = total - load64(r + CRAB_OP_DONE);
    if (left < 0) { left = 0; }
    return left / rate;
}

# Close both descriptors and return the record to idle. Used by every exit path.
# ⚠ ONE PLACE THAT CLOSES, so a path added later cannot forget half of it — a leaked fd in a file
# manager is not academic: crab is long-lived and the descriptor table is not.
fn crab_op_release(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    var fi = load64(r + CRAB_OP_FIN);
    var fo = load64(r + CRAB_OP_FOUT);
    if (fo >= 0) { sys_close(fo); }
    if (fi >= 0) { sys_close(fi); }
    store64(r + CRAB_OP_FIN, 0 - 1);
    store64(r + CRAB_OP_FOUT, 0 - 1);
    store64(r + CRAB_OP_KIND, CRAB_OP_IDLE);
    return 0;
}

# @public — abandon the transfer at the operator's request. -> CRAB_FS_OK.
#
# ⛔⛔ A CANCEL DELETES THE PARTIAL DESTINATION; AN I/O FAILURE DOES NOT. That asymmetry is
# deliberate and it is the whole difference between the two paths. On an I/O error the filesystem is
# already unhappy, and issuing another write-path syscall into it is how a bad situation becomes a
# worse one — so `crab_copy_step` leaves the evidence in place and says so. On a CANCEL nothing is
# wrong: the operator changed their mind, and leaving a truncated file wearing the real file's name
# is the worst outcome available — the next reader cannot tell it from the whole thing.
# ⚠ The source is never touched. A cancelled move is a no-op, not a half-move.
fn crab_copy_cancel(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return CRAB_FS_OK; }
    if (load64(r + CRAB_OP_KIND) == CRAB_OP_IDLE) { return CRAB_FS_OK; }
    crab_op_release();
    var dl = crab_cstr_len(r + CRAB_OP_DST, CRAB_PATH_MAX);
    if (dl > 0) { crab_fs_unlink_raw(r + CRAB_OP_DST, dl); }
    return CRAB_FS_OK;
}

# @public — begin a stepped copy (`kind` = CRAB_OP_COPY) or move (CRAB_OP_MOVE) of `name` from
# `srcdir` to `dstdir`. -> CRAB_FS_OK once it is running, or a CRAB_FS_* refusal.
#
# ⭐ A MOVE STILL TRIES `rename` FIRST, in the caller, and only reaches here when it refuses — so the
# common case (both panes on one filesystem) never reads or writes a byte and never shows a bar.
# ⚠ THE GUARDS ARE THE SAME ONES `crab_fs_copy` USES, IN THE SAME ORDER, and they all run BEFORE
# anything is opened — so a refused transfer has not touched the disk.
# ⭐ AND THE TOTAL COMES FROM A STAT OF THE **SOURCE**, which nothing did before: `crab_fs_exists`
# stats the DESTINATION for the overwrite guard and discards the statbuf it just filled. Without a
# source size there is no denominator, and the bar could only ever be indeterminate.
# ⚠ A FAILED STAT IS NOT A FAILED COPY. `-1` flows into `CRAB_OP_TOTAL` and the bar renders
# indeterminate — which is exactly the state dhancha 0.9.22 added `den <= 0` for. On a host build
# that is the normal answer, and the copy still runs.
fn crab_copy_begin(kind, srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var r = crab_op_rec();
    if (r == 0) { return CRAB_FS_EIO; }
    if (load64(r + CRAB_OP_KIND) != CRAB_OP_IDLE) { return CRAB_FS_EBUSY; }
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = crab_fs_path(scr2, dstdir, name);
    if (ld < 0) { return ld; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
    # ⛔⛔ A FOLDER IS REFUSED HERE, AND THIS GUARD SHIPPED MISSING. Without it `crab_fs_open_r`
    # succeeds on a directory, `crab_fs_open_w` CREATES the destination, and the first
    # `crab_copy_step` fails — leaving a stray 0-byte file behind and a retry that returns
    # `EEXIST` forever, because the stray is now what the overwrite guard finds. On agnos the
    # damage is worse than empty: reading a directory yields raw dirent bytes, so the stray is
    # non-empty and corrupt.
    # ⛔ IT MUST LIVE IN THIS FUNCTION, NOT AT THE FOUR CALL SITES. Two of them arrive from
    # `crab_queue_advance`, which holds a NAME and no record — there is no `CRAB_REC_TYPE` to
    # consult, which is exactly how the marked path reached `open` with a folder in hand. The
    # marked-DELETE path re-derives the type per entry (`src/main.cyr`, `crab_index_of`); copy and
    # move were the outlier.
    # ⚠ AFTER the `EEXIST` test on purpose, so every refusal that was already reachable keeps the
    # message it had — only the case that used to create a file changes. `crab_fs_exists` creates
    # nothing, so nothing is on disk yet when this returns.
    # ⚠ NOT the recursive path's answer: a folder that should be copied whole goes to
    # `crab_walk_begin(CRAB_OP_CTREE, …)`, which never calls this function.
    if (crab_fs_isdir(scr1, ls, statbuf) == 1) { return CRAB_FS_EISDIR; }
    if (crab_copy_buf() == 0) { return CRAB_FS_EIO; }
    var fin = crab_fs_open_r(scr1, ls);
    if (fin < 0) { return CRAB_FS_ESYS; }
    var fout = crab_fs_open_w(scr2, ld);
    if (fout < 0) { sys_close(fin); return CRAB_FS_ESYS; }
    # ⚠ Stat the source AFTER both opens succeed, so a stat failure cannot leave a half-open state.
    var total = crab_fs_stat_size(scr1, ls, statbuf);
    store64(r + CRAB_OP_KIND, kind);
    store64(r + CRAB_OP_FIN, fin);
    store64(r + CRAB_OP_FOUT, fout);
    store64(r + CRAB_OP_DONE, 0);
    store64(r + CRAB_OP_T0, clock_now_ms());
    store64(r + CRAB_OP_TOTAL, total);
    crab_strcpy_n(r + CRAB_OP_NAME, name, CRAB_NAME_MAX);
    crab_strcpy_n(r + CRAB_OP_SRC, scr1, CRAB_PATH_MAX);
    crab_strcpy_n(r + CRAB_OP_DST, scr2, CRAB_PATH_MAX);
    return CRAB_FS_OK;
}

# @public — advance the transfer by at most `CRAB_COPY_STEP_CHUNKS` chunks.
# -> 1 = still running (call again), 0 = nothing to do (idle), or a CRAB_FS_* result on completion
#    or failure (CRAB_FS_OK = finished cleanly).
#
# ⛔ THE SHORT-WRITE LOOP IS INSIDE THE STEP, NOT ACROSS STEPS. `write` may take fewer bytes than
# offered, and a chunk left half-written between two idle ticks would be a partially applied step
# whose remainder depends on a buffer the next tick has already refilled. Each chunk is fully
# written or the transfer fails; the step boundary is always between whole chunks.
# ⛔ A PART-WAY FAILURE LEAVES THE PARTIAL FILE. See `crab_copy_cancel` for why that differs from a
# cancel: here the filesystem is already failing, and writing more into it is not a repair.
fn crab_copy_step(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    var kind = load64(r + CRAB_OP_KIND);
    if (kind == CRAB_OP_IDLE) { return 0; }
    var buf = crab_copy_buf();
    var fin = load64(r + CRAB_OP_FIN);
    var fout = load64(r + CRAB_OP_FOUT);
    var n = 0;
    while (n < CRAB_COPY_STEP_CHUNKS) {
        var got = sys_read(fin, buf, CRAB_COPY_CHUNK);
        if (got < 0) { crab_op_release(); return CRAB_FS_EIO; }
        if (got == 0) {
            # EOF — the only clean way out. A move unlinks its source ONLY here.
            crab_op_release();
            if (kind == CRAB_OP_MOVE) {
                var sl = crab_cstr_len(r + CRAB_OP_SRC, CRAB_PATH_MAX);
                if (sl <= 0) { return CRAB_FS_ESYS; }
                if (crab_fs_unlink_raw(r + CRAB_OP_SRC, sl) < 0) { return CRAB_FS_ESYS; }
            }
            return CRAB_FS_OK;
        }
        var off = 0;
        while (off < got) {
            var put = sys_write(fout, buf + off, got - off);
            if (put <= 0) { crab_op_release(); return CRAB_FS_EIO; }
            off = off + put;
        }
        store64(r + CRAB_OP_DONE, load64(r + CRAB_OP_DONE) + got);
        n = n + 1;
    }
    return 1;
}

# =================================================================================================
# M4 — THE RECURSIVE WALK. Copying and deleting a tree, a bounded slice at a time.
# =================================================================================================

# @public — is `path` inside the tree rooted at `root`? 1 = yes.
#
# ⛔⛔ THE GUARD AGAINST COPYING A FOLDER INTO ITSELF. `/a` copied into `/a/b` produces
# `/a/b/a/b/a/b/…` until the path bound stops it — a walk that never terminates on its own and
# leaves a deep partial tree behind. Refused BEFORE anything is created.
# ⚠ BOUNDARY-AWARE: `/ab` is NOT inside `/a`. A plain prefix compare says it is, and that would
# refuse a perfectly legal copy — the kind of false refusal an operator cannot argue with.
# ⚠ A path IS inside itself, which the caller wants: the exact-same-path case is refused too, and
# `crab_streq_n` catches it first with the clearer `CRAB_FS_ESAME`.
fn crab_path_within(root, path, cap): i64 {
    var rl = crab_cstr_len(root, cap);
    var pl = crab_cstr_len(path, cap);
    if (rl < 0) { return 0; }
    if (pl < 0) { return 0; }
    if (pl < rl) { return 0; }
    var i = 0;
    while (i < rl) {
        if (load8(root + i) != load8(path + i)) { return 0; }
        i = i + 1;
    }
    if (pl == rl) { return 1; }
    # ⚠ The next byte must be a separator, or this is a SIBLING whose name merely starts the same.
    # ⚠ Unless the root already ends in one, which is only true of "/" itself.
    if (load8(root + rl - 1) == 47) { return 1; }
    if (load8(path + rl) == 47) { return 1; }
    return 0;
}

# @public — the cursor a walk of `kind` may resume a directory read from.
# -> 0 for a delete (always restart), `saved` for a copy.
#
# ⛔⛔ A DELETE MUTATES THE DIRECTORY IT IS READING, AND THAT IS WHY IT CANNOT CARRY A CURSOR.
# `ext2_dir_remove` coalesces a removed entry into its PREDECESSOR by extending that record's
# `rec_len`. `readdir_at` parks its cursor on the record it did not take and resumes by reading a
# header at that offset — which, after a coalesce, is now INTERIOR to the predecessor's extended
# record. So the kernel parses a record header out of the middle of a FILENAME.
# ⛔ AND THE TWO GUARDS DO NOT SAVE IT. The 4-byte alignment check passes, because a valid record
# start stays 4-aligned; and `ext2_dirent_valid` is satisfied by ordinary filename bytes. The failure
# is not a crash and not an empty listing — it is a FABRICATED ENTRY NAME handed to `unlink`, and a
# fabricated name that happens to match a real sibling deletes the wrong file.
# ⇒ A delete re-reads from 0 every step. It costs one extra `readdir_at` per step and it is the
# difference between correct and catastrophic.
# ⚠ A predicate rather than an inline branch, for the same reason `crab_readdir_stalled` is one: the
# walk it protects is agnos-shaped and the rule is what a host test can actually assert.
fn crab_walk_cursor_for(kind, saved): i64 {
    if (kind == CRAB_OP_DTREE) { return 0; }
    return saved;
}

# ⚠ One shared batch buffer for the whole walk — never one per level. 64 records = 4 KB, the same
# shape as `crab_readdir_into`'s counting scratch and one ext2 block.
var crab_wbuf = 0;
var crab_wraw = 0;

fn crab_walk_buf(): i64 {
    if (crab_wbuf == 0) { crab_wbuf = alloc(CRAB_READDIR_BATCH * CRAB_REC_SZ); }
    return crab_wbuf;
}

fn crab_walk_raw(): i64 {
    if (crab_wraw == 0) { crab_wraw = alloc(CRAB_COPY_CHUNK); }
    return crab_wraw;
}

# @public — read up to `max` entries of the directory at `path` into `buf` as crab records,
# resuming from `*curptr` (0 = the top) and writing the next cursor back. -> the count, or negative.
# `*curptr` becomes -1 when the directory is exhausted.
#
# ⭐⭐ THIS EXISTS SO THE WALK CAN BE TESTED, AND THAT IS NOT A SIDE BENEFIT. `crab_readdir_into` is
# agnos-only — its whole body sits inside `#ifdef CYRIUS_TARGET_AGNOS` and yields 0 on the host — so
# a tree walk built on it would have been another `#101`-shaped blind spot, in the most destructive
# code in the app. Linux's `getdents64` carries `d_off`, a seek cookie with EXACTLY `#101`'s
# semantics, so the same state machine runs for real against real directories in `tests/crab.tcyr`.
# ⚠ `.` and `..` are skipped on both targets. They consume batch space and never become records —
# a walk that descended into `..` would leave the tree immediately.
fn crab_walk_readdir(path, plen, buf, max, curptr): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_readdir_at(path, buf, max, curptr);
    #else
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { return 0 - 1; }
    var start = load64(curptr);
    if (start < 0) { sys_close(fd); return 0; }
    if (start > 0) { xlseek(fd, start, 0); }   # portable in every syscall peer
    var raw = crab_walk_raw();
    if (raw == 0) { sys_close(fd); return 0 - 1; }
    var got = sys_getdents64(fd, raw, CRAB_COPY_CHUNK);
    if (got < 0) { sys_close(fd); return 0 - 1; }
    if (got == 0) { store64(curptr, 0 - 1); sys_close(fd); return 0; }
    var n = 0;
    var off = 0;
    var lastoff = start;
    while (off < got) {
        # struct linux_dirent64: u64 d_ino; s64 d_off; u16 d_reclen @+16; u8 d_type @+18; name @+19
        var reclen = load8(raw + off + 16) | (load8(raw + off + 17) << 8);
        if (reclen <= 0) { off = got; }
        else {
            if (n >= max) { off = got; }
            else {
                var dt = load8(raw + off + 18);
                var nm = raw + off + 19;
                var skip = 0;
                if (load8(nm) == 46) {
                    if (load8(nm + 1) == 0) { skip = 1; }
                    if (load8(nm + 1) == 46) { if (load8(nm + 2) == 0) { skip = 1; } }
                }
                lastoff = load64(raw + off + 8);
                if (skip == 0) {
                    var rec = buf + n * CRAB_REC_SZ;
                    var i = 0;
                    while (i < CRAB_REC_SZ) { store8(rec + i, 0); i = i + 1; }
                    crab_strcpy_n(rec, nm, CRAB_NAME_MAX);
                    # ⚠ DT_DIR is 4 on Linux; crab's record uses 1 = directory, matching agnos.
                    if (dt == 4) { store8(rec + CRAB_REC_TYPE, 1); }
                    n = n + 1;
                }
                off = off + reclen;
            }
        }
    }
    store64(curptr, lastoff);
    sys_close(fd);
    return n;
    #endif
}

# Close both descriptors WITHOUT ending the operation. Split out of `crab_op_release` for the walk:
# a tree must close a finished file's fds and keep going, where a single-file transfer is done.
# ⚠ Still ONE place that closes, which is the property the original comment names.
fn crab_op_fds_close(r): i64 {
    if (r == 0) { return 0; }
    var fi = load64(r + CRAB_OP_FIN);
    var fo = load64(r + CRAB_OP_FOUT);
    if (fo >= 0) { sys_close(fo); }
    if (fi >= 0) { sys_close(fi); }
    store64(r + CRAB_OP_FIN, 0 - 1);
    store64(r + CRAB_OP_FOUT, 0 - 1);
    return 0;
}

# Truncate the live paths back to this level's prefix. Called after every entry, so `CURS`/`CURD`
# always describe the DIRECTORY the walk stands in and never the entry it just looked at.
fn crab_walk_restore(r, slot): i64 {
    var sl = load64(slot + CRAB_WS_SLEN);
    var dl = load64(slot + CRAB_WS_DLEN);
    store8(r + CRAB_OP_CURS + sl, 0);
    if (dl > 0) { store8(r + CRAB_OP_CURD + dl, 0); }
    return 0;
}

# End the walk, leaving the record idle. -> `rc`, so callers can `return crab_walk_stop(r, code)`.
fn crab_walk_stop(r, rc): i64 {
    crab_op_fds_close(r);
    store64(r + CRAB_OP_KIND, CRAB_OP_IDLE);
    return rc;
}

# @public — begin a recursive copy (`CRAB_OP_CTREE`) or delete (`CRAB_OP_DTREE`) of the directory
# `name` in `srcdir`. `dstdir` is ignored for a delete. -> CRAB_FS_OK once running, or a refusal.
fn crab_walk_begin(kind, srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var r = crab_op_rec();
    if (r == 0) { return CRAB_FS_EIO; }
    if (load64(r + CRAB_OP_KIND) != CRAB_OP_IDLE) { return CRAB_FS_EBUSY; }
    if (crab_walk_buf() == 0) { return CRAB_FS_EIO; }
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = 0;
    if (kind == CRAB_OP_CTREE) {
        ld = crab_fs_path(scr2, dstdir, name);
        if (ld < 0) { return ld; }
        if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
        # ⛔ THE DESTINATION MUST NOT BE INSIDE THE SOURCE. `/a` into `/a/b` produces `/a/b/a/b/…`
        # until the path bound stops it — a walk that never terminates on its own and leaves a deep
        # partial tree behind. Checked ONCE here rather than per step: the walk only ever descends
        # real directories under the source root and builds the destination from the destination
        # root, so this static check holds for the whole run.
        if (crab_path_within(scr1, dstdir, CRAB_PATH_MAX) == 1) { return CRAB_FS_ELOOP; }
        if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
        if (crab_fs_mkdir_raw(scr2, ld) < 0) { return CRAB_FS_ESYS; }
    }
    store64(r + CRAB_OP_KIND, kind);
    store64(r + CRAB_OP_FIN, 0 - 1);
    store64(r + CRAB_OP_FOUT, 0 - 1);
    store64(r + CRAB_OP_DONE, 0);
    store64(r + CRAB_OP_TOTAL, 0 - 1);
    store64(r + CRAB_OP_T0, clock_now_ms());
    store64(r + CRAB_OP_DEPTH, 0);
    store64(r + CRAB_OP_FILES, 0);
    store64(r + CRAB_OP_BYTES, 0);
    store64(r + CRAB_OP_WSTEP, 0);
    crab_strcpy_n(r + CRAB_OP_NAME, name, CRAB_NAME_MAX);
    crab_strcpy_n(r + CRAB_OP_SROOT, scr1, CRAB_PATH_MAX);
    crab_strcpy_n(r + CRAB_OP_CURS, scr1, CRAB_PATH_MAX);
    store8(r + CRAB_OP_DROOT, 0);
    store8(r + CRAB_OP_CURD, 0);
    if (kind == CRAB_OP_CTREE) {
        crab_strcpy_n(r + CRAB_OP_DROOT, scr2, CRAB_PATH_MAX);
        crab_strcpy_n(r + CRAB_OP_CURD, scr2, CRAB_PATH_MAX);
    }
    var slot = r + CRAB_OP_STACK;
    store64(slot + CRAB_WS_CUR, 0);
    store64(slot + CRAB_WS_SLEN, ls);
    store64(slot + CRAB_WS_DLEN, ld);
    store64(slot + CRAB_WS_IDX, 0);
    return CRAB_FS_OK;
}

# Advance the file currently in flight inside a tree copy. Same chunk loop as `crab_copy_step`, with
# two differences: EOF closes the fds and keeps the WALK alive (returning 2, "an item finished"), and
# every chunk also accumulates into the operation-wide byte total.
fn crab_walk_file_step(): i64 {
    var r = crab_op_rec();
    var buf = crab_copy_buf();
    var fin = load64(r + CRAB_OP_FIN);
    var fout = load64(r + CRAB_OP_FOUT);
    var n = 0;
    while (n < CRAB_COPY_STEP_CHUNKS) {
        var got = sys_read(fin, buf, CRAB_COPY_CHUNK);
        if (got < 0) { return crab_walk_stop(r, CRAB_FS_EIO); }
        if (got == 0) {
            crab_op_fds_close(r);
            store64(r + CRAB_OP_FILES, load64(r + CRAB_OP_FILES) + 1);
            store64(r + CRAB_OP_DONE, 0);
            store64(r + CRAB_OP_TOTAL, 0 - 1);
            return 2;
        }
        var off = 0;
        while (off < got) {
            var put = sys_write(fout, buf + off, got - off);
            if (put <= 0) { return crab_walk_stop(r, CRAB_FS_EIO); }
            off = off + put;
        }
        store64(r + CRAB_OP_DONE, load64(r + CRAB_OP_DONE) + got);
        store64(r + CRAB_OP_BYTES, load64(r + CRAB_OP_BYTES) + got);
        n = n + 1;
    }
    return 1;
}

# Advance the directory walk by at most `CRAB_WALK_STEP_ENTRIES` entries.
# -> 1 = more to do, 2 = an item finished (redraw, but the panes did not change), CRAB_FS_OK when the
#    whole tree is done, or a CRAB_FS_* failure.
#
# ⛔⛔ A DELETE GOES CHILDREN-FIRST AND A COPY GOES PARENTS-FIRST, and neither order is a preference.
# `rmdir` refuses a non-empty directory, so a delete must empty a level before it can remove it; and
# a copy must create the destination directory before it can write anything into it.
# ⛔ AND THE DELETE RE-READS FROM CURSOR 0 EVERY STEP — see `crab_walk_cursor_for`. It is mutating
# the directory it is reading, and a carried cursor lands inside a coalesced record.
fn crab_walk_step(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    var kind = load64(r + CRAB_OP_KIND);
    if (kind == CRAB_OP_IDLE) { return 0; }
    var wbuf = crab_walk_buf();
    if (wbuf == 0) { return crab_walk_stop(r, CRAB_FS_EIO); }
    var curbox = r + CRAB_OP_WSTEP;                  # scratch: reused as the readdir cursor cell
    var budget = 0;
    while (budget < CRAB_WALK_STEP_ENTRIES) {
        # ⚠ The backstop, the same shape as `CRAB_READDIR_STEPS_MAX`: far above any legitimate walk,
        # so reaching it is a fault rather than a big tree.
        if (load64(r + CRAB_OP_WSTEP) >= CRAB_WALK_STEPS_MAX) { return crab_walk_stop(r, CRAB_FS_EIO); }
        var d = load64(r + CRAB_OP_DEPTH);
        var slot = r + CRAB_OP_STACK + d * CRAB_WALK_SLOT;
        var slen = load64(slot + CRAB_WS_SLEN);
        var dlen = load64(slot + CRAB_WS_DLEN);
        # Refill this level's batch from its saved cursor (a delete always from 0).
        var cbox[8];
        store64(&cbox, crab_walk_cursor_for(kind, load64(slot + CRAB_WS_CUR)));
        var n = crab_walk_readdir(r + CRAB_OP_CURS, slen, wbuf, CRAB_READDIR_BATCH, &cbox);
        if (n < 0) { return crab_walk_stop(r, CRAB_FS_ESYS); }
        var idx = load64(slot + CRAB_WS_IDX);
        # ⚠ A DELETE'S INDEX IS ALWAYS 0. It re-reads from the top and the entries it already removed
        # are gone, so the first record is always the next one to remove. Carrying an index would
        # skip exactly as many survivors as it had already deleted.
        if (kind == CRAB_OP_DTREE) { idx = 0; }
        if (idx >= n) {
            # ⛔⛔ "THIS LEVEL IS FINISHED" IS A DIFFERENT QUESTION FOR EACH KIND, AND CONFLATING THEM
            # HANGS THE WALK. A COPY carries its cursor, so it is done when the cursor says exhausted.
            # A DELETE always re-reads from the TOP (see `crab_walk_cursor_for`), so its cursor is
            # meaningless — and an empty directory still yields `.` and `..`, which are skipped, so
            # the read returns 0 entries with a cursor that is NOT the sentinel. Testing the cursor
            # there re-reads the same empty directory forever.
            # ⇒ For a delete, "no entries came back from the top" IS empty.
            var lvldone = 0;
            if (kind == CRAB_OP_DTREE) { if (n == 0) { lvldone = 1; } }
            else { if (load64(&cbox) == (0 - 1)) { lvldone = 1; } }
            if (lvldone == 1) {
                # This level is exhausted.
                if (kind == CRAB_OP_DTREE) {
                    # ⛔ CHILDREN FIRST: the directory itself goes only now that it is empty.
                    if (crab_fs_rmdir_raw(r + CRAB_OP_CURS, slen) < 0) {
                        return crab_walk_stop(r, CRAB_FS_ESYS);
                    }
                    store64(r + CRAB_OP_FILES, load64(r + CRAB_OP_FILES) + 1);
                }
                if (d == 0) { return crab_walk_stop(r, CRAB_FS_OK); }
                store64(r + CRAB_OP_DEPTH, d - 1);
                var up = r + CRAB_OP_STACK + (d - 1) * CRAB_WALK_SLOT;
                crab_walk_restore(r, up);
                # ⚠ The parent's batch is stale after a descend, so its index restarts. A copy's
                # cursor still carries, so it resumes where it left off rather than re-walking.
                store64(up + CRAB_WS_IDX, load64(up + CRAB_WS_IDX));
                budget = budget + 1;
                store64(r + CRAB_OP_WSTEP, load64(r + CRAB_OP_WSTEP) + 1);
            } else {
                store64(slot + CRAB_WS_CUR, load64(&cbox));
                store64(slot + CRAB_WS_IDX, 0);
                # ⚠ A refill spends budget too. Without this a pathological directory that yields a
                # cursor but no usable records could spin inside one step forever — the same class of
                # non-terminating loop the `#101` stall guard exists for.
                budget = budget + 1;
                store64(r + CRAB_OP_WSTEP, load64(r + CRAB_OP_WSTEP) + 1);
            }
        } else {
            var rec = wbuf + idx * CRAB_REC_SZ;
            store64(slot + CRAB_WS_IDX, idx + 1);
            store64(r + CRAB_OP_WSTEP, load64(r + CRAB_OP_WSTEP) + 1);
            budget = budget + 1;
            if (crab_name_ok(rec) == 0) { return crab_walk_stop(r, CRAB_FS_EBADNAME); }
            # ⛔ JOIN THE DESTINATION FIRST — BEFORE THE SOURCE AND BEFORE ANY mkdir OR open. A tree
            # that is legal at the source can be illegal at the destination, because the bound is on
            # the ABSOLUTE path and the two roots differ in length. Refusing here means a partial
            # tree is always a PREFIX of a correct copy, never a corrupt one.
            var dl2 = 0;
            if (kind == CRAB_OP_CTREE) {
                if (crab_join_n(r + CRAB_OP_CURD, CRAB_PATH_MAX, r + CRAB_OP_CURD, rec) < 0) {
                    crab_walk_restore(r, slot);
                    return crab_walk_stop(r, CRAB_FS_ETOOLONG);
                }
                dl2 = crab_cstr_len(r + CRAB_OP_CURD, CRAB_PATH_MAX);
            }
            if (crab_join_n(r + CRAB_OP_CURS, CRAB_PATH_MAX, r + CRAB_OP_CURS, rec) < 0) {
                crab_walk_restore(r, slot);
                return crab_walk_stop(r, CRAB_FS_ETOOLONG);
            }
            var sl2 = crab_cstr_len(r + CRAB_OP_CURS, CRAB_PATH_MAX);
            # ⚠ `== 1`, NOT `!= 0`, AND NO TEST DISTINGUISHES THEM TODAY — said rather than implied.
            # Both backends emit only 0 or 1 (agnos sets the byte from `ftype == 2`; the host arm
            # sets it from `DT_DIR`), so the two forms are currently equivalent and a mutation
            # between them passes the suite. `== 1` is chosen anyway: a future backend that passed a
            # raw ext2 `ftype` through would make `!= 0` descend a SYMLINK, whose ftype is 7.
            # ⛔ THE DESCEND GATE IS THE RECORD'S TYPE BYTE AND NOTHING ELSE — NEVER A STAT. A
            # symlink, including one pointing at a directory, arrives with type 0 because both kernel
            # backends set the byte from `ftype == 2` alone. So the walk treats it as a leaf and
            # unlinks the LINK, never the target — correct `rm -r` behaviour, achieved with no
            # `lstat` and safe by construction rather than by a check that could be forgotten.
            # ⚠ THE PIN HAS HAD `sys_lstat` SINCE 6.5.37 — this line used to say it "does not exist
            # in the pinned stdlib", which was the reason given for not calling it. The reason is
            # now the argument above, not the absence: the type byte IS the gate, and reaching for
            # a stat here would re-open the very thing this paragraph rules out.
            if (load8(rec + CRAB_REC_TYPE) == 1) {
                if ((d + 1) >= CRAB_WALK_DEPTH_MAX) {
                    crab_walk_restore(r, slot);
                    return crab_walk_stop(r, CRAB_FS_ETOOLONG);
                }
                if (kind == CRAB_OP_CTREE) {
                    if (crab_fs_exists(r + CRAB_OP_CURD, dl2, crab_walk_statbuf()) != 0) {
                        crab_walk_restore(r, slot);
                        return crab_walk_stop(r, CRAB_FS_EEXIST);
                    }
                    if (crab_fs_mkdir_raw(r + CRAB_OP_CURD, dl2) < 0) {
                        crab_walk_restore(r, slot);
                        return crab_walk_stop(r, CRAB_FS_ESYS);
                    }
                    store64(r + CRAB_OP_FILES, load64(r + CRAB_OP_FILES) + 1);
                }
                store64(r + CRAB_OP_DEPTH, d + 1);
                var down = r + CRAB_OP_STACK + (d + 1) * CRAB_WALK_SLOT;
                store64(down + CRAB_WS_CUR, 0);
                store64(down + CRAB_WS_SLEN, sl2);
                store64(down + CRAB_WS_DLEN, dl2);
                store64(down + CRAB_WS_IDX, 0);
            } else {
                if (kind == CRAB_OP_DTREE) {
                    if (crab_fs_unlink_raw(r + CRAB_OP_CURS, sl2) < 0) {
                        # ⛔⛔ SECURITY AUDIT F4 (2026-08-31) — AN UNLINK THAT FAILS MAY BE A
                        # DIRECTORY THE BACKEND DID NOT TYPE. The record's type byte is set from
                        # `DT_DIR` on the host and `ftype == 2` on agnos; a filesystem that answers
                        # `DT_UNKNOWN` leaves it 0, so a real directory arrives as a leaf, `unlink`
                        # refuses it, and the delete reported a failure instead of descending.
                        # ⇒ RE-DISPATCH THE SAME ENTRY AS A DIRECTORY: mark the record and rewind the
                        # batch index by one, so the next step takes the descend branch. The paths
                        # are restored first, because the next step re-joins them from the parent.
                        # ⛔ THIS CANNOT LOOP. The mark is written once — the retry takes the type-1
                        # branch, which never returns here — and if the entry is genuinely not a
                        # directory (a permission failure, a busy file), the descend's readdir fails
                        # and the walk stops with the honest error one step later. `CRAB_WALK_STEPS_MAX`
                        # is the backstop under all of it.
                        # ⚠ IT COSTS NOTHING WHEN THE BACKEND TYPES CORRECTLY: the retry only ever
                        # runs after a syscall that already failed.
                        crab_walk_restore(r, slot);
                        if (crab_walk_retry_as_dir(load8(rec + CRAB_REC_TYPE)) == 1) {
                            store8(rec + CRAB_REC_TYPE, 1);
                            store64(slot + CRAB_WS_IDX, idx);
                            return 0;
                        }
                        return crab_walk_stop(r, CRAB_FS_ESYS);
                    }
                    store64(r + CRAB_OP_FILES, load64(r + CRAB_OP_FILES) + 1);
                    crab_walk_restore(r, slot);
                } else {
                    if (crab_fs_exists(r + CRAB_OP_CURD, dl2, crab_walk_statbuf()) != 0) {
                        crab_walk_restore(r, slot);
                        return crab_walk_stop(r, CRAB_FS_EEXIST);
                    }
                    var fin2 = crab_fs_open_r(r + CRAB_OP_CURS, sl2);
                    if (fin2 < 0) { crab_walk_restore(r, slot); return crab_walk_stop(r, CRAB_FS_ESYS); }
                    var fout2 = crab_fs_open_w(r + CRAB_OP_CURD, dl2);
                    if (fout2 < 0) {
                        sys_close(fin2);
                        crab_walk_restore(r, slot);
                        return crab_walk_stop(r, CRAB_FS_ESYS);
                    }
                    store64(r + CRAB_OP_FIN, fin2);
                    store64(r + CRAB_OP_FOUT, fout2);
                    store64(r + CRAB_OP_DONE, 0);
                    store64(r + CRAB_OP_TOTAL, crab_fs_stat_size(r + CRAB_OP_CURS, sl2, crab_walk_statbuf()));
                    crab_strcpy_n(r + CRAB_OP_NAME, rec, CRAB_NAME_MAX);
                    # ⛔ SRC AND DST ARE REWRITTEN FOR EVERY FILE. `crab_copy_cancel` reads DST after
                    # the fds are closed, and a stale DST would unlink the PREVIOUS file.
                    crab_strcpy_n(r + CRAB_OP_SRC, r + CRAB_OP_CURS, CRAB_PATH_MAX);
                    crab_strcpy_n(r + CRAB_OP_DST, r + CRAB_OP_CURD, CRAB_PATH_MAX);
                    # ⚠ The live paths go back to describing the DIRECTORY immediately — the walk
                    # never stands on a file.
                    crab_walk_restore(r, slot);
                    return 1;
                }
            }
        }
    }
    return 1;
}

# ⚠ The walk's own statbuf — it cannot borrow the caller's, because the walk outlives the call.
var crab_wstat = 0;
fn crab_walk_statbuf(): i64 {
    if (crab_wstat == 0) { crab_wstat = alloc(STAT_BUFSZ); }
    return crab_wstat;
}

# @public — THE single entry point the idle tick calls. Dispatches on what is actually running.
# ⛔ A TICK IS EITHER 64 CHUNKS OF ONE FILE OR 32 DIRECTORY ENTRIES, NEVER BOTH — the open-fd test
# below guarantees it, so the tick cost is bounded by the larger of the two rather than their sum.
fn crab_op_step(): i64 {
    var r = crab_op_rec();
    if (r == 0) { return 0; }
    var k = load64(r + CRAB_OP_KIND);
    if (k == CRAB_OP_IDLE) { return 0; }
    if (k == CRAB_OP_COPY) { return crab_copy_step(); }
    if (k == CRAB_OP_MOVE) { return crab_copy_step(); }
    if (load64(r + CRAB_OP_FIN) >= 0) { return crab_walk_file_step(); }
    return crab_walk_step();
}

# @public — the operator-facing sentence for a `CRAB_FS_*` result. Never 0.
#
# ⚠ THE STATUS LINE IS THE ONLY PLACE A REFUSAL IS SEEN. crab logs to the console as well, but three
# processes share that console unserialised on iron and the operator is not reading it. A refusal
# the operator cannot see is indistinguishable from the operation silently not working.
fn crab_fs_msg(rc): i64 {
    if (rc == CRAB_FS_OK)       { return "done"; }
    if (rc == CRAB_FS_EBADNAME) { return "refused: crab will not act on that name"; }
    if (rc == CRAB_FS_ETOOLONG) { return "refused: the path would be too long"; }
    if (rc == CRAB_FS_EEXIST)   { return "refused: something of that name is already there"; }
    if (rc == CRAB_FS_ESAME)    { return "refused: the source and the destination are the same"; }
    if (rc == CRAB_FS_EIO)      { return "failed part-way: the copy is incomplete"; }
    if (rc == CRAB_FS_ENOEXEC)  { return "crab has no way to open that yet"; }
    if (rc == CRAB_FS_ESPAWNLEN) { return "refused: the path is too long to launch"; }
    if (rc == CRAB_FS_EBUSY)    { return "a transfer is already running"; }
    if (rc == CRAB_FS_ELOOP)    { return "refused: a folder cannot be copied into itself"; }
    if (rc == CRAB_FS_EISDIR)   { return "refused: that is a folder"; }
    return "failed: the filesystem refused";
}

fn crab_ascend(path, buf, sizes, mtimes, pathscr, statbuf): i64 {
    var n = strlen(path);
    if (n <= 1) { return -1; }                       # already at "/"
    var last = 0;
    var j = 0;
    while (j < n) { if (load8(path + j) == 47) { last = j; } j = j + 1; }
    if (last == 0) { store8(path + 1, 0); } else { store8(path + last, 0); }
    var cnt = crab_readdir_into(path, buf);
    crab_stat_for_listing(path, buf, cnt, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, cnt, crab_sort_mode);
    return cnt;
}
