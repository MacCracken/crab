# crab — the APPLICATION LAYER: everything `main()` does that is not the event loop.
#
# ⛔⛔ THIS FILE EXISTS FOR ONE REASON: `src/main.cyr` ENDS IN `_entry();`, SO INCLUDING IT FROM A
# TEST WOULD RUN THE APP. Every function here used to live there, which meant **none of it was
# reachable from `tests/crab.tcyr`** — no assertion could touch the readdir parser, the stat layer,
# descend, ascend, or the premultiplied surface flag. `src/path.cyr` was carved out of the same file
# at 0.5.0 for the same reason, after a P1 memory-safety repair landed somewhere the suite could not
# see; this is that extraction finished rather than repeated.
#
# ⇒ `main.cyr` now holds `main()` and `_entry()` and nothing else. Anything added to crab that is not
# literally the event loop belongs HERE, where it can be asserted on.
#
# ⚠ THE RESIDUAL GAP IS IRREDUCIBLE AND IS NOT PRETENDED AWAY: `main()` itself still cannot be called
# from a suite that would then run the app. The mitigation is architectural rather than test-shaped —
# `crab_render` installs the frame arena and calls `dh_frame_begin()` itself (see `src/ui.cyr`), so
# the setup `main()` used to own and could have forgotten is no longer `main()`'s to forget.

include "src/ui.cyr"

fn crab_say(s): i64 { return syscall(SYS_WRITE, 1, s, strlen(s)); }

# ⛔ ONE cap for the readdir buffer AND the readdir call. It was the literal `32` in seven places —
# the call plus six allocations — so raising the cap without finding every allocation writes past
# the buffer, and raising an allocation without the call changes nothing. Keep them derived.
#
# ⚠ 32 was not enough for a REAL root. Iron 2026-08-19: `/` held **114** entries after a few burns
# (run outputs land there), so crab showed 32 and silently dropped 82 — a file the shell's `ls`
# listed was simply absent from the pane, which reads as a filesystem fault rather than a cap.
#
# ⭐ 256 -> 1024 (M3 *#02*, agnos 1.56.50). The design canvas shows **812 items** in a pane, so 256
# was below the number the design itself asks for. Records are 64 B, so 1024 entries is a 64 KB pane
# buffer — two panes plus their size/mtime arrays is ~160 KB, against a bump allocator that never
# frees, paid once at startup rather than per frame.
# ⛔ RAISING THE CAP DOES NOT MAKE THE CAP HONEST, WHICH IS THE ACTUAL DEFECT. A directory bigger
# than any cap still exists; what changed is that crab can now SAY how much it is not showing,
# because `#101 readdir_at` lets the walk continue past the buffer without storing.
enum CrabDir {
    CRAB_MAX_ENTRIES = 1024;
    # ⚠ Records per `readdir_at` call. Bounds the syscall's write to the pane buffer; it is not the
    # pane cap. 64 records = 4 KB, which is also the counting scratch below.
    CRAB_READDIR_BATCH = 64;
    # ⛔⛔ THE BACKSTOP ON A `#101` WALK, AND IT IS THE SECOND GUARD, NOT THE FIRST. The kernel's
    # I/O-error paths (`agnos/kernel/core/ext2.cyr`) `store64(cursor_uva, pos)` with `pos` UNCHANGED
    # and `return count` — which may be 0, and 0 is NOT negative. A persistent block-read failure
    # therefore satisfies `k >= 0` and `cur != -1` forever, and crab spins in a syscall loop with no
    # output at all: a hang, not a crash, and nothing in the suite can see it.
    # ⇒ The precise guard is the stall test at each call site — `k == 0` AND the cursor did not move.
    # This cap exists for the case that test cannot see: a cursor that advances while yielding
    # nothing. It is deliberately FAR above any legitimate walk (4096 calls x 64 records = 262,144
    # entries) so that reaching it is always a fault, never a big directory.
    CRAB_READDIR_STEPS_MAX = 4096;
    # ⭐⭐ THE HARDCODED `CRAB_SYS_READDIR_AT = 101` IS GONE (2026-08-30). It was an interim with a
    # stated expiry — "switch to `sys_readdir_at` and delete this constant the moment crab's pin
    # moves to >= 6.5.36" — and that condition is met: **cyrius 6.5.36 is released**, crab pins it,
    # and `lib/syscalls_x86_64_agnos.cyr` now vendors `sys_readdir_at(path, buf, max, cursor)`.
    # ⚠ crab was the FIRST consumer to exercise that wrapper. agnos's own `rdat.cyr` proves the
    # kernel contract but calls the raw number, so until this change nothing had ever called the
    # cyrius peer — it was asserted to compile, never to run. The next burn is what proves it.
    # ⛔ A consumer hard-coding a syscall number is the bug class agnos's roadmap tracks; do not
    # reintroduce one. If a needed wrapper is missing, file it upstream and pin the interim to an
    # explicit expiry, as this one was.
    # ⚠ M4's copy buffer. 4 KiB matches the readdir counting scratch and one ext2 block; it is a
    # throughput knob and nothing else, since every read is drained by a bounded write loop.
    CRAB_COPY_CHUNK = 4096;
}

# True number of entries the last listing's directory holds, which is NOT the number stored when the
# directory is bigger than the pane buffer. -1 when it was not determined.
var crab_dir_total = 0 - 1;

fn crab_listing_total(): i64 { return crab_dir_total; }

# ⭐ THE LAST LISTING'S KERNEL ERROR, 0 WHEN IT SUCCEEDED (M4). `crab_readdir_into` clamps its return
# to >= 0 — deliberately, because every caller uses it as a loop bound — so before this the reason a
# pane was empty could not survive the call. An empty directory and a vanished one were the same
# answer, and the pane drew the same blank for both.
# ⛔ READ IT NEXT TO THE LISTING THAT SET IT. It is overwritten by every readdir, and crab lists two
# panes, so a read deferred to render time reports the right pane's error for both. `main.cyr`
# captures it into the pane's own state immediately after each `crab_readdir_into`.
var crab_dir_err = 0;

fn crab_listing_err(): i64 { return crab_dir_err; }

# ⚠ `CRAB_REC_SZ` / `CRAB_REC_TYPE` / `CRAB_PATH_MAX` / `CRAB_NAME_MAX`, and the bounded path helpers
# `crab_strcpy_n` / `crab_join_n`, live in `src/path.cyr` (pulled in via `src/ui.cyr` above). They are
# there and not here for ONE reason: `tests/crab.tcyr` includes `ui.cyr`, never `main.cyr`, so
# anything defined in this file CANNOT BE TESTED. The 0.5.0 path-overflow fix is the reason that
# stopped being acceptable — a P1 memory-safety repair with no reachable test is a repair on trust.

# ⭐⭐ `AE-6` — crab's surface is PREMULTIPLIED, unconditionally.
#
# This is what routes crab through agnos `gpu_shader_op #92` op 0x01 — a real per-pixel
# `out = src + dst * (1 - src_a)` on the shader cores — instead of `#87`, a byte mover with no ALU that can
# only copy. The blend is the one operation CP-DMA structurally cannot do, and it had no client at all.
#
# ⭐ crab satisfies the op's precondition by construction: sadish's `sd_alpha_of()` maps a bare `sd_rgb`
# value's 0 byte to 255 and `draw.cyr` stores that, so every pixel crab produces is **alpha 255**. At
# a == 255 premultiplied and straight alpha are the same bytes, so the surface is trivially premultiplied
# and the blend collapses to `out = src + dst*0 = src`. `tests/crab.tcyr` asserts `a == 255 && c <= a` on
# every pixel of the production render, with negative controls, so the precondition is a gate and not a
# hope. [[feedback_audit_re_derive_dont_validate_comments]]
#
# ⚠ A boot whose GPU cannot run the shader is handled in the COMPOSITOR, per window: `ae_gpu_present_frame`
# falls back to `#87` for a premultiplied surface when the envelope is absent, which is exact at alpha 255.
# Nothing is conditional here, and there is no arm — the client states what its pixels ARE and the
# compositor decides how to draw them.
fn crab_surface_flags(): i64 {
    return SETU_SURF_PREMULTIPLIED | SETU_SURF_FULL_KEYS;
}

# ⭐⭐ `SETU_SURF_FULL_KEYS` (M2, *deferral #06*) — crab now asks for key RELEASES as well as presses.
# The compositor honours it per surface: `win_set_keymode(win, flags & SETU_SURF_FULL_KEYS)` at
# CREATE_SURFACE, and `setu_srv_forward_key` then sets `mods` to **1 = press / 0 = release**. A
# press-only surface (the default) receives presses only, with `mods` always 0.
#
# ⛔⛔ ASKING FOR IT WITHOUT GATING ON IT MAKES EVERY KEY ACT TWICE, AND THAT IS NOT A GUESS — the
# compositor carries the burn. aethersafha `src/main.cyr`: *"every key acted on BOTH edges. Measured
# on the 2026-08-18 burn: three F3 presses produced SIX `theme switched` lines, and the launcher moved
# its selection twice per keypress, which is what made choosing an app hard."* For crab that would be
# two rows per Down, and Enter descending twice — the second descend landing wherever the first left
# the selection.
#
# ⚠ THE GATE IS ONLY CORRECT BECAUSE THE FLAG IS REQUESTED, and the two must move together. On a
# press-only surface `mods` is 0 for a PRESS, so a client that asked for press-only and then gated on
# `mods == 1` would act on nothing at all. That coupling is why this predicate sits beside
# `crab_surface_flags` rather than in the event loop.
fn crab_key_acts(mods): i64 {
    if (mods == 1) { return 1; }
    return 0;
}

# ⭐⭐ HELD-KEY REPEAT (M2, *deferral #06* second half), AND IT NEEDED NO KERNEL CHANGE.
# ⛔ AN EARLIER NOTE HERE CLAIMED IT WAS BLOCKED ON agnos FOR WANT OF A BOUNDED WAIT. THAT WAS WRONG,
# and it was wrong because it read syscall SIGNATURES and stopped there: `#14 pause` takes no timeout
# argument, so it looked unbounded. Its kernel comment says otherwise in as many words — *"Do ONE SAFE
# (IF=1) hlt so a device IRQ (e.g. NIC RX) **or the 100 Hz timer** wakes it"* — and MEASURED on a real
# kernel, `sys_pause()` returns in **0-4 ms**. It is already a bounded wait; nothing needed adding.
# ⇒ Repeat is a clock check in the idle path, not a new primitive.
#
# ⚠ bhumi does not repeat FOR us and says so: *"forwarding a repeat as another press delivers a key
# the user never pressed again. Repeat is policy, not drain."* On agnos it diffs HID reports into
# edges, so a held key is exactly one press and one release. The policy is here.
enum CrabRepeat {
    CRAB_REPEAT_DELAY_MS = 400;      # hold this long before the first repeat
    CRAB_REPEAT_INTERVAL_MS = 60;    # then this often
}

# Does this key repeat while held? -> 1 yes, 0 no.
#
# ⛔ ONLY MOVEMENT REPEATS. Enter descends and Backspace ascends: repeating those walks the operator
# through the filesystem at 16 directories a second on one held key, and every step re-readdirs and
# re-stats. A pane switch (Left/Right) repeating is merely useless — it lands on the same pane. The
# keys where repeat is what the operator MEANT are the ones that move a selection one row at a time.
fn crab_key_repeats(usage): i64 {
    if (usage == 0x52) { return 1; }        # Up
    if (usage == 0x51) { return 1; }        # Down
    if (usage == 0x0E) { return 1; }        # k
    if (usage == 0x0D) { return 1; }        # j
    return 0;
}

# Is a repeat due? `held_ms` = how long the key has been down, `since_last` = since the last action.
# -> 1 fire, 0 wait.
#
# ⚠ THE DELAY EXISTS SO A DELIBERATE SINGLE PRESS IS NOT A BURST. Without it every tap moves several
# rows, which reads as the selection overshooting rather than as repeat working.
fn crab_repeat_due(held_ms, since_last): i64 {
    if (held_ms < CRAB_REPEAT_DELAY_MS) { return 0; }
    if (since_last < CRAB_REPEAT_INTERVAL_MS) { return 0; }
    return 1;
}

# ⭐⭐ RESIZE POLICY (M2). The compositor ASKS via `WINDOW_CONFIGURE`; deciding whether to adopt the
# ask is policy, and it lives here rather than in `main.cyr` for the reason this whole file exists —
# nothing in `main.cyr` is reachable from a test. The plumbing (resize the surface, swap the shm
# buffer, re-attach, re-commit) stays there because it is syscalls; the *decision* is here.
enum CrabWindow {
    CRAB_DIM_MAX = 4096;                 # per-axis sanity bound
    # ⛔⛔ THIS WAS 16 MB ("the framebuffer's own size") AND THAT NUMBER WAS INVENTED, NOT DERIVED.
    # QEMU found it: on a maximize the compositor asked for a full-screen surface, crab's policy said
    # yes, and `setu_buf_create` then failed — because the kernel's shm caps are
    #   `SHM_MAX_SIZE     = 2,097,152`  (2 MB)  — syscall `#71`, pmm-backed: ONE 2 MB page per buffer
    #   `SHM_GPU_MAX_SIZE = 33,554,432` (32 MB) — syscall `#86`, one slot of the GPU carveout
    # `setu_buf_create` asks `#86` first and falls back to `#71`, so **which cap applies depends on
    # whether the machine has a GPU carveout — and under QEMU it does not.** A client cannot query
    # which backing it got.
    # ⇒ THE CAP HERE IS THE ABSURDITY BOUND, NOT THE ANSWER. It is the highest any backing could ever
    # provide; the real arbiter is whether `setu_buf_create` succeeds, and `main.cyr` now survives a
    # refusal instead of guessing. Guessing was the bug.
    CRAB_SURFACE_BYTES_MAX = 33554432;   # agnos SHM_GPU_MAX_SIZE — the ceiling of any backing
}

# Byte size of a `w` x `h` BGRA surface, or **-1** when the extent is not one we will honour.
#
# ⛔ THE CAPS ARE NOT DEFENSIVE PADDING, THEY ARE WHAT MAKES OVERFLOW UNREACHABLE. `w * h * 4` on
# attacker-or-compositor-supplied dimensions is a multiplication crab then uses to size a shm slot
# and to bound a `setu_buf_write`. Bounding each axis at 4096 caps the product at 67 MB — far inside
# i64 — so there is no wrap to reason about, and the byte cap then bounds the slot itself.
# ⚠ A `#86` GPU-visible slot is a scarce, system-wide resource: there are **16**. Honouring an absurd
# ask would spend one on a surface nothing can composite.
fn crab_surface_bytes(w, h): i64 {
    if (w <= 0) { return 0 - 1; }
    if (h <= 0) { return 0 - 1; }
    if (w > CRAB_DIM_MAX) { return 0 - 1; }
    if (h > CRAB_DIM_MAX) { return 0 - 1; }
    var n = w * h * 4;
    if (n > CRAB_SURFACE_BYTES_MAX) { return 0 - 1; }
    return n;
}

# ⭐⭐ POINTER POLICY (M2, *deferral #05*). Like the resize policy above, the DECISION lives here so a
# test can reach it; the geometry is in `src/ui.cyr` and the syscall plumbing in `src/main.cyr`.
#
# ⛔⛔ AND crab OWNS ITS INTERACTION STATE — IT DOES NOT USE `dh_dispatch`. Operator ruling
# 2026-08-27, and the reason is structural: `dh_dispatch` tracks a press by storing a **widget
# pointer** (`_dh_press`), and crab rebuilds its whole tree every frame with `dh_frame_begin()`
# rewinding the arena and clearing exactly those pointers. A press and its release are separated by a
# rebuild, so the press target no longer exists. dhancha 0.9.15 says it outright — *cross-frame widget
# identity and a per-frame arena are mutually exclusive by construction* — and press/release tracking
# IS cross-frame widget identity. ⇒ crab tracks **pane index + row index**, which survive a rebuild
# because they are its own model rather than the toolkit's. The toolkit supplies geometry only.
enum CrabPointer {
    CRAB_DOUBLECLICK_MS = 400;
    CRAB_SCROLL_ROWS = 3;         # rows the selection moves per wheel detent
}

# Where the selection lands after a wheel delta, clamped to [0, count-1]. -> the new index.
#
# ⛔⛔ THE WHEEL MOVES THE SELECTION, NOT THE VIEW, AND THAT IS A DESIGN CHOICE WITH A REASON.
# `crab_render` restores each pane's scroll offset and then calls `dh_list_scroll_to_sel`, which
# enforces "the selection is visible" — so a free-scrolled view would be snapped back on the very next
# frame by the machinery that makes keyboard navigation work. Decoupling them means revisiting the
# scroll round-trip, which is load-bearing and heavily documented (`src/ui.cyr`).
# ⇒ Moving the selection makes the view follow for free and fights nothing. ⚠ It is NOT what every
# file manager does — a detached view-scroll is the other reasonable answer, and it is a separate
# change rather than a tweak.
# ⚠ SIGN: positive delta is wheel-UP (away from the user), which moves toward index 0.
fn crab_scroll_sel(sel, count, delta): i64 {
    if (count <= 0) { return 0; }
    var n = sel - delta * CRAB_SCROLL_ROWS;
    if (n < 0) { n = 0; }
    if (n > count - 1) { n = count - 1; }
    return n;
}

# Is this click the second half of a double-click? -> 1 double, 0 single.
#
# ⚠ SAME ROW, SAME PANE, AND INSIDE THE WINDOW. Two clicks on different rows are two selections, not
# an activation — treating them as a double would descend into whichever row happened to be second.
# ⛔ A NEGATIVE INTERVAL IS NEVER A DOUBLE-CLICK. `clock_now_ms` is monotonic on agnos (bound to
# uptime, `#40`), so `dt < 0` should be impossible — which is exactly why it must not be *assumed*.
# If the clock ever moves backwards, guessing "double" would descend into a directory the operator
# only clicked once, and a wrong descend is indistinguishable from a misclick after the fact.
fn crab_is_double(prev_pane, prev_row, prev_ms, pane, row, ms): i64 {
    if (prev_row < 0) { return 0; }              # no previous click to pair with
    if (row < 0) { return 0; }
    if (prev_pane != pane) { return 0; }
    if (prev_row != row) { return 0; }
    var dt = ms - prev_ms;
    if (dt < 0) { return 0; }
    if (dt > CRAB_DOUBLECLICK_MS) { return 0; }
    return 1;
}

# Log a resize outcome with its extent. ⚠ "resized" on its own proves an event arrived, not that the
# surface actually grew — and the two look identical in a serial log, which is how a harness scores a
# pass for a test it never performed. The NUMBERS are the oracle.
fn crab_log_extent(tag, w, h): i64 {
    var d = alloc(24);
    crab_say(tag);
    crab_u2s(d, w); crab_say(d); crab_say("x");
    crab_u2s(d, h); crab_say(d); crab_say("\n");
    return 0;
}

# Should a `WINDOW_CONFIGURE` ask be adopted? -> 1 adopt, 0 ignore.
#
# ⛔ A DEGENERATE ASK IS REFUSED, NOT CLAMPED. The compositor asking is not the same as the ask being
# usable, and a 0-wide pane is not a smaller pane — it is a divide-by-zero waiting in the layout.
# ⚠ AND AN ASK FOR THE SIZE WE ALREADY HAVE IS IGNORED. A compositor is free to re-send CONFIGURE
# with the current extent; adopting it would close and re-create a scarce `#86` shm slot, throw away
# the cached render target, and re-ATTACH — every time, for no change on screen.
fn crab_resize_wanted(cur_w, cur_h, ask_w, ask_h): i64 {
    if (crab_surface_bytes(ask_w, ask_h) < 0) { return 0; }
    if (ask_w == cur_w) {
        if (ask_h == cur_h) { return 0; }
    }
    return 1;
}

# ============================================================================================
# ⭐⭐ SORTING (M3, *deferral #33*) — the pane rendered raw readdir order, which is ON-DISK order
# ============================================================================================
# A directory listing in creation-or-wherever-ext2-put-it order is not a browser. This is the
# comparison and the sort; `src/main.cyr` calls it after every listing.
#
# ⛔ DIRECTORIES FIRST, UNCONDITIONALLY, and it is a separate axis from the sort key rather than a
# mode of it. Every file manager does this and the reason is navigational: directories are where you
# GO, files are what you act on, and interleaving them by name means hunting for the one folder in a
# hundred files. Making it optional would be a setting nobody turns off.
#
# ⛔⛔ DOTFILES ARE **NOT** HIDDEN, DELIBERATELY. Hiding them is the other half of what a file manager
# usually does — and it is only safe when there is a way to reveal them. crab has no "show hidden"
# affordance and no settings surface to put one on, so hiding would make files that exist
# unreachable and unmentioned, with the operator given no reason to suspect it. ⚠ A file manager that
# silently omits files is worse than one that shows too many. They sort naturally: `.` is 0x2E, ahead
# of every letter, so they cluster at the top of their group.
# ⚠ MODULE STATE, not a parameter threaded through every listing. `crab_descend` / `crab_ascend`
# already take nine arguments each and are called from four places; adding a tenth for a value that
# is global to the session buys nothing. It is read by the sort and written by one key.
var crab_sort_mode = 0;                          # CRAB_SORT_NAME

# Advance to the next sort mode, wrapping. -> the new mode.
fn crab_sort_cycle(): i64 {
    crab_sort_mode = crab_sort_mode + 1;
    if (crab_sort_mode >= CrabSort.CRAB_SORT_MODES) { crab_sort_mode = 0; }
    return crab_sort_mode;
}

fn crab_sort_mode_get(): i64 { return crab_sort_mode; }

# The mode's name, for the serial log — a number alone cannot be checked by a harness reading a log.
fn crab_sort_name(mode): i64 {
    if (mode == CrabSort.CRAB_SORT_SIZE) { return "size"; }
    if (mode == CrabSort.CRAB_SORT_MTIME) { return "modified"; }
    if (mode == CrabSort.CRAB_SORT_KIND) { return "kind"; }
    return "name";
}

enum CrabSort {
    CRAB_SORT_NAME  = 0;     # A-Z, case-insensitive
    CRAB_SORT_SIZE  = 1;     # largest first
    CRAB_SORT_MTIME = 2;     # newest first
    CRAB_SORT_KIND  = 3;     # by extension, then name
    CRAB_SORT_MODES = 4;     # how many there are — the cycle wraps on this
}

# Fold one ASCII byte to lower case. Bytes outside A-Z pass through, so this is safe on UTF-8
# continuation bytes (all >= 0x80) rather than corrupting them.
fn crab_lower(c): i64 {
    if (c >= 65) {
        if (c <= 90) { return c + 32; }
    }
    return c;
}

# Compare two NUL-terminated names. -> <0, 0, >0.
#
# ⚠ CASE-INSENSITIVE FIRST, THEN CASE-SENSITIVE AS A TIEBREAK. `README.md` sorting a hundred rows
# from `readme.md` is the thing byte-order gets wrong and operators notice immediately. The
# second pass exists so the order is TOTAL: without it `a` and `A` compare equal, and a stable sort
# would then leave them in readdir order — which is on-disk order, i.e. the thing this replaces.
fn crab_name_cmp(a, b): i64 {
    var i = 0;
    var ca = crab_lower(load8(a));
    var cb = crab_lower(load8(b));
    while (ca == cb) {
        if (ca == 0) { i = 0 - 1; }              # both names ended: equal when case-folded
        if (i < 0) { ca = 0; cb = 0; break; }
        i = i + 1;
        ca = crab_lower(load8(a + i));
        cb = crab_lower(load8(b + i));
    }
    if (ca != cb) { return ca - cb; }
    # Case-folded equal — fall back to RAW bytes so the order is total. Without this `a` and `A` tie,
    # and a stable sort then leaves them in readdir order, i.e. on-disk order — the thing this file
    # exists to replace.
    var j = 0;
    var ra = load8(a);
    var rb = load8(b);
    while (ra == rb) {
        if (ra == 0) { return 0; }
        j = j + 1;
        ra = load8(a + j);
        rb = load8(b + j);
    }
    return ra - rb;
}

# The extension of a name: the offset just past the LAST '.', or the name length when there is none.
# ⚠ A LEADING dot is not an extension. `.bashrc` is a dotfile named `bashrc`, not a file of type
# `bashrc` — starting the scan at 1 is what keeps every dotfile from sorting into its own "kind".
fn crab_ext_at(name): i64 {
    var n = 0;
    while (load8(name + n) != 0) { n = n + 1; }
    var dot = n;
    var i = 1;
    while (i < n) {
        if (load8(name + i) == 46) { dot = i + 1; }
        i = i + 1;
    }
    return dot;
}

# Compare entries `i` and `j`. -> <0 if i sorts first, >0 if j does, 0 if genuinely tied.
fn crab_entry_cmp(buf, sizes, mtimes, i, j, mode): i64 {
    var ri = buf + i * CRAB_REC_SZ;
    var rj = buf + j * CRAB_REC_SZ;
    # ⛔ THE DIRECTORY AXIS RUNS FIRST AND OUTRANKS THE KEY. Sorting by size with directories mixed in
    # is meaningless anyway — a directory's size is the entry itself, not its contents.
    var di = 0; if (load8(ri + CRAB_REC_TYPE) == 1) { di = 1; }
    var dj = 0; if (load8(rj + CRAB_REC_TYPE) == 1) { dj = 1; }
    if (di != dj) { return dj - di; }              # 1 (dir) sorts before 0 (file)

    if (mode == CRAB_SORT_SIZE) {
        var si = load64(sizes + i * 8);
        var sj = load64(sizes + j * 8);
        # ⚠ THE -1 GUARD IS UNEXERCISED UNDER THE CURRENT ORDER, AND SAYING SO BEATS THE CONFIDENT
        # CLAIM THAT WAS HERE. The first draft asserted it stopped unstattable entries leading a
        # largest-first list. That is FALSE: -1 is the smallest value, so largest-first already sinks
        # them. Mutation proved it — deleting these two lines fails nothing.
        # ⇒ Kept, because the moment a smallest-first or oldest-first order exists (column headers,
        # M3 *#32*) -1 leads the list and reads as a sorting bug. Explicit intent for the cost of two
        # comparisons, labelled as defence rather than sold as a fix.
        if (si < 0) { if (sj >= 0) { return 1; } }
        if (sj < 0) { if (si >= 0) { return 0 - 1; } }
        if (si != sj) {
            if (si > sj) { return 0 - 1; }         # largest first
            return 1;
        }
    }
    if (mode == CRAB_SORT_MTIME) {
        var mi = load64(mtimes + i * 8);
        var mj = load64(mtimes + j * 8);
        if (mi < 0) { if (mj >= 0) { return 1; } }
        if (mj < 0) { if (mi >= 0) { return 0 - 1; } }
        if (mi != mj) {
            if (mi > mj) { return 0 - 1; }         # newest first
            return 1;
        }
    }
    if (mode == CRAB_SORT_KIND) {
        var ei = crab_ext_at(ri);
        var ej = crab_ext_at(rj);
        var ce = crab_name_cmp(ri + ei, rj + ej);
        if (ce != 0) { return ce; }
    }
    # NAME is the default and every other mode's tiebreak, so a tie is never left to readdir order.
    return crab_name_cmp(ri, rj);
}

# ⭐⭐ THE SORT'S SCRATCH, ALLOCATED ONCE FOR THE PROCESS. Two index arrays and one record.
#
# ⛔ `alloc` IS A BUMP ALLOCATOR WITH NO `free()`, AND THIS USED TO BE PER CALL. The insertion sort
# below took its 64-byte swap slot with a bare `alloc(CRAB_REC_SZ)` inside the function — and the
# function runs once per listing, i.e. on every descend and every ascend. That is 64 bytes leaked
# per keypress, forever, in the allocator whose per-frame cost four releases were spent driving to
# zero. Hoisting it here is not a micro-optimisation; it is the same rule the frame arena obeys.
# ⚠ 16 KB + 64 B, once, against the ~597 KB crab already pays at startup for the render target and
# the arena. A fixed cost instead of a per-keypress one, which is the whole pattern in this app.
var crab_sidx = 0;
var crab_stmp = 0;
var crab_srec = 0;

# -> the index scratch, or 0 if it could not be allocated (the caller then takes the slow path).
fn crab_sort_scratch(): i64 {
    if (crab_sidx == 0) {
        crab_sidx = alloc(CRAB_MAX_ENTRIES * 8);
        crab_stmp = alloc(CRAB_MAX_ENTRIES * 8);
        crab_srec = alloc(CRAB_REC_SZ);
        if (crab_stmp == 0) { crab_sidx = 0; }
        if (crab_srec == 0) { crab_sidx = 0; }
    }
    return crab_sidx;
}

# Sort `count` entries in place by insertion — STABLE, O(n^2), and now the FALLBACK rather than the
# path. Kept, not deleted, for two reasons: it is what runs if the scratch above cannot be had, so
# the sort can never silently fail to sort; and it is the differential oracle the merge sort is
# tested against in `tests/crab.tcyr`, which is a stronger check than asserting either alone.
fn crab_sort_insertion(buf, sizes, mtimes, count, mode): i64 {
    if (count < 2) { return 0; }
    var scratch = crab_srec;
    if (scratch == 0) { scratch = alloc(CRAB_REC_SZ); }
    var i = 1;
    while (i < count) {
        var j = i;
        while (j > 0) {
            if (crab_entry_cmp(buf, sizes, mtimes, j - 1, j, mode) <= 0) { j = 0; }
            else {
                var a = buf + (j - 1) * CRAB_REC_SZ;
                var b = buf + j * CRAB_REC_SZ;
                var k = 0;
                while (k < CRAB_REC_SZ) { store8(scratch + k, load8(a + k)); k = k + 1; }
                k = 0;
                while (k < CRAB_REC_SZ) { store8(a + k, load8(b + k)); k = k + 1; }
                k = 0;
                while (k < CRAB_REC_SZ) { store8(b + k, load8(scratch + k)); k = k + 1; }
                var ts = load64(sizes + (j - 1) * 8);
                store64(sizes + (j - 1) * 8, load64(sizes + j * 8));
                store64(sizes + j * 8, ts);
                var tm = load64(mtimes + (j - 1) * 8);
                store64(mtimes + (j - 1) * 8, load64(mtimes + j * 8));
                store64(mtimes + j * 8, tm);
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Sort `count` entries in place, permuting the record, its size and its mtime together.
#
# ⛔ ALL THREE ARRAYS MOVE TOGETHER OR NONE DO. `sizes[i]` and `mtimes[i]` are parallel to record `i`;
# permuting the records alone would leave every row showing another file's size and date — and the
# status line reads the same index, so it would agree with the wrong answer confidently.
#
# ⛔⛔ THIS RUNS ON THE KEYSTROKE PATH, WHICH IS WHY IT IS NO LONGER O(n^2). It is called once per
# listing — so on every descend, every ascend, and twice more when `s` cycles the sort mode. The
# insertion sort above was justified by a comment reading "`CRAB_MAX_ENTRIES` is 256"; M3 *#02*
# raised the cap to 1024 and never re-derived it. Measured native x86_64, and agnos under QEMU is
# far slower:
#
#   | n    | random | reverse-sorted |
#   |------|--------|----------------|
#   | 256  |   6 ms |          14 ms |
#   | 1024 | 100 ms |         200 ms |
#
# M3 *#03* existed to remove ~280 ms from exactly this path by deferring the stat sweep; putting
# 200 ms back into it undoes that work in the place the operator feels it.
#
# ⭐ BOTTOM-UP MERGE SORT OVER AN INDEX ARRAY, THEN ONE PERMUTATION PASS. Two things make it fast,
# and the second matters more than the first at this record size:
#   - O(n log n) comparisons rather than O(n^2)  — 10,240 vs ~524,288 at the cap
#   - **n record moves rather than O(n^2) swaps**. The old inner loop moved 64 bytes ONE BYTE AT A
#     TIME, three times per swap. Sorting indices means the 64-byte payload is touched once per
#     entry, by the cycle-following pass at the end, and never during the sort itself.
#
# ⚠ STABILITY IS PRESERVED AND IS LOAD-BEARING. `crab_entry_cmp` returns 0 only for entries
# identical on every axis including raw name bytes, but NAME is every other mode's tiebreak, so a
# stable sort is what keeps a re-sort from reshuffling equal rows under the selection. The merge
# takes from the LEFT run on `<= 0`, which is the stability condition.
# ⚠ Comparisons all happen BEFORE the permutation, so `crab_entry_cmp`'s indices refer to the
# original arrays throughout the merge — which is the only reason indirect sorting is valid here.
fn crab_sort_entries(buf, sizes, mtimes, count, mode): i64 {
    if (count < 2) { return 0; }
    var idx = crab_sort_scratch();
    if (idx == 0) { return crab_sort_insertion(buf, sizes, mtimes, count, mode); }
    var tmp = crab_stmp;
    var rec = crab_srec;

    var i = 0;
    while (i < count) { store64(idx + i * 8, i); i = i + 1; }

    # --- merge runs of `width` until one run covers everything -------------------------------------
    var width = 1;
    while (width < count) {
        var lo = 0;
        while (lo < count) {
            var mid = lo + width;
            var hi = lo + width + width;
            if (mid > count) { mid = count; }
            if (hi > count) { hi = count; }
            var a = lo;
            var b = mid;
            var o = lo;
            while (o < hi) {
                var takea = 0;
                if (a >= mid) { takea = 0; }                 # left run spent — the rest is right
                else {
                    if (b >= hi) { takea = 1; }              # right run spent — the rest is left
                    else {
                        # ⚠ `<= 0`, not `< 0`. This single character is the stability of the sort.
                        if (crab_entry_cmp(buf, sizes, mtimes,
                            load64(idx + a * 8), load64(idx + b * 8), mode) <= 0) { takea = 1; }
                    }
                }
                if (takea != 0) { store64(tmp + o * 8, load64(idx + a * 8)); a = a + 1; }
                else { store64(tmp + o * 8, load64(idx + b * 8)); b = b + 1; }
                o = o + 1;
            }
            lo = lo + width + width;
        }
        i = 0;
        while (i < count) { store64(idx + i * 8, load64(tmp + i * 8)); i = i + 1; }
        width = width + width;
    }

    # --- apply the permutation: sorted[k] = original[idx[k]] ---------------------------------------
    # ⭐ CYCLE-FOLLOWING, so every record is written AT MOST ONCE. Walking `idx` and swapping instead
    # would move the same record repeatedly; following each cycle lifts one record out, shifts the
    # rest of its cycle down, and drops the saved one into the hole. `idx[k] = k` marks a slot done,
    # so no separate visited set is needed and the pass is O(n) with no extra memory.
    i = 0;
    while (i < count) {
        if (load64(idx + i * 8) != i) {
            var s = 0;
            while (s < CRAB_REC_SZ) { store8(rec + s, load8(buf + i * CRAB_REC_SZ + s)); s = s + 1; }
            var hs = load64(sizes + i * 8);
            var hm = load64(mtimes + i * 8);
            var slot = i;
            var nxt = load64(idx + slot * 8);
            while (nxt != i) {
                s = 0;
                while (s < CRAB_REC_SZ) {
                    store8(buf + slot * CRAB_REC_SZ + s, load8(buf + nxt * CRAB_REC_SZ + s));
                    s = s + 1;
                }
                store64(sizes + slot * 8, load64(sizes + nxt * 8));
                store64(mtimes + slot * 8, load64(mtimes + nxt * 8));
                store64(idx + slot * 8, slot);
                slot = nxt;
                nxt = load64(idx + slot * 8);
            }
            s = 0;
            while (s < CRAB_REC_SZ) { store8(buf + slot * CRAB_REC_SZ + s, load8(rec + s)); s = s + 1; }
            store64(sizes + slot * 8, hs);
            store64(mtimes + slot * 8, hm);
            store64(idx + slot * 8, slot);
        }
        i = i + 1;
    }
    return 0;
}

# =================================================================================================
# M4 — FILE OPERATIONS. The write layer: the first thing in crab that CHANGES the disk.
# =================================================================================================
#
# ⭐⭐ THE ROADMAP SAID "Gate: agnos write syscalls" AND THAT GATE DOES NOT EXIST. Every arm is real
# and mount-routed, and has been since agnos 1.41.3 — `open`#7 (`syscall.cyr:8496`), `mkdir`#9
# (`:8547`), `rmdir`#10 (`:8565`), `unlink`#30 (`:8849`), `rename`#31 (`:8879`) — and crab's ALREADY
# PINNED cyrius 6.5.35 vendors a wrapper for every one of them. No pin move was required.
# ⛔ THE TRAP THAT MAKES ANYONE RE-CHECKING THIS REACH THE WRONG ANSWER: agnos's own userland-ABI
# TABLE still describes mkdir and rmdir as "🔧 stub -> 0" and open as "initrd_open ONLY". The table
# is stale; the dispatcher is not. VERIFY AGAINST THE DISPATCHER, NEVER THE TABLE.
#
# ⛔⛔ THE TWO TARGETS DISAGREE ON EVERY SIGNATURE, AND THAT IS WHY THIS SHIM EXISTS. agnos takes an
# explicit length on every path (`sys_mkdir(path, pathlen)`); Linux takes a NUL-terminated path and
# a MODE in the same argument position (`sys_mkdir(path, mode)`). They are the same arity with
# different meanings, so a call written for one compiles clean against the other and does something
# else entirely — passing 0755 where a length belongs, or a length where permissions belong. Nothing
# in the type system catches it. ⇒ ONE shim per operation, and no other code in crab calls `sys_*`.
#
# ⭐ AND THE HOST ARM IS REAL, WHICH IS THE POINT. Unlike `#101` readdir — agnos-only, so the suite
# can never execute it — these ARE Linux syscalls on the host, so `tests/crab.tcyr` operates on a
# real temporary directory and asserts on real files. The refusal logic, the join, the overwrite
# guard and the copy loop are all exercised for real; only the agnos ABI arm is taken on trust.

fn crab_fs_mkdir_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_mkdir(path, plen);
    #else
    return sys_mkdir(path, 0x1ED);                       # 0755
    #endif
}

fn crab_fs_rmdir_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rmdir(path, plen);
    #else
    return sys_rmdir(path);
    #endif
}

fn crab_fs_unlink_raw(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path, plen);
    #else
    return sys_unlink(path);
    #endif
}

fn crab_fs_rename_raw(op, olen, np, nlen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rename(op, olen, np, nlen);
    #else
    return sys_rename(op, np);
    #endif
}

# Open for reading. -> fd, or negative.
fn crab_fs_open_r(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(path, plen, AO_RDONLY);
    #else
    return sys_open(path, O_RDONLY, 0);
    #endif
}

# Create-and-open for writing. -> fd, or negative.
#
# ⛔⛔ THERE IS NO `AO_EXCL` ON agnos, SO THE KERNEL CANNOT REFUSE AN OVERWRITE FOR US. Linux has
# `O_EXCL` and agnos's flag set stops at CREAT/TRUNC/APPEND/DIRECTORY — there is no exclusive-create
# bit to pass. A copy that relied on the open failing would therefore silently TRUNCATE the
# destination on agnos and correctly refuse on the host: the same code, opposite outcomes, and the
# dangerous one is the target that ships.
# ⇒ Every caller MUST establish absence with `crab_fs_exists` first. That check is the guard, not
# this flag word.
# ⚠ AND IT IS A TOCTOU WINDOW crab CANNOT CLOSE. Between the stat and this open, another process
# may create the file. crab is a single-user desktop file manager and the race needs a second
# writer to the same path in the same instant; it is disclosed rather than pretended away, and it
# closes for free the day agnos grows an exclusive-create flag.
fn crab_fs_open_w(path, plen): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_open(path, plen, AO_WRONLY | AO_CREAT | AO_TRUNC);
    #else
    return sys_open(path, O_WRONLY | O_CREAT | O_EXCL, 0x1A4);   # 0644
    #endif
}

# Does `path` resolve? 1 = yes, 0 = no.
#
# ⚠ THE ONLY QUESTION ASKED IS EXISTENCE, and `stat` is the only primitive both targets have for it.
# ⛔ IT FOLLOWS SYMLINKS, AND ON THIS KERNEL IT MUST. agnos `lstat`#102 was minted off the very burn
# that motivated this work, but its cyrius peer is still OPEN — there is no `sys_lstat` to call. So
# a dangling symlink (the burn's `/sl_s`) reports as ABSENT here, and a copy onto it would replace
# the link. That is the honest limit of what crab can currently ask, and it is why the destination
# guard is stated as "resolves" rather than "is free".
fn crab_fs_exists(path, plen, statbuf): i64 {
    var rc = 0 - 1;
    #ifdef CYRIUS_TARGET_AGNOS
    rc = sys_stat(path, plen, statbuf);
    #else
    rc = sys_stat(path, statbuf);
    #endif
    if (rc < 0) { return 0; }
    return 1;
}

# ⚠ Named results, because a bare -1 from six operations cannot be told apart at the call site and
# the status line has to say WHICH refusal happened.
enum CrabFs {
    CRAB_FS_OK       = 0;
    CRAB_FS_EBADNAME = -10;    # empty, ".", "..", contains '/', or unterminated
    CRAB_FS_ETOOLONG = -11;    # the joined path would not fit CRAB_PATH_MAX
    CRAB_FS_EEXIST   = -12;    # the destination resolves — crab never overwrites silently
    CRAB_FS_ESAME    = -13;    # source and destination are the same path
    CRAB_FS_ESYS     = -14;    # the kernel refused
    CRAB_FS_EIO      = -15;    # a copy failed part-way through
}

# @public — may crab act on this entry name? 1 = yes, 0 = refuse.
#
# ⛔⛔ THIS IS THE GUARD BETWEEN A KEYPRESS AND `unlink`, AND IT IS DELIBERATELY PARANOID ABOUT DATA
# crab DID NOT CREATE. `name` is a kernel readdir record. The refusals, and why each is here:
#   - EMPTY: joins to the parent directory itself, so "delete the selected entry" becomes "delete
#     the directory you are standing in".
#   - "." : the same thing, spelled differently.
#   - ".." : resolves to the PARENT. A delete would be one keystroke from removing the tree above
#     the pane, and a rename would move it.
#   - ANY '/' : an entry name cannot contain one — the record layout forbids it — so a slash means
#     the record is malformed or crafted. Accepting it turns `crab_join_n`'s single join into a
#     multi-segment path and lets a name escape its own directory.
#   - UNTERMINATED: no NUL within `CRAB_NAME_MAX`, so no length can be taken safely.
# ⚠ Dotfiles are NOT refused, and must not be. `.bashrc` is an ordinary file and crab shows it
# (dotfiles are deliberately never hidden); only the two navigation entries are special.
fn crab_name_ok(name): i64 {
    if (name == 0) { return 0; }
    var n = crab_cstr_len(name, CRAB_NAME_MAX);
    if (n <= 0) { return 0; }                            # -1 unterminated, 0 empty
    if (load8(name) == 46) {                             # '.'
        if (n == 1) { return 0; }                        # "."
        if (n == 2) { if (load8(name + 1) == 46) { return 0; } }   # ".."
    }
    var i = 0;
    while (i < n) {
        if (load8(name + i) == 47) { return 0; }         # '/' can never be inside an entry name
        i = i + 1;
    }
    return 1;
}

# Join `dir` + "/" + `name` into `dst` (cap CRAB_PATH_MAX), validating the name first.
# -> the joined length, or a CRAB_FS_* error.
fn crab_fs_path(dst, dir, name): i64 {
    if (crab_name_ok(name) == 0) { return CRAB_FS_EBADNAME; }
    if (crab_join_n(dst, CRAB_PATH_MAX, dir, name) < 0) { return CRAB_FS_ETOOLONG; }
    var l = crab_cstr_len(dst, CRAB_PATH_MAX);
    if (l < 0) { return CRAB_FS_ETOOLONG; }
    return l;
}

# @public — create directory `name` inside `dir`. -> CRAB_FS_OK or a CRAB_FS_* error.
fn crab_fs_mkdir(dir, name, pathscr, statbuf): i64 {
    var l = crab_fs_path(pathscr, dir, name);
    if (l < 0) { return l; }
    # ⛔ REFUSE A NAME ALREADY IN USE RATHER THAN LETTING THE KERNEL DECIDE. agnos's mkdir returns a
    # bare negative for every reason, so "it already exists" and "the disk is full" are one answer;
    # asking first is what lets the status line say which.
    if (crab_fs_exists(pathscr, l, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_mkdir_raw(pathscr, l) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# @public — delete entry `name` from `dir`. `is_dir` selects rmdir over unlink.
#
# ⛔⛔ THIS DOES NOT RECURSE, AND THAT IS A DECISION RATHER THAN A GAP. `rmdir` refuses a non-empty
# directory and crab reports that refusal; it does NOT walk the tree deleting as it goes. A
# recursive delete behind a single keypress is the one operation in a file manager that cannot be
# undone and cannot be interrupted, and crab has neither a progress surface to show it (the transfer
# tray is M4's gated item) nor a trash to make it reversible. ⇒ When crab can show what it is doing
# and stop, it can do this. Not before.
fn crab_fs_delete(dir, name, is_dir, pathscr): i64 {
    var l = crab_fs_path(pathscr, dir, name);
    if (l < 0) { return l; }
    var rc = 0;
    if (is_dir != 0) { rc = crab_fs_rmdir_raw(pathscr, l); }
    else { rc = crab_fs_unlink_raw(pathscr, l); }
    if (rc < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# @public — rename `oldname` to `newname`, both inside `dir`. Two scratch buffers, each CRAB_PATH_MAX.
#
# ⚠ BOTH NAMES ARE VALIDATED, not just the source. `newname` reaches this from a text field rather
# than from a readdir record, so it is the LESS trustworthy of the two — a typed "../x" is exactly
# the escape `crab_name_ok`'s slash refusal exists for.
fn crab_fs_rename(dir, oldname, newname, scr1, scr2, statbuf): i64 {
    var lo = crab_fs_path(scr1, dir, oldname);
    if (lo < 0) { return lo; }
    var ln2 = crab_fs_path(scr2, dir, newname);
    if (ln2 < 0) { return ln2; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ln2, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_rename_raw(scr1, lo, scr2, ln2) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# ⚠ ONE COPY BUFFER FOR THE PROCESS, allocated on first use — the same rule the sort scratch and the
# frame arena follow. `alloc` never frees, so a per-copy buffer would leak 4 KB per file copied.
var crab_cpbuf = 0;

fn crab_copy_buf(): i64 {
    if (crab_cpbuf == 0) { crab_cpbuf = alloc(CRAB_COPY_CHUNK); }
    return crab_cpbuf;
}

# @public — copy file `name` from `srcdir` into `dstdir`, keeping its name.
#
# ⛔ FILES ONLY. A directory reaching here would be opened and read as a byte stream, which on ext2
# yields raw dirent bytes — a "copy" that produces a corrupt file rather than a folder. The caller
# checks the record's type byte; this is the second line of that defence.
# ⛔ THE DESTINATION IS CHECKED BEFORE THE SOURCE IS OPENED, so a refused copy has not touched
# anything. See `crab_fs_open_w` for why the check and not the flag is what protects it.
# ⚠ A PART-WAY FAILURE LEAVES A PARTIAL FILE, AND IT IS REPORTED AS `CRAB_FS_EIO` RATHER THAN
# CLEANED UP. Unlinking a half-written destination is the right instinct and the wrong action here:
# the write failed, so the reason is very likely that the filesystem is unhappy, and issuing another
# write-path syscall into that is how a bad situation becomes a worse one. crab says so and leaves
# the evidence in place.
fn crab_fs_copy(srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = crab_fs_path(scr2, dstdir, name);
    if (ld < 0) { return ld; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
    var buf = crab_copy_buf();
    if (buf == 0) { return CRAB_FS_EIO; }
    var fin = crab_fs_open_r(scr1, ls);
    if (fin < 0) { return CRAB_FS_ESYS; }
    var fout = crab_fs_open_w(scr2, ld);
    if (fout < 0) { sys_close(fin); return CRAB_FS_ESYS; }
    var rc = CRAB_FS_OK;
    var going = 1;
    while (going == 1) {
        var got = sys_read(fin, buf, CRAB_COPY_CHUNK);
        if (got < 0) { rc = CRAB_FS_EIO; going = 0; }
        if (got == 0) { going = 0; }                     # EOF — the only clean way out
        if (got > 0) {
            # ⛔ A SHORT WRITE IS NOT AN ERROR, IT IS THE CONTRACT. `write` may take fewer bytes than
            # offered, so a single call whose result is only tested for negativity silently drops
            # the tail — and the copy reports success with a truncated file, which is the worst
            # failure this function has.
            var off = 0;
            while (off < got) {
                var put = sys_write(fout, buf + off, got - off);
                if (put <= 0) { rc = CRAB_FS_EIO; off = got; going = 0; }
                else { off = off + put; }
            }
        }
    }
    sys_close(fout);
    sys_close(fin);
    return rc;
}

# @public — move file `name` from `srcdir` to `dstdir`.
#
# ⭐ RENAME FIRST, COPY-THEN-DELETE ONLY IF IT REFUSES. `rename`#31 is atomic and works within one
# filesystem; across filesystems agnos refuses it, and the fallback is the only way across. Trying
# the cheap atomic path first means the common case (both panes on the same volume) never reads or
# writes a byte of the file.
# ⛔ THE DELETE HAPPENS ONLY AFTER THE COPY REPORTS OK, and never on `EEXIST`. A move that removed
# the source after a failed copy is data loss, and it is the single most destructive thing this
# file could get wrong.
fn crab_fs_move(srcdir, name, dstdir, scr1, scr2, statbuf): i64 {
    var ls = crab_fs_path(scr1, srcdir, name);
    if (ls < 0) { return ls; }
    var ld = crab_fs_path(scr2, dstdir, name);
    if (ld < 0) { return ld; }
    if (crab_streq_n(scr1, scr2, CRAB_PATH_MAX) != 0) { return CRAB_FS_ESAME; }
    if (crab_fs_exists(scr2, ld, statbuf) != 0) { return CRAB_FS_EEXIST; }
    if (crab_fs_rename_raw(scr1, ls, scr2, ld) >= 0) { return CRAB_FS_OK; }
    var rc = crab_fs_copy(srcdir, name, dstdir, scr1, scr2, statbuf);
    if (rc != CRAB_FS_OK) { return rc; }
    # ⚠ Re-join: `crab_fs_copy` reused both scratch buffers, so `scr1` no longer holds the source.
    var ls2 = crab_fs_path(scr1, srcdir, name);
    if (ls2 < 0) { return ls2; }
    if (crab_fs_unlink_raw(scr1, ls2) < 0) { return CRAB_FS_ESYS; }
    return CRAB_FS_OK;
}

# ⭐⭐ STARTING PATHS FROM argv (M3, *deferral #11*). `/bin` and `/` were hardcoded smoke-test
# targets, and `args` sat declared in `[deps].stdlib` and never called.
#
# ⛔ AN UNUSABLE PATH IS REFUSED AND SAID OUT LOUD, not quietly swapped for the default. crab's
# readdir takes absolute paths; a relative one silently lists NOTHING, and an empty pane with no
# message reads as a broken filesystem rather than as a rejected argument. `src/main.cyr` logs the
# refusal and falls back.
# ⚠ THE LENGTH BOUND IS THE 0.5.0 P1's BOUND. `CRAB_PATH_MAX` sizes `lpath`/`rpath`/`pathscr`, and
# every descent grows the path from here — so a starting path at the very limit leaves no room to
# navigate. Refusing at the cap is the same discipline `crab_join_n` applies.
fn crab_path_usable(p): i64 {
    if (p == 0) { return 0; }
    # The absolute check subsumes the empty one: "" cannot begin with '/'. An explicit empty guard
    # was here and mutation testing showed it could not fail, so it is gone rather than decorative.
    if (load8(p) != 47) { return 0; }             # must be absolute — '/' is 47
    var n = 0;
    while (load8(p + n) != 0) {
        n = n + 1;
        if (n >= CRAB_PATH_MAX) { return 0; }     # would not fit, or is unterminated
    }
    return 1;
}

# ⭐⭐ SELECTION MEMORY (M3, *deferral #34*) — Backspace used to land you at the TOP of the parent.
# Ascending out of `/usr/local/bin` put the cursor on the parent's first entry, so the directory you
# had just left was somewhere below and you had to find it again. Every file manager returns you to
# it, and the reason is navigational: ascend-then-descend is how you move sideways between siblings.
#
# ⚠ TWO PURE HELPERS RATHER THAN A BIGGER `crab_ascend`. `crab_ascend` already takes six arguments and
# returns a count; threading "and also tell me where to put the cursor" through it means a seventh
# out-parameter and a second thing to get wrong. These are separately testable, and the second one is
# reused to make the sort key follow the selection instead of resetting it.

# Copy the last path segment of `path` into `out` (bounded by `cap`). -> its length, or -1.
#
# ⚠ THE ROOT HAS NO LEAF, and that is a real answer rather than an error. `/` is where ascending
# stops, so there is nothing to return to and the caller must leave the selection alone.
fn crab_leaf_name(path, out, cap): i64 {
    var n = 0;
    while (load8(path + n) != 0) { n = n + 1; }
    if (n <= 1) { return 0 - 1; }                 # "" or "/" — no leaf
    var last = 0;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { last = i; }
        i = i + 1;
    }
    return crab_strcpy_n(out, path + last + 1, cap);
}

# Index of the entry named `name`, or -1 when it is not in the listing.
#
# ⚠ -1 IS THE HONEST ANSWER AND THE CALLER MUST HANDLE IT. The directory can genuinely be gone —
# deleted, renamed, or on a filesystem that changed under us between the two readdirs. Falling back
# to 0 there is right; guessing an index is not.
fn crab_index_of(buf, count, name): i64 {
    var i = 0;
    while (i < count) {
        var rec = buf + i * CRAB_REC_SZ;
        var k = 0;
        var same = 1;
        while (1 == 1) {
            var a = load8(rec + k);
            var b = load8(name + k);
            if (a != b) { same = 0; }
            if (same == 0) { break; }
            if (a == 0) { break; }
            k = k + 1;
        }
        if (same == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Log a navigation to serial (the smoke's dispositive gate — like "key received").
fn crab_log_cd(path): i64 {
    crab_say("crab: cd ");
    crab_say(path);
    crab_say("\n");
    return 0;
}

# --- path helpers for directory navigation (Enter descends, Backspace ascends) ---

# @public — what may a listing of `n` entries honestly say about being cut short?
#   0 = say NOTHING          — the listing is complete
#   1 = "showing n of total" — truncated, by a known amount
#   2 = "has more..."        — truncated, amount unknown
#
# ⛔⛔ A FULL BUFFER IS NOT A TRUNCATION. A directory of EXACTLY `CRAB_MAX_ENTRIES` entries is
# complete, and warning about it tells the operator files are missing when none are — the same lie
# as hiding them, and harder to disbelieve because it is stated outright. The shipped guard was
# `n >= CRAB_MAX_ENTRIES` alone, so it fired on that directory every time.
#
# ⛔ THE CURSOR IS NOT THE ORACLE EITHER, AND THAT IS THE NON-OBVIOUS PART. Testing `cur != -1`
# reads as the natural fix and does not work: `agnos/kernel/core/ext2.cyr:2412` PARKS the cursor on
# the record it declined to take — `store64(cursor_uva, blkbase + off)` — whenever the batch budget
# is reached, and only `:2440` (walked off the end) and `:2392` (start >= dir_size) ever store -1.
# At exactly the cap the final batch fills, so the cursor is parked rather than exhausted and a
# cursor test STILL reports the false truncation. The COUNT is what knows: the counting walk
# resumes from that parked cursor, takes `:2392` immediately, and adds nothing.
#
# ⚠ `total < 0` is genuinely unknown, not zero, and has three sources: the `#81` fallback (which has
# no cursor and so can never count), an I/O error during the counting walk, and the step cap. All
# three warrant the wordy line — crab knows it is not showing everything and cannot say how much.
fn crab_truncation_note(n, total): i64 {
    if (n < CRAB_MAX_ENTRIES) { return 0; }          # the buffer never filled — nothing to report
    if (total > n) { return 1; }                     # a real cut, with a number behind it
    if (total < 0) { return 2; }                     # a real cut, and the count is not trustworthy
    return 0;                                        # total == n: it filled the buffer exactly
}

# @public — did this `#101` step make no progress? 1 = stalled, 0 = keep walking.
#
# ⛔⛔ THIS PREDICATE IS A FUNCTION FOR ONE REASON: THE LOOPS THAT USE IT CANNOT BE TESTED.
# Both `#101` walks live inside `#ifdef CYRIUS_TARGET_AGNOS` and drive a raw syscall, so the host
# suite cannot reach either of them — which is exactly how a non-terminating loop shipped in the
# first place and sat through 253/0 green. Lifting the decision out gives the suite the part that
# can actually be wrong, on the same principle that made `src/path.cyr` a file.
# ⚠ `k == 0` ALONE IS NOT A STALL, and this is the whole subtlety. A batch can legitimately yield
# zero records while the cursor advances — a directory block holding only deleted entries. Breaking
# on the count alone would truncate such a listing silently, which is the 0.4.x cap bug wearing a
# new hat. Only zero-AND-unmoved is a fault.
# ⚠ `k < 0` is NOT this function's business: a negative is the kernel's own error signal and the
# callers act on it differently (the listing walk falls back to `#81`, the counter gives up).
fn crab_readdir_stalled(k, was, now): i64 {
    if (k != 0) { return 0; }                        # records came back — progress, by definition
    if (now != was) { return 0; }                    # cursor moved — progress through the dir file
    return 1;
}

# readdir `path` into `buf` (up to CRAB_MAX_ENTRIES records); returns the entry count (>= 0).
# agnos-only (sys_readdir is the #81 wrapper); on the host it yields 0 (mock panes).
#
# ⚠ A FULL BUFFER IS NOT A COMPLETE LISTING. `sys_readdir` returns what fit, so `n == max` cannot be
# told apart from "there were more" — it is the only truncation signal there is. SAY SO: a pane that
# quietly stops at the cap looks like the missing files do not exist.
# ⭐⭐ PAGED LISTING (M3 *#02*, agnos 1.56.50 `#101 readdir_at`). `#81` always starts at the top and
# stops at `max`, so a directory larger than the pane buffer was silently truncated. `#101` carries a
# cursor — the byte offset into the directory file — so the walk resumes.
# ⭐ AND WHEN THE BUFFER FILLS, THE WALK CONTINUES WITHOUT STORING, purely to count. That is what
# turns "there are more entries than are shown" into "showing 1024 of 3891". The extra pass costs
# nothing in the normal case because it only runs when the directory actually overflows the cap.
# ⛔ THE #81 FALLBACK IS NOT OPTIONAL. Against a kernel older than 1.56.50, `#101` is an unknown
# syscall and the dispatcher returns -1 — so without this, crab would show an EMPTY pane on every
# older kernel and look like a filesystem fault. The fallback triggers on any negative from the
# FIRST batch, which is exactly the "syscall not there" case.
fn crab_readdir_into(path, buf): i64 {
    var n = 0;
    crab_dir_total = 0 - 1;
    crab_dir_err = 0;
    #ifdef CYRIUS_TARGET_AGNOS
    var cur[8];
    store64(&cur, 0);                                # 0 = start at the top of the directory
    var paged = 1;
    var steps = 0;
    while (load64(&cur) != (0 - 1)) {
        if (n >= CRAB_MAX_ENTRIES) { break; }
        if (steps >= CRAB_READDIR_STEPS_MAX) { break; }
        steps = steps + 1;
        var want = CRAB_MAX_ENTRIES - n;
        if (want > CRAB_READDIR_BATCH) { want = CRAB_READDIR_BATCH; }
        var was = load64(&cur);                      # the cursor BEFORE the call — the stall oracle
        var k = sys_readdir_at(path, buf + n * CRAB_REC_SZ, want, &cur);
        if (k < 0) {
            if (n == 0) { paged = 0; crab_dir_err = k; }   # #101 unavailable — take the old path
            break;
        }
        # ⛔ THE STALL GUARD. See `CRAB_READDIR_STEPS_MAX`. Zero records AND an unmoved cursor is the
        # kernel's I/O-error shape, and it is indistinguishable from it by return value alone — the
        # error path returns a non-negative count. Without this the loop never ends.
        # ⛔ `n >= CRAB_MAX_ENTRIES` ABOVE IS NOT A SECOND ESCAPE FROM THIS. `n` advances only by
        # `n = n + k`, and on a stall `k` is the zero — so that test can never become true either.
        # There is no safer half of this loop; both exits need the guard.
        if (crab_readdir_stalled(k, was, load64(&cur)) != 0) { break; }
        n = n + k;
    }
    if (paged == 0) {
        n = sys_readdir(path, buf, CRAB_MAX_ENTRIES);
        # ⛔ KEEP `#101`'s CLASSIFICATION WHEN IT MADE ONE, AND ONLY THEN. `-1` is the ambiguous code
        # — bad pointer, not ext2, or the syscall simply not existing on a kernel older than
        # 1.56.50 — so it says nothing about the PATH and must not become a pane state. `-2` (does
        # not resolve) and `-4` (not a directory) are real answers about the path, and `#81` has no
        # way to express either: it returns a bare negative for all of them.
        # ⚠ A SUCCESSFUL `#81` CLEARS THE ERROR. Reaching here means `#101` failed, and on an older
        # kernel it always will — so leaving its `-1` set would put every pane on such a kernel into
        # UNREAD while the fallback was listing the directory perfectly well.
        if (n < 0) {
            if (crab_dir_err == (0 - 1)) { crab_dir_err = n; }
            if (crab_dir_err == 0) { crab_dir_err = n; }
            n = 0;
        } else { crab_dir_err = 0; }
    }
    if (paged == 1) {
        crab_dir_total = n;
        # ⚠ Only when the buffer actually filled AND the directory has more. `cur` is the oracle for
        # "more remains", not `n >= cap` — a directory of exactly the cap is complete, not truncated.
        if (load64(&cur) != (0 - 1)) {
            var scratch[4096];                       # CRAB_READDIR_BATCH records, discarded
            var steps2 = 0;
            while (load64(&cur) != (0 - 1)) {
                # ⛔ Same stall shape as the listing walk above, and the same two guards. This loop
                # has NO buffer to fill, so it has no incidental bound at all — it walks to the end
                # of the directory by construction. Reaching the cap means the count is not
                # trustworthy, so it reports "unknown" (-1) rather than a total it cannot stand
                # behind: the truncation line then says "has more entries than are shown" instead of
                # quoting a wrong number, which is the honest failure.
                if (steps2 >= CRAB_READDIR_STEPS_MAX) { crab_dir_total = 0 - 1; break; }
                steps2 = steps2 + 1;
                var was2 = load64(&cur);
                var k2 = sys_readdir_at(path, &scratch, CRAB_READDIR_BATCH, &cur);
                if (k2 < 0) { crab_dir_total = 0 - 1; break; }
                if (crab_readdir_stalled(k2, was2, load64(&cur)) != 0) { crab_dir_total = 0 - 1; break; }
                crab_dir_total = crab_dir_total + k2;
            }
        }
    }
    #endif
    if (n < 0) { n = 0; }
    # ⚠ Defence in depth, not a known defect: the #81/#101 contracts bound the count by `max`, so this
    # clamp is unreachable today. It is here because `n` is used as a loop bound over a buffer sized
    # from the SAME constant — if the kernel contract ever drifts, the failure is a silent read past
    # lbuf/rbuf, and a one-line clamp is cheaper than the burn that would find it.
    if (n > CRAB_MAX_ENTRIES) { n = CRAB_MAX_ENTRIES; }
    # ⛔⛔ A FULL BUFFER IS NOT A TRUNCATION, AND `n >= cap` ALONE MUST NEVER DECIDE THIS. A directory
    # of EXACTLY `CRAB_MAX_ENTRIES` entries is complete; warning about it tells the operator that
    # files are missing when none are, which is the same lie as hiding them and harder to disbelieve
    # because it is stated. `crab_dir_total` is the oracle — the count the second walk actually made.
    #
    # ⛔ THE CURSOR IS NOT THE ORACLE, AND THE OBVIOUS FIX IS WRONG. It is natural to test
    # `cur != -1` here, and it does not work: `agnos/kernel/core/ext2.cyr:2412` PARKS the cursor on
    # the record it did not take — `store64(cursor_uva, blkbase + off)` — whenever the batch budget
    # is reached, and only line `:2440` (walked off the end) or `:2392` (start >= dir_size) ever
    # stores -1. So at exactly the cap the last batch fills, the cursor is left parked rather than
    # exhausted, and a cursor test still reports the false truncation. The COUNT is what knows:
    # the counting walk resumes from that parked cursor, immediately takes `:2392`, and adds 0.
    #
    # ⇒ Three states, and each says only what it can stand behind:
    #     total >  n  — genuinely truncated, and by a known amount    -> "showing n of total"
    #     total == n  — complete, and it exactly filled the buffer    -> SILENT
    #     total <  0  — unknown: the #81 fallback (no cursor at all), a counting-walk I/O error, or
    #                   the step cap                                  -> "has more", with no number
    var note = crab_truncation_note(n, crab_dir_total);
    if (note != 0) {
        crab_say("crab: WARNING listing truncated at the entry cap -- "); crab_say(path);
        # ⚠ The digit buffer is the only thing that can withhold the numbers, and the line must still
        # terminate if it does — an unterminated WARNING swallows the listing line that follows it.
        if ((note == 1) && (crab_sdig != 0)) {
            crab_say(" showing "); crab_u2s(crab_sdig, n); crab_say(crab_sdig);
            crab_say(" of "); crab_u2s(crab_sdig, crab_dir_total); crab_say(crab_sdig);
            crab_say("\n");
        } else {
            crab_say(" has more entries than are shown\n");
        }
    }
    # ⭐ ONE LINE PER LISTING, ALWAYS. This is the honest oracle for "did the pane see everything":
    # a COUNT, stated once. Inferring it by counting per-entry lines made the diagnostic itself the
    # cost being measured, and 114 console writes per navigation is what made crab feel slow.
    if (crab_sdig != 0) {
        crab_u2s(crab_sdig, n);
        crab_say("crab: listed "); crab_say(crab_sdig); crab_say(" entries in "); crab_say(path); crab_say("\n");
    }
    return n;
}

# stat every entry in `buf` (count records) and store its byte size in sizes[i]
# and mtime (unix seconds) in mtimes[i]; a stat failure stores -1 in both. On
# agnos each entry (files AND dirs) is stat'd (#33 — size @ +16, mtime @ +40 of
# the §4.1 struct) via its full path; on the host both stay -1 (mock render_test).
# Per-entry stat tracing: OFF unless CRAB_STAT_TRACE=1. `crab_sdig` is allocated ONCE — the old code
# called alloc(24) per entry with no free, so a session of navigating leaked 24 B per file listed.
var crab_stat_trace = 0;
var crab_sdig       = 0;

fn crab_stat_trace_init(): i64 {
    crab_sdig = alloc(24);
    var v = getenv("CRAB_STAT_TRACE");
    if (v == 0) { return 0; }
    if (load8(v) == 49) { crab_stat_trace = 1; }     # '1'
    return 0;
}

# ⭐⭐ DEFERRED STATTING (M3, *deferral #03*) — "get the stat storm off the keystroke path".
#
# ⭐ MEASURED FIRST, BECAUSE THIS COST WAS MISATTRIBUTED ONCE ALREADY. The 2026-08-19 iron report
# ("crab shows way more entries than before but is responding slower from inputs") looked like the
# listing and was in fact the per-entry NARRATION (see the trace gate below). So before restructuring
# anything, `crab_stat_all` was made to report its own cost on the one line per readdir that already
# existed. On agnos under QEMU: **50 ms for 45 entries in /bin, 10 ms for 7 in /** — about **1.1 ms
# per entry**, linear. At the `CRAB_MAX_ENTRIES` cap that is **~1.1 s of blocking syscalls** on the
# keystroke that descends or ascends.
# ⚠ THAT FIGURE IS 4x WHAT THIS COMMENT SAID UNTIL 0.8.0, AND THE NUMBER MOVED WITHOUT THE PROSE.
# It read "~280 ms at the cap of 256" — correct when written and left behind by M3 *#02*, which
# raised the cap to 1024 and re-derived nothing. A stale cost is worse than no cost: it is the
# number the next reader budgets against.
# ⚠ THOSE ARE QEMU FIGURES AND QEMU'S DISK EMULATION IS MUCH SLOWER THAN IRON. The per-entry
# linearity is the durable finding; the absolute number is an upper bound, not an iron measurement.
#
# ⭐ WHAT MAKES THE DEFERRAL SAFE: **dir-ness comes from the readdir record, not from stat**
# (`CRAB_REC_TYPE`). So directories-first ordering, the `/` row marker, NAME order and KIND order all
# work with **no stat data at all**. Only the size column, the status line, and SIZE/MTIME ordering
# need it. ⇒ The listing marks every entry pending and returns immediately; the event loop fills the
# sizes in bounded batches; and a sort that genuinely needs every size forces the sweep itself.
#
# ⛔ PENDING (-2) IS NOT THE SAME AS UNSTATTABLE (-1), AND CONFLATING THEM WOULD HIDE A BUG. An entry
# that is merely not reached yet would otherwise render identically to one whose stat FAILED — so an
# entry stuck pending forever (a batch loop that never completes) would look like a filesystem fault
# and be debugged as one.
fn crab_sz_pending(): i64 { return 0 - 2; }

# ⚠ 32 ENTRIES PER IDLE TICK IS A TRADE, AND BOTH SIDES ARE REAL. At the measured ~1.1 ms per entry
# a batch is ~35 ms, so a full 1024-entry directory fills over 32 ticks and delays event handling by
# at most one batch. (Eight ticks was the 256-entry figure; the cap moved and this
# comment did not.) Smaller batches are more responsive but redraw more often — and each redraw is a
# full surface render plus a buffer write, which is not free either.
enum CrabStat {
    CRAB_STAT_BATCH = 32;    # entries stat'd per idle tick
}

# Mark every entry as awaiting a stat. Cheap and O(count) with no syscalls — this is what the
# keystroke path pays instead of the sweep.
fn crab_stat_reset(sizes, mtimes, count): i64 {
    var i = 0;
    while (i < count) {
        store64(sizes + i * 8, 0 - 2);
        store64(mtimes + i * 8, 0 - 2);
        i = i + 1;
    }
    return 0;
}

# Index of the next entry still awaiting a stat at or after `from`, or -1 when none remain.
fn crab_stat_next_pending(sizes, count, from): i64 {
    var i = from;
    if (i < 0) { i = 0; }
    while (i < count) {
        if (load64(sizes + i * 8) == 0 - 2) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ⛔ SIZE AND MTIME ORDER CANNOT BE COMPUTED FROM PARTIAL DATA. Sorting while entries are still
# pending would order them by the -2 sentinel — every unstat'd file tying at the bottom, and the list
# visibly reshuffling as batches land. NAME and KIND read only the record, so they are free.
fn crab_sort_needs_stats(mode): i64 {
    if (mode == CRAB_SORT_SIZE) { return 1; }
    if (mode == CRAB_SORT_MTIME) { return 1; }
    return 0;
}

# stat ONE entry into sizes[i] / mtimes[i]. A stat failure — or a join that would not fit — stores -1
# in both, which is the honest "unstattable" answer and is distinct from the -2 pending marker.
fn crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf): i64 {
    var rec = buf + i * CRAB_REC_SZ;
    var sz = 0 - 1;                                  # stat-failure default
    var mt = 0 - 1;
    # ⛔ A TRUNCATED JOIN IS NOT A PATH — it names a DIFFERENT file, so statting it would report
    # someone else's size and mtime against this row. Unstattable is the honest answer.
    var jl = crab_join_n(pathscr, CRAB_PATH_MAX, path, rec);
    #ifdef CYRIUS_TARGET_AGNOS
    if ((jl >= 0) && (sys_stat(pathscr, strlen(pathscr), statbuf) == 0)) {
        sz = load64(statbuf + STAT_SIZE);            # agnos stat struct §4.1 — named, not a literal
        mt = load64(statbuf + STAT_MTIME);           # unix seconds
        # ⛔⛔ ONE CONSOLE LINE PER ENTRY IS A PER-NAVIGATION COST, AND THE CAP JUST GREW 8x.
        # This printed unconditionally for every entry and allocated 24 B for every entry — with
        # the old 32-entry cap that was 32 lines; on a real `/` (122 entries, iron 2026-08-30) it
        # is 122 writes to a console THREE PROCESSES SHARE UNSERIALISED, on every readdir, i.e.
        # every descend and every ascend. Iron 2026-08-19: "crab shows way more entries than
        # before but is responding slower from inputs." The listing was not the cost; narrating
        # it was.
        # ⇒ Bounded, and off by default. `CRAB_STAT_TRACE=1` in the environment brings it back
        # for a burn that actually needs the per-entry readout.
        if (crab_stat_trace == 1) {
            if (crab_sdig != 0) {
                crab_u2s(crab_sdig, sz);
                crab_say("crab: stat "); crab_say(rec); crab_say(" "); crab_say(crab_sdig); crab_say("\n");
            }
        }
    }
    #endif
    store64(sizes + i * 8, sz);
    store64(mtimes + i * 8, mt);
    return sz;
}

# stat at most `budget` still-pending entries, cheapest-index first. Returns how many were stat'd, so
# the caller knows whether a redraw is worth issuing and whether the sweep is finished.
# ⚠ THE BUDGET BOUNDS SYSCALLS, NOT ENTRIES SCANNED. The scan itself is a pointer walk over an array
# that is at most `CRAB_MAX_ENTRIES` long; the ~1.1 ms cost is entirely in `sys_stat`.
fn crab_stat_batch(path, buf, count, sizes, mtimes, pathscr, statbuf, budget): i64 {
    var done = 0;
    var i = 0;
    while ((done < budget) && (i < count)) {
        if (load64(sizes + i * 8) == 0 - 2) {
            crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf);
            done = done + 1;
        }
        i = i + 1;
    }
    return done;
}

# stat EVERY entry, synchronously. This is the storm, and it is now paid only where it is genuinely
# required: a SIZE or MTIME sort, which cannot order anything without all of the data.
fn crab_stat_all(path, buf, count, sizes, mtimes, pathscr, statbuf): i64 {
    var t0 = clock_now_ms();
    var i = 0;
    while (i < count) {
        crab_stat_one(path, buf, i, sizes, mtimes, pathscr, statbuf);
        i = i + 1;
    }
    # ⚠ ONE LINE PER SWEEP, NOT PER ENTRY — the per-entry trace is exactly the cost that made crab
    # feel slow on iron, so the measurement must not reintroduce it. On the host this reads 0 ms
    # because the stat body is `#ifdef CYRIUS_TARGET_AGNOS` and does nothing here.
    # ⚠ "stat-cost", NOT "stat" — `crab-listing-cap-test.py` counts per-entry trace lines with
    # `startswith("crab: stat ")` and asserts that count is 0 by default. A summary line sharing that
    # prefix would be counted as a per-entry trace and break an oracle that is currently honest.
    # ⛔ `crab_sdig` IS LAZILY ALLOCATED AND IS 0 UNTIL `crab_stat_trace_init` RUNS. The test suite
    # calls into here without it, so an unguarded `crab_u2s` writes to address 0 and faults — which
    # is exactly what the first version of this line did.
    if (crab_sdig == 0) { return 0; }
    crab_u2s(crab_sdig, clock_now_ms() - t0);
    crab_say("crab: stat-cost "); crab_say(crab_sdig); crab_say(" ms for ");
    crab_u2s(crab_sdig, count);
    crab_say(crab_sdig); crab_say(" entries in "); crab_say(path); crab_say("\n");
    return 0;
}

# ⭐ WHAT A LISTING PAYS. The keystroke path calls THIS, not `crab_stat_all`: pending marks are free,
# and the sweep happens only for an order that cannot be computed without it.
fn crab_stat_for_listing(path, buf, count, sizes, mtimes, pathscr, statbuf, mode): i64 {
    crab_stat_reset(sizes, mtimes, count);
    if (crab_sort_needs_stats(mode) == 1) {
        crab_stat_all(path, buf, count, sizes, mtimes, pathscr, statbuf);
        return 1;
    }
    return 0;
}

# Descend: if the selected entry (buf[sel], sel < count) is a directory, rewrite
# `path` in place to path/name, re-readdir into `buf`, and re-stat size+mtime.
# Returns the new entry count (>= 0), or -1 when the selection is not a dir / empty.
fn crab_descend(path, buf, sel, count, namescr, pathscr, sizes, mtimes, statbuf): i64 {
    if (count <= 0) { return -1; }
    if (sel < 0) { return -1; }
    if (sel >= count) { return -1; }                 # belt-and-braces: sel indexes a record below
    var rec = buf + sel * CRAB_REC_SZ;
    if (load8(rec + CRAB_REC_TYPE) != 1) { return -1; }     # type byte: 1 = dir
    if (crab_strcpy_n(namescr, rec, CRAB_NAME_MAX) < 0) { return -1; }   # name out before readdir overwrites buf
    # ⛔ REFUSE, do not truncate. Descending into a truncated path would readdir a directory the
    # operator did not select — silently, and with the pane header showing the name they DID select.
    if (crab_join_n(pathscr, CRAB_PATH_MAX, path, namescr) < 0) {
        crab_say("crab: path too long -- refusing to descend\n");
        return -1;
    }
    if (crab_strcpy_n(path, pathscr, CRAB_PATH_MAX) < 0) { return -1; }
    var n = crab_readdir_into(path, buf);
    # ⚠ AFTER the stat marks, never before — SIZE and MTIME order read arrays the stat fills, and
    # `crab_stat_for_listing` performs the full sweep for exactly those two modes.
    crab_stat_for_listing(path, buf, n, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, n, crab_sort_mode);
    return n;
}

# Ascend: truncate `path` in place to its parent directory, re-readdir into `buf`,
# and re-stat size+mtime. Returns the new entry count (>= 0), or -1 at the root "/".
# @public — re-read a pane's CURRENT directory in place (M4). -> the new entry count.
#
# ⛔⛔ AFTER A WRITE, BOTH PANES ARE STALE, NOT JUST THE ACTIVE ONE. A copy adds an entry to the
# other pane; a move adds one there and removes one here; a delete removes one here. crab's panes
# are snapshots taken at listing time, so an operation that changed the disk and re-listed only the
# pane the operator was looking at leaves the OTHER pane confidently showing a file that is gone —
# and Enter on it would descend into nothing.
# ⚠ This is `crab_ascend` minus the path surgery: same listing, same deferred stat marking, same
# sort. Kept as its own function rather than a flag on ascend, because "go up" and "look again" are
# different intentions and only one of them may move the pane.
fn crab_relist(path, buf, sizes, mtimes, pathscr, statbuf): i64 {
    var cnt = crab_readdir_into(path, buf);
    crab_stat_for_listing(path, buf, cnt, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, cnt, crab_sort_mode);
    return cnt;
}

# @public — the operator-facing sentence for a `CRAB_FS_*` result. Never 0.
#
# ⚠ THE STATUS LINE IS THE ONLY PLACE A REFUSAL IS SEEN. crab logs to the console as well, but three
# processes share that console unserialised on iron and the operator is not reading it. A refusal
# the operator cannot see is indistinguishable from the operation silently not working.
fn crab_fs_msg(rc): i64 {
    if (rc == CRAB_FS_OK)       { return "done"; }
    if (rc == CRAB_FS_EBADNAME) { return "refused: crab will not act on that name"; }
    if (rc == CRAB_FS_ETOOLONG) { return "refused: the path would be too long"; }
    if (rc == CRAB_FS_EEXIST)   { return "refused: something of that name is already there"; }
    if (rc == CRAB_FS_ESAME)    { return "refused: the source and the destination are the same"; }
    if (rc == CRAB_FS_EIO)      { return "failed part-way: the copy is incomplete"; }
    return "failed: the filesystem refused";
}

fn crab_ascend(path, buf, sizes, mtimes, pathscr, statbuf): i64 {
    var n = strlen(path);
    if (n <= 1) { return -1; }                       # already at "/"
    var last = 0;
    var j = 0;
    while (j < n) { if (load8(path + j) == 47) { last = j; } j = j + 1; }
    if (last == 0) { store8(path + 1, 0); } else { store8(path + last, 0); }
    var cnt = crab_readdir_into(path, buf);
    crab_stat_for_listing(path, buf, cnt, sizes, mtimes, pathscr, statbuf, crab_sort_mode);
    crab_sort_entries(buf, sizes, mtimes, cnt, crab_sort_mode);
    return cnt;
}
