# crab 🦀 — sovereign Cyrius-native file manager for AGNOS.
#
# A dhancha widget client on the native desktop stack: builds a DUAL-PANE file UI
# with the toolkit (widgets + flexbox layout), drawn via sadish (2D vector) + the
# kashi system font, and presented over setu to the aethersafha compositor — the
# seam the puka terminal and the setu widget probe proved.
#
# It lists REAL directories via the resumable readdir syscall (#101, with #81 as the fallback for
# kernels older than agnos 1.56.50): each pane readdir's a
# path into a buffer of fixed 64-byte records (name NUL-terminated at +0, type at
# +63; 1 = dir) and renders the entries. Navigation (Norton-Commander / Dolphin):
# Left/Right (or h/l) switch the active pane; Up/Down (or j/k) move the selection;
# Enter descends into the selected directory; Backspace ascends to the parent.
#
# Deps (cyrius.cyml): sadish + rekha + kashi (system font) + dhancha + setu.

# ⛔ THIS FILE IS `main()` AND `_entry()` AND NOTHING ELSE. It ends in `_entry();`, so a test that
# included it would RUN THE APP — which is why everything testable now lives in `src/app.cyr`.
# Do not add a function here; add it there.
include "src/app.cyr"

fn main(): i64 {
    alloc_init();
    crab_stat_trace_init();
    var w = 380;
    var h = 220;
    var nbytes = w * h * 4;

    # Two panes, each listing a real directory. On agnos, readdir_at(#101) fills a buffer
    # of fixed 64-byte records; on the host the panes stay empty (render_test mocks them).
    var lpath = alloc(CRAB_PATH_MAX);
    var rpath = alloc(CRAB_PATH_MAX);
    # ⭐ START WHERE THE OPERATOR CHOSE (*#11*): `crab [LEFT] [RIGHT]`. `/bin` and `/` were hardcoded
    # smoke-test targets, and `args` was declared in the manifest and never called.
    # ⚠ THE DEFAULTS STAY, and they matter: on agnos the compositor spawns crab through the launcher
    # with a path and no arguments, so the desktop case is always the fallback case.
    # ⛔ A REFUSED ARGUMENT IS ANNOUNCED. Silently falling back would leave the operator looking at
    # `/bin` having asked for something else, with nothing to explain it.
    args_init();
    var lstart = "/bin";
    var rstart = "/";
    if (argc() > 1) {
        if (crab_path_usable(argv(1)) == 1) { lstart = argv(1); }
        else { crab_say("crab: left path unusable (must be absolute and fit) -- using /bin\n"); }
    }
    if (argc() > 2) {
        if (crab_path_usable(argv(2)) == 1) { rstart = argv(2); }
        else { crab_say("crab: right path unusable (must be absolute and fit) -- using /\n"); }
    }
    crab_strcpy_n(lpath, lstart, CRAB_PATH_MAX);   # mutable pane paths — Enter/Backspace rewrite them
    crab_strcpy_n(rpath, rstart, CRAB_PATH_MAX);
    var lbuf = alloc(CRAB_MAX_ENTRIES * CRAB_REC_SZ);
    var rbuf = alloc(CRAB_MAX_ENTRIES * CRAB_REC_SZ);
    # ⭐ MULTI-SELECT MARKS (M4) — one BYTE per entry, parallel to the record buffer, per pane.
    # ⛔ CLEARED ON EVERY RE-LISTING. A mark is an index, and an index means nothing once the
    # directory has been read again — see the ⛔ in `src/ui.cyr`.
    # ⭐⭐ THE OVERLAY'S STATE (M4), IN crab's OWN VARIABLES. dhancha holds no "which popup is open" —
    # a widget pointer there would die at `dh_frame_begin`, the same failure as drag in 0.9.21. The
    # popup exists because these say so, and the layer being in the tree IS the modality.
    var menu_open = 0;
    var menu_x = 0;
    var menu_y = 0;
    var menu_sel = 0;
    # ⚠ `edit_open` doubles as the MODE: 1 = rename the selected entry, 2 = create a folder. The two
    # share the field, the keys and the sheet; only the commit differs.
    var edit_open = 0;
    var edit_label = "";
    var lmarks = alloc(CRAB_MAX_ENTRIES);
    var rmarks = alloc(CRAB_MAX_ENTRIES);
    var lsizes = alloc(CRAB_MAX_ENTRIES * 8);             # per-entry byte sizes (parallel to lbuf)
    var rsizes = alloc(CRAB_MAX_ENTRIES * 8);
    var lmtimes = alloc(CRAB_MAX_ENTRIES * 8);            # per-entry mtime (unix seconds)
    var rmtimes = alloc(CRAB_MAX_ENTRIES * 8);
    var namescr = alloc(CRAB_NAME_MAX);     # scratch: selected entry name (descend)
    var pathscr = alloc(CRAB_PATH_MAX);     # scratch: joined child path (descend / stat)
    # ⛔ M4 NEEDS TWO PATH SCRATCHES AT ONCE, and reusing `pathscr` for both would be the 0.5.0
    # aliasing bug in a new place: `crab_fs_copy` holds the SOURCE in one buffer while it joins the
    # DESTINATION into the other, and a single buffer would make them the same string — which
    # `crab_streq_n` would then correctly report as CRAB_FS_ESAME, refusing every copy.
    var pathscr2 = alloc(CRAB_PATH_MAX);    # scratch: the second path (copy / move destinations)
    # ⚠ `STAT_BUFSZ`, not a literal 48. It is 48 on agnos (§4.1) and 144 on the Linux/Windows peers,
    # and this alloc sits OUTSIDE the agnos #ifdef while the reads sit inside it — so the buffer is
    # sized by whichever peer the build actually included, which is the only correct answer.
    var statbuf = alloc(STAT_BUFSZ);        # scratch: stat struct, sized by the target's own contract
    var ln = crab_readdir_into(lpath, lbuf);   # readdir(path, buf, CRAB_MAX_ENTRIES) -> count (0 on host)
    # ⭐ THE PANE'S STATE, CAPTURED WHERE THE LISTING HAPPENED (M4). `crab_listing_err` reports the
    # LAST readdir and crab has two panes, so this must be read here and not at render time — a
    # deferred read gives both panes whichever pane listed last. Every assignment to `ln`/`rn` from a
    # listing is paired with one of these; that pairing is the whole correctness argument.
    var lstate = crab_pane_state(ln, crab_listing_err());
    # ⭐ M4's DELETE CONFIRMATION, as a latch rather than a modal. crab has no modal sheet (that is
    # the gated part of M4) and does not need one for a yes/no: `d` arms this, the NEXT key either
    # confirms with `y` or cancels by being anything else.
    # ⛔ FAIL-SAFE BY CONSTRUCTION — only `y` proceeds. An unrecognised key cancels, so a stray
    # keypress between arming and confirming can never delete; the operator has to answer the
    # question that is on screen.
    var confirm_del = 0;
    # ⭐ THE LISTING NO LONGER PAYS THE STORM (*#03*). `crab_stat_for_listing` marks every entry
    # pending — free, no syscalls — and sweeps only when the sort mode genuinely needs every size.
    crab_stat_for_listing(lpath, lbuf, ln, lsizes, lmtimes, pathscr, statbuf, crab_sort_mode_get());
    # ⚠ THE INITIAL LISTINGS NEED SORTING TOO. `crab_descend`/`crab_ascend` sort their own results, so
    # forgetting these two would leave the FIRST view crab ever shows in raw readdir order — and only
    # the first, which is the shape of bug that gets reported as "sorting works after you navigate".
    crab_sort_entries(lbuf, lsizes, lmtimes, ln, crab_sort_mode_get());
    var rn = crab_readdir_into(rpath, rbuf);
    var rstate = crab_pane_state(rn, crab_listing_err());
    crab_stat_for_listing(rpath, rbuf, rn, rsizes, rmtimes, pathscr, statbuf, crab_sort_mode_get());
    crab_sort_entries(rbuf, rsizes, rmtimes, rn, crab_sort_mode_get());

    # ⛔ CORRECTED 2026-08-12. The paragraph here said "The path is advisory and always was — setu
    # ignores it. The transport behind this call is TCP on loopback:7700, RETIRED..." — three claims,
    # all now wrong: setu honours the path (0.8.4) and resolves `$SETU_SOCKET` (0.8.5), and the
    # transport is AF_UNIX/SOCK_SEQPACKET on Linux and the `#97` channel band on agnos. The TCP
    # history it recounted is real but belongs in setu's own CHANGELOG, not at a live call site.
    # ⭐⭐ THROUGH THE TOOLKIT, NOT AROUND IT (2026-08-16). This called `setu_client_connect` directly
    # while crab already builds its UI on dhancha (30 API calls in `src/ui.cyr`) — so the app depended on
    # the toolkit for pixels and bypassed it for the connection. `dh_client_connect` is a one-line
    # delegation to the same setu entry point, so this changes no behaviour; what it changes is WHERE the
    # seam is. When the transport moves again — and it has twice, TCP -> AF_UNIX -> the agnos `#97`
    # channel band — a consumer routed through dhancha follows for free, and one that is not gets left
    # behind silently. dhancha itself was left behind exactly that way: it pinned setu 0.7.4 across the
    # channel-band cutover and had NO agnos arm until 0.9.4.
    # ⚠ The PRESENT path deliberately stays hand-rolled below: crab uses a LIVE shared buffer
    # (`setu_buf_create` once, `setu_buf_write` per frame, no re-present), while `dh_client_present`
    # sends ATTACH + COMMIT every frame. Those are different models and swapping them is not a rename.
    # ⚠ CORRECTED 2026-08-17: this used to say `dh_client_present` "re-sends pixels every call". That
    # is no longer true — `setu_client_present` caches a shared buffer (create once, rewrite in place,
    # recreate on resize). The reason to stay put is the per-frame commit, not a pixel copy.
    var path = 0;
    var c = dh_client_connect(path);
    if (c == 0) { crab_say("crab: setu connect failed\n"); return 1; }
    var fd = dh_client_fd(c);

    var buf_id = setu_buf_create(nbytes);
    if (buf_id < 0) { crab_say("crab: buf_create failed\n"); return 1; }

    var active_pane = 0;   # 0 = left, 1 = right
    # ⭐ THE PREVIEW COLUMN'S TOGGLE (M5). ⚠ OFF BY DEFAULT, and that is the conservative choice
    # rather than the timid one: crab's shipped window is 380x220, where opening the preview costs
    # the panes their MODIFIED column. A view that reflows the moment the app starts is a view the
    # operator did not ask for.
    var pv_open = 0;
    # ⭐ THE VIEW MODE (M5). ⚠ ONE MODE FOR BOTH PANES, like the sort order — a view is a property of
    # how the operator is reading, and two panes in different modes is a display they would have to
    # remember having toggled.
    var view_mode = CRAB_VIEW_LIST;
    var sel_l = 0;
    var sel_r = 0;
    # ⭐ Scroll offsets are APP state (0.4.10). The widget tree is rebuilt every frame, so the LIST
    # that owns the offset is destroyed and recreated each time; these two cells are what carry it
    # across, and without them every downward step past the viewport would snap to the top edge
    # instead of scrolling by a row. Heap cells rather than locals because `crab_render` writes back.
    var scroll_l = alloc(8); store64(scroll_l, 0);
    var scroll_r = alloc(8); store64(scroll_r, 0);

    # ⛔⛔ ONE SURFACE FOR THE WHOLE SESSION, CREATED HERE AND REUSED EVERY FRAME. `crab_render` used
    # to mint its own `dh_surface_new` per call, and dhancha 0.9.14 caches the sadish render target
    # ON the DhSurface — so a per-frame DhSurface would have thrown the cache away every frame and
    # saved nothing. The hoist IS the fix; the dhancha change alone does not help a caller that does
    # this per frame. Measured together: 746,440 -> 77,608 B per frame.
    # ⚠ THE ALLOCATOR HAS NO `free()` (`lib/alloc.cyr` is a bump allocator; `alloc_reset` rewinds the
    # WHOLE arena and would invalidate the pane paths, the readdir buffers and the client struct). So
    # "allocated once" is not a tidiness point — it is the only way a frame's cost is not permanent.
    # ⚠ WHEN RESIZE LANDS (M2 / `WINDOW_CONFIGURE`), THIS IS THE LINE THAT HAS TO CHANGE: the surface
    # is created at the compile-time `w`/`h` and dhancha has no `dh_surface_resize` yet.
    var surf = dh_surface_new(w, h);
    if (surf == 0) { crab_say("crab: surface alloc failed\n"); return 1; }

    # ⭐ THE RENDER-STATE RECORD (M5) — allocated once, refilled before each of the five renders
    # below. It replaced a 32-argument `crab_render` call that appeared here five times, identically,
    # where a single miscounted comma would have shifted every argument after it and still compiled.
    # ⚠ REFILLED, NOT MUTATED IN PLACE BY THE KEY HANDLERS: the loop's locals stay the source of
    # truth and the record is written from them immediately before each render, so there is no second
    # copy of the app's state to keep in step.
    var rs = crab_rs();
    if (rs == 0) { crab_say("crab: render state alloc failed\n"); return 1; }
    # ⚠ The preview's dimension out-record, allocated once beside the render state it feeds.
    var pvdims = alloc(CRAB_IMG_SZ);
    if (pvdims == 0) { crab_say("crab: preview dims alloc failed\n"); return 1; }
    store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0);

    # ⚠ NO ARENA SETUP HERE ANY MORE (0.6.0). It lived in this function and that was a gap: nothing
    # in `main.cyr` is reachable from `tests/crab.tcyr`, so deleting the install broke no test while
    # restoring a 77 KB-per-frame leak. `crab_render` now owns and installs it — see `src/ui.cyr`.

    # ⚠ WHICH PANE THE PREVIEW DESCRIBES — the ACTIVE one, the same pane the status line reads.
    var apath = lpath; var abuf2 = lbuf; var asel2 = sel_l; var acount = ln;
    if (active_pane == 1) { apath = rpath; abuf2 = rbuf; asel2 = sel_r; acount = rn; }
    crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);

    crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);

    crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());

    crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
    crab_rs_preview(rs, pv_open);
    crab_rs_view(rs, view_mode);
    # ⭐ THE DIMENSIONS ARE READ HERE, NOT IN THE RENDERER, because the read needs a syscall and
    # `src/ui.cyr` sits below the layer that owns them. ⚠ `crab_preview_dims` is MEMOISED on
    # (directory, name) and returns early on a non-image, so this costs nothing per frame — only
    # the frame after the selection actually moves to a new image pays an open/read/close.
    # ⚠ AND ONLY WHILE THE PREVIEW IS OPEN. A closed preview reads no files at all.
    if (pv_open == 1) {
        if (acount > 0) {
            crab_preview_dims(apath, abuf2 + asel2 * CRAB_REC_SZ, pvdims, pathscr);
        } else { store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0); }
    }
    crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
    crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
    crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());

    var sds = crab_render(surf, 0, rs);
    if (sds == 0) { crab_say("crab: initial render failed\n"); return 1; }
    setu_buf_write(buf_id, sd_surface_pixels(sds), nbytes);
    if (setu_send(fd, setu_create_surface(w, h, crab_surface_flags())) < 0) { crab_say("crab: create_surface send failed\n"); return 1; }
    var reply = setu_msg_new();
    if (setu_read_msg(fd, reply) < 0) { crab_say("crab: no surface_created reply\n"); return 1; }
    if (setu_msg_kind(reply) != SETU_SURFACE_CREATED) { crab_say("crab: reply was not surface_created\n"); return 1; }
    var sid = setu_msg_arg(reply, 0);
    var stride = w * 4;
    # ⚠ These two used to `return 1` in silence, AFTER the compositor had already minted a surface —
    # so the one process that knew the attach or the commit had failed said nothing, and the failure
    # looked from outside like a client that never ran. Every other exit here names itself.
    if (setu_send(fd, setu_attach_buf(sid, w, h, stride, 1, buf_id)) < 0) { crab_say("crab: attach_buf send failed\n"); return 1; }
    if (setu_send(fd, setu_commit(sid)) < 0) { crab_say("crab: commit send failed\n"); return 1; }
    crab_say("crab: dual-pane file-manager UI presented over setu\n");
    var resized = 0;        # set by WINDOW_CONFIGURE, consumed by the re-ATTACH after the next render
    # ⭐ POINTER STATE (M2, *deferral #05*), OWNED BY crab RATHER THAN BY `dh_dispatch`.
    # ⛔ `SETU_INPUT_PTR_BTN` CARRIES NO COORDINATES — only button and state. The position comes from
    # `SETU_INPUT_PTR_MOVE`, so a client that does not track motion has nowhere to put a click. That
    # is why these two exist and why the MOVE arm is not optional.
    # ⚠ The last-click cells are crab's OWN model — pane index and row index, never widget pointers.
    # A widget pointer would not survive `dh_frame_begin`'s arena rewind between the two clicks of a
    # double-click; a row index does. See the ⛔ in `src/app.cyr`.
    var ptr_x = 0;
    var ptr_y = 0;
    var last_pane = 0 - 1;
    var last_row = 0 - 1;
    var last_ms = 0;
    var hit = alloc(16);
    # ⭐⭐ DRAG BETWEEN PANES (M4), IN crab's OWN MODEL. Pane index + row index + the press origin —
    # never a widget pointer, for the same reason double-click and the wheel do it this way: the
    # tree is rebuilt every frame and the arena rewinds underneath it. See `crab_drag_started`.
    # ⚠ `drag_pane` is -1 when no button is down; that doubles as "nothing to drop".
    var drag_pane = 0 - 1;
    var drag_row = 0 - 1;
    var drag_x = 0;
    var drag_y = 0;
    var dragging = 0;
    # ⭐ HELD-KEY REPEAT (M2 *#06*). `SETU_SURF_FULL_KEYS` gives crab both edges, so it can know a key
    # is still down — which is the whole reason the flag was worth requesting.
    # ⚠ ONE held key, not a set. Two movement keys held at once is not a gesture a file manager owes
    # anyone, and tracking a set would need a release to clear the right slot rather than just clear.
    var held_key = 0;
    var held_since = 0;
    var held_last = 0;

    # LIVE (agnos): re-render on forwarded key input. Left/Right (0x50/0x4F) or h/l
    # switch the active pane; Up/Down (0x52/0x51) or k/j move its selection (clamped
    # to the entry count); Enter (0x28) descends into the selected directory and
    # Backspace (0x2A) ascends to the parent (each re-readdirs + resets the selection).
    # The client logs each key to serial (input gate).
    #ifdef CYRIUS_TARGET_AGNOS
    # ⭐⭐ INPUT THROUGH THE TOOLKIT (0.4.12). This was a hand-rolled `setu_poll_input` loop switching
    # on raw setu message kinds, while crab already used dhancha for pixels. It is now
    # `dh_client_poll_event` — the NON-BLOCKING half dhancha grew in 0.9.11 precisely because a file
    # manager redraws on its own and cannot sit in a blocking read waiting for a keystroke.
    # ⭐ ADOPTING IT FIXES A LATENT BUG crab could not see. `setu_poll_input` is documented by setu as
    # "decodes only the FIRST frame of each recv; coalesced or split frames are dropped ... kept for
    # API compat" — and a dropped tail LOSES KEY-RELEASE EVENTS. dhancha wraps
    # `setu_client_poll_input`, which reassembles the stream. crab never noticed because it only
    # reads presses; the next consumer to want held keys would have.
    # ⚠ The PRESENT path below is deliberately unchanged — see the note at the connect site.
    # ⛔⛔ THE LOOP BOUND WAS A SPIN COUNT, AND IT ENDED SESSIONS (fixed 0.5.0). This was
    # `while (frame < 2000000)` with `frame` incremented once per POLL — and no call in the body
    # blocks: `dh_client_poll_event` returns 0 immediately on an idle channel and `sys_sched_yield`
    # returns at once. So `frame` counted neither frames presented nor seconds nor user actions; it
    # counted how fast the CPU could spin. At roughly a microsecond an iteration that is about
    # **two seconds** before crab closed its own window, mid-session, while focused and in use —
    # and the exit path printed NOTHING, so from the operator's side it was indistinguishable from
    # a crash. It also burned one core at 100% for its whole (short) life.
    # ⇒ The loop now ends on the two things that actually mean "stop": EOF and WINDOW_CLOSE. Both
    # were already handled; neither was allowed to be the reason the loop ended.
    #
    # ⚠ AND THE IDLE WAIT IS LOAD-BEARING, NOT POLITENESS. `dh_setu_poll_event` calls `setu_msg_new()`
    # BEFORE it knows whether anything is pending, so every idle poll leaks ~80 B into an allocator
    # with no free. Removing the frame cap without slowing the poll would have turned a bounded
    # 152 MB leak into an unbounded one — roughly 80 MB/s of idle growth. Waiting on an interrupt
    # instead of spinning bounds it to the tick rate: still a leak, still upstream, but survivable
    # while dhancha's poll is fixed.
    # ⇒ Wait ONLY when the poll came back empty, so a burst of events still drains at full speed.
    # ⛔ WHICH wait primitive is not a detail — see the ⛔ block at the bottom of this loop. Getting
    # it wrong froze the whole desktop, and only a QEMU run showed it.
    # ⚠ NOT `dh_client_next_event` (which blocks): crab must be able to redraw without input for the
    # idle mascot line, transfer progress and index progress. A blocking read forecloses all three.
    var running = 1;
    while (running == 1) {
        var ev = dh_client_poll_event(c);
        # ⛔ EOF IS NOT "no input". -6 means the connection is gone; carrying on would render into a
        # surface nobody reads, holding the `#86` slot the whole time.
        if (ev == (0 - 6)) {
            crab_say("crab: connection closed -- exiting\n");
            running = 0;
        }
        if (ev > 0) {
            var k = dh_event_kind(ev);
            # ⛔⛔ THE COMPOSITOR CLOSED OUR WINDOW — EXIT, do not keep drawing into a surface nobody
            # composites. Before this, aethersafha's F4 removed the window from its own list and said
            # nothing, so crab carried on forever: on the 2026-08-08 iron burn the process was left
            # **orphaned alive**, holding its `#97` channel end and its `#86` GPU-visible shm slot for
            # the rest of the boot. There are only 16 of those slots system-wide.
            # ⭐ Our EXIT is what releases them — the kernel reclaims the channel end and the slot when
            # the process dies. So honouring this message is not politeness, it is the release path.
            # ⚠ `SETU_CLOSE` has been in the protocol since it was written (lib/setu.cyr:140); it was
            # simply never sent and never handled. Nothing here is a protocol extension.
            if (k == WINDOW_CLOSE) {
                crab_say("crab: compositor closed the window -- exiting\n");
                running = 0;                     # fall out of the loop, then run the normal teardown
            }
            # ⭐⭐ THE COMPOSITOR ASKS FOR A NEW SIZE (M2). `WINDOW_CONFIGURE` has reached apps since
            # dhancha 0.9.12 and crab dropped it on the floor for five releases — so a maximise or a
            # fullscreen grew the WINDOW and not the file manager, and aethersafha clamped its blit to
            # the buffer crab last gave it. That is the 2026-08-19 iron report's shape exactly.
            # ⛔ IT IS AN ASK, NOT A FACT. The surface is crab's — on agnos a `#86` slot crab owns —
            # and only crab can grow it. Nothing changes until the re-ATTACH below lands.
            # ⚠ The DECISION is `crab_resize_wanted` in `src/app.cyr`, where a test can reach it; what
            # is here is the syscall plumbing that cannot be.
            if (k == WINDOW_CONFIGURE) {
                var aw = dh_event_a(ev);
                var ah = dh_event_b(ev);
                if (crab_resize_wanted(w, h, aw, ah) == 1) {
                    var nb = crab_surface_bytes(aw, ah);
                    var nbuf = buf_id;
                    var ok = 1;
                    if (nb != nbytes) {
                        # ⛔⛔ CREATE BEFORE CLOSE. THE FIRST DRAFT CLOSED FIRST AND QEMU KILLED IT:
                        # on a maximize `setu_buf_create` failed, crab had already released its only
                        # buffer, and it exited — `crab: buf_create failed on resize -- exiting`.
                        # **Never destroy a working surface to attempt an upgrade.** setu's own
                        # `setu_client_present` closes first, but it has an inline-pixel fallback to
                        # land on; crab's hand-rolled LIVE-buffer path has none, so the same order is
                        # fatal here. Two slots are held for one call, which is 2 of 16 transiently.
                        nbuf = setu_buf_create(nb);
                        if (nbuf < 0) {
                            # ⛔ A REFUSED RESIZE IS A FROZEN EXTENT, NOT A DEATH. The kernel caps a
                            # `#71` pmm slot at 2 MB and only a real GPU carveout (`#86`) reaches
                            # 32 MB — under QEMU there is no carveout, so a fullscreen ask cannot be
                            # backed at all. Staying at the old size is the documented degradation
                            # for a client that cannot honour a CONFIGURE; exiting is not.
                            crab_log_extent("crab: cannot back a surface of ", aw, ah);
                            ok = 0;
                        }
                        else { setu_buf_close(buf_id); }
                    }
                    if (ok == 1) {
                        if (dh_surface_resize(surf, aw, ah) == DHANCHA_OK) {
                            buf_id = nbuf;
                            w = aw;
                            h = ah;
                            nbytes = nb;
                            stride = w * 4;
                            resized = 1;     # the ATTACH+COMMIT happens after the render below
                            crab_log_extent("crab: resized to ", w, h);
                        }
                    }
                }
            }
            # ⭐ POINTER MOTION — track it, do not act on it. Coordinates are CONTENT-relative and
            # the compositor has already dropped anything outside the content rect (its own ⛔: a
            # pointer on the titlebar produced a negative `ry`, and a client indexing by it reads
            # before its buffer). crab relies on that bound rather than re-deriving it.
            # ⚠ aethersafha dedupes motion, so a stationary pointer costs nothing.
            if (k == POINTER_MOVE) {
                ptr_x = dh_event_a(ev);
                ptr_y = dh_event_b(ev);
                # ⭐ PROMOTE AN ARMED PRESS TO A DRAG once the pointer has travelled far enough.
                # ⚠ The notice is set ONCE, on the transition — setting it every motion event would
                # rebuild the status line on a dedupe-free stream for no change in what it says.
                if (drag_pane >= 0) {
                    if (dragging == 0) {
                        if (crab_drag_started(drag_x, drag_y, ptr_x, ptr_y) == 1) {
                            dragging = 1;
                            crab_set_notice("drag to the other pane to move");
                        }
                    }
                }
            }
            # ⭐⭐ THE WHEEL (M2, *deferral #05*). Five repos had to move for this event to exist:
            # agnos 1.56.49 reads HID report byte [3] (documented and never read until then), bhumi
            # 1.4.3 carries it as `BHUMI_EV_SCROLL`, setu 0.8.8 defines `SETU_INPUT_PTR_SCROLL`,
            # dhancha 0.9.18 maps it to `POINTER_SCROLL`, and the compositor forwards it.
            # ⚠ IT SCROLLS THE PANE UNDER THE CURSOR, not the focused one — that is what a wheel does
            # everywhere else, and it does NOT steal focus. A wheel that also focused would make an
            # accidental scroll-over change which pane the arrow keys drive.
            if (k == POINTER_SCROLL) {
                var sdel = dh_event_a(ev);
                if (sdel != 0) {
                    if (crab_hit(ptr_x, ptr_y, hit) == 1) {
                        var sp = load64(hit);
                        if (sp == 0) { sel_l = crab_scroll_sel(sel_l, ln, sdel); }
                        if (sp == 1) { sel_r = crab_scroll_sel(sel_r, rn, sdel); }
                        crab_say("crab: scroll\n");
                    }
                }
            }
            # ⭐⭐ CLICK: focus the pane, select the row, and descend on a double-click.
            # ⚠ PRESS ONLY (`b == 1`). Acting on the release as well would double every click, and on
            # a double-click would descend twice — the second descend landing wherever the first left
            # the selection.
            if (k == POINTER_BTN) {
                if (dh_event_b(ev) == 1) {
                    if (crab_hit(ptr_x, ptr_y, hit) == 1) {
                        var hp = load64(hit);
                        var hr = load64(hit + 8);
                        active_pane = hp;             # clicking a pane focuses it, even off-row
                        var now = clock_now_ms();
                        if (hr >= 0) {
                            # ⚠ CLAMP AGAINST THE LIVE COUNT. The tree was built from the count at the
                            # last render; nothing has changed it since, but a row index is an index
                            # into arrays sized by `CRAB_MAX_ENTRIES` and is not worth trusting.
                            if (hp == 0) { if (hr < ln) { sel_l = hr; } }
                            if (hp == 1) { if (hr < rn) { sel_r = hr; } }
                            if (crab_is_double(last_pane, last_row, last_ms, hp, hr, now) == 1) {
                                if (hp == 0) {
                                    var dl = crab_descend(lpath, lbuf, sel_l, ln, namescr, pathscr, lsizes, lmtimes, statbuf);
                                    if (dl >= 0) {
                                        ln = dl;
                                        crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                        lstate = crab_pane_state(ln, crab_listing_err());
                                        sel_l = 0;
                                        crab_log_cd(lpath);
                                    }
                                }
                                if (hp == 1) {
                                    var dr = crab_descend(rpath, rbuf, sel_r, rn, namescr, pathscr, rsizes, rmtimes, statbuf);
                                    if (dr >= 0) {
                                        rn = dr;
                                        crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                        rstate = crab_pane_state(rn, crab_listing_err());
                                        sel_r = 0;
                                        crab_log_cd(rpath);
                                    }
                                }
                                # ⛔ CONSUME THE PAIR. Leaving `last_row` set would make a third click
                                # a second double-click, descending twice on a triple-click.
                                last_pane = 0 - 1;
                                last_row = 0 - 1;
                            }
                            else {
                                last_pane = hp;
                                last_row = hr;
                                last_ms = now;
                            }
                        }
                        crab_say("crab: click\n");
                        # ⭐ ARM THE DRAG. Recorded on every press on a row; it only becomes a drag
                        # once the pointer travels past the threshold, so this costs a click nothing.
                        if (hr >= 0) {
                            drag_pane = hp;
                            drag_row = hr;
                            drag_x = ptr_x;
                            drag_y = ptr_y;
                            dragging = 0;
                        }
                    }
                }
                # ⭐⭐ RELEASE — THE DROP. crab had no release arm at all before M4; a press did
                # everything and the button coming back up was ignored.
                if (dh_event_b(ev) == 0) {
                    if (dragging == 1) {
                        var dropped = 0;
                        if (crab_hit(ptr_x, ptr_y, hit) == 1) {
                            var tp = load64(hit);
                            # ⛔ THE DESTINATION IS THE OTHER PANE'S DIRECTORY, NOT THE ROW UNDER THE
                            # POINTER. Dropping "onto" a folder row would be a different gesture with
                            # a different meaning, and getting it wrong moves a file somewhere the
                            # operator did not point at. Row-targeted drops can come later; the pane
                            # is the unambiguous target and the one the dual-pane layout implies.
                            if (crab_drag_targets(drag_pane, tp) == 1) {
                                var sp2 = lpath; var dp2 = rpath; var sb2 = lbuf; var sc2 = ln;
                                if (drag_pane == 1) { sp2 = rpath; dp2 = lpath; sb2 = rbuf; sc2 = rn; }
                                if (drag_row < sc2) {
                                    var srec2 = sb2 + drag_row * CRAB_REC_SZ;
                                    if (load8(srec2 + CRAB_REC_TYPE) != 0) {
                                        crab_set_notice("folders cannot be dragged yet — files only");
                                    } else {
                                        crab_strcpy_n(namescr, srec2, CRAB_NAME_MAX);
                                        var rcd2 = crab_fs_move(sp2, namescr, dp2, pathscr, pathscr2, statbuf);
                                        crab_set_notice(crab_fs_msg(rcd2));
                                        crab_say("crab: drag-move "); crab_say(namescr);
                                        crab_say(" -> "); crab_say(crab_fs_msg(rcd2)); crab_say("\n");
                                        ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                        crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                        lstate = crab_pane_state(ln, crab_listing_err());
                                        rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                        crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                        rstate = crab_pane_state(rn, crab_listing_err());
                                        if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                        if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                                    }
                                    dropped = 1;
                                }
                            }
                        }
                        if (dropped == 0) { crab_set_notice("dropped nowhere — drag to the other pane"); }
                        # ⛔ A DRAG IS NOT A CLICK. Consume the double-click pair, or the release that
                        # ended a drag would pair with the next press and descend.
                        last_pane = 0 - 1;
                        last_row = 0 - 1;
                    }
                    drag_pane = 0 - 1;
                    drag_row = 0 - 1;
                    dragging = 0;
                }
            }
            if (k == KEY) {
                var u = dh_event_a(ev);
                crab_say("crab: key received\n");
                # ⛔⛔ PRESS ONLY. crab asks for `SETU_SURF_FULL_KEYS` (see `crab_surface_flags`), so
                # every key now arrives TWICE — `mods` 1 on the press, 0 on the release. Acting on
                # both edges moves the selection two rows per Down and descends twice on Enter, the
                # second descend landing wherever the first left the selection. The compositor hit
                # exactly this on its own chrome handlers and measured it on the 2026-08-18 burn.
                # ⚠ `crab: key received` stays OUTSIDE the gate deliberately: it is the input-arrival
                # oracle the QEMU harnesses read, and it should count every event the wire delivered.
                # `crab: key press` below counts what crab ACTED on. The two together are what
                # distinguish "releases are arriving" from "releases are being acted on".
                # ⚠ TRACK THE EDGE BEFORE ACTING. A release must clear the latch even though it is
                # not acted on, or the key repeats forever after the operator lets go — the stuck-key
                # failure `SETU_SURF_FULL_KEYS` exists to make avoidable.
                if (crab_key_acts(dh_event_b(ev)) == 1) {
                    if (crab_key_repeats(u) == 1) {
                        held_key = u;
                        held_since = clock_now_ms();
                        held_last = held_since;
                    }
                    else { held_key = 0; }
                }
                else {
                    if (u == held_key) { held_key = 0; }      # release of the held key
                }
                if (crab_key_acts(dh_event_b(ev)) == 1) {
                    crab_say("crab: key press\n");
                    # ⚠ The pane facts the menu's enable rules need, read once per keypress.
                    var mcnt2 = ln; var mmkp = lmarks; var mbufp = lbuf; var mselp = sel_l;
                    if (active_pane == 1) { mcnt2 = rn; mmkp = rmarks; mbufp = rbuf; mselp = sel_r; }
                    var misdir2 = 0;
                    if (mcnt2 > 0) { misdir2 = load8(mbufp + mselp * CRAB_REC_SZ + CRAB_REC_TYPE); }
                    var mmark2 = crab_mark_count(mmkp, mcnt2);
                    # ⭐⭐ THE EDIT FIELD TAKES EVERY KEY WHILE IT IS OPEN, and returns before any binding
                    # below sees one. ⛔ A field that let `d` through would delete the file being renamed.
                    # Same shape as the delete confirmation one layer up: a modal surface owns the keyboard
                    # until it closes, and the layer being in the tree is what makes it modal on screen.
                    if (edit_open != 0) {
                        if (u == 0x29) {                                   # Esc — abandon
                            edit_open = 0;
                            crab_set_notice("cancelled");
                        } else {
                            if (u == 0x28) {                                   # Enter — commit
                                var epath = lpath; if (active_pane == 1) { epath = rpath; }
                                var erc = 0;
                                if (edit_open == 3) {
                                    # ⛔ QUEUE BY NAME FIRST. Each rename leaves the pane
                                    # buffer describing the PRE-rename
                                    # listing, so renaming the second entry by index would be safe only by accident.
                                    var bmk = lmarks; var bbuf = lbuf; var bcnt = ln;
                                    if (active_pane == 1) { bmk = rmarks; bbuf = rbuf; bcnt = rn; }
                                    crab_queue_marked(bbuf, bmk, bcnt);
                                    var bi = 1;
                                    var bfail = 0;
                                    var bdst = crab_batch_dst();
                                    var bnm = crab_queue_next();
                                    while (bnm != 0) {
                                        if (crab_batch_name(bdst, crab_edit_buf(), bi, bnm) < 0) { bfail = bfail + 1; }
                                        else {
                                            # ⚠ The expansion still faces the name guard —
                                            # `*` splices in a readdir name, so a
                                            # pattern really can produce `..` or a name carrying a separator.
                                            if (crab_fs_rename(epath, bnm, bdst, pathscr,
                                                pathscr2, statbuf) != CRAB_FS_OK) {
                                                bfail = bfail + 1;
                                            }
                                        }
                                        bi = bi + 1;
                                        bnm = crab_queue_next();
                                    }
                                    crab_queue_reset();
                                    if (bfail > 0) { erc = CRAB_FS_ESYS; } else { erc = CRAB_FS_OK; }
                                } else {
                                    if (edit_open == 2) {
                                        erc = crab_fs_mkdir(epath, crab_edit_buf(), pathscr, statbuf);
                                    } else {
                                        var erec = lbuf + sel_l * CRAB_REC_SZ;
                                        if (active_pane == 1) { erec = rbuf + sel_r * CRAB_REC_SZ; }
                                        crab_strcpy_n(namescr, erec, CRAB_NAME_MAX);
                                        erc = crab_fs_rename(epath, namescr, crab_edit_buf(),
                                          pathscr, pathscr2, statbuf);
                                    }
                                }
                                crab_set_notice(crab_fs_msg(erc));
                                crab_say("crab: edit commit -> "); crab_say(crab_fs_msg(erc)); crab_say("\n");
                                edit_open = 0;
                                ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                lstate = crab_pane_state(ln, crab_listing_err());
                                rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                rstate = crab_pane_state(rn, crab_listing_err());
                                if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                            }
                            if (u == 0x2A) { crab_edit_backspace(); }           # Backspace
                            if (u == 0x50) { crab_edit_move(0 - 1); }           # Left
                            if (u == 0x4F) { crab_edit_move(1); }               # Right
                            # ⚠ `mods` carries press/release, not shift — crab asked for FULL_KEYS, so there is no
                            # shift state on the wire yet. Names type lower-case until the compositor forwards
                            # modifiers; the map already takes the flag.
                            var ech = crab_key_char(u, 0);
                            if (ech != 0) { crab_edit_insert(ech); }
                        }
                    } else {
                        # ============ M4 — FILE OPERATIONS ============================================
                        # ⛔⛔ THE CONFIRMATION IS RESOLVED BEFORE ANY OTHER KEY IS LOOKED AT, and it
                        # consumes the keypress. Letting `y` fall through to the bindings below would
                        # make the confirming keystroke ALSO do whatever `y` means later — and the
                        # answer to "delete this file?" must do exactly one thing.
                        if (confirm_del == 1) {
                            confirm_del = 0;
                            crab_clear_notice();
                            if (u == 0x1C) {                                   # y — go ahead
                                var dpath = lpath; var dbuf2 = lbuf; var dsel = sel_l; var dcnt = ln;
                                if (active_pane == 1) { dpath = rpath; dbuf2 = rbuf; dsel = sel_r; dcnt = rn; }
                                var dmk = lmarks; if (active_pane == 1) { dmk = rmarks; }
                                var dmarked = crab_mark_count(dmk, dcnt);
                                if ((dcnt > 0) && (dmarked > 0)) {
                                    # ⭐ MARKED DELETE. Queued by NAME first, because each `crab_fs_delete`
                                    # is followed by nothing that re-lists — but the NEXT one indexes the
                                    # same buffer, and deleting by index while the buffer still describes
                                    # the pre-delete listing is only safe because nothing re-reads it in
                                    # between. Queuing by name removes that "only safe because" entirely.
                                    crab_queue_marked(dbuf2, dmk, dcnt);
                                    var dfails = 0;
                                    var dok = 0;
                                    var dnm = crab_queue_next();
                                    while (dnm != 0) {
                                        # ⚠ The type byte must be read BEFORE the queue advanced past the
                                        # record, so it is re-derived from the name's index instead.
                                        var di2 = crab_index_of(dbuf2, dcnt, dnm);
                                        var dis = 0;
                                        if (di2 >= 0) { dis = load8(dbuf2 + di2 * CRAB_REC_SZ + CRAB_REC_TYPE); }
                                        var rcm = crab_fs_delete(dpath, dnm, dis, pathscr);
                                        if (rcm == CRAB_FS_OK) { dok = dok + 1; } else { dfails = dfails + 1; }
                                        dnm = crab_queue_next();
                                    }
                                    crab_queue_reset();
                                    if (dfails > 0) { crab_set_notice("some entries could not be deleted"); }
                                    else { crab_set_notice("done"); }
                                    crab_say("crab: delete marked\n");
                                    ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                    crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                    lstate = crab_pane_state(ln, crab_listing_err());
                                    rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                    crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                    rstate = crab_pane_state(rn, crab_listing_err());
                                    if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                    if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                                }
                                if ((dcnt > 0) && (dmarked == 0)) {
                                    var drec = dbuf2 + dsel * CRAB_REC_SZ;
                                    var ddir = load8(drec + CRAB_REC_TYPE);
                                    # ⛔ COPY THE NAME OUT BEFORE THE RE-LISTING OVERWRITES THE RECORD.
                                    # `crab_relist` readdirs straight back into this buffer, so a name
                                    # still pointing into it afterwards describes a different file.
                                    crab_strcpy_n(namescr, drec, CRAB_NAME_MAX);
                                    # ⭐ A FOLDER IS A RECURSIVE DELETE NOW (M4). ⛔ It is the single
                                    # most destructive thing crab can do and it is NOT undoable — which
                                    # is why it sits behind the same y-confirmation, why the prompt says
                                    # "and everything in it", and why Esc stops it mid-walk.
                                    var rcd = 0;
                                    if (ddir != 0) {
                                        rcd = crab_walk_begin(CRAB_OP_DTREE, dpath, namescr, 0,
                                          pathscr, pathscr2, statbuf);
                                        if (rcd == CRAB_FS_OK) { crab_set_notice("deleting folder..."); }
                                        else { crab_set_notice(crab_fs_msg(rcd)); }
                                    } else {
                                        rcd = crab_fs_delete(dpath, namescr, ddir, pathscr);
                                        crab_set_notice(crab_fs_msg(rcd));
                                    }
                                    crab_say("crab: delete "); crab_say(namescr);
                                    crab_say(" -> "); crab_say(crab_fs_msg(rcd)); crab_say("\n");
                                    # ⚠ A tree delete is still RUNNING here — the idle tick relists when
                                    # it finishes. Relisting now would readdir a directory mid-removal.
                                    if (crab_op_active() == 0) {
                                        ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                        crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                        lstate = crab_pane_state(ln, crab_listing_err());
                                        rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                        crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                        rstate = crab_pane_state(rn, crab_listing_err());
                                        if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                        if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                                    }
                                }
                            } else { crab_say("crab: delete cancelled\n"); }
                        } else {
                            # ⚠ EVERY OTHER KEY CLEARS A STALE NOTICE. Without this the result of the last
                            # operation would sit over the status line for the rest of the session, and the
                            # operator would be reading an answer to a question they have stopped asking.
                            # ⛔ AND NAVIGATION LIVES INSIDE THIS `else`, NOT ABOVE IT. It used to sit before
                            # the confirmation gate, so an arrow or Enter answering "delete this?" ALSO moved
                            # the selection or descended — and then the gate cancelled, having already acted.
                            # The comment above this gate claimed keys were resolved here first; they were not.
                            if (crab_get_notice() != 0) { crab_clear_notice(); }
                            # ⭐⭐ ESC CANCELS A TRANSFER (M4, v0.7.3). ⛔ A STEPPED OPERATION THE
                            # OPERATOR CANNOT STOP IS A WORSE CONTROL THAN A BLOCKING ONE: the blocking
                            # version at least ended by itself. Shipped in the same change as the
                            # stepping, not after it.
                            # ⚠ Checked BEFORE every other binding and consumes the key, so Esc during a
                            # transfer cannot also mean whatever Esc comes to mean later.
                            # ⭐⭐ SPACE MARKS AND ADVANCES (M4 multi-select) — the Norton Commander
                            # gesture crab's whole layout descends from. Marking without advancing means
                            # two keys per file; advancing without marking is what the arrow keys do.
                            # ⚠ It advances even on the LAST row (where it cannot move), so the mark
                            # still lands — a toggle that silently did nothing at the bottom of a pane
                            # would look like a dropped keypress.
                            if (u == 0x2C) {                                       # Space
                                if (active_pane == 0) {
                                    crab_mark_toggle(lmarks, sel_l, ln);
                                    if (sel_l < crab_maxsel(ln)) { sel_l = sel_l + 1; }
                                } else {
                                    crab_mark_toggle(rmarks, sel_r, rn);
                                    if (sel_r < crab_maxsel(rn)) { sel_r = sel_r + 1; }
                                }
                            }
                            if (u == 0x29) {                                       # Esc
                                if (crab_op_active() == 1) {
                                    crab_copy_cancel();
                                    crab_set_notice("transfer cancelled");
                                    crab_say("crab: transfer cancelled\n");
                                    ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                    crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                    lstate = crab_pane_state(ln, crab_listing_err());
                                    rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                    crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                    rstate = crab_pane_state(rn, crab_listing_err());
                                    if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                    if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                                }
                            }
                            # ⭐⭐ THE GRID VIEW CHANGES WHAT AN ARROW MEANS, AND ONLY IN GRID MODE.
                            # ⛔ In a grid, Left/Right must move the CURSOR — a 2-D arrangement the
                            # operator can see has to answer the arrow that was pressed. But
                            # Left/Right also switch panes, and that binding predates this view.
                            # ⇒ In grid mode the ARROWS navigate the grid and `h`/`l` keep switching
                            # panes; in list mode nothing changes at all. crab has had the vim
                            # aliases since M2, so the pane switch never becomes unreachable.
                            # ⚠ THE STEP IS THE COLUMN COUNT THE PANE WAS LAID OUT WITH, read back
                            # from the widget rather than recomputed — `dh_grid_cols` reads the
                            # RESOLVED width, so "down" moves by the number of columns the operator
                            # can actually see. Recomputing it here from `panew` would be a second
                            # answer, free to disagree by one at exactly the widths that matter.
                            var gstep = 1;
                            if (view_mode == CRAB_VIEW_GRID) {
                                var apw = crab_pane_widget(active_pane);
                                if (apw != 0) { gstep = dh_grid_cols(apw); }
                                if (gstep < 1) { gstep = 1; }
                            }
                            if (u == 0x0B) { active_pane = 0; }                    # h — always a pane switch
                            if (u == 0x0F) { active_pane = 1; }                    # l — always a pane switch
                            if (u == 0x50) {                                       # Left
                                if (view_mode == CRAB_VIEW_GRID) {
                                    if (active_pane == 0) { if (sel_l > 0) { sel_l = sel_l - 1; } }
                                    if (active_pane == 1) { if (sel_r > 0) { sel_r = sel_r - 1; } }
                                } else { active_pane = 0; }
                            }
                            if (u == 0x4F) {                                       # Right
                                if (view_mode == CRAB_VIEW_GRID) {
                                    if (active_pane == 0) { if (sel_l < crab_maxsel(ln)) { sel_l = sel_l + 1; } }
                                    if (active_pane == 1) { if (sel_r < crab_maxsel(rn)) { sel_r = sel_r + 1; } }
                                } else { active_pane = 1; }
                            }
                            if ((u == 0x52) || (u == 0x0E)) {                      # Up / k
                                # ⚠ CLAMPED AT THE TOP ROW RATHER THAN REFUSED. dhancha's
                                # `dh_grid_move_sel` refuses a move off the edge, which is right for
                                # a widget; crab holds the selection itself (the 2026-08-27 ruling),
                                # and clamping keeps a partial top row reachable.
                                if (active_pane == 0) { if (sel_l >= gstep) { sel_l = sel_l - gstep; } else { sel_l = 0; } }
                                if (active_pane == 1) { if (sel_r >= gstep) { sel_r = sel_r - gstep; } else { sel_r = 0; } }
                            }
                            if ((u == 0x51) || (u == 0x0D)) {                      # Down / j
                                if (active_pane == 0) {
                                    if (sel_l + gstep <= crab_maxsel(ln)) { sel_l = sel_l + gstep; }
                                    else { sel_l = crab_maxsel(ln); }
                                }
                                if (active_pane == 1) {
                                    if (sel_r + gstep <= crab_maxsel(rn)) { sel_r = sel_r + gstep; }
                                    else { sel_r = crab_maxsel(rn); }
                                }
                            }
                            if (u == 0x0A) {                                       # g — cycle the view
                                # ⚠ A CYCLE, NOT A TOGGLE, and one key rather than three. Three views
                                # is still few enough that stepping through them is faster than
                                # remembering which key is which — the same argument the sort key
                                # makes for its four modes.
                                view_mode = view_mode + 1;
                                if (view_mode > CRAB_VIEW_GALLERY) { view_mode = CRAB_VIEW_LIST; }
                                if (view_mode == CRAB_VIEW_LIST) { crab_say("crab: view list\n"); }
                                if (view_mode == CRAB_VIEW_GRID) { crab_say("crab: view grid\n"); }
                                if (view_mode == CRAB_VIEW_GALLERY) { crab_say("crab: view gallery\n"); }
                                # ⛔ THE SCROLL OFFSETS ARE RESET. A list offset is a pixel count in
                                # rows of 26; a grid's is in rows of 32 holding three entries each.
                                # Carrying one across means landing somewhere unrelated to what was
                                # on screen — and `scroll_to` would clamp it, so it would not even
                                # look like a bug, just a jump nobody could explain.
                                store64(scroll_l, 0);
                                store64(scroll_r, 0);
                                crab_clear_notice();
                            }
                            # ⭐⭐ ENTER ON A FILE IS NO LONGER SILENT (M4). It used to reach
                            # `crab_descend`, which refuses a non-directory and returns -1 — and this
                            # site dropped that -1 with no else arm. So Enter on a file did nothing and
                            # SAID nothing, which the operator cannot tell from a keypress crab never
                            # received. That silence is what the roadmap's M4 section opens by naming.
                            # ⚠ THE TYPE BYTE DECIDES, NOT THE RETURN VALUE. Branching on `crab_descend`'s
                            # -1 would conflate "not a directory" with "the path was too long" — two
                            # different answers, and one of them must not launch anything.
                            if (u == 0x28) {                                       # Enter — descend, or OPEN
                                var epath = lpath; var ebuf = lbuf; var esel = sel_l; var ecnt = ln;
                                if (active_pane == 1) { epath = rpath; ebuf = rbuf; esel = sel_r; ecnt = rn; }
                                if (ecnt <= 0) { crab_set_notice("nothing to open"); }
                                else {
                                    if (load8(ebuf + esel * CRAB_REC_SZ + CRAB_REC_TYPE) != 0) {
                                        if (active_pane == 0) {
                                            var nl = crab_descend(lpath, lbuf, sel_l, ln, namescr, pathscr,
                                              lsizes, lmtimes, statbuf);
                                            if (nl >= 0) {
                                                ln = nl;
                                                crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                                lstate = crab_pane_state(ln, crab_listing_err());
                                                sel_l = 0;
                                                crab_log_cd(lpath);
                                            } else { crab_set_notice("cannot open that folder"); }
                                        }
                                        if (active_pane == 1) {
                                            var nr = crab_descend(rpath, rbuf, sel_r, rn, namescr, pathscr,
                                              rsizes, rmtimes, statbuf);
                                            if (nr >= 0) {
                                                rn = nr;
                                                crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                                rstate = crab_pane_state(rn, crab_listing_err());
                                                sel_r = 0;
                                                crab_log_cd(rpath);
                                            } else { crab_set_notice("cannot open that folder"); }
                                        }
                                    } else {
                                        crab_strcpy_n(namescr, ebuf + esel * CRAB_REC_SZ, CRAB_NAME_MAX);
                                        var rco = crab_fs_launch(epath, namescr, pathscr);
                                        crab_set_notice(crab_fs_msg(rco));
                                        crab_say("crab: open "); crab_say(namescr);
                                        crab_say(" -> "); crab_say(crab_fs_msg(rco)); crab_say("\n");
                                    }
                                }
                            }
                            # ⭐⭐ THE MENU OWNS THE KEYBOARD WHILE OPEN — the same rule as
                            # the edit field and the delete confirmation. ⛔ Checked BEFORE
                            # every binding below and it consumes the key, so `d` while the
                            # menu is open moves the highlight rather than deleting anything.
                            if (menu_open != 0) {
                                if (u == 0x29) { menu_open = 0; u = 0; }           # Esc — dismiss
                                else {
                                    if ((u == 0x52) || (u == 0x0E)) {
                                        menu_sel = crab_menu_prev(menu_sel, mcnt2, misdir2, mmark2);
                                        u = 0;
                                    }
                                    else { if ((u == 0x51) || (u == 0x0D)) {
                                            menu_sel = crab_menu_next(menu_sel, mcnt2, misdir2, mmark2);
                                            u = 0;
                                        }
                                        else { if (u == 0x28) {
                                                menu_open = 0;
                                                # ⚠ THE MENU DOES NOT REIMPLEMENT THE VERBS. It
                                                # rewrites `u` to the key the entry names and falls
                                                # through, so there is exactly ONE implementation of
                                                # each command and the accelerator column cannot
                                                # drift from what the entry actually does.
                                                u = 0;
                                                if (menu_sel == CRAB_MI_COPY) { u = 0x06; }
                                                if (menu_sel == CRAB_MI_MOVE) { u = 0x10; }
                                                if (menu_sel == CRAB_MI_RENAME) { u = 0x15; }
                                                if (menu_sel == CRAB_MI_DELETE) { u = 0x07; }
                                                if (menu_sel == CRAB_MI_NEWDIR) { u = 0x11; }
                                                if (menu_sel == CRAB_MI_OPEN) { u = 0x28; }
                                            } else { u = 0; } } }
                                }
                            }
                            # ⭐ r — RENAME the selected entry. `crab_fs_rename` has existed and been asserted since
                            # 0.7.1; this is the field that finally reaches it.
                            if (u == 0x15) {                                       # r
                                var rcnt = ln; var rrec = lbuf + sel_l * CRAB_REC_SZ;
                                if (active_pane == 1) { rcnt = rn; rrec = rbuf + sel_r * CRAB_REC_SZ; }
                                # ⭐⭐ A MARKED SET IS THE BATCH SHEET, NOT A RENAME. Renaming a set one name at a
                                # time is not what the operator asked for — which is why the menu greys single Rename
                                # the moment more than one entry is marked.
                                if (mmark2 > 1) {
                                    crab_edit_start("*");
                                    edit_open = 3;
                                    edit_label = "Rename pattern:  # = number, * = old name";
                                } else {
                                    if (rcnt > 0) {
                                        crab_edit_start(rrec);
                                        edit_open = 1;
                                        edit_label = "Rename to:";
                                    } else { crab_set_notice("nothing selected to rename"); }
                                }
                            }
                            # ⭐ n — NEW FOLDER. Same field, same keys, different commit.
                            if (u == 0x11) {                                       # n
                                crab_edit_start(0);
                                edit_open = 2;
                                edit_label = "New folder name:";
                            }
                            # ⭐ THE CONTEXT MENU. ⚠ KEYBOARD ONLY — the Menu key below is the
                            # ONLY thing in the program that sets `menu_open`, which is right for a
                            # crab that is keyboard-first by construction: a menu only a mouse can
                            # reach is invisible to an operator who never touches one.
                            # ⛔ THIS SAID "opened from the KEYBOARD as well as the pointer". THERE
                            # IS NO POINTER ROUTE, and that is an M6 gap rather than a stance:
                            # dhancha carries the button code in `POINTER_BTN`'s `a`, and crab's arm
                            # reads only `b` (press vs release) — so a RIGHT-click is
                            # indistinguishable from a left one and runs the ordinary path. Nor does
                            # the OPEN menu take a click: `crab_hit` resolves only the two pane
                            # LISTs, so there is no pointer selection and no click-away dismiss.
                            # ⚠ `menu_x`/`menu_y` below only PLACE the keyboard-opened menu at the
                            # last tracked pointer position; they do not open it.
                            if (u == 0x65) {                                       # the Menu key
                                menu_open = 1;
                                menu_sel = 0;
                                menu_x = ptr_x;
                                menu_y = ptr_y;
                            }
                            if (u == 0x07) {                                       # d — delete, with a confirmation
                                var qcnt = ln; if (active_pane == 1) { qcnt = rn; }
                                var qmk = lmarks; if (active_pane == 1) { qmk = rmarks; }
                                var nmark = crab_mark_count(qmk, qcnt);
                                if (qcnt > 0) {
                                    confirm_del = 1;
                                    # ⛔ THE PROMPT MUST SAY HOW MANY. "delete the selected entry?" in
                                    # front of a nine-file marked set is the most dangerous sentence in
                                    # the app — the operator answers the question they were asked.
                                    if (nmark > 0) { crab_set_notice("delete the MARKED entries?  y = yes, any other key = no"); }
                                    else {
                                        # ⛔ A FOLDER PROMPT MUST SAY WHAT ELSE GOES. "delete the selected
                                        # entry?" in front of a directory is technically true and
                                        # practically a lie — the operator answers the question asked.
                                        var qrec = lbuf + sel_l * CRAB_REC_SZ;
                                        if (active_pane == 1) { qrec = rbuf + sel_r * CRAB_REC_SZ; }
                                        if (load8(qrec + CRAB_REC_TYPE) != 0) {
                                            crab_set_notice("delete this FOLDER and everything in it?  y = yes");
                                        } else {
                                            crab_set_notice("delete the selected entry?  y = yes, any other key = no");
                                        }
                                    }
                                } else { crab_set_notice("nothing selected to delete"); }
                            }
                            # ⭐ COPY AND MOVE GO TO THE OTHER PANE, WHICH IS WHAT THE SECOND PANE IS FOR.
                            # This is the Norton-Commander idiom crab's whole layout is built on: the
                            # destination is not typed, it is the directory already open opposite. It also
                            # means M4's first write operations need no text entry at all.
                            # ⚠ NOT BOUND TO F5/F6. aethersafha takes F5 for maximize (`win_notify_resize`),
                            # so a client binding it would never see the key.
                            if ((u == 0x06) || (u == 0x10)) {                      # c — copy / m — move
                                var srcp = lpath; var dstp = rpath; var sbuf2 = lbuf; var ssel = sel_l; var scnt = ln;
                                if (active_pane == 1) { srcp = rpath; dstp = lpath; sbuf2 = rbuf; ssel = sel_r; scnt = rn; }
                                if (scnt <= 0) { crab_set_notice("nothing selected"); }
                                else {
                                    var srec = sbuf2 + ssel * CRAB_REC_SZ;
                                    crab_strcpy_n(namescr, srec, CRAB_NAME_MAX);
                                    # ⭐ MARKS OUTRANK THE CURSOR, and with nothing marked the cursor IS the
                                    # selection — so an operator who never presses Space sees no change at all.
                                    # ⛔⛔ THIS IS READ **BEFORE** THE CURSOR'S TYPE, AND THAT ORDER IS THE FIX.
                                    # It used to sit inside the not-a-folder arm, so the rule above was true only
                                    # when the cursor happened to be on a file: marking five files and leaving the
                                    # cursor on a sixth entry that was a FOLDER silently discarded all five marks
                                    # and acted on the folder instead. The comment claimed the opposite three
                                    # lines away from the code that broke it.
                                    var smk = lmarks; if (active_pane == 1) { smk = rmarks; }
                                    var smarked = crab_mark_count(smk, scnt);
                                    # ⛔⛔ THE RULE ITSELF LIVES IN `crab_transfer_plan`, NOT HERE, and that is
                                    # deliberate: everything in this file between the `#ifdef` at 263 and the
                                    # `#endif` at 1484 is invisible to every test crab has — no `#else`, and
                                    # nothing includes `main.cyr`. Both defects this branch shipped were
                                    # decisions, not wiring, so the decision moved somewhere the suite can reach
                                    # it and this stays a dispatch.
                                    var isdirsel = 0;
                                    if (load8(srec + CRAB_REC_TYPE) != 0) { isdirsel = 1; }
                                    var ismv = 0;
                                    if (u == 0x10) { ismv = 1; }
                                    var plan = crab_transfer_plan(ismv, smarked, isdirsel);
                                    if ((plan == CRAB_PLAN_TREE) || (plan == CRAB_PLAN_NOMOVEDIR)) {
                                        if (plan == CRAB_PLAN_NOMOVEDIR) {
                                            crab_set_notice(
                                              "folders cannot be moved yet — copy it, then delete the original");
                                            crab_say("crab: move tree refused "); crab_say(namescr); crab_say("\n");
                                        } else {
                                            # ⭐ A FOLDER IS A RECURSIVE COPY NOW (M4). The tray is what makes it
                                            # acceptable: it shows what is happening and Esc stops it.
                                            var rct = crab_walk_begin(CRAB_OP_CTREE, srcp, namescr, dstp,
                                              pathscr, pathscr2, statbuf);
                                            if (rct == CRAB_FS_OK) { crab_set_notice("copying folder..."); }
                                            else { crab_set_notice(crab_fs_msg(rct)); }
                                            crab_say("crab: copy tree "); crab_say(namescr); crab_say("\n");
                                        }
                                    } else {
                                        # ⚠ A MARKED FOLDER REACHES THE QUEUE AND IS REFUSED THERE, by
                                        # `crab_copy_begin`'s `EISDIR` guard — it does not silently become a
                                        # recursive copy. Marking a mixed set transfers the files and says so;
                                        # recursing per marked folder is a separate operation and a separate
                                        # ruling. `crab_queue_advance` skips each refusal and keeps going.
                                        if (smarked > 0) {
                                            var qkind = CRAB_OP_COPY;
                                            if (u == 0x10) { qkind = CRAB_OP_MOVE; }
                                            crab_queue_marked(sbuf2, smk, scnt);
                                            crab_queue_dirs(qkind, srcp, dstp);
                                            var qn0 = crab_queue_advance(pathscr, pathscr2, statbuf);
                                            if (qn0 == 1) { crab_set_notice("transferring..."); }
                                            else { crab_set_notice("nothing could be transferred"); }
                                            crab_say("crab: transfer marked\n");
                                        }
                                        var rcc = 0;
                                        # ⭐ A MOVE STILL TRIES `rename` FIRST and only steps when it
                                        # refuses — the common case (both panes on one filesystem) never
                                        # reads a byte, finishes instantly, and shows no bar at all.
                                        var started = 0;
                                        if (smarked > 0) { started = 0 - 1; }
                                        if ((smarked == 0) && (u == 0x10)) {
                                            rcc = crab_fs_move(srcp, namescr, dstp, pathscr, pathscr2, statbuf);
                                            if (rcc == CRAB_FS_OK) { started = 0; }
                                            else { started = 1; }
                                        }
                                        if ((smarked == 0) && (u != 0x10)) { started = 1; }
                                        if (started == 1) {
                                            var okind = CRAB_OP_COPY;
                                            if (u == 0x10) { okind = CRAB_OP_MOVE; }
                                            rcc = crab_copy_begin(okind, srcp, namescr, dstp, pathscr, pathscr2, statbuf);
                                            # ⚠ OK here means STARTED, not finished — the idle tick
                                            # carries it from now on and reports the outcome.
                                            if (rcc == CRAB_FS_OK) { crab_set_notice("transferring..."); }
                                            else { crab_set_notice(crab_fs_msg(rcc)); }
                                        } else { if (started == 0) { crab_set_notice(crab_fs_msg(rcc)); } }
                                        if (u == 0x06) { crab_say("crab: copy "); } else { crab_say("crab: move "); }
                                        crab_say(namescr); crab_say(" -> "); crab_say(crab_fs_msg(rcc)); crab_say("\n");
                                        if (crab_op_active() == 0) {
                                            ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                            crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                            lstate = crab_pane_state(ln, crab_listing_err());
                                            rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                            crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                            rstate = crab_pane_state(rn, crab_listing_err());
                                            if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                                            if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                                        }
                                    }
                                }
                            }
                            # ============ end M4 =========================================================
                            if (u == 0x16) {                                       # s — cycle the sort mode
                                # ⛔ RE-SORT BOTH PANES, not the active one. The mode is a property of the VIEW,
                                # and two panes ordered differently is a display that cannot be reasoned about —
                                # the operator would have to remember which pane they pressed `s` in.
                                # ⭐ AND *#34* PAID FOR THE SELECTION FOLLOWING THE RE-SORT. An earlier cut
                                # reset both panes to 0 and said so; with `crab_index_of` the cursor stays on
                                # the file the operator was looking at, which is the point of re-sorting.
                                # ⛔ CAPTURE BOTH NAMES BEFORE EITHER SORT — `crab_sort_entries` permutes in
                                # place, so a name read after the first sort is already the wrong row's.
                                var lkeep = alloc(CRAB_NAME_MAX);
                                var rkeep = alloc(CRAB_NAME_MAX);
                                if (ln > 0) { crab_strcpy_n(lkeep, lbuf + sel_l * CRAB_REC_SZ, CRAB_NAME_MAX); }
                                if (rn > 0) { crab_strcpy_n(rkeep, rbuf + sel_r * CRAB_REC_SZ, CRAB_NAME_MAX); }
                                var sm = crab_sort_cycle();
                                # ⛔ A SIZE OR MTIME ORDER CANNOT BE COMPUTED FROM PARTIAL DATA (*#03*). The
                                # deferred sweep may still have entries pending, and sorting on the -2 marker
                                # would tie every unstat'd file at the bottom and then visibly reshuffle the
                                # list as batches landed. So this mode change pays the storm, once, on the
                                # keypress that asked for it — and NAME and KIND still pay nothing.
                                if (crab_sort_needs_stats(sm) == 1) {
                                    crab_stat_batch(lpath, lbuf, ln, lsizes, lmtimes, pathscr, statbuf, ln);
                                    crab_stat_batch(rpath, rbuf, rn, rsizes, rmtimes, pathscr, statbuf, rn);
                                }
                                crab_sort_entries(lbuf, lsizes, lmtimes, ln, sm);
                                crab_sort_entries(rbuf, rsizes, rmtimes, rn, sm);
                                # ⛔⛔ A RE-SORT PERMUTES THE ENTRIES, SO EVERY MARK NOW POINTS AT A
                                # DIFFERENT FILE. This is the subtlest way a mark set goes stale — the
                                # listing did not change, only its ORDER, so nothing else here notices.
                                # `crab_index_of` follows the CURSOR through the permutation because it
                                # tracks one name; doing that for an arbitrary mark set means carrying
                                # every marked name through the sort, which is the queue's job.
                                crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                sel_l = 0;
                                sel_r = 0;
                                if (ln > 0) { var nl = crab_index_of(lbuf, ln, lkeep); if (nl >= 0) { sel_l = nl; } }
                                if (rn > 0) { var nr = crab_index_of(rbuf, rn, rkeep); if (nr >= 0) { sel_r = nr; } }
                                crab_say("crab: sort ");
                                crab_say(crab_sort_name(sm));
                                crab_say("\n");
                            }
                            if (u == 0x13) {                                       # p — the preview column
                                # ⛔ THE TOGGLE FLIPS EVEN WHEN THE WINDOW CANNOT HONOUR IT, and the
                                # refusal is reported rather than swallowed. Storing the operator's
                                # WANT separately from what fits means a window later resized wide
                                # enough shows the preview without a second keypress — and a key
                                # that silently does nothing is indistinguishable from a broken one.
                                # ⚠ Same discipline as `crab_resize_wanted`: refuse out loud.
                                if (pv_open == 0) { pv_open = 1; } else { pv_open = 0; }
                                if (pv_open == 1) {
                                    if (crab_preview_fit(w, 1) == 0) {
                                        crab_set_notice("preview needs a wider window");
                                    } else { crab_clear_notice(); crab_say("crab: preview on\n"); }
                                } else { crab_clear_notice(); crab_say("crab: preview off\n"); }
                            }
                            if (u == 0x2A) {                                       # Backspace — ascend to the parent
                                # ⭐ SELECTION MEMORY (*#34*). Capture the leaf BEFORE the ascend — the ascend rewrites
                                # `path` in place, so afterwards there is nothing left to look for.
                                # ⚠ `crab_index_of` answering -1 is a REAL outcome, not a failure: the directory can have
                                # been removed or renamed between the two readdirs. Landing on 0 is right there; guessing
                                # an index is not.
                                if (active_pane == 0) {
                                    var lleaf = crab_leaf_name(lpath, namescr, CRAB_NAME_MAX);
                                    var al = crab_ascend(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                                    if (al >= 0) {
                                        ln = al;
                                        crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                                        lstate = crab_pane_state(ln, crab_listing_err());
                                        sel_l = 0;
                                        if (lleaf >= 0) { var li = crab_index_of(lbuf, ln, namescr); if (li >= 0) { sel_l = li; } }
                                        crab_log_cd(lpath);
                                    }
                                }
                                if (active_pane == 1) {
                                    var rleaf = crab_leaf_name(rpath, namescr, CRAB_NAME_MAX);
                                    var ar = crab_ascend(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                                    if (ar >= 0) {
                                        rn = ar;
                                        crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                                        rstate = crab_pane_state(rn, crab_listing_err());
                                        sel_r = 0;
                                        if (rleaf >= 0) { var ri = crab_index_of(rbuf, rn, namescr); if (ri >= 0) { sel_r = ri; } }
                                        crab_log_cd(rpath);
                                    }
                                }
                            }
                        }                                  # end of the M4 confirmation `else`
                    }                                  # end of the EDIT-FIELD `else`
                }
            }
            # ⛔ DO NOT REPAINT A WINDOW THAT IS GONE. This render + 334 KB shm write used to run
            # unconditionally, including on the WINDOW_CLOSE and EOF paths — drawing one last frame
            # into a surface the compositor had just destroyed, and leaking a full render to do it.
            if (running == 1) {
                # ⚠ WHICH PANE THE PREVIEW DESCRIBES — the ACTIVE one, the same pane the status line reads.
                var apath = lpath; var abuf2 = lbuf; var asel2 = sel_l; var acount = ln;
                if (active_pane == 1) { apath = rpath; abuf2 = rbuf; asel2 = sel_r; acount = rn; }
                crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                crab_rs_preview(rs, pv_open);
                crab_rs_view(rs, view_mode);
                # ⭐ THE DIMENSIONS ARE READ HERE, NOT IN THE RENDERER, because the read needs a syscall and
                # `src/ui.cyr` sits below the layer that owns them. ⚠ `crab_preview_dims` is MEMOISED on
                # (directory, name) and returns early on a non-image, so this costs nothing per frame — only
                # the frame after the selection actually moves to a new image pays an open/read/close.
                # ⚠ AND ONLY WHILE THE PREVIEW IS OPEN. A closed preview reads no files at all.
                if (pv_open == 1) {
                    if (acount > 0) {
                        crab_preview_dims(apath, abuf2 + asel2 * CRAB_REC_SZ, pvdims, pathscr);
                    } else { store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0); }
                }
                crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                var s2 = crab_render(surf, 0, rs);
                if (s2 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                else {
                    setu_buf_write(buf_id, sd_surface_pixels(s2), nbytes);
                    # ⛔ RE-ATTACH ONLY AFTER A RESIZE, AND ONLY AFTER THE PIXELS ARE WRITTEN. crab's
                    # steady state is a LIVE buffer — write in place, no re-present — which is why
                    # this is not in the normal path. But the compositor holds the OLD extent and the
                    # OLD buffer id until an ATTACH says otherwise, so a resize that skipped this
                    # would render at the new size into a buffer nothing reads at that size.
                    # ⚠ ORDER: write, then ATTACH, then COMMIT — the same order `setu_client_present`
                    # uses, because the compositor re-reads the id it holds on each commit.
                    if (resized == 1) {
                        resized = 0;
                        if (setu_send(fd, setu_attach_buf(sid, w, h, stride, 1, buf_id)) < 0) {
                            crab_say("crab: re-attach failed after resize -- exiting\n");
                            running = 0;
                        }
                        elif (setu_send(fd, setu_commit(sid)) < 0) {
                            crab_say("crab: re-commit failed after resize -- exiting\n");
                            running = 0;
                        }
                    }
                }
            }
        }
        # ⛔⛔ `sys_pause` (#14), NOT `sys_sleep_ms` (#41). THIS EXACT LINE WAS A REGRESSION IN A
        # 0.5.0 DRAFT AND QEMU CAUGHT IT — no host test could have.
        #
        # The draft used `sys_sleep_ms(16)` to slow the idle poll. `sleep_ms` is the DOOM frame-pacing
        # primitive: it calls **`preempt_disable()`** and then `hlt`s in a loop until the tick target
        # (kernel/core/syscall.cyr, `num == 41`). Its own comment says the quiet part out loud —
        # *"we can't be preempted off mid-sleep"*. That is correct for a game that owns the machine
        # and catastrophic for a desktop client: while crab slept, **nothing else could be
        # scheduled**. Measured against `puka-terminal-test.py`: clients placed 2, clients
        # **presented 0**, `aethersafha --clients` never finished. The 0.4.15 baseline on the same
        # harness scored presented 2 and exit 95. crab did not just fail to yield — it stopped the
        # compositor from running at all.
        #
        # ⭐ `pause` (#14) is the primitive this loop actually wants: the syscall handler **yields to
        # a ready proc first**, and only falls through to a safe IF=1 `hlt` when nothing else is
        # runnable. So other processes get the CPU, and when the machine really is idle crab waits on
        # an interrupt instead of spinning — which is also what bounds `dh_setu_poll_event`'s ~80 B
        # per-poll leak until that dhancha gate closes.
        # ⚠ It is NOT `sys_sched_yield`: yield hands off but comes straight back, so an idle desktop
        # still spins a core at poll speed. `pause` is yield-then-wait.
        #
        # Idle only. An event just handled means more may be queued — drain at full speed.
        # ⭐⭐ THE REPEAT TICK. `sys_pause` (#14) is already a BOUNDED wait — measured 0-4 ms on a real
        # kernel, because a device IRQ or the 100 Hz timer wakes its single `hlt`. So the idle path
        # runs often enough to drive repeat with nothing but a clock check.
        # ⛔ AND IT MUST NOT BECOME `sys_sleep_ms`. That syscall `preempt_disable()`s for its whole
        # duration and froze the entire desktop — see the ⛔ below. `pause` disables preemption for
        # ONE hlt, which is the difference.
        if (running == 1) {
            if (held_key != 0) {
                var rnow = clock_now_ms();
                if (crab_repeat_due(rnow - held_since, rnow - held_last) == 1) {
                    held_last = rnow;
                    if ((held_key == 0x52) || (held_key == 0x0E)) {          # Up / k
                        if (active_pane == 0) { if (sel_l > 0) { sel_l = sel_l - 1; } }
                        if (active_pane == 1) { if (sel_r > 0) { sel_r = sel_r - 1; } }
                    }
                    if ((held_key == 0x51) || (held_key == 0x0D)) {          # Down / j
                        if (active_pane == 0) { if (sel_l < crab_maxsel(ln)) { sel_l = sel_l + 1; } }
                        if (active_pane == 1) { if (sel_r < crab_maxsel(rn)) { sel_r = sel_r + 1; } }
                    }
                    crab_say("crab: key repeat\n");
                    # ⚠ WHICH PANE THE PREVIEW DESCRIBES — the ACTIVE one, the same pane the status line reads.
                    var apath = lpath; var abuf2 = lbuf; var asel2 = sel_l; var acount = ln;
                    if (active_pane == 1) { apath = rpath; abuf2 = rbuf; asel2 = sel_r; acount = rn; }
                    crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                    crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                    crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                    crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                    crab_rs_preview(rs, pv_open);
                    crab_rs_view(rs, view_mode);
                    # ⭐ THE DIMENSIONS ARE READ HERE, NOT IN THE RENDERER, because the read needs a syscall and
                    # `src/ui.cyr` sits below the layer that owns them. ⚠ `crab_preview_dims` is MEMOISED on
                    # (directory, name) and returns early on a non-image, so this costs nothing per frame — only
                    # the frame after the selection actually moves to a new image pays an open/read/close.
                    # ⚠ AND ONLY WHILE THE PREVIEW IS OPEN. A closed preview reads no files at all.
                    if (pv_open == 1) {
                        if (acount > 0) {
                            crab_preview_dims(apath, abuf2 + asel2 * CRAB_REC_SZ, pvdims, pathscr);
                        } else { store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0); }
                    }
                    crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                    crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                    crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                    var s3 = crab_render(surf, 0, rs);
                    if (s3 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                    else { setu_buf_write(buf_id, sd_surface_pixels(s3), nbytes); }
                }
            }
        }
        # ⭐⭐ THE DEFERRED STAT DRAIN (*#03*). The listing marks entries pending and returns; the sizes
        # arrive here, a bounded batch at a time, so the keystroke that descends costs no syscalls at
        # all. Measured cost of the old behaviour: ~1.1 ms per entry, i.e. ~1.1 s at the 1024 cap.
        # ⛔ IDLE ONLY (`ev == 0`), FOR THE SAME REASON `sys_pause` IS. An event just handled means
        # more may be queued, and spending 35 ms statting ahead of them is exactly the input latency
        # this change exists to remove.
        # ⚠ ONE PANE PER TICK, LEFT FIRST — not both. Draining both would double the tick's cost and
        # give back half of what the batching bought.
        # ⭐⭐ THE TRANSFER STEP (M4, v0.7.3) — DRIVEN BY THE SAME IDLE TICK AS THE STAT DRAIN, and
        # placed BEFORE it deliberately: a transfer the operator started and is watching outranks
        # filling in size columns they have not asked about. Both are bounded, so neither starves.
        # ⛔ THIS IS WHAT MAKES A PROGRESS BAR MEAN ANYTHING. The copy used to run to completion
        # inside the keypress branch, so the loop drew no frames while it ran — a bar driven from
        # that renders once at 0 %, never repaints, and vanishes. dhancha 0.9.22 shipping `PROGRESS`
        # did not fix that; this does.
        if ((running == 1) && (ev == 0)) {
            if (crab_op_active() == 1) {
                var cstep = crab_copy_step();
                if (cstep != 1) {
                    # ⭐ ADVANCE THE QUEUE BEFORE REPORTING. A multi-file transfer should look like ONE
                    # continuous operation, not N separate ones flashing "done" between files.
                    # ⚠ A REFUSAL DOES NOT STOP THE QUEUE — one file already present at the
                    # destination must not abandon the other nine. Only a cancel stops everything.
                    var more = crab_queue_advance(pathscr, pathscr2, statbuf);
                    if (more == 1) { cstep = 1; }
                    # Finished or failed. Both panes are stale: the source lost an entry on a move,
                    # the destination gained one either way.
                    if (more != 1) {
                        crab_set_notice(crab_fs_msg(cstep));
                        crab_say("crab: transfer -> "); crab_say(crab_fs_msg(cstep)); crab_say("\n");
                    }
                    ln = crab_relist(lpath, lbuf, lsizes, lmtimes, pathscr, statbuf);
                    crab_mark_clear(lmarks, CRAB_MAX_ENTRIES);
                    lstate = crab_pane_state(ln, crab_listing_err());
                    rn = crab_relist(rpath, rbuf, rsizes, rmtimes, pathscr, statbuf);
                    crab_mark_clear(rmarks, CRAB_MAX_ENTRIES);
                    rstate = crab_pane_state(rn, crab_listing_err());
                    if (sel_l > crab_maxsel(ln)) { sel_l = crab_maxsel(ln); }
                    if (sel_r > crab_maxsel(rn)) { sel_r = crab_maxsel(rn); }
                }
                # ⚠ REDRAW EVERY STEP, not only on completion — the bar moving IS the point, and a
                # tray that updates once at the end is the blocking copy with extra steps.
                # ⚠ WHICH PANE THE PREVIEW DESCRIBES — the ACTIVE one, the same pane the status line reads.
                var apath = lpath; var abuf2 = lbuf; var asel2 = sel_l; var acount = ln;
                if (active_pane == 1) { apath = rpath; abuf2 = rbuf; asel2 = sel_r; acount = rn; }
                crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                crab_rs_preview(rs, pv_open);
                crab_rs_view(rs, view_mode);
                # ⭐ THE DIMENSIONS ARE READ HERE, NOT IN THE RENDERER, because the read needs a syscall and
                # `src/ui.cyr` sits below the layer that owns them. ⚠ `crab_preview_dims` is MEMOISED on
                # (directory, name) and returns early on a non-image, so this costs nothing per frame — only
                # the frame after the selection actually moves to a new image pays an open/read/close.
                # ⚠ AND ONLY WHILE THE PREVIEW IS OPEN. A closed preview reads no files at all.
                if (pv_open == 1) {
                    if (acount > 0) {
                        crab_preview_dims(apath, abuf2 + asel2 * CRAB_REC_SZ, pvdims, pathscr);
                    } else { store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0); }
                }
                crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                var s5 = crab_render(surf, 0, rs);
                if (s5 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                else { setu_buf_write(buf_id, sd_surface_pixels(s5), nbytes); }
            }
        }
        # ⭐⭐ THE THUMBNAIL DECODE (M5) — ON THE IDLE TICK, NEVER ON THE KEYSTROKE PATH.
        # ⛔ IDLE ONLY (`ev == 0`), for the same reason the stat drain and the transfer step are: an
        # event just handled means more may be queued, and a decode is the most expensive thing crab
        # does. The metadata appears immediately; the picture arrives a tick later.
        # ⛔ AT MOST ONE DECODE PER TICK, and that is the finest granularity available — chitra's
        # entry point is a single call that returns an image or does not, so a decode cannot be
        # resumed the way `crab_copy_step` and `crab_walk_step` can. "Bounded work per tick" here
        # means "at most one image".
        # ⚠ AFTER the transfer step and BEFORE the stat drain: a transfer the operator started
        # outranks a picture they have not seen yet, and a picture they are looking at outranks size
        # columns they have not asked about. All three are bounded, so none starves.
        # ⚠ `crab_thumb_step` is MEMOISED on the full path — including a remembered REFUSAL — so an
        # unchanged selection costs one string compare and nothing else. A tick does not re-decide a
        # file it has already declined.
        # ⛔ ONLY WHILE THE PREVIEW IS OPEN. A closed preview decodes nothing and spends nothing,
        # which matters more here than anywhere else in crab: the spend is PERMANENT.
        # ⭐⭐ THE GALLERY'S FILL — one decode per idle tick, in index order, and it stops on its own.
        # ⛔ THE VIEW NEVER TRIGGERS WORK; THE TICK DOES. `crab_pane` draws whatever the cache
        # already holds and draws a name where it holds nothing, so opening a gallery of a thousand
        # files costs one frame. The pictures arrive at one per tick and the operator watches them
        # land — the same shape as the deferred stat sweep and the stepped copy.
        # ⛔ AND IT STOPS BY ITSELF, THREE WAYS: the walk ends at the entry count, `crab_thumb_step`
        # caches refusals so a file it declined is never retried, and the session budget refuses
        # every decode once it is spent. None of those needs a flag here.
        # ⚠ THE ACTIVE PANE ONLY. Filling both would double the tick's cost and halve the rate at
        # which the pane the operator is looking at fills in.
        if ((running == 1) && (ev == 0)) {
            if (view_mode == CRAB_VIEW_GALLERY) {
                var qpath = lpath; var qbuf = lbuf; var qcnt = ln;
                if (active_pane == 1) { qpath = rpath; qbuf = rbuf; qcnt = rn; }
                # ⛔⛔ SECURITY AUDIT F1 — ONLY WHAT THE OPERATOR CAN SEE. This walk covered the whole
                # pane, so opening a folder ran the decoders over every image in it. `chitra` +
                # `sankoch` are ~22,500 lines running in-process on bytes someone else chose, and the
                # budgets bound memory rather than the code paths a crafted file reaches.
                # ⇒ Scrolling is consent; opening a folder is not.
                # ⚠ A pane that was not drawn (solo mode) has no widget and no visible range, so it
                # decodes nothing at all — which is correct: nothing of it is on screen.
                var qvis = crab_vis_buf();
                var qfirst = 0;
                var qlast = 0 - 1;
                if (crab_grid_visible(crab_pane_widget(active_pane), qvis, qcnt) == 1) {
                    qfirst = load64(qvis);
                    qlast = load64(qvis + 8);
                }
                var qi = qfirst;
                var qdid = 0;
                while (qi <= qlast) {
                    var qrec = qbuf + qi * CRAB_REC_SZ;
                    if (load8(qrec + CRAB_REC_TYPE) == 0) {
                        if (crab_is_image(qrec) == 1) {
                            if (crab_fs_path(pathscr, qpath, qrec) >= 0) {
                                if (crab_tc_find(pathscr) < 0) {
                                    crab_thumb_step(qpath, qrec, pathscr);
                                    qdid = 1;
                                    qi = qlast;
                                }
                            }
                        }
                    }
                    qi = qi + 1;
                }
                # ⚠ REDRAW ONLY WHEN A PICTURE ACTUALLY LANDED. Repainting on every tick once the
                # gallery is full turns the idle loop into a busy loop drawing the same frame.
                if (qdid == 1) {
                    crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                    crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                    crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                    crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                    crab_rs_preview(rs, pv_open);
                    crab_rs_view(rs, view_mode);
                    crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                    crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                    crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                    var s7 = crab_render(surf, 0, rs);
                    if (s7 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                    else { setu_buf_write(buf_id, sd_surface_pixels(s7), nbytes); }
                }
            }
        }
        if ((running == 1) && (ev == 0)) {
            if (pv_open == 1) {
                var tpath = lpath; var tbuf = lbuf; var tsel = sel_l; var tcnt = ln;
                if (active_pane == 1) { tpath = rpath; tbuf = rbuf; tsel = sel_r; tcnt = rn; }
                if (tcnt > 0) {
                    var tbefore = crab_thumb_state();
                    var tafter = crab_thumb_step(tpath, tbuf + tsel * CRAB_REC_SZ, pathscr);
                    # ⚠ REDRAW ONLY WHEN THE ANSWER CHANGED. A decode that was already cached — the
                    # common case on every subsequent tick — must not repaint the window, or the
                    # idle loop becomes a busy loop drawing the same frame forever.
                    if (tafter != tbefore) {
                        crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                        crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                        crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                        crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                        crab_rs_preview(rs, pv_open);
                        crab_rs_view(rs, view_mode);
                        crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                        crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                        crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                        var s6 = crab_render(surf, 0, rs);
                        if (s6 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                        else { setu_buf_write(buf_id, sd_surface_pixels(s6), nbytes); }
                    }
                }
            }
        }
        if ((running == 1) && (ev == 0)) {
            var sdone = crab_stat_batch(lpath, lbuf, ln, lsizes, lmtimes, pathscr, statbuf, CRAB_STAT_BATCH);
            if (sdone == 0) {
                sdone = crab_stat_batch(rpath, rbuf, rn, rsizes, rmtimes, pathscr, statbuf, CRAB_STAT_BATCH);
            }
            if (sdone > 0) {
                # ⚠ ONE LINE PER SWEEP, AND IT IS THE ONLY WAY TO SEE THE DRAIN FROM OUTSIDE. The
                # batch itself is silent by design; without this a harness cannot tell a drain that
                # completed from one that never ran, and "the sizes fill in" would be an assumption.
                # It fires once because `sdone > 0` means work happened on THIS tick, and the pending
                # scan only reaches -1 on the tick that finishes the pane.
                if (crab_stat_next_pending(lsizes, ln, 0) == 0 - 1) {
                    if (crab_stat_next_pending(rsizes, rn, 0) == 0 - 1) {
                        crab_say("crab: stat-drain complete\n");
                    }
                }
                # ⚠ WHICH PANE THE PREVIEW DESCRIBES — the ACTIVE one, the same pane the status line reads.
                var apath = lpath; var abuf2 = lbuf; var asel2 = sel_l; var acount = ln;
                if (active_pane == 1) { apath = rpath; abuf2 = rbuf; asel2 = sel_r; acount = rn; }
                crab_rs_pane(rs, 0, lbuf, ln, lpath, lsizes, lmtimes, lstate, lmarks, sel_l, scroll_l);
                crab_rs_pane(rs, 1, rbuf, rn, rpath, rsizes, rmtimes, rstate, rmarks, sel_r, scroll_r);
                crab_rs_op(rs, crab_op_name(), crab_op_done(), crab_op_total(), crab_op_rate(), crab_op_eta());
                crab_rs_chrome(rs, active_pane, menu_open, menu_x, menu_y, menu_sel, edit_open, edit_label);
                crab_rs_preview(rs, pv_open);
                crab_rs_view(rs, view_mode);
                # ⭐ THE DIMENSIONS ARE READ HERE, NOT IN THE RENDERER, because the read needs a syscall and
                # `src/ui.cyr` sits below the layer that owns them. ⚠ `crab_preview_dims` is MEMOISED on
                # (directory, name) and returns early on a non-image, so this costs nothing per frame — only
                # the frame after the selection actually moves to a new image pays an open/read/close.
                # ⚠ AND ONLY WHILE THE PREVIEW IS OPEN. A closed preview reads no files at all.
                if (pv_open == 1) {
                    if (acount > 0) {
                        crab_preview_dims(apath, abuf2 + asel2 * CRAB_REC_SZ, pvdims, pathscr);
                    } else { store64(pvdims + CRAB_IMG_W, 0); store64(pvdims + CRAB_IMG_H, 0); }
                }
                crab_rs_dims(rs, load64(pvdims + CRAB_IMG_W), load64(pvdims + CRAB_IMG_H));
                crab_rs_thumb(rs, crab_thumb_pixels(), crab_thumb_state());
                crab_rs_exif(rs, crab_preview_camera(), crab_preview_shot());
                var s4 = crab_render(surf, 0, rs);
                if (s4 == 0) { crab_say("crab: render failed -- exiting\n"); running = 0; }
                else { setu_buf_write(buf_id, sd_surface_pixels(s4), nbytes); }
            }
        }
        if ((running == 1) && (ev == 0)) { sys_pause(); }
    }
    #endif
    dh_client_close(c);          # symmetry: connected through the toolkit, close through it too
    return 0;
}

fn _entry(): i64 { var r = main(); syscall(SYS_EXIT, r); return 0; }
_entry();
