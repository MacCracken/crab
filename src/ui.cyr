# crab UI — the dual-pane file-manager widget tree, built with the dhancha toolkit,
# drawn via sadish + the kashi system font. Each pane renders from a readdir buffer:
# fixed 64-byte records (name NUL-terminated at +0, type at +63; 1 = dir). Kept
# separate from the transport (main.cyr) so it's host-testable (render_test.cyr).
#
# Include with the dhancha/sadish/rekha/kashi deps.

include "src/path.cyr"

# ⭐⭐ EVERY PER-FRAME ALLOCATION IN THIS FILE GOES THROUGH `dh_falloc` (0.6.0-dev), NOT `alloc`.
# `dh_falloc` draws from the arena `dh_frame_arena_set` installed and `dh_frame_begin` rewinds — so a
# frame's scratch is reclaimed instead of retained by a bump allocator that has no `free()`.
# ⛔ IT IS NOT AN OPTIMISATION FOR `disp` AND `out`, IT IS A LIFETIME REQUIREMENT.
# `dh_widget_set_text` **stores the pointer and does not copy**, so a row's display string and the
# status line's buffer must live exactly as long as the widgets that point at them. Leaving those two
# on the global allocator while the widgets moved to the arena would be the one mismatch this design
# can produce — the widget dies at `dh_frame_begin` and the string outlives it forever.
# ⚠ With no arena set, `dh_falloc` IS `alloc`. Every caller that has not opted in — `tests/crab.tcyr`,
# `src/render_test.cyr` — behaves exactly as before.

# ⛔ `CRAB_ROWS_CAP = 7` LIVED HERE UNTIL 0.4.10 and it is deliberately not replaced by a bigger
# number. A pane now holds a dhancha LIST, which scrolls and clips, so there is no row count to cap:
# the viewport is however tall the window is and the content is however long the directory is.

# Unsigned int -> decimal string in dst (NUL-terminated). Returns the length.
# ⚠ A NEGATIVE NOW RENDERS "-" RATHER THAN NOTHING (0.5.0). The `while (v > 0)` loop below simply
# does not run for a negative, so the old code returned length 0 having written only a NUL — and
# every caller appends to that. A zero-length number is how an overflowed size became a bare unit
# letter with no digits. Whatever a negative means here, it is never the empty string.
fn crab_u2s(dst, n): i64 {
    if (n < 0) { store8(dst, 45); store8(dst + 1, 0); return 1; }
    if (n == 0) { store8(dst, 48); store8(dst + 1, 0); return 1; }
    var tmp = dh_falloc(24);
    var i = 0;
    var v = n;
    while (v > 0) { store8(tmp + i, 48 + (v - (v / 10) * 10)); i = i + 1; v = v / 10; }
    var j = 0;
    while (j < i) { store8(dst + j, load8(tmp + (i - 1 - j))); j = j + 1; }
    store8(dst + i, 0);
    return i;
}

# Format a byte size into dst as a short human string ("512", "4K", "15M", "2G", "1T").
# A negative size (directory / stat failure) yields "-".
#
# ⛔ THE LADDER USED TO STOP AT M, AND THE ROUNDING COULD CARRY OFF THE END OF ITS OWN UNIT (0.5.0).
# Two defects, both reproduced with a compiled probe against this function:
#   1. `1048575` printed **"1024K"** — the K rounding `(val + 512) / 1024` carries to 1024, which is
#      1 M and should have moved up a unit. A size read as 1024K when the very next byte reads 1M is
#      a sorting and comparison hazard in a file manager, which is the one place sizes are compared.
#   2. `1073741824` printed **"1024M"** and a 100 GB file printed **"102400M"** — six digits in a
#      column budgeted for a short string, because the ladder had no G or T rung at all.
# ⇒ Round FIRST, then carry, then pick the unit from the carried value. One divisor per rung, and the
# carry check is `>= 1024` after rounding rather than before.
#
# ⚠ A negative now renders "-" rather than the empty string. `crab_u2s` writes nothing at all for a
# negative argument, so the old empty return let the caller emit a bare unit letter with no number in
# front of it — and it disagreed with `crab_status_str`, which already printed "-" for the same file.
# One unstattable file, two different renderings, is worse than either.
fn crab_size_str(dst, size): i64 {
    # ⛔ PENDING IS NOT UNSTATTABLE, AND THE ROW MUST NOT SAY IT IS. -2 means "not stat'd yet" (the
    # deferred sweep of *#03* has not reached this row); -1 means the stat FAILED. Rendering both as
    # "-" would make an entry stuck pending forever — a batch drain that never completes — read as a
    # filesystem fault, and it would be debugged as one.
    if (size == 0 - 2) { store8(dst, 63); store8(dst + 1, 0); return 1; }   # "?" — awaiting its stat
    if (size < 0) { store8(dst, 45); store8(dst + 1, 0); return 1; }   # "-"
    var val = size;
    var unit = 0;                                     # 0 = bytes, 1 = K, 2 = M, 3 = G, 4 = T
    # ⛔ DIVIDE FIRST, THEN ROUND — `(val + 512)` OVERFLOWS. The obvious rounding idiom adds before
    # dividing, and at a size near i64 max that addition wraps NEGATIVE: the ladder then exits on the
    # first pass, `crab_u2s` writes nothing at all for a negative, and the row rendered as a bare
    # **"K"** with no number in front of it. Caught by a probe against this function, not by reading
    # it. `st_size` is a u64 read straight out of a kernel stat buffer, so a value with the top bit
    # set is a corrupt-filesystem question, not an impossible one — and "K" is the worst possible
    # answer to it. Computing the quotient and remainder separately cannot overflow at any input.
    while ((val >= 1024) && (unit < 4)) {
        var q = val / 1024;
        if ((val - q * 1024) >= 512) { q = q + 1; }
        val = q;
        unit = unit + 1;
    }
    # The rounding above can land exactly on 1024 (e.g. 1048575 B -> 1024K). That is one full unit,
    # so carry it rather than printing a value the next rung would print as 1.
    if ((val >= 1024) && (unit < 4)) { val = val / 1024; unit = unit + 1; }
    var w = crab_u2s(dst, val);
    if (unit == 1) { store8(dst + w, 75); w = w + 1; }   # 'K'
    if (unit == 2) { store8(dst + w, 77); w = w + 1; }   # 'M'
    if (unit == 3) { store8(dst + w, 71); w = w + 1; }   # 'G'
    if (unit == 4) { store8(dst + w, 84); w = w + 1; }   # 'T'
    store8(dst + w, 0);
    return w;
}

# Write n as exactly 2 zero-padded digits at dst (n in [0,99]). No NUL.
# ⚠ CLAMPED (0.5.0). These write a FIXED width, so an out-of-range n could not overflow — but
# `48 + t` for t outside [0,9] emits a byte that is not a digit, and for a large enough value it
# emits **0**, i.e. an embedded NUL that truncates the whole status line at that point. The mtime
# these format comes from `load64(statbuf + STAT_MTIME)` — kernel data crab does not control.
# Clamping keeps a corrupt timestamp a display problem instead of a string-termination one.
fn crab_pad2(dst, n): i64 {
    var v = n;
    if (v < 0) { v = 0; }
    if (v > 99) { v = 99; }
    var t = v / 10;
    store8(dst, 48 + t); store8(dst + 1, 48 + (v - t * 10));
    return 2;
}

# Write n as exactly 4 zero-padded digits at dst (a year). No NUL. Clamped — see crab_pad2.
fn crab_pad4(dst, n): i64 {
    var v = n;
    if (v < 0) { v = 0; }
    if (v > 9999) { v = 9999; }
    var a = v / 1000;
    var b = (v / 100) - a * 10;
    var c = (v / 10) - (v / 100) * 10;
    store8(dst, 48 + a); store8(dst + 1, 48 + b);
    store8(dst + 2, 48 + c); store8(dst + 3, 48 + (v - (v / 10) * 10));
    return 4;
}

# Format a unix epoch (seconds) into dst as "YYYY-MM-DD HH:MM". epoch <= 0 yields
# "-" (unknown). Civil date via Howard Hinnant's days->(y,m,d) algorithm (z>=0).
fn crab_mtime_str(dst, epoch): i64 {
    # ⛔ PENDING IS NOT UNKNOWN — same distinction `crab_size_str` makes, for the same reason. -2 is
    # "the deferred sweep (*#03*) has not reached this row yet"; anything else <= 0 is genuinely no
    # date. ⚠ The status line is where this shows longest, because it reads the SELECTED row and the
    # drain is idle-driven — so after a descend it can read "?" until the first idle tick, which is
    # milliseconds. Marking it honestly beats showing a "-" that claims the mtime is unavailable.
    if (epoch == 0 - 2) { store8(dst, 63); store8(dst + 1, 0); return 1; }   # "?" — awaiting its stat
    if (epoch <= 0) { store8(dst, 45); store8(dst + 1, 0); return 1; }   # "-"
    var days = epoch / 86400;
    var sod = epoch - days * 86400;
    var hh = sod / 3600;
    var mm = (sod - hh * 3600) / 60;
    var z = days + 719468;
    var era = z / 146097;
    var doe = z - era * 146097;
    var yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    var y = yoe + era * 400;
    var doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    var mp = (5 * doy + 2) / 153;
    var d = doy - (153 * mp + 2) / 5 + 1;
    var mo = mp + 3;
    if (mp >= 10) { mo = mp - 9; }
    if (mo <= 2) { y = y + 1; }
    var w = 0;
    w = w + crab_pad4(dst + w, y);  store8(dst + w, 45); w = w + 1;   # '-'
    w = w + crab_pad2(dst + w, mo); store8(dst + w, 45); w = w + 1;   # '-'
    w = w + crab_pad2(dst + w, d);  store8(dst + w, 32); w = w + 1;   # ' '
    w = w + crab_pad2(dst + w, hh); store8(dst + w, 58); w = w + 1;   # ':'
    w = w + crab_pad2(dst + w, mm);
    store8(dst + w, 0);
    return w;
}

# One entry row: a 13-char name column, then "/" for a directory or a right-gapped
# human size for a file. Highlighted when selected: BRIGHT in the active pane, DIM
# in the inactive one.
# ⚠ DECLARED HERE, NOT IN `app.cyr`, AND THE REASON IS THE INCLUDE ORDER. `app.cyr` includes
# `ui.cyr`, so the fold puts ui.cyr FIRST — an enum declared in app.cyr is invisible to every line
# above it. `tests/crab.tcyr` includes `app.cyr`, so anything here is still reachable from a test.
# ⭐⭐ REAL COLUMNS (M3 *#32*, dhancha 0.9.20). The 13-character name column is gone: NAME is now the
# REMAINDER column, so it grows with the pane instead of being pinned at a width chosen in 2026-08.
#
# ⛔ COLUMNS THAT DO NOT FIT ARE DROPPED, NOT SQUEEZED. crab's default window is 380x220, so a pane
# is ~187 px — at the system font's 9 px advance that is ~20 characters TOTAL. A MODIFIED column is
# `2026-08-28 11:04`, sixteen characters, 144 px on its own: showing it at that width would leave
# four characters for the filename, which is not a file manager. So the pane picks its column set
# from its own width, and a wider window earns more columns.
# ⚠ THE THRESHOLDS ARE THE COLUMNS' OWN COSTS PLUS A NAME FLOOR, not round numbers: a name column
# narrower than ~10 characters cannot distinguish the files in a real directory, which is the same
# argument that retired the 13-character column.
enum CrabCol {
    CRAB_COL_CHARW    = 9;      # kashi CP437 8x16 advance: 8 px glyph + 1 px gap
    CRAB_COL_SIZE_W   = 54;     # 6 chars — "1023K" plus its gap
    CRAB_COL_MTIME_W  = 153;    # 17 chars — "2026-08-28 11:04" plus its gap
    CRAB_COL_NAME_MIN = 90;     # 10 chars — below this a name column cannot tell files apart
    CRAB_PANE_GAP     = 6;      # the seam between the two panes, and the window's own edge padding
    # ⛔ THE PREVIEW COLUMN'S WIDTH IS `CRAB_COL_MTIME_W`, AND THAT IS A DERIVATION, NOT A COINCIDENCE.
    # The widest line the preview draws is a modified timestamp — `2026-08-28 11:04`, seventeen
    # characters with its gap — which is the same string the MODIFIED column exists to hold and was
    # measured for. Giving the column its own literal would be a second number meaning the same
    # thing, free to drift when the font or the date format moves. ⇒ One constant, one derivation.
    CRAB_PV_W         = 153;
    CRAB_PV_ROW_H     = 18;     # a preview line, matching the column header's row height
    CRAB_PV_HDR_H     = 28;     # ...and its header, matching a PANE header so the two tops line up
}

# @public — can this window honestly show TWO panes? 1 = two, 0 = one pane plus the A/B switcher.
#
# ⭐⭐ M4 RATIFIES THE CANVAS'S OPEN QUESTION: "does the second pane ever leave?" — yes, and this is
# where. All three canvas directions drop to one pane plus a Pane A/B switcher at their small size,
# and the roadmap listed it as unratified and *forced by M4*.
#
# ⛔ THE THRESHOLD IS DERIVED, NOT THE CANVAS'S 420 COPIED IN. A pixel number lifted from a mockup
# is a number nobody can re-derive when the font, the row height or the column set changes. The rule
# is instead the one crab already uses to decide what a pane may show: **two panes are worth it only
# when EACH can honestly show the full column set** — NAME + SIZE + MODIFIED. Below that, splitting
# the window buys a second path listing and pays for it by hiding the data the app exists to show.
# ⇒ two panes need `panew >= 297`, i.e. a window of **600 px**. The canvas's 420 sits below that and
# gets one pane, which is what the canvas draws.
#
# ⭐ AND THIS IS WHY THE SHIPPED DEFAULT FINALLY SHOWS A DATE. At 380x220 two panes give 187 px each,
# so `crab_cols_for_width` returns 2 and the MODIFIED column never appeared — while the README and
# the CHANGELOG headline read "NAME · SIZE · MODIFIED". One pane at 380 gets 374 px and all three
# columns. The disclosure that used to be a ⚠ in the handoff is now just fixed.
fn crab_two_panes_fit(w): i64 {
    var panew = (w - CRAB_PANE_GAP) / 2;
    if (panew >= (CRAB_COL_NAME_MIN + CRAB_COL_SIZE_W + CRAB_COL_MTIME_W)) { return 1; }
    return 0;
}

# How many columns a pane `panew` px wide can honestly show: 1 = NAME, 2 = +SIZE, 3 = +MODIFIED.
fn crab_cols_for_width(panew): i64 {
    if (panew >= (CRAB_COL_NAME_MIN + CRAB_COL_SIZE_W + CRAB_COL_MTIME_W)) { return 3; }
    if (panew >= (CRAB_COL_NAME_MIN + CRAB_COL_SIZE_W)) { return 2; }
    return 1;
}

# Characters that fit in a `px`-wide column. ⚠ Floor, never rounded up — a column that reports one
# more character than it can draw is how text gets clipped with no truncation marker.
fn crab_col_chars(px): i64 {
    if (px <= 0) { return 0; }
    return px / CRAB_COL_CHARW;
}

# Copy `name` into `dst` truncated to `chars`, marking the cut with '~'. -> bytes written.
# ⛔ SAY THAT IT WAS CUT (0.5.0, and it survives the column port). Names can be 62 bytes and any
# column is narrower, so `agnos-kernel-build.log` and `agnos-kernel-build.tmp` rendered as one
# identical row — two DIFFERENT files, with no indication either was truncated. In a file manager
# that is not cosmetic: the operator selects, descends and acts on rows.
# ⚠ '~' (126), not '…' — the kashi system font is CP437 8x16 and has no ellipsis glyph.
# ⚠ The width is now the COLUMN's, not a hardcoded 13 — that constant was the thing *#32* retired.
# ⛔⛔ THE SCAN IS BOUNDED, AND `name` IS KERNEL DATA. `name` points into a readdir record the kernel
# filled — untrusted by crab's own rule, and the exact data whose unbounded copies caused the 0.5.0
# P-1 that made `src/path.cyr` a file. This loop used to be a bare `while (load8(name + n) != 0)`.
#
# ⚠ IT WAS SAFE ONLY BY A COINCIDENCE THAT WAS ABOUT TO EXPIRE, WHICH IS WHY IT IS FIXED NOW RATHER
# THAN WHEN IT BITES. Two things happened to hold it up: the kernel NUL-terminates at <= 62 bytes,
# and `dst` was reached through a `chars` small enough to clamp any runaway. The second guard is
# GONE above a ~1,860 px window — `chars` is width-derived, and at a full-screen 2560 px it is 118,
# well past the cell — leaving the kernel's own good behaviour as the only thing between a
# misformed record and a heap write. crab already accepts that resize (`crab_resize_wanted`), so one
# F5 at a large window reaches it — under QEMU as readily as on iron. Defence in depth means TWO
# guards, and this restores the missing one.
#
# ⚠ THE BOUND IS `CRAB_REC_TYPE`, NOT `CRAB_NAME_MAX`, AND THE ONE-BYTE DIFFERENCE IS THE POINT.
# The name region of a record is bytes [0, CRAB_REC_TYPE); byte 63 is the TYPE. Scanning to
# `CRAB_NAME_MAX` (64) would read that byte and render it as a character on a record the kernel
# failed to terminate. This reads only what is a name.
fn crab_name_cell(dst, name, chars): i64 {
    if (chars <= 0) { store8(dst, 0); return 0; }
    var n = 0;
    while ((n < CRAB_REC_TYPE) && (load8(name + n) != 0)) { n = n + 1; }
    if (n <= chars) {
        var i = 0;
        while (i < n) { store8(dst + i, load8(name + i)); i = i + 1; }
        store8(dst + n, 0);
        return n;
    }
    var j = 0;
    while (j < chars - 1) { store8(dst + j, load8(name + j)); j = j + 1; }
    store8(dst + chars - 1, 126);                      # '~' — this name was cut
    store8(dst + chars, 0);
    return chars;
}

# One row of the pane, as CELLS in the shared column spec (dhancha 0.9.20) rather than one
# space-padded string. `ncols` is what the pane's width can honestly show.
fn crab_row(col, spec, ncols, namew, name, is_dir, size, mtime, marked): i64 {
    var row = dh_table_row(spec);
    # ⭐ NO BACKGROUND (0.4.10). Rows used to paint their own selection — accent when the pane was
    # active, a muted line-tint when it was not — and dhancha 0.9.8 does exactly that from the LIST's
    # own `DH_W_SEL` and focus. ⛔ A row that keeps a background here paints OVER the highlight and
    # the selection silently stops showing; leaving it unset is what lets the toolkit's highlight
    # through. This deletion is the point of the port: the rule lived in three apps, now it lives once.
    dh_widget_set_bg(row, 0 - 1);
    dh_widget_set_pref(row, 0, 26);
    # ⭐⭐ A MARKED ROW IS TINTED, NOT PREFIXED (M4 multi-select). A marker character would be
    # unambiguous but it steals a column from the NAME cell, which at the shipped window is 14
    # characters wide — and the names it would truncate are exactly the ones the operator marked.
    # `DH_W_FG` (dhancha 0.9.20) costs no width.
    # ⛔ AND IT YIELDS TO THE SELECTION, WHICH IS CORRECT AND NOT A BUG. dhancha treats a widget's
    # own `fg` as a PREFERENCE and the focused selection's `on-accent` as a legibility GUARANTEE, so
    # the marked row under the cursor renders in on-accent rather than accent-on-accent — which is
    # the one combination that would be invisible. The toolkit already settled this at 0.9.20.
    if (marked != 0) { dh_widget_set_fg(row, dh_theme_accent()); }

    # NAME — the remainder column. A directory keeps its trailing '/', which is why the marker is
    # appended to the truncated text rather than being a column of its own.
    # ⛔ DERIVED, NOT `80`. This is the destination `crab_name_cell` writes into, and the literal was
    # a second, unstated contract with that function's bound — the kind of pairing that silently
    # stops holding when one side moves. The worst case is now arithmetic rather than a guess:
    # `crab_name_cell` writes at most `CRAB_REC_TYPE` name bytes plus its NUL, and a directory then
    # takes one more byte for the '/' and re-terminates. That is `CRAB_REC_TYPE + 2` bytes = 65;
    # the `+ 3` keeps a byte of slack so a future marker is not an overflow.
    var nm = dh_falloc(CRAB_REC_TYPE + 3);
    var nchars = namew;
    if (is_dir != 0) { nchars = nchars - 1; }          # leave room for the '/'
    var used = crab_name_cell(nm, name, nchars);
    if (is_dir != 0) { store8(nm + used, 47); store8(nm + used + 1, 0); }
    dh_table_cell(row, spec, 0, nm);

    # SIZE — a directory has no meaningful byte size; its "size" is the entry, not its contents.
    if (ncols >= 2) {
        var ss = dh_falloc(24);
        if (is_dir != 0) { store8(ss, 45); store8(ss + 1, 0); }   # "-"
        else { crab_size_str(ss, size); }
        dh_table_cell(row, spec, 1, ss);
    }
    # MODIFIED
    if (ncols >= 3) {
        var ds = dh_falloc(24);
        crab_mtime_str(ds, mtime);
        dh_table_cell(row, spec, 2, ds);
    }
    # ⚠ `dh_list_add`, not `dh_widget_add_child` — it stamps the row height and pins flex to 0.
    dh_list_add(col, row);
    return 0;
}

# One pane: a fixed-width column with a path header above a dhancha LIST holding EVERY entry read
# from `buf` (a readdir buffer of `count` 64-byte records). -> the pane's LIST widget.
#
# ⭐⭐ THE PORT (0.4.10): this used to be a `BOX_V` of at most `CRAB_ROWS_CAP` rows, and the entries
# past row 7 were simply NOT DRAWN — a directory's 8th file did not exist as far as the operator
# could tell. Every row is now added and the LIST scrolls, so the cap and the truncation are gone.
# ⭐⭐ WHY A PANE WITH NO ROWS NEEDS A STATE AT ALL (M4). A pane showing nothing had exactly one
# appearance — blank — and it meant four unrelated things: the directory is empty, the directory is
# gone, the path is not a directory, or the read failed. Those need different reactions from the
# operator, and blank asks them to guess. This is the M4 item the 2026-08-30 iron burn actually
# produced evidence for: `/` held two entries (`/sl_s`, `/lp`) the kernel could list but not stat,
# and every layer above reported the failure as an absence.
#
# ⛔⛔ THERE IS NO "PERMISSION DENIED" STATE, AND INVENTING ONE WOULD BE A LIE. The roadmap's M4 line
# reads "empty and permission-denied pane states", written against POSIX habits. agnos is
# single-user and always-root: `ext2_readdir_at_sys` has no `EACCES` arm and cannot produce one, and
# `getuid`#15 is a literal `return 0`. The burn's "operation not permitted" lines came from kriya's
# `rm`/`ls` failing to *stat* a broken symlink, not from any denial crab can observe.
# ⇒ These are the states the kernel can actually report. If agnos ever grows a credential model, a
# DENIED state belongs here and not before.
#
# ⚠ THE CODES ARE `#101`'s, TRANSCRIBED FROM ITS ABI ROW, and `#81` cannot express most of them —
# which is why the fallback path keeps `#101`'s classification when it made one. See
# `crab_readdir_into`.
enum CrabPaneState {
    CRAB_PANE_OK     = 0;    # rows to draw — no notice
    CRAB_PANE_EMPTY  = 1;    # the read succeeded and the directory holds nothing
    CRAB_PANE_GONE   = 2;    # -2: the path does not resolve
    CRAB_PANE_NOTDIR = 3;    # -4: it resolves, but it is a file
    CRAB_PANE_UNREAD = 4;    # -1 / -5 / anything else: bad pointer, not ext2, bad cursor, I/O
}

# @public — classify a finished listing. `err` is 0 or the kernel's negative code.
#
# ⚠ COUNT WINS OVER ERROR, DELIBERATELY. A walk that returned entries and *then* failed has real
# rows to show, and replacing them with a notice would hide data crab already holds. The error only
# decides the notice when there is nothing to draw.
fn crab_pane_state(count, err): i64 {
    if (count > 0) { return CRAB_PANE_OK; }
    if (err == 0) { return CRAB_PANE_EMPTY; }
    if (err == (0 - 2)) { return CRAB_PANE_GONE; }
    if (err == (0 - 4)) { return CRAB_PANE_NOTDIR; }
    return CRAB_PANE_UNREAD;
}

# @public — the line an empty pane shows. Never 0; `CRAB_PANE_OK` returns the empty string so a
# caller that draws it unconditionally renders nothing rather than dereferencing.
#
# ⚠ PLAIN LANGUAGE, NOT ERRNO. "-2" tells the operator nothing they can act on; "this folder no
# longer exists" tells them the pane is stale and Backspace is the way out. The numeric code still
# reaches the console through `crab_readdir_into`, where a developer is the one reading.
fn crab_pane_state_label(state): i64 {
    if (state == CRAB_PANE_EMPTY)  { return "This folder is empty"; }
    if (state == CRAB_PANE_GONE)   { return "This folder no longer exists"; }
    if (state == CRAB_PANE_NOTDIR) { return "Not a folder"; }
    if (state == CRAB_PANE_UNREAD) { return "This folder could not be read"; }
    return "";
}

# @public — the SOLO pane's header text: "A  /path" for the left pane, "B  /path" for the right.
# -> the bytes written, or -1 if the path did not fit.
#
# ⛔ EXTRACTED SO THE SWITCHER'S ONE AFFORDANCE IS ASSERTABLE. When only one pane is on screen this
# letter is the entire indication of WHICH pane the operator is looking at — the two panes can no
# longer distinguish themselves by being side by side. Built inline it was visual-only: a mutation
# that labelled both panes "A" changed nothing any test could see, and the operator would be left
# switching between two views that claim to be the same one.
# ⚠ Bounded like every other string helper here — `path` is crab's own joined path, but it is the
# same buffer descent grows, and the 0.5.0 P-1 was in exactly that family.
fn crab_pane_label(dst, cap, which, path): i64 {
    if (cap < 4) { return -1; }
    store8(dst, 65 + which);                           # 'A' + pane index
    store8(dst + 1, 32);
    store8(dst + 2, 32);
    var n = crab_strcpy_n(dst + 3, path, cap - 3);
    if (n < 0) { return -1; }
    return n + 3;
}

# =================================================================================================
# M4 — MULTI-SELECT MARKS. Pure array predicates over a byte-per-entry mark buffer.
# =================================================================================================
#
# ⛔⛔ THESE LIVE IN `ui.cyr`, NOT `app.cyr`, AND THE REASON IS THE INCLUDE CHAIN — I GOT THIS WRONG
# TWICE IN ONE MILESTONE. `ui.cyr` is included BY `app.cyr`, and both `render_test.cyr` and the suite
# include `ui.cyr` **alone**. A render path that calls up into `app.cyr` compiles fine through
# `main.cyr` and leaves `render_test` with undefined symbols. ⇒ **Anything the render path calls must
# be at or below `ui.cyr`.** The mark QUEUE stays in `app.cyr` because it is operation state, not
# rendering — and nothing in the render path touches it.
#
# ⛔ MARKS ARE INDICES, SO EVERY RE-LISTING CLEARS THEM. An index means nothing once the directory
# has been read again: entries move when the sort mode changes and vanish when a file is deleted. A
# stale mark set would act on whatever now occupies that row, which is the worst possible failure
# for a delete.
# ⚠ Marks are separate from the CURSOR. The cursor is where the keyboard is; marks are what the next
# verb acts on. With nothing marked the verbs act on the cursor, so an operator who never presses
# Space never sees a difference.

# @public — toggle the mark on entry `i`. -> the new state (1 = marked, 0 = not).
fn crab_mark_toggle(marks, i, count): i64 {
    if (marks == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= count) { return 0; }
    var v = 1 - load8(marks + i);
    store8(marks + i, v);
    return v;
}

# @public — is entry `i` marked? 1 = yes. Bounds-checked, because it is read from the render path.
fn crab_marked(marks, i, count): i64 {
    if (marks == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= count) { return 0; }
    return load8(marks + i);
}

# @public — how many entries are marked.
fn crab_mark_count(marks, count): i64 {
    if (marks == 0) { return 0; }
    var n = 0;
    var i = 0;
    while (i < count) {
        if (load8(marks + i) != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# @public — clear every mark. Called on EVERY re-listing; see the ⛔ above.
fn crab_mark_clear(marks, count): i64 {
    if (marks == 0) { return 0; }
    var i = 0;
    while (i < count) { store8(marks + i, 0); i = i + 1; }
    return 0;
}

# =================================================================================================
# M4 — THE EDIT BUFFER. Typing a name, owned by crab.
# =================================================================================================
#
# ⛔⛔ crab DOES NOT USE dhancha's `TEXTINPUT`, AND THIS IS THE THIRD FEATURE WITH THE SAME MISMATCH.
# `dh_text_new` allocates its buffer with the GLOBAL allocator so it survives frames — but the
# WIDGET holding it is `dh_falloc`'d and dies at every `dh_frame_begin`. So an immediate-mode app
# that rebuilds its tree each frame must call `dh_text_new` each frame, and each call leaks a fresh
# buffer into an allocator with no `free()`. TEXTINPUT is built for a RETAINED tree.
# ⚠ That is the same structural shape as `dh_dispatch` (a press held as a widget pointer, operator
# ruling 2026-08-27) and as drag (`_dh_drag_src`, fixed in dhancha 0.9.21 by refusing to start).
# Three features, one mismatch. **Worth telling dhancha; not worth crab pretending otherwise.**
# ⇒ crab owns the buffer, the length and the caret, in globals that outlive a frame — exactly as it
# owns pane index, row index and the operation record. The toolkit draws the string.
# ⚠ AND IT LIVES IN `ui.cyr`, NOT `app.cyr`, FOR THE REASON RECORDED AT THE MARK PREDICATES ABOVE:
# the render path calls it, and `ui.cyr` is what `render_test.cyr` includes alone. Third time in this
# milestone — the rule is that anything the render path touches must be at or below this file.

enum CrabEdit {
    CRAB_EDIT_CAP = 64;        # = CRAB_NAME_MAX: a name that cannot be typed cannot be created
}

var crab_ebuf = 0;
var crab_elen = 0;
var crab_ecar = 0;

fn crab_edit_buf(): i64 {
    if (crab_ebuf == 0) { crab_ebuf = alloc(CRAB_EDIT_CAP); }
    if (crab_ebuf != 0) { store8(crab_ebuf + crab_elen, 0); }
    return crab_ebuf;
}

fn crab_edit_len(): i64 { return crab_elen; }
fn crab_edit_caret(): i64 { return crab_ecar; }

# @public — start editing with `init` (0 or "" for an empty field). -> the length seeded.
fn crab_edit_start(init): i64 {
    var b = crab_edit_buf();
    if (b == 0) { return 0; }
    crab_elen = 0;
    crab_ecar = 0;
    if (init != 0) {
        var i = 0;
        while (i < (CRAB_EDIT_CAP - 1)) {
            var c = load8(init + i);
            if (c == 0) { i = CRAB_EDIT_CAP; }
            else { store8(b + i, c); i = i + 1; crab_elen = i; }
        }
    }
    store8(b + crab_elen, 0);
    # ⚠ The caret starts at the END, not at 0. Renaming almost always means appending or trimming a
    # suffix; starting at the front means every rename begins with a trip across the name.
    crab_ecar = crab_elen;
    return crab_elen;
}

# @public — insert one byte at the caret. -> 1 if it went in, 0 if the field was full.
#
# ⛔ A FULL FIELD REFUSES; IT DOES NOT TRUNCATE OR OVERWRITE. The cap is `CRAB_NAME_MAX`, so a name
# that cannot be typed is a name the filesystem could not hold anyway — and silently dropping the
# keystroke the operator just made is better than silently dropping a character they typed earlier.
fn crab_edit_insert(ch): i64 {
    var b = crab_edit_buf();
    if (b == 0) { return 0; }
    if (ch <= 0) { return 0; }
    if (crab_elen >= (CRAB_EDIT_CAP - 1)) { return 0; }
    var i = crab_elen;
    while (i > crab_ecar) { store8(b + i, load8(b + i - 1)); i = i - 1; }
    store8(b + crab_ecar, ch);
    crab_elen = crab_elen + 1;
    crab_ecar = crab_ecar + 1;
    store8(b + crab_elen, 0);
    return 1;
}

# @public — delete the byte BEFORE the caret. -> 1 if one went, 0 at the start of the field.
fn crab_edit_backspace(): i64 {
    var b = crab_edit_buf();
    if (b == 0) { return 0; }
    if (crab_ecar <= 0) { return 0; }
    var i = crab_ecar - 1;
    while (i < (crab_elen - 1)) { store8(b + i, load8(b + i + 1)); i = i + 1; }
    crab_elen = crab_elen - 1;
    crab_ecar = crab_ecar - 1;
    store8(b + crab_elen, 0);
    return 1;
}

# @public — move the caret by `d`, clamped to the field. -> the new position.
fn crab_edit_move(d): i64 {
    var n = crab_ecar + d;
    if (n < 0) { n = 0; }
    if (n > crab_elen) { n = crab_elen; }
    crab_ecar = n;
    return crab_ecar;
}

# @public — the printable character for HID usage `u`, or 0 if it is not one. `shift` = 1 for upper.
#
# ⛔⛔ crab RECEIVES HID USAGES, NOT CHARACTERS, AND NOTHING ELSE IN THE STACK TRANSLATES THEM. The
# compositor forwards the raw usage (which is what makes `u == 0x28` mean Enter everywhere in this
# file), so a field that takes typing needs this map and there is nowhere else to put it.
# ⚠ THE MAP IS US QWERTY, DELIBERATELY AND VISIBLY. agnos's HID layer installs "US QWERTY" tables at
# boot and nothing in the stack carries a layout preference, so this matches what the kernel already
# assumes rather than inventing a second answer. A real layout story is a kernel/compositor arc.
# ⚠ ONLY WHAT A FILENAME NEEDS. Letters, digits, and the punctuation that appears in names — not a
# full keyboard. A key that yields 0 is simply ignored by the caller, which is the right default for
# a field that names a file.
fn crab_key_char(u, shift): i64 {
    if ((u >= 0x04) && (u <= 0x1D)) {                  # a..z
        if (shift != 0) { return 65 + (u - 0x04); }
        return 97 + (u - 0x04);
    }
    if ((u >= 0x1E) && (u <= 0x26)) {                  # 1..9
        if (shift != 0) { return 0; }                  # the shifted row is symbols crab does not need
        return 49 + (u - 0x1E);
    }
    if (u == 0x27) { if (shift != 0) { return 0; } return 48; }   # 0
    if (u == 0x2C) { return 32; }                      # space
    if (u == 0x2D) { if (shift != 0) { return 95; } return 45; }  # - / _
    if (u == 0x37) { return 46; }                      # .
    return 0;
}

# =================================================================================================
# M4 — THE CONTEXT MENU'S MODEL. Which commands apply, and what each one is called.
# =================================================================================================
#
# ⭐ dhancha 0.9.23 ships MENU as a configured LIST plus an overlay layer with real placement, so
# crab supplies only what dhancha cannot know: WHICH commands are legal on the thing under the
# pointer, and what they are named.
# ⛔ THE MENU IS NOT A SECOND SET OF VERBS. Every entry maps to the key binding that already exists,
# and the shortcut column says so — a menu that could do something the keyboard cannot is a second
# implementation of the same commands, drifting from the first. It is a DISCOVERY surface.
enum CrabMenuItem {
    CRAB_MI_OPEN   = 0;
    CRAB_MI_COPY   = 1;
    CRAB_MI_MOVE   = 2;
    CRAB_MI_RENAME = 3;
    CRAB_MI_DELETE = 4;
    CRAB_MI_NEWDIR = 5;
    CRAB_MI_COUNT  = 6;
}

# @public — the label for item `i`, or "" out of range. Never 0.
fn crab_menu_label(i): i64 {
    if (i == CRAB_MI_OPEN)   { return "Open"; }
    if (i == CRAB_MI_COPY)   { return "Copy to other pane"; }
    if (i == CRAB_MI_MOVE)   { return "Move to other pane"; }
    if (i == CRAB_MI_RENAME) { return "Rename..."; }
    if (i == CRAB_MI_DELETE) { return "Delete"; }
    if (i == CRAB_MI_NEWDIR) { return "New folder..."; }
    return "";
}

# @public — the accelerator shown beside item `i`, or "" if it has none.
# ⚠ These are the REAL bindings, not decoration. If a key moves, this moves with it or the menu
# starts lying — and a menu that lies about a shortcut is worse than one that shows none.
fn crab_menu_key(i): i64 {
    if (i == CRAB_MI_OPEN)   { return "Enter"; }
    if (i == CRAB_MI_COPY)   { return "c"; }
    if (i == CRAB_MI_MOVE)   { return "m"; }
    if (i == CRAB_MI_RENAME) { return "r"; }
    if (i == CRAB_MI_DELETE) { return "d"; }
    if (i == CRAB_MI_NEWDIR) { return "n"; }
    return "";
}

# @public — does item `i` apply, given the pane's state? 1 = show it live, 0 = show it greyed.
#
# ⛔ GREYED, NOT HIDDEN, AND THAT IS THE WHOLE POINT OF THE PREDICATE. A menu whose entries move
# around depending on what is selected forces the operator to re-read it every time; one whose
# entries stay put teaches their positions. The canvas's own menus keep a stable shape.
# ⚠ `count == 0` is an EMPTY PANE, where only "New folder" applies — everything else needs a row.
fn crab_menu_enabled(i, count, isdir, marked): i64 {
    if (i == CRAB_MI_NEWDIR) { return 1; }             # always: it needs no selection
    if (count <= 0) { return 0; }                      # every other verb needs a row
    if (i == CRAB_MI_OPEN) {
        # ⚠ Open on a directory means DESCEND, which is always legal; on a file it means run, which
        # crab refuses for a non-ELF — but that refusal is the operator's to discover by trying,
        # not a reason to grey the entry. Greying "Open" on every data file would read as broken.
        return 1;
    }
    if (i == CRAB_MI_RENAME) {
        # ⛔ RENAME IS SINGLE-TARGET. With a mark set the operator means the SET, and renaming a set
        # is the batch sheet — a different command with a different surface.
        if (marked > 1) { return 0; }
        return 1;
    }
    return 1;
}

# ⚠ The batch expansion's destination, allocated once — it outlives no frame but it is written once
# per entry in a loop, and a per-entry `alloc` would leak one buffer per file renamed.
var crab_bdst = 0;
fn crab_batch_dst(): i64 {
    if (crab_bdst == 0) { crab_bdst = alloc(CRAB_EDIT_CAP); }
    return crab_bdst;
}

# @public — expand a batch-rename `pattern` for entry `idx` (1-based) whose current name is `orig`,
# into `dst` (cap `CRAB_EDIT_CAP`). -> the length written, or -1 if it did not fit.
#
# ⭐ TWO SUBSTITUTIONS AND NOTHING ELSE: `#` is the sequence number, `*` is the original name.
# That is enough for the renames people actually do — prefix, suffix, and number a set — and every
# addition past it is a small language nobody asked for. `photo-#` and `*-backup` cover the cases
# the canvas draws.
# ⛔ THE RESULT IS STILL RUN THROUGH `crab_name_ok` BY THE CALLER. A pattern is operator input, and
# `*` splices in a name that came from a readdir record — so a pattern can produce `..` or a name
# with a separator, which is exactly what the guard exists to refuse.
# ⚠ REFUSES RATHER THAN TRUNCATES. A truncated name is a DIFFERENT name, and a batch that silently
# renamed forty files to forty truncated names would be worse than one that stopped.
fn crab_batch_name(dst, pattern, idx, orig): i64 {
    if (dst == 0) { return 0 - 1; }
    if (pattern == 0) { return 0 - 1; }
    var lim = CRAB_EDIT_CAP - 1;
    var w = 0;
    var i = 0;
    var ch = load8(pattern + i);
    while (ch != 0) {
        if (ch == 35) {                                  # '#' — the sequence number
            var nb = dh_falloc(24);
            var nl = crab_u2s(nb, idx);
            var k = 0;
            while (k < nl) {
                if (w >= lim) { store8(dst + w, 0); return 0 - 1; }
                store8(dst + w, load8(nb + k)); w = w + 1; k = k + 1;
            }
        } else {
            if (ch == 42) {                              # '*' — the original name
                var j = 0;
                var oc = 0;
                if (orig != 0) { oc = load8(orig + j); }
                while (oc != 0) {
                    if (w >= lim) { store8(dst + w, 0); return 0 - 1; }
                    store8(dst + w, oc); w = w + 1; j = j + 1;
                    oc = load8(orig + j);
                }
            } else {
                if (w >= lim) { store8(dst + w, 0); return 0 - 1; }
                store8(dst + w, ch); w = w + 1;
            }
        }
        i = i + 1;
        ch = load8(pattern + i);
    }
    store8(dst + w, 0);
    return w;
}

# @public — the next / previous ENABLED menu item from `i`, wrapping. -> the new index.
#
# ⛔ THE KEYBOARD MUST SKIP A GREYED ENTRY, or the highlight lands on something Enter cannot do and
# the menu appears to ignore a keypress. dhancha's `dh_list_move_sel` already steps over `INERT`
# rows for the same reason; this is the model-side answer so the selection crab passes IN is
# already a legal one.
# ⚠ WRAPPING, not clamping, and that is the opposite of a file list: a menu is six items the
# operator can see all of, so running off the end and continuing is faster than stopping. A pane of
# 1024 rows is the case where wrapping would lose your place.
# ⚠ The scan is capped by the item count, so a menu with nothing enabled returns `i` rather than
# spinning.
fn crab_menu_next(i, count, isdir, marked): i64 {
    var n = i;
    var g = 0;
    while (g < CRAB_MI_COUNT) {
        n = n + 1;
        if (n >= CRAB_MI_COUNT) { n = 0; }
        if (crab_menu_enabled(n, count, isdir, marked) == 1) { return n; }
        g = g + 1;
    }
    return i;
}

fn crab_menu_prev(i, count, isdir, marked): i64 {
    var n = i;
    var g = 0;
    while (g < CRAB_MI_COUNT) {
        n = n - 1;
        if (n < 0) { n = CRAB_MI_COUNT - 1; }
        if (crab_menu_enabled(n, count, isdir, marked) == 1) { return n; }
        g = g + 1;
    }
    return i;
}

# @public — the menu's title: what the commands will act on.
# ⚠ "3 marked" beats the file's name when a set is marked, because the verbs act on the SET — a menu
# headed with one name while Delete removes nine is the most dangerous label in the app.
fn crab_menu_target(marked, name): i64 {
    if (marked > 1) { return "the marked entries"; }
    if (name == 0) { return "this folder"; }
    if (load8(name) == 0) { return "this folder"; }
    return name;
}

# ⚠ `dh_list_add` pins each row's flex to 0 for us; flex rows would share the viewport instead of
# overflowing it, and a list whose content exactly fills the viewport never scrolls.
fn crab_pane(root, which, panew, path, buf, count, sizes, mtimes, sel, active, state, solo, marks): i64 {
    var col = dh_widget_new(BOX);
    dh_widget_set_layout(col, BOX_V);
    dh_widget_set_pref(col, panew, 0);
    dh_widget_set_bg(col, dh_theme_panel());   # pane column surface
    var hdr = dh_widget_new(LABEL);
    var hc = dh_theme_panel();                 # pane header bar
    if (active != 0) { hc = dh_theme_accent(); }   # accent when this pane is focused
    dh_widget_set_bg(hdr, hc);
    dh_widget_set_pref(hdr, 0, 28);
    # ⚠ WHEN ONLY ONE PANE IS ON SCREEN THE HEADER MUST SAY WHICH ONE IT IS. Two panes distinguish
    # themselves by being side by side; one pane cannot, and the operator switching with Left/Right
    # would otherwise see the path change with no way to tell A from B — worse than two panes,
    # because it looks like navigation rather than a switch.
    # ⚠ `dh_falloc`, not `alloc`: `dh_widget_set_text` stores the pointer without copying, so this
    # string must live exactly as long as the widget does — one frame.
    var htext = path;
    if (solo != 0) {
        var hb = dh_falloc(CRAB_PATH_MAX + 4);
        crab_pane_label(hb, CRAB_PATH_MAX + 4, which, path);
        htext = hb;
    }
    dh_widget_set_text(hdr, htext);
    dh_widget_add_child(col, hdr);

    # ⭐⭐ REAL COLUMNS (*#32*, dhancha 0.9.20). The 13-character name column is gone — NAME is the
    # REMAINDER column, so it grows with the pane. ⛔ Columns that do not fit are DROPPED, not
    # squeezed: at the default 380x220 a pane is ~187 px, and a MODIFIED column alone is 153 px.
    # ⚠ ONE SPEC, READ BY THE HEADER AND EVERY ROW. That shared read is what makes the columns line
    # up; rows laid out independently drift the moment one cell's text changes.
    # ⛔ AND THE SPEC IS ALLOCATED ONCE AND RESET, NEVER BUILT PER FRAME. `alloc` is a bump allocator
    # with no `free()`, so `dh_cols_new` inside the render path retained 40 B per pane per frame —
    # measured at 1600 B over twenty frames, which is exactly the per-frame allocation dhancha
    # 0.9.13-0.9.16 and crab 0.6.0 spent four releases driving to zero. The suite caught it.
    crab_spec_init();
    var ncols = crab_cols_for_width(panew);
    var spec = crab_lspec;
    if (which == 1) { spec = crab_rspec; }
    dh_cols_reset(spec, ncols);
    dh_cols_set_width(spec, 0, 0);                                    # NAME — the remainder
    if (ncols >= 2) { dh_cols_set_width(spec, 1, CRAB_COL_SIZE_W); }
    if (ncols >= 3) { dh_cols_set_width(spec, 2, CRAB_COL_MTIME_W); }
    var namechars = crab_col_chars(panew - dh_cols_fixed_total(spec));
    # ⛔ THE COLUMN HEADER SITS OUTSIDE THE LIST, which is what keeps it from scrolling away and from
    # ever being a selectable row. A header the operator can select is a file that does not exist.
    var chdr = dh_table_header(spec);
    dh_widget_set_pref(chdr, 0, 18);
    dh_widget_set_flex(chdr, 0);
    dh_table_cell(chdr, spec, 0, "NAME");
    if (ncols >= 2) { dh_table_cell(chdr, spec, 1, "SIZE"); }
    if (ncols >= 3) { dh_table_cell(chdr, spec, 2, "MODIFIED"); }
    dh_widget_add_child(col, chdr);


    var lst = dh_list_new(26);                 # row height matches crab_row's pref
    dh_widget_set_flex(lst, 1);                # the list takes the column's remaining height
    var i = 0;
    while (i < count) {
        var rec = buf + i * CRAB_REC_SZ;        # name (NUL-terminated) at +0
        var is_dir = load8(rec + CRAB_REC_TYPE);  # type byte: 1 = dir
        var sz = load64(sizes + i * 8);         # per-entry byte size (-1 = dir/unknown)
        var mt = load64(mtimes + i * 8);
        crab_row(lst, spec, ncols, namechars, rec, is_dir, sz, mt, crab_marked(marks, i, count));
        i = i + 1;
    }
    # ⭐ THE EMPTY-PANE NOTICE (M4). Added as a row so it inherits the list's clipping and scroll
    # geometry rather than floating over them, and so a pane that later gains entries needs no
    # different layout path.
    # ⛔ IT IS NOT SELECTABLE, AND THAT MATTERS. `dh_list_select` is skipped below whenever
    # `count == 0`, so the notice can never be the selected row — a highlighted "This folder is
    # empty" reads as a file with that name, and Enter on it would descend into nothing.
    # ⚠ Drawn through the SPEC's first cell like every other row, so it starts at the NAME column's
    # left edge and lines up with what the operator was reading a moment ago.
    if (count == 0) {
        var note = crab_pane_state_label(state);
        if (load8(note) != 0) {
            var nrow = dh_table_row(spec);
            dh_widget_set_bg(nrow, 0 - 1);
            dh_widget_set_pref(nrow, 0, 26);
            dh_table_cell(nrow, spec, 0, note);
            dh_list_add(lst, nrow);
        }
    }
    # ⛔ THE SELECTION IS SET, NOT PAINTED. dhancha draws it — accented when this list holds focus,
    # muted when it does not — which is why `active` no longer reaches the rows at all.
    if (count > 0) { dh_list_select(lst, sel); }
    if (active != 0) { dh_focus_set(lst); }
    dh_widget_add_child(col, lst);
    dh_widget_add_child(root, col);
    return lst;
}

# Build the status-line text (returned as a cstring) for the active pane's selected
# entry: "<name>   <size|<dir>>   <mtime>". Empty pane -> a single space.
# ⭐⭐ THE TRANSIENT NOTICE (M4) — what the status line says INSTEAD of the selected row, when crab
# has something to tell the operator that the row cannot.
#
# ⛔ IT EXISTS BECAUSE A DESTRUCTIVE ACTION NEEDS A VISIBLE PROMPT AND A VISIBLE RESULT. crab's other
# diagnostics go to the console, and on iron that console is shared unserialised by three processes
# and is not where the operator is looking — the 2026-08-30 burn has crab's own exit line spliced
# into the middle of aethersafha's frame banner. A "delete this?" that only the console asks is a
# delete with no confirmation at all.
# ⚠ SET IT TO A LITERAL OR TO SOMETHING THAT OUTLIVES THE FRAME. `dh_widget_set_text` stores the
# pointer without copying, so a notice built in `dh_falloc` scratch would be freed by the next
# `dh_frame_begin` while the widget still pointed at it. Every current caller passes a literal.
# ⚠ CLEARED BY THE NEXT KEYPRESS, not by a timer. crab has no clock in the render path and a notice
# that lingers past the action it describes is worse than none.
var crab_notice = 0;

fn crab_set_notice(s): i64 { crab_notice = s; return 0; }
fn crab_clear_notice(): i64 { crab_notice = 0; return 0; }
fn crab_get_notice(): i64 { return crab_notice; }

fn crab_status_str(buf, sel, sizes, mtimes, count): i64 {
    var out = dh_falloc(96);    # ⛔ the status LABEL points at this — same lifetime
    if (count <= 0) { store8(out, 32); store8(out + 1, 0); return out; }
    var rec = buf + sel * CRAB_REC_SZ;
    var w = 0;
    var k = 0; var ch = load8(rec + k);                 # name (<= 40)
    while ((ch != 0) && (k < 40)) { store8(out + w, ch); w = w + 1; k = k + 1; ch = load8(rec + k); }
    store8(out + w, 32); w = w + 1; store8(out + w, 32); w = w + 1;
    if (load8(rec + CRAB_REC_TYPE) == 1) {              # directory -> "<dir>"
        var dtag = "<dir>"; var t = 0;
        while (load8(dtag + t) != 0) { store8(out + w, load8(dtag + t)); w = w + 1; t = t + 1; }
    } else {                                            # file -> human size
        var ss = dh_falloc(24); var sl = crab_size_str(ss, load64(sizes + sel * 8));
        # ⚠ The old `if (sl == 0) { emit '-' }` compensation is GONE, and its absence is the fix:
        # `crab_size_str` now renders "-" for an unstattable file itself, so both the pane row and
        # this line get the same string from the same place. Compensating here was what let the two
        # disagree — a blank in the pane, a dash in the status line, for one file.
        var m = 0; while (m < sl) { store8(out + w, load8(ss + m)); w = w + 1; m = m + 1; }
    }
    store8(out + w, 32); w = w + 1; store8(out + w, 32); w = w + 1;
    var ds = dh_falloc(24); var dl = crab_mtime_str(ds, load64(mtimes + sel * 8));   # mtime date
    var q = 0; while (q < dl) { store8(out + w, load8(ds + q)); w = w + 1; q = q + 1; }
    store8(out + w, 0);
    return out;
}

# Build + render the dual-pane window into the CALLER'S surface: two readdir panes on top, a status
# line (the active selection's size + mtime) along the bottom. -> the sadish SdSurface, or 0.
#
# ⛔⛔ THE SURFACE IS A PARAMETER, NOT A LOCAL (0.6.0-dev), AND THAT IS THE WHOLE POINT OF THE CHANGE.
# This function used to call `dh_surface_new(w, h)` itself, once per call — so every frame minted a
# fresh DhSurface, and dhancha's per-DhSurface render-target cache (0.9.14) would have saved crab
# **nothing**: a cache on an object that is thrown away each frame is not a cache. Hoisting the
# surface into the caller is what turns 334,432 B per frame into 334,432 B once.
# ⚠ MEASURED: 412,040 -> 77,608 B per frame, with the two steps together taking 746,440 -> 77,608.
#
# ⭐ `w`/`h` ARE NO LONGER PARAMETERS — they are read back off the surface. They were always required
# to equal the surface's own dimensions (this function passed the same pair to `dh_surface_new`), so
# taking them separately only created a way for them to disagree. The signature gets shorter, not
# longer, for gaining a parameter.
# ⚠ THE RETURNED SURFACE BELONGS TO `surf` AND IS OVERWRITTEN BY THE NEXT RENDER INTO IT — see the
# ⛔ on `dh_surface_render` in dhancha 0.9.14. A caller that wants two frames at once needs two
# surfaces; `src/render_test.cyr` is exactly such a caller and does exactly that.
# ⭐⭐ THE PER-FRAME ARENA IS OWNED HERE, NOT BY `main()` (0.6.0). It used to be created and installed
# in `src/main.cyr`, and that was a gap the suite could not see: `tests/crab.tcyr` cannot include
# `main.cyr` (it ends in `_entry();`), so deleting `dh_frame_arena_set` from `main` broke nothing that
# any test could notice while quietly restoring a 77 KB-per-frame leak.
# ⇒ The fix is architectural rather than a new assertion: the setup lives next to the render that
# needs it, is created on first use, and is reachable from the suite. There is no longer a step for
# `main()` to forget.
# ⚠ GROWABLE, AND THAT IS LOAD-BEARING. `arena_reset` on a GROW arena rewinds to the first chunk and
# KEEPS the chain, so the render loop converges on its high-water mark and then costs the global
# allocator nothing at all. A fixed arena would have to guess a capacity, and guessing low means
# `dh_falloc` silently spilling back to the global heap — the leak, quietly restored.
# ⚠ 256 KiB SIZES THE COMMON CASE AND NOTHING MORE, AND THE CHAIN IS NOT AN EDGE CASE ANY MORE.
# This comment used to read "it absorbs a full frame at the `CRAB_MAX_ENTRIES` ceiling (256 entries
# per pane) without ever chaining. GROW covers anything past that with ONE extra chunk." Both halves
# were true when written and neither survived, because TWO things moved under it and neither
# re-derived the number: M3 *#02* took the cap 256 -> 1024, and M3 *#32* took a row from one widget
# to 1 + `ncols` (a row widget plus a cell widget per column, at `DH_WIDGET_SIZE` = 256 B each).
#
# ⭐ RE-MEASURED 2026-08-30 with `arena_capacity_total`, per rendered frame, both panes:
#
#   | window    | entries | cols | chain total | chunks |
#   |-----------|--------:|-----:|------------:|-------:|
#   | 380x220   |     122 |    2 |     262,144 |      1 |   <- the real iron `/`, 2026-08-30
#   | 380x220   |     256 |    2 |     524,288 |      2 |
#   | 380x220   |    1024 |    2 |   1,835,008 |      7 |
#   | 2560x1440 |    1024 |    3 |   2,621,440 |     10 |
#
# ⇒ The ceiling costs SEVEN chunks at the shipped window, not one. Note the second row: at the OLD
# 256 cap it already chained, so the claim was stale before the cap bump and the bump only widened
# the gap.
#
# ⚠ MEASURE WITH `arena_capacity_total`, NOT `arena_used`. `arena_used` is `cur - base` of the
# CURRENT chunk only, so on a chained arena it reports the tail residue — 13,104 B for the 2.6 MB
# row above. Reading it as the total is how a ten-chunk frame looks like a 4%-full one.
#
# ⭐ AND IT IS STILL NOT A LEAK, WHICH IS WHY THIS IS A COMMENT AND NOT A DEFECT. `arena_reset`
# rewinds to the first chunk and KEEPS the chain, so the chunks are allocated once and reused for
# the process's life: the global heap still sees zero bytes per steady-state frame, which is the
# gate four releases were spent closing. What changed is the one-time cost — ~1.8 MB at the cap
# rather than the 256 KiB this comment promised.
# ⇒ 256 KiB is KEPT deliberately: the common case is what the burn actually ran (122 entries at the
# default window = 217,680 B), and that fits one chunk with room to spare. Sizing for the ceiling
# would pay 1.8 MB up front for a directory almost nobody opens.
var crab_arena = 0;

# @public — crab's per-frame arena, created on first call. -> the arena, or 0 if it could not be made.
fn crab_frame_arena(): i64 {
    if (crab_arena == 0) { crab_arena = arena_new_growable(262144); }
    return crab_arena;
}

# ⭐⭐ THE CURRENT FRAME'S TREE, FOR HIT-TESTING (M2, *deferral #05*). `crab_render` records the root
# and the two pane LISTs here so a pointer event can be mapped to (pane, row) without crab
# re-deriving the layout arithmetic — which would be the geometric form of a test that mirrors the
# code it is testing.
#
# ⛔ THE LIFETIME IS EXACTLY ONE FRAME, AND THAT IS SAFE FOR ONE REASON ONLY: these are refreshed by
# the same render that builds the tree they point into, and the tree is only rewound by the NEXT
# `crab_render`'s `dh_frame_begin()`. So between renders — which is precisely when input is handled —
# they address live widgets. ⚠ Do not read them from anywhere else, and never store them.
# ⚠ This is the same rule dhancha states for `_dh_focus`: on a per-frame arena, any widget pointer
# must be re-established every frame. crab can hold these because it re-establishes them every frame;
# it cannot hold a PRESS across frames, which is why `dh_dispatch` is not used — see `src/app.cyr`.
var crab_root = 0;
var crab_llst = 0;
var crab_rlst = 0;

# Map a content-relative pointer position to crab's own model. -> 1 when it landed inside a pane.
#   out16 + 0 : pane  (0 = left, 1 = right, -1 = none)
#   out16 + 8 : row   (index within that pane, -1 = the pane but not a row)
#
# ⚠ COORDINATES ARE CONTENT-RELATIVE AND ALREADY BOUNDS-CHECKED BY THE COMPOSITOR. aethersafha drops
# any position outside the content rect before forwarding, because a pointer on the titlebar produced
# `ry` in [-30,-1] and a client indexing `ry / row_h` read before its own buffer. crab does not
# re-derive that bound; it relies on it, and this note is where that reliance is written down.
# ⚠ A CLICK ON A PANE HEADER RETURNS 0 TODAY. The header is a sibling of the list, not inside it, so
# the walk below never reaches a LIST and the click does nothing. Focusing a pane by its header is a
# reasonable thing to want; it is simply not claimed here.
# ⚠ ONE COLUMN SPEC PER PANE, ALLOCATED ONCE (*#32*). Built lazily so the allocation happens on the
# first render rather than at module-init, and reset — not rebuilt — on every frame after that.
var crab_lspec = 0;
var crab_rspec = 0;

fn crab_spec_init(): i64 {
    if (crab_lspec == 0) { crab_lspec = dh_cols_new(DH_COLS_MAX); }
    if (crab_rspec == 0) { crab_rspec = dh_cols_new(DH_COLS_MAX); }
    return 0;
}

fn crab_hit(x, y, out16): i64 {
    store64(out16, 0 - 1);
    store64(out16 + 8, 0 - 1);
    if (crab_root == 0) { return 0; }
    var w = dh_hit_test(crab_root, x, y);
    if (w == 0) { return 0; }
    # Walk up to whichever pane LIST contains the hit, remembering the child we came through —
    # that child IS the row, because `dh_list_add` makes rows direct children of the list.
    var node = w;
    var child = 0;
    var pane = 0 - 1;
    while (node != 0) {
        if (node == crab_llst) { pane = 0; }
        if (node == crab_rlst) { pane = 1; }
        if (pane >= 0) { store64(out16, pane); }
        if (pane >= 0) { node = 0; }
        else {
            child = node;
            node = dh_widget_parent(node);
        }
    }
    if (pane < 0) { return 0; }
    if (child == 0) { return 1; }                 # inside the list, but not on a row
    var lst = crab_llst;
    if (pane == 1) { lst = crab_rlst; }
    var i = 0;
    var r = dh_list_row_at(lst, i);
    while (r != 0) {
        if (r == child) {
            store64(out16 + 8, i);
            return 1;
        }
        i = i + 1;
        r = dh_list_row_at(lst, i);
    }
    return 1;
}

# @public — write the tray's detail line into `dst`: "118 MB/s · 3m 04s left".
# -> bytes written, excluding the NUL. `dst` must hold at least 40. Writes "" when nothing is known.
#
# ⛔ EACH HALF APPEARS ONLY IF IT IS TRUE. `rate < 0` means the transfer is too young to have a
# trustworthy rate; `eta < 0` means there is no denominator to project against. The canvas draws
# "118 MB/s · 3m 04s left" as one string, but a tray that prints "0 B/s · 0s left" while it works out
# what is happening is worse than one that prints nothing — the operator reads the zero as a stall.
# ⇒ Four outcomes: both, rate only, neither. (ETA without a rate is impossible by construction.)
# ⚠ The canvas's own 420px variant drops this line entirely, so an absent detail line is a drawn
# state rather than a missing feature.
fn crab_tray_detail(dst, rate, eta): i64 {
    store8(dst, 0);
    if (rate < 0) { return 0; }
    var n = crab_size_str(dst, rate);
    store8(dst + n, 47); n = n + 1;                    # '/'
    store8(dst + n, 115); n = n + 1;                   # 's'
    if (eta < 0) { store8(dst + n, 0); return n; }
    store8(dst + n, 32); n = n + 1;
    store8(dst + n, 183 - 0); n = n + 1;               # CP437 middle dot
    store8(dst + n, 32); n = n + 1;
    n = n + crab_dur_str(dst + n, eta);
    store8(dst + n, 32); n = n + 1;
    store8(dst + n, 108); n = n + 1;                   # 'l'
    store8(dst + n, 101); n = n + 1;                   # 'e'
    store8(dst + n, 102); n = n + 1;                   # 'f'
    store8(dst + n, 116); n = n + 1;                   # 't'
    store8(dst + n, 0);
    return n;
}

# @public — write `secs` into `dst` as "45s" / "3m 04s" / "2h 09m". -> bytes written.
#
# ⚠ TWO UNITS, NEVER THREE, AND THE SECOND IS ZERO-PADDED. "3m 4s" reads as ambiguous at a glance
# where "3m 04s" does not, and an ETA precise to the second across two hours is precision the
# measurement does not have.
fn crab_dur_str(dst, secs): i64 {
    var sv = secs;
    if (sv < 0) { sv = 0; }
    if (sv < 60) {
        var n0 = crab_u2s(dst, sv);
        store8(dst + n0, 115); store8(dst + n0 + 1, 0);      # 's'
        return n0 + 1;
    }
    if (sv < 3600) {
        var m = sv / 60;
        var n1 = crab_u2s(dst, m);
        store8(dst + n1, 109); n1 = n1 + 1;                  # 'm'
        store8(dst + n1, 32); n1 = n1 + 1;
        n1 = n1 + crab_pad2(dst + n1, sv - m * 60);
        store8(dst + n1, 115); store8(dst + n1 + 1, 0);      # 's'
        return n1 + 1;
    }
    var h = sv / 3600;
    var n2 = crab_u2s(dst, h);
    store8(dst + n2, 104); n2 = n2 + 1;                      # 'h'
    store8(dst + n2, 32); n2 = n2 + 1;
    n2 = n2 + crab_pad2(dst + n2, (sv - h * 3600) / 60);
    store8(dst + n2, 109); store8(dst + n2 + 1, 0);          # 'm'
    return n2 + 1;
}

# @public — write the tray's percentage into `dst` ("68%", or "--" when the total is unknown).
# -> the bytes written, excluding the NUL. `dst` must hold at least 8.
#
# ⛔ "--", NOT "0%", WHEN THERE IS NO DENOMINATOR. They are different facts and the whole reason
# dhancha's bar has an indeterminate mode: a transfer whose source could not be stat'd has not made
# zero progress, it has made unmeasurable progress. Printing 0% next to a bar that is deliberately
# NOT showing 0% would also make the two disagree on screen.
# ⚠ A total of 0 is a real, legitimate case — an empty file — and it is COMPLETE the moment it
# starts. It reads 100%, not a division by zero.
fn crab_tray_pct(dst, done, total): i64 {
    if (total < 0) { store8(dst, 45); store8(dst + 1, 45); store8(dst + 2, 0); return 2; }
    var pct = 100;
    if (total > 0) {
        var d = done;
        if (d < 0) { d = 0; }
        if (d > total) { d = total; }
        # ⚠ Multiply then divide, as everywhere else — `done * (100 / total)` truncates to zero for
        # every file bigger than 100 bytes.
        pct = d * 100 / total;
    }
    var n = crab_u2s(dst, pct);
    store8(dst + n, 37);                               # '%'
    store8(dst + n + 1, 0);
    return n + 1;
}

# ⚠ Tray geometry. 4px bar with 5px above and 4px below, plus an 18px title line — the mockup's own
# proportions, lifted as GEOMETRY rather than as position or colour.
enum CrabMenuGeom {
    CRAB_MENU_W    = 210;
    CRAB_MENU_KEYW = 54;
    CRAB_SHEET_H   = 96;
}

# ⛔ ONE SPEC, ALLOCATED ONCE AND RESET — `dh_cols_new` is on the GLOBAL allocator, so a spec built
# inside the render path is a 40-byte-per-frame leak. Same rule the pane specs follow.
var crab_mspec = 0;
fn crab_mspec_init(): i64 {
    if (crab_mspec == 0) { crab_mspec = dh_cols_new(DH_COLS_MAX); }
    return crab_mspec;
}

# ⚠ The menu's LIST, recorded for hit-testing — refreshed every frame like `crab_llst`/`crab_rlst`.
var crab_mlst = 0;
fn crab_menu_list(): i64 { return crab_mlst; }

enum CrabTray {
    CRAB_TRAY_H      = 31;
    CRAB_TRAY_BAR_H  = 4;
    CRAB_TRAY_TITLE_H = 18;
    CRAB_TRAY_DETAIL_H = 14;
}

# @public — should the tray be on screen at all? 1 = yes. `opname` is 0 when nothing is running.
#
# ⚠ THE TRAY IS NOT A PERMANENT FIXTURE. A file manager with a dead progress strip along the bottom
# has spent 31px of every window on nothing; when no transfer is running the band is not reserved,
# no widgets are built, and the panes get the pixels back.
#
# ⛔⛔ THE TRANSFER STATE ARRIVES AS PARAMETERS, NOT BY CALLING `crab_op_active()`. This file is
# BELOW `app.cyr` in the include chain — `ui.cyr` is included BY `app.cyr`, and both `render_test.cyr`
# and the suite include `ui.cyr` ALONE. Reaching up into the operation record compiled fine through
# `main.cyr` and left `render_test` with four undefined symbols, which is the layering inversion this
# codebase already carved `path.cyr` and `app.cyr` out to prevent. Same rule as `lstate`/`rstate`:
# the caller reads its own state and passes it down.
fn crab_tray_wanted(opname): i64 {
    if (opname == 0) { return 0; }
    if (load8(opname) == 0) { return 0; }
    return 1;
}

# Build the transfer tray: a title line over a PROGRESS bar (dhancha 0.9.22).
#
# ⛔⛔ crab NAMES NO COLOUR ON THE BAR, AND THAT IS THE WHOLE REASON `PROGRESS` IS A dhancha WIDGET
# RATHER THAN A BOX crab TINTS ITSELF. A bar built here from two coloured boxes would have crab
# writing `dh_theme_accent()` into its own source — the exact thing ADR 0001 forbids, and the first
# step toward crab carrying a palette.
# ⛔ AND THE BAR GOES IN A `BOX_V`. In a `BOX_H` its `pref_h` is the CROSS axis, where ALIGN_STRETCH
# fills the row height and ignores it — the bar would silently become as tall as its row.
# ⚠ Every string here is `dh_falloc`, because `dh_widget_set_text` stores the pointer without
# copying: a global-alloc string on an arena widget outlives its widget forever.
fn crab_tray(root, w, opname, opdone, optotal, oprate, opeta): i64 {
    var tray = dh_widget_new(BOX);
    dh_widget_set_layout(tray, BOX_V);
    dh_widget_set_bg(tray, dh_theme_panel());
    dh_widget_set_pref(tray, 0, CRAB_TRAY_H);
    dh_widget_set_flex(tray, 0);
    dh_widget_set_padding(tray, 4);

    var title = dh_widget_new(BOX);
    dh_widget_set_layout(title, BOX_H);
    dh_widget_set_pref(title, 0, CRAB_TRAY_TITLE_H);
    dh_widget_set_flex(title, 0);
    var nm = dh_widget_new(LABEL);
    dh_widget_set_flex(nm, 1);
    dh_widget_set_text(nm, opname);
    dh_widget_add_child(title, nm);
    # ⚠ THE PERCENTAGE IS A SIBLING LABEL, NOT TEXT ON THE BAR. dhancha's own header says why: one
    # centred "68%" straddling the fill edge cannot be legible in a single ink — `on-accent` over the
    # track and plain `ink` over the fill both fall near 1.3:1 on the dark grounds.
    var pctw = dh_widget_new(LABEL);
    dh_widget_set_flex(pctw, 0);
    dh_widget_set_pref(pctw, 40, 0);
    dh_widget_set_fg(pctw, dh_theme_mute());
    var pb = dh_falloc(16);
    crab_tray_pct(pb, opdone, optotal);
    dh_widget_set_text(pctw, pb);
    dh_widget_add_child(title, pctw);
    dh_widget_add_child(tray, title);

    # ⚠ THE DETAIL LINE IS ADDED ONLY WHEN IT HAS SOMETHING TO SAY, so the tray does not reserve a
    # row for a string that is empty for the first half-second of every transfer.
    var db = dh_falloc(48);
    var dn = crab_tray_detail(db, oprate, opeta);
    if (dn > 0) {
        var det = dh_widget_new(LABEL);
        dh_widget_set_pref(det, 0, CRAB_TRAY_DETAIL_H);
        dh_widget_set_flex(det, 0);
        dh_widget_set_fg(det, dh_theme_mute());
        dh_widget_set_text(det, db);
        dh_widget_add_child(tray, det);
    }
    var bar = dh_progress_new(CRAB_TRAY_BAR_H);
    dh_widget_set_flex(bar, 1);
    # ⛔ THE TOTAL IS PASSED THROUGH UNTOUCHED, INCLUDING -1. dhancha reads `den <= 0` as
    # INDETERMINATE, which is exactly what crab means when the source could not be stat'd — and on a
    # host build that is the normal answer. Substituting a guessed denominator here to "make the bar
    # look right" would be crab lying about what it knows.
    dh_progress_set(bar, opdone, optotal);
    dh_widget_add_child(tray, bar);
    dh_widget_add_child(root, tray);
    return tray;
}

# ⭐⭐ THE OVERLAY LAYER (M4, dhancha 0.9.23). The context menu and the rename field both live here.
#
# ⛔ THE LAYER IS THE LAST CHILD OF THE ROOT, AND THAT IS LOAD-BEARING IN BOTH PASSES. `dh_hit_test`
# prunes any subtree whose root does not contain the point, and the painter culls identically — so a
# popup parented to the ROW that spawned it would be invisible and unclickable together. A
# full-window layer added last wins the click and the pixel by construction, and it is also what
# makes the popup MODAL: it swallows every hit the popup itself does not take, so the panes beneath
# are unreachable for exactly as long as it is in the tree. dhancha holds no modal state; the tree
# IS the state.
#
# ⚠ `menu_x`/`menu_y` are where the operator asked for it. `dh_place_at_point` FLIPS rather than
# slides near an edge, so the pointer is never left sitting on top of the menu it opened.
fn crab_overlay(root, w, h, menuopen, menux, menuy, menusel, mcount, misdir, mmarked, mname,
  editopen, editlabel): i64 {
    var layer = dh_overlay_new();
    dh_widget_set_pref(layer, w, h);
    if (menuopen != 0) {
        crab_mspec_init();
        dh_cols_reset(crab_mspec, 2);
        dh_cols_set_width(crab_mspec, 0, 0);
        dh_cols_set_width(crab_mspec, 1, CRAB_MENU_KEYW);
        var m = dh_menu_new(22);
        var i = 0;
        while (i < CRAB_MI_COUNT) {
            var row = dh_menu_item(m, crab_mspec, crab_menu_label(i), crab_menu_key(i));
            # ⚠ A DISABLED ENTRY IS GREYED AND INERT, not hidden — entries that move around force
            # the operator to re-read the menu every time. `DH_FLAG_INERT` makes dhancha skip it with
            # the keyboard and miss it with the mouse, so "greyed" is not merely cosmetic.
            if (crab_menu_enabled(i, mcount, misdir, mmarked) == 0) {
                dh_widget_set_fg(row, dh_theme_faint());
                dh_widget_set_inert(row, 1);
            }
            # ⛔ A separator before the destructive verb, so Delete is never the key you land on by
            # overshooting Rename.
            if (i == CRAB_MI_RENAME) { dh_menu_sep(m); }
            i = i + 1;
        }
        dh_list_select(m, menusel);
        # ⛔⛔ `dh_falloc`, NOT `alloc` — THIS WAS A REAL PER-FRAME LEAK, SHIPPED IN 0.7.5. Both this
        # rect and the sheet's below are pure scratch: an out-parameter read on the next three lines
        # and never referenced again. On the global allocator, which has no `free()`, they cost 32 B
        # on EVERY frame drawn while a menu or the rename sheet is open — and crab re-renders after
        # every handled event, so arrowing down a six-item menu leaked 32 B per keystroke, forever.
        # ⛔ THE GATE COULD NOT SEE IT, AND THAT IS THE REAL FINDING. crab's zero-allocation
        # assertion renders twenty frames with **no overlay open**, so this whole branch never ran
        # under it. A gate that covers only the default state proves the default state.
        # ⇒ The test now renders with the menu open, the sheet open and the preview open. Found
        # 2026-08-31 while making `crab_is_image` allocation-free — the same mistake, one branch over.
        var mr = dh_falloc(32);
        dh_place_at_point(mr, menux, menuy, CRAB_MENU_W, dh_menu_pref_h(m), w, h, 4);
        dh_widget_set_pref(m, load64(mr + 16), load64(mr + 24));
        dh_widget_set_offset(m, load64(mr + 0), load64(mr + 8));
        dh_widget_add_child(layer, m);
        crab_mlst = m;
    } else { crab_mlst = 0; }
    if (editopen != 0) {
        # ⚠ A SHEET, NOT A ROW-ALIGNED FIELD. Inline-over-the-row is what the canvas draws, but it
        # needs the row's laid-out rect, and the row is rebuilt after this runs. A pinned sheet is
        # unambiguous, works identically in solo and dual pane, and is a form the canvas itself draws
        # at its small size.
        dh_widget_set_scrim(layer, 1);
        var sh = dh_sheet_new();
        dh_widget_set_layout(sh, BOX_V);
        var lab = dh_widget_new(LABEL);
        dh_widget_set_pref(lab, 0, 20);
        dh_widget_set_text(lab, editlabel);
        dh_widget_add_child(sh, lab);
        var fld = dh_widget_new(LABEL);
        dh_widget_set_pref(fld, 0, 24);
        dh_widget_set_bg(fld, dh_theme_widget());
        # ⚠ The caret is drawn INTO the string, because crab owns the buffer rather than dhancha —
        # see the ⛔ on `crab_edit_buf`. `_` at the caret is the CP437 font's most legible marker.
        var eb = dh_falloc(CRAB_EDIT_CAP + 4);
        var ei2 = 0;
        var ec = crab_edit_caret();
        var el = crab_edit_len();
        var src = crab_edit_buf();
        var o2 = 0;
        while (ei2 < el) {
            if (ei2 == ec) { store8(eb + o2, 95); o2 = o2 + 1; }
            store8(eb + o2, load8(src + ei2)); o2 = o2 + 1;
            ei2 = ei2 + 1;
        }
        if (ec >= el) { store8(eb + o2, 95); o2 = o2 + 1; }
        store8(eb + o2, 0);
        dh_widget_set_text(fld, eb);
        dh_widget_add_child(sh, fld);
        var hint = dh_widget_new(LABEL);
        dh_widget_set_pref(hint, 0, 18);
        dh_widget_set_fg(hint, dh_theme_mute());
        dh_widget_set_text(hint, "Enter = confirm    Esc = cancel");
        dh_widget_add_child(sh, hint);
        var sr = dh_falloc(32);      # ⛔ scratch — see the ⛔ on the menu's rect above
        dh_place_pinned(sr, 0, CRAB_SHEET_H, w, h, DH_PIN_BOTTOM, 24);
        dh_widget_set_pref(sh, load64(sr + 16), load64(sr + 24));
        dh_widget_set_offset(sh, load64(sr + 0), load64(sr + 8));
        dh_widget_add_child(layer, sh);
    }
    dh_widget_add_child(root, layer);
    return layer;
}

# Case-insensitive compare of an `el`-byte extension against an all-lowercase literal.
#
# ⛔⛔ ALLOCATION-FREE ON PURPOSE, AND THE FIRST DRAFT OF THIS WAS NOT. It lowercased into an
# `alloc(8)` scratch buffer — eight bytes per call, on a path `crab_preview` reaches EVERY FRAME,
# through an allocator with no `free()`. That is precisely the per-frame leak dhancha 0.9.13–0.9.16
# and crab 0.6.0 spent four releases driving to zero, reintroduced by a convenience buffer.
# ⚠ `dh_falloc` would also have been wrong here, though only in style: nothing outlives the call, so
# the right answer is not to allocate at all. Reach for the arena when a WIDGET needs the string.
# ⚠ The suite did not catch the first draft, because the zero-allocation gate rendered frames with
# the preview CLOSED. That gap is closed alongside this — see the preview arm in `crab.tcyr`.
fn crab_ext_eq(ext, el, lit): i64 {
    var i = 0;
    while (i < el) {
        var c = load8(ext + i);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        if (c != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    if (load8(lit + el) != 0) { return 0; }    # the literal is longer -> not a match
    return 1;
}

# @public — is `name` one of the raster formats this stack can actually decode? 1 = yes.
#
# ⛔ THE SET IS DERIVED FROM chitra, NOT INVENTED HERE. chitra 1.0.0 decodes exactly PNG, JPEG, GIF
# and BMP — `chitra_image_decode` sniffs those four signatures and REJECTS anything else with no
# fall-through — so this is the set for which crab can ever show dimensions or a thumbnail. Naming a
# fifth extension here would promise a preview the stack cannot produce.
# ⚠ AN EXTENSION IS A HINT AND crab TREATS IT AS ONE. It decides what is worth *reading a header
# for*; the header's own signature bytes decide what the file actually is. A `.png` holding JPEG
# bytes is a JPEG, and `crab_img_dims` says so — this function only avoids opening every file in the
# directory to find out.
# ⚠ CASE-INSENSITIVE, because `.JPG` off a camera is the common case, not the odd one.
fn crab_is_image(name): i64 {
    if (name == 0) { return 0; }
    var n = 0;
    while ((load8(name + n) != 0) && (n < CRAB_NAME_MAX)) { n = n + 1; }
    var dot = 0 - 1;
    var i = n - 1;
    while (i > 0) {
        if (load8(name + i) == 46) { dot = i; i = 0; }
        else { i = i - 1; }
    }
    if (dot < 0) { return 0; }
    var e = dot + 1;
    var el = n - e;
    if (el < 3) { return 0; }
    if (el > 4) { return 0; }
    if (crab_ext_eq(name + e, el, "png") == 1) { return 1; }
    if (crab_ext_eq(name + e, el, "jpg") == 1) { return 1; }
    if (crab_ext_eq(name + e, el, "jpeg") == 1) { return 1; }
    if (crab_ext_eq(name + e, el, "gif") == 1) { return 1; }
    if (crab_ext_eq(name + e, el, "bmp") == 1) { return 1; }
    return 0;
}

# ⭐⭐ IMAGE DIMENSIONS FROM THE HEADER ALONE — no decoder, no dependency, no inflate.
#
# ⛔⛔ THIS IS DELIBERATELY NOT chitra, AND THE REASON IS A MEASURED 528 KB. Declaring
# `chitra 1.0.0` takes crab's host binary from **453,304 B to 981,992 B (+116.6 %)** and the agnos
# binary from 474,944 to 1,001,520 (+110.9 %), and `CYRIUS_DCE=1` reclaims **none** of it — it NOPs
# the unreachable functions and the byte count does not move. Decomposed on 2026-08-31:
#
#   | added                                   | host bytes |     delta |
#   |-----------------------------------------|-----------:|----------:|
#   | (baseline, 0.7.5)                       |    453,304 |         — |
#   | + stdlib `thread`                       |    461,608 |    +8,304 |
#   | + stdlib `flags`                        |    461,624 |    +8,320 |
#   | + stdlib `thread` + `sankoch`           |    860,784 |  +407,480 |
#   | + all three + chitra's own fold         |    981,992 |  +528,688 |
#
# ⇒ **~399 KB of it is `sankoch`**, the RFC 1950/1951 inflate leaf that PNG's IDAT needs, pulled in
# transitively — chitra's own decoder fold is only ~113 KB. crab does not choose that; PNG does.
# ⚠ And crab need not DECLARE the extra leaves: `cyrius deps` re-creates them from chitra's
# `dist/chitra.deps` sidecar, so the cost arrives whether or not the manifest names them.
# ⇒ **Dimensions do not need any of it.** PNG, GIF and BMP put width and height at FIXED offsets in
# the first 26 bytes, and JPEG puts them in an SOF segment a bounded marker walk reaches. So the
# metadata half of the preview is free, and the PIXEL half — thumbnails — is a separate decision
# with a price tag attached, which is the operator's to make and not this file's.
#
# ⛔⛔ EVERY READ IS BOUNDED BY `len`, AND THAT IS NOT OPTIONAL — this parses a FILE, which is the
# most untrusted input crab handles. `src/path.cyr` exists because an unbounded copy over readdir
# data caused the 0.5.0 P-1, and a file's bytes are chosen by whoever wrote the file. The JPEG walk
# additionally caps its iteration count, for the same reason the `#101` readdir loops do: a segment
# length of 0 would otherwise spin forever on a crafted file.
#
# -> 1 with width at `out + CRAB_IMG_W` and height at `+ CRAB_IMG_H`; 0 if the bytes are not a
# format crab recognises, are truncated, or claim an absurd size.
enum CrabImg {
    CRAB_IMG_W        = 0;
    CRAB_IMG_H        = 8;
    CRAB_IMG_SZ       = 16;
    # ⚠ An ABSURDITY bound, not a format limit — PNG's own maximum is 2^31-1. A raster crab could
    # act on is bounded by what a surface can hold; anything past this is a corrupt header, and
    # reporting it as a size would put a nonsense number in front of the operator.
    CRAB_IMG_DIM_MAX  = 1048576;
    # ⚠ Same shape and reasoning as `CRAB_READDIR_STEPS_MAX`: far above any legitimate JPEG (a photo
    # with EXIF has a handful of segments before SOF), so reaching it is always a malformed file.
    CRAB_IMG_SCAN_MAX = 256;
}

# Big-endian and little-endian scalar reads. ⚠ `load8` is UNSIGNED (0..255) — verified by probe,
# not assumed, because a sign-extending load would make PNG's 0x89 signature byte compare as -119
# and every PNG would be rejected.
fn crab_be16(p): i64 { return load8(p) * 256 + load8(p + 1); }
fn crab_be32(p): i64 {
    return load8(p) * 16777216 + load8(p + 1) * 65536 + load8(p + 2) * 256 + load8(p + 3);
}
fn crab_le16(p): i64 { return load8(p + 1) * 256 + load8(p); }
fn crab_le32(p): i64 {
    return load8(p + 3) * 16777216 + load8(p + 2) * 65536 + load8(p + 1) * 256 + load8(p);
}

# Accept a width/height pair only if both are positive and inside the absurdity bound.
fn crab_dims_ok(out, w, h): i64 {
    if (w <= 0) { return 0; }
    if (h <= 0) { return 0; }
    if (w > CRAB_IMG_DIM_MAX) { return 0; }
    if (h > CRAB_IMG_DIM_MAX) { return 0; }
    store64(out + CRAB_IMG_W, w);
    store64(out + CRAB_IMG_H, h);
    return 1;
}

# JPEG: walk the marker chain to the first SOF segment, which carries height then width.
# ⚠ SOF is 0xC0-0xCF **except** 0xC4 (DHT), 0xC8 (JPG) and 0xCC (DAC) — those three sit inside the
# range and are not frame headers. Treating them as SOF reads a Huffman table as a size.
fn crab_jpeg_dims(buf, len, out): i64 {
    # ⛔⛔ `p` IS AN OFFSET INTO `buf`, NEVER AN ADDRESS — every read below is `buf + p`. The first
    # draft wrote `load8(p)`, which dereferences address 2 and segfaults on the very first marker.
    # ⚠ AND NOT ONE BOUNDS CHECK WOULD HAVE CAUGHT IT: `p` was compared against `len` correctly
    # throughout, so the arithmetic was right and only the BASE was missing. A bounds check proves
    # an index is in range; it says nothing about which buffer the index is used against.
    var p = 2;                                   # past SOI
    var steps = 0;
    while (steps < CRAB_IMG_SCAN_MAX) {
        steps = steps + 1;
        if (p + 1 >= len) { return 0; }
        # ⚠ FILL BYTES: a marker may be preceded by any number of 0xFF padding bytes, so the marker
        # identifier is the first NON-0xFF byte after them. ⛔ The loop carries an explicit flag
        # rather than encoding "found" in `p` itself — a first draft signalled the exit by assigning
        # `p = len + len` and then subtracting it back, which restored `p` to 0 and restarted the
        # walk at the SOI. It compiled, and on a JPEG with no fill bytes it never ran.
        if (load8(buf + p) != 255) { return 0; }
        var scanning = 1;
        while (scanning == 1) {
            if (p >= len) { return 0; }
            if (load8(buf + p) == 255) { p = p + 1; } else { scanning = 0; }
        }
        var mk = load8(buf + p);
        p = p + 1;
        # ⚠ STANDALONE MARKERS CARRY NO LENGTH PAYLOAD — SOI, TEM and the eight restart markers are
        # two bytes and nothing more, so reading a segment length after one reads the NEXT marker's
        # bytes as a size. A flag rather than a nested else-chain: three conditions with one
        # consequence read as three conditions, and the chain needed a `steps = steps;` no-op in
        # each empty arm to say nothing.
        var standalone = 0;
        if (mk == 0xD8) { standalone = 1; }                       # SOI
        if (mk == 0x01) { standalone = 1; }                       # TEM
        if ((mk >= 0xD0) && (mk <= 0xD7)) { standalone = 1; }     # RST0-RST7
        if (standalone == 0) {
            # ⛔ SOS and EOI mean the frame header is behind us and was never found. Scanning into
            # entropy-coded data would find 0xFF bytes that are not markers at all.
            if (mk == 0xDA) { return 0; }
            if (mk == 0xD9) { return 0; }
            if (p + 1 >= len) { return 0; }
            var seg = crab_be16(buf + p);
            # ⚠ DEFENCE IN DEPTH, NOT THE TERMINATION GUARANTEE — and the fuzzer proved which is
            # which. A segment length below 2 cannot advance `p`, so a crafted file would re-read
            # the same marker forever; but removing this check does NOT hang, because
            # `CRAB_IMG_SCAN_MAX` stops the walk after 256 markers regardless. **The step cap is
            # what makes this function total**; this line just makes the refusal immediate and
            # named. Same relationship as `CRAB_WALK_STEPS_MAX` to the walk's own guards.
            if (seg < 2) { return 0; }
            var issof = 0;
            if ((mk >= 0xC0) && (mk <= 0xCF)) { issof = 1; }
            if (mk == 0xC4) { issof = 0; }
            if (mk == 0xC8) { issof = 0; }
            if (mk == 0xCC) { issof = 0; }
            if (issof == 1) {
                if (p + 7 >= len) { return 0; }
                return crab_dims_ok(out, crab_be16(buf + p + 5), crab_be16(buf + p + 3));
            }
            p = p + seg;
        }
    }
    return 0;
}

# @public — read an image's pixel dimensions out of `len` header bytes. See the ⛔ block above.
fn crab_img_dims(buf, len, out): i64 {
    if (buf == 0) { return 0; }
    if (out == 0) { return 0; }
    if (len < 10) { return 0; }
    store64(out + CRAB_IMG_W, 0);
    store64(out + CRAB_IMG_H, 0);
    # --- PNG: the 8-byte signature, then an IHDR chunk whose width/height are at 16 and 20.
    if (load8(buf) == 137) {
        if (load8(buf + 1) == 80) {
            if (load8(buf + 2) == 78) {
                if (load8(buf + 3) == 71) {
                    if (len < 24) { return 0; }
                    # ⛔ THE CHUNK TYPE IS CHECKED, not assumed from the signature. IHDR is required
                    # to be first by the spec, and a file that breaks that rule is exactly the file
                    # this parser must not read four arbitrary bytes out of.
                    if (load8(buf + 12) != 73) { return 0; }      # 'I'
                    if (load8(buf + 13) != 72) { return 0; }      # 'H'
                    if (load8(buf + 14) != 68) { return 0; }      # 'D'
                    if (load8(buf + 15) != 82) { return 0; }      # 'R'
                    return crab_dims_ok(out, crab_be32(buf + 16), crab_be32(buf + 20));
                }
            }
        }
    }
    # --- GIF: "GIF87a" / "GIF89a", then a little-endian logical screen size at 6 and 8.
    if (load8(buf) == 71) {
        if (load8(buf + 1) == 73) {
            if (load8(buf + 2) == 70) {
                # ⚠ THE VERSION IS TWO CHARACTERS, "87a" or "89a", AND BOTH ARE CHECKED. Testing
                # only the '8' accepts "GIF8Xa" for any X — a signature check that admits files no
                # decoder in the stack would take, which is the opposite of what it is for.
                if (load8(buf + 3) != 56) { return 0; }           # '8'
                var gv = load8(buf + 4);
                if ((gv != 55) && (gv != 57)) { return 0; }       # '7' or '9'
                if (load8(buf + 5) != 97) { return 0; }           # 'a'
                return crab_dims_ok(out, crab_le16(buf + 6), crab_le16(buf + 8));
            }
        }
    }
    # --- BMP: "BM", then a DIB header whose SIZE field says which layout it is.
    if (load8(buf) == 66) {
        if (load8(buf + 1) == 77) {
            if (len < 26) { return 0; }
            var dib = crab_le32(buf + 14);
            # ⚠ BITMAPCOREHEADER is 12 bytes with 16-bit dimensions; everything since is >= 40 with
            # 32-bit ones. Reading a core header at the modern offsets gets the palette instead.
            if (dib == 12) { return crab_dims_ok(out, crab_le16(buf + 18), crab_le16(buf + 20)); }
            if (dib < 40) { return 0; }
            var bw = crab_le32(buf + 18);
            var bh = crab_le32(buf + 22);
            # ⚠ A NEGATIVE HEIGHT MEANS TOP-DOWN ROW ORDER, not a negative size. It is a direction
            # flag living in the sign bit, and the magnitude is the real height.
            if (bh >= 2147483648) { bh = 4294967296 - bh; }
            if (bw >= 2147483648) { bw = 4294967296 - bw; }
            return crab_dims_ok(out, bw, bh);
        }
    }
    # --- JPEG: SOI, then a bounded walk to the first SOF.
    if (load8(buf) == 255) {
        if (load8(buf + 1) == 216) { return crab_jpeg_dims(buf, len, out); }
    }
    return 0;
}

# @public — the KIND line's text. ⚠ THREE KINDS AND DELIBERATELY NOT MORE.
# An extension-to-kind table is the "small language nobody asked for" that the batch-rename sheet
# refused for the same reason: every entry is a claim about a file crab has not opened, and the
# table grows forever once it exists. crab names the two kinds it can act on differently — a folder
# it can descend into, and an image it can read dimensions from — and calls everything else a file.
fn crab_kind_str(name, is_dir): i64 {
    if (is_dir == 1) { return "Folder"; }
    if (crab_is_image(name) == 1) { return "Image"; }
    return "File";
}

# @public — may this window show the preview column? 1 = yes. `want` is the operator's toggle.
#
# ⛔ THE THRESHOLD IS DERIVED FROM crab's OWN COLUMN RULE, exactly as `crab_two_panes_fit` is, and
# for the reason recorded there: a pixel lifted from a mockup is a number nobody can re-derive when
# the font or the column set changes. The rule is **the preview may not cost a pane its SIZE
# column** — a pane reduced to bare names is not a file manager, and the preview shows the metadata
# of ONE entry while the column shows it for all of them.
# ⚠ IT DELIBERATELY DOES NOT DEMAND THREE COLUMNS. Opening the preview at the shipped 380x220 does
# drop the panes from three columns to two — but the value that leaves the pane, MODIFIED, is the
# value the preview then shows for the selected entry. That is a trade the operator asked for by
# pressing the key, not a silent loss.
# ⛔ AND WHEN IT DOES NOT FIT, THE ANSWER IS A REFUSAL THE OPERATOR CAN SEE — `src/main.cyr` sets a
# notice, the same discipline `crab_resize_wanted` uses. A toggle that silently does nothing is
# indistinguishable from a broken key.
fn crab_preview_fit(w, want): i64 {
    if (want == 0) { return 0; }
    var rest = w - CRAB_PV_W;
    if (rest <= CRAB_PANE_GAP) { return 0; }
    var panew = rest - CRAB_PANE_GAP;
    if (crab_two_panes_fit(rest) == 1) { panew = (rest - CRAB_PANE_GAP) / 2; }
    if (crab_cols_for_width(panew) < 2) { return 0; }
    return 1;
}

# One label/value pair in the preview column. The label is muted and the value is not, so the eye
# lands on the data rather than on the word naming it.
# ⚠ `dh_falloc` throughout — `dh_widget_set_text` stores the pointer and does not copy, so every
# string here must die with the frame that built it.
fn crab_pv_field(col, label, value): i64 {
    var l = dh_widget_new(LABEL);
    dh_widget_set_pref(l, 0, CRAB_PV_ROW_H);
    dh_widget_set_flex(l, 0);
    dh_widget_set_fg(l, dh_theme_mute());
    dh_widget_set_text(l, label);
    dh_widget_add_child(col, l);
    var v = dh_widget_new(LABEL);
    dh_widget_set_pref(v, 0, CRAB_PV_ROW_H);
    dh_widget_set_flex(v, 0);
    dh_widget_set_text(v, value);
    dh_widget_add_child(col, v);
    return 0;
}

# @public — the preview column: what the ACTIVE pane's selected entry is, in words.
#
# ⛔ IT READS THE SAME ARRAYS THE PANE DOES and calls the same formatters — `crab_size_str` and
# `crab_mtime_str`. A preview that formatted its own size would be a second answer to a question the
# pane already answers, free to disagree with the row two inches to its left. That disagreement is
# the exact bug 0.5.0 fixed in `crab_status_str`, where a blank in the pane read as a dash in the
# status line for one unstattable file.
# ⚠ A PENDING SIZE STAYS PENDING HERE TOO. `crab_size_str` renders the deferred-stat sentinel as it
# renders it everywhere else, so opening the preview does not force a synchronous stat onto the
# keystroke path — the thing M3 *#03* restructured the listing to avoid.
# ⚠ AN EMPTY PANE GETS THE COLUMN, NOT A HOLE. The header stays and the fields read "—", because a
# column that vanishes when a directory happens to be empty makes the whole window jump.
fn crab_preview(parent, h, buf, sel, sizes, mtimes, count, imgw, imgh): i64 {
    var col = dh_widget_new(BOX);
    dh_widget_set_layout(col, BOX_V);
    dh_widget_set_pref(col, CRAB_PV_W, h);
    dh_widget_set_flex(col, 0);
    dh_widget_set_bg(col, dh_theme_panel());
    var hdr = dh_widget_new(LABEL);
    dh_widget_set_bg(hdr, dh_theme_panel());
    dh_widget_set_pref(hdr, 0, CRAB_PV_HDR_H);
    dh_widget_set_flex(hdr, 0);
    dh_widget_set_text(hdr, "PREVIEW");
    dh_widget_add_child(col, hdr);
    if (count <= 0) {
        crab_pv_field(col, "NAME", "—");
        crab_pv_field(col, "KIND", "—");
        dh_widget_add_child(parent, col);
        return col;
    }
    var rec = buf + sel * CRAB_REC_SZ;
    var isdir = load8(rec + CRAB_REC_TYPE);
    # ⚠ TRUNCATED TO THE COLUMN, with the same "~" marker the pane rows use — a name clipped without
    # a marker is a name the operator will retype wrongly.
    var nb = dh_falloc(CRAB_NAME_MAX + 4);
    crab_name_cell(nb, rec, crab_col_chars(CRAB_PV_W));
    crab_pv_field(col, "NAME", nb);
    crab_pv_field(col, "KIND", crab_kind_str(rec, isdir));
    if (isdir == 1) {
        # ⛔ A DIRECTORY HAS NO SIZE crab CAN HONESTLY REPORT. The on-disk size of the directory
        # entry itself is not what "size" means to anyone looking at a folder, and the recursive
        # answer is a tree walk — which crab has (`crab_walk_step`) and which costs what it costs.
        # Printing the wrong number is worse than printing none.
        crab_pv_field(col, "SIZE", "—");
    } else {
        var sb = dh_falloc(24);
        crab_size_str(sb, load64(sizes + sel * 8));
        crab_pv_field(col, "SIZE", sb);
    }
    var mb = dh_falloc(24);
    crab_mtime_str(mb, load64(mtimes + sel * 8));
    crab_pv_field(col, "MODIFIED", mb);
    # ⭐ THE CANVAS'S OWN LINE — `42.8 MB · 8192 x 5464`. ⛔ THE ROW IS ABSENT, NOT EMPTY, when crab
    # has no dimensions: a "DIMENSIONS: —" under every text file is a promise the preview keeps
    # failing, and a "0 x 0" is worse still because it reads as a measurement. The label appears
    # exactly when there is something to put beside it.
    if (imgw > 0) {
        if (imgh > 0) {
            var db = dh_falloc(48);
            var dl = crab_u2s(db, imgw);
            store8(db + dl, 32); store8(db + dl + 1, 120); store8(db + dl + 2, 32);
            dl = dl + 3 + crab_u2s(db + dl + 3, imgh);
            store8(db + dl, 0);
            crab_pv_field(col, "DIMENSIONS", db);
        }
    }
    dh_widget_add_child(parent, col);
    return col;
}

# ⭐⭐ THE RENDER-STATE RECORD (M5). `crab_render` took **32 positional parameters** and every one of
# them arrived for a good reason — state flows DOWN into this file rather than being reached UP for,
# because `ui.cyr` sits below `app.cyr` and the render path must never call back up. That rule is not
# being relaxed. What changes is the *carrier*: one record pointer instead of 32 argument slots.
#
# ⛔ THE FAILURE THIS EXISTS TO PREVENT IS A MISCOUNTED COMMA. At 32 positional arguments — nine of
# which are 0, four of which are `0 - 1`, and six of which are bare pointers — dropping or adding one
# argument shifts every argument after it and still compiles, because they are all `i64`. crab had
# twenty-four such call sites in `tests/crab.tcyr` alone. A setter with eleven named parameters
# cannot silently absorb that mistake: the arity check catches it at compile time.
#
# ⛔ THE DEFAULTS ARE WRITTEN ONCE, HERE, AND THAT IS THE OTHER HALF OF THE POINT. `optotal`,
# `oprate` and `opeta` all use **-1 = cannot be said yet**, not 0 — 0 means "measured, and it is
# zero", which the tray would render as a real 0 B/s. A zeroed record is therefore WRONG, so
# `crab_rs_reset` sets the three sentinels explicitly. Every one of those 24 call sites used to spell
# `0 - 1` by hand, and a single one of them spelling `0` instead would have been invisible.
#
# ⚠ Byte offsets, not a struct — the same discipline as the readdir record (`CrabRec`) and the
# operation record (`CrabOp`). ⚠ The two pane blocks are IDENTICAL in layout and indexed by pane
# number, so `crab_rs_pane` is one function rather than a left copy and a right copy that drift.
enum CrabRs {
    # --- per-pane block, 2 x CRAB_RSP_SZ starting at 0 ---
    CRAB_RSP_BUF    = 0;    # readdir buffer: CRAB_REC_SZ-byte records
    CRAB_RSP_N      = 8;    # entries in it
    CRAB_RSP_PATH   = 16;   # the pane's directory path (a cstring)
    CRAB_RSP_SIZES  = 24;   # parallel i64 array, or CRAB_SZ_PENDING
    CRAB_RSP_MTIMES = 32;   # parallel i64 array
    CRAB_RSP_STATE  = 40;   # CrabPaneState, captured AT LISTING TIME — see below
    CRAB_RSP_MARKS  = 48;   # parallel byte array, 1 = marked
    CRAB_RSP_SEL    = 56;   # selected row
    CRAB_RSP_SCROLL = 64;   # POINTER to the caller's scroll cell — written back through
    CRAB_RSP_SZ     = 72;

    CRAB_RS_ACTIVE   = 144;  # 0 = left, 1 = right
    # The transfer tray. ⚠ Three of these are -1-means-unknown; see the ⛔ above.
    CRAB_RS_OPNAME   = 152;
    CRAB_RS_OPDONE   = 160;
    CRAB_RS_OPTOTAL  = 168;
    CRAB_RS_OPRATE   = 176;
    CRAB_RS_OPETA    = 184;
    # The overlay: the context menu and the rename/batch field.
    CRAB_RS_MENUOPEN = 192;
    CRAB_RS_MENUX    = 200;
    CRAB_RS_MENUY    = 208;
    CRAB_RS_MENUSEL  = 216;
    CRAB_RS_EDITOPEN = 224;
    CRAB_RS_EDITLBL  = 232;
    # The preview column (M5). ⚠ The operator's WANT, not the outcome — `crab_preview_fit` decides
    # whether the window can honour it, and the toggle stays on across a resize that cannot.
    CRAB_RS_PVOPEN   = 240;
    # ⚠ 0 x 0 MEANS "NOT AN IMAGE, OR crab COULD NOT READ ITS HEADER" — the preview then shows no
    # dimensions line at all rather than a "0 x 0" that reads like a measurement.
    CRAB_RS_PVW      = 248;
    CRAB_RS_PVH      = 256;
    CRAB_RS_SZ       = 264;
}

var crab_rs_rec = 0;

# @public — the process-wide render-state record, allocated once.
#
# ⚠ ONE RECORD FOR THE PROCESS, like the sort scratch, the copy buffer and the operation record —
# and for the same reason: `lib/alloc.cyr` is a bump allocator with no `free()`, so a record minted
# per frame would be retained forever. crab renders one frame at a time.
# ⚠ `crab_render` takes the record as a PARAMETER rather than calling this itself, so a caller that
# genuinely needs two independent states (a test rendering two scenarios without them aliasing) can
# allocate its own `CRAB_RS_SZ` bytes and pass that instead.
fn crab_rs(): i64 {
    if (crab_rs_rec == 0) {
        crab_rs_rec = alloc(CRAB_RS_SZ);
        if (crab_rs_rec != 0) { crab_rs_reset(crab_rs_rec); }
    }
    return crab_rs_rec;
}

# @public — clear a record to the state that means "two empty panes, nothing running, no overlay".
#
# ⛔ NOT A memset. Three fields default to **-1**, not 0 — see the ⛔ on `CrabRs`. This function is
# the single place that knows which, and it is why a caller can no longer get it wrong.
fn crab_rs_reset(rs): i64 {
    if (rs == 0) { return 0; }
    var i = 0;
    while (i < CRAB_RS_SZ) { store64(rs + i, 0); i = i + 8; }
    store64(rs + CRAB_RS_OPTOTAL, 0 - 1);
    store64(rs + CRAB_RS_OPRATE, 0 - 1);
    store64(rs + CRAB_RS_OPETA, 0 - 1);
    return 0;
}

# @public — fill one pane's block. `which` is 0 = left, 1 = right.
#
# ⚠ `state` comes from `crab_pane_state(count, crab_listing_err())` and is captured by the caller AT
# LISTING TIME. It is carried rather than recomputed for one reason: `crab_listing_err` reports the
# LAST readdir, and crab lists two panes — so reading it at render time would give both panes the
# right-hand pane's state. The capture has to happen next to the listing that produced it.
# ⚠ `scroll` is a POINTER to a caller-owned i64 cell, not a value: `crab_render` writes the settled
# offset back through it. The widget tree is rebuilt every frame, so the LIST that owns the offset is
# destroyed and recreated each time and that cell is what carries it across.
fn crab_rs_pane(rs, which, buf, n, path, sizes, mtimes, state, marks, sel, scroll): i64 {
    if (rs == 0) { return 0; }
    if (which < 0) { return 0; }
    if (which > 1) { return 0; }
    var p = rs + which * CRAB_RSP_SZ;
    store64(p + CRAB_RSP_BUF, buf);
    store64(p + CRAB_RSP_N, n);
    store64(p + CRAB_RSP_PATH, path);
    store64(p + CRAB_RSP_SIZES, sizes);
    store64(p + CRAB_RSP_MTIMES, mtimes);
    store64(p + CRAB_RSP_STATE, state);
    store64(p + CRAB_RSP_MARKS, marks);
    store64(p + CRAB_RSP_SEL, sel);
    store64(p + CRAB_RSP_SCROLL, scroll);
    return 1;
}

# @public — the transfer tray's state. `name == 0` or `""` means nothing is running, and the tray
# then costs no pixels and no widgets at all.
# ⚠ `total` / `rate` / `eta` are **-1 when they cannot be said yet**, never 0. See `crab_op_rate`.
fn crab_rs_op(rs, name, done, total, rate, eta): i64 {
    if (rs == 0) { return 0; }
    store64(rs + CRAB_RS_OPNAME, name);
    store64(rs + CRAB_RS_OPDONE, done);
    store64(rs + CRAB_RS_OPTOTAL, total);
    store64(rs + CRAB_RS_OPRATE, rate);
    store64(rs + CRAB_RS_OPETA, eta);
    return 1;
}

# @public — the operator's preview-column toggle. ⚠ SEPARATE FROM `crab_rs_chrome` on purpose: the
# preview is a persistent view preference that survives every menu, rename and transfer, while the
# chrome group is per-frame overlay state that is cleared and rebuilt. Folding a preference into a
# group whose whole job is to be reset is how a toggle turns itself off.
fn crab_rs_preview(rs, want): i64 {
    if (rs == 0) { return 0; }
    store64(rs + CRAB_RS_PVOPEN, want);
    return 1;
}

# @public — the selected entry's pixel dimensions, for the preview's DIMENSIONS line.
# ⛔ THE READ THAT PRODUCES THESE LIVES IN `app.cyr` (`crab_preview_dims`) BECAUSE IT NEEDS A
# SYSCALL, and this file sits below that one. Carrying the answer in the record is what keeps the
# render path from reaching up for it — the same rule the pane state and the tray follow.
fn crab_rs_dims(rs, w, h): i64 {
    if (rs == 0) { return 0; }
    store64(rs + CRAB_RS_PVW, w);
    store64(rs + CRAB_RS_PVH, h);
    return 1;
}

# @public — which pane is active, plus the overlay: the context menu and the rename/batch field.
fn crab_rs_chrome(rs, active, menuopen, menux, menuy, menusel, editopen, editlabel): i64 {
    if (rs == 0) { return 0; }
    store64(rs + CRAB_RS_ACTIVE, active);
    store64(rs + CRAB_RS_MENUOPEN, menuopen);
    store64(rs + CRAB_RS_MENUX, menux);
    store64(rs + CRAB_RS_MENUY, menuy);
    store64(rs + CRAB_RS_MENUSEL, menusel);
    store64(rs + CRAB_RS_EDITOPEN, editopen);
    store64(rs + CRAB_RS_EDITLBL, editlabel);
    return 1;
}

# ⭐ EVERY VALUE THE FRAME NEEDS ARRIVES IN `rs` — see `CrabRs`. This file sits BELOW `app.cyr`, which
# owns the listing, the operation record and the pane state, so the render path may not reach up for
# any of them; carrying them in a record changes the vehicle, not that rule.
# ⚠ THE BODY UNPACKS INTO THE OLD NAMES ON PURPOSE. Reading the record once at the top and then
# leaving the 120 lines below untouched is what makes this a change of signature rather than a
# rewrite of the renderer — and `load64` of a field is not free, so hoisting it out of the layout
# code is also the faster shape.
# ⚠ A NULL `rs` RENDERS NOTHING AND SAYS SO by returning 0, exactly as a null surface does. It is a
# caller error, and a frame drawn from a zeroed record would look like an empty directory.
fn crab_render(surf, font, rs): i64 {
    if (surf == 0) { return 0; }
    if (rs == 0) { return 0; }
    var lp0 = rs;
    var rp0 = rs + CRAB_RSP_SZ;
    var lbuf     = load64(lp0 + CRAB_RSP_BUF);
    var ln       = load64(lp0 + CRAB_RSP_N);
    var lpath    = load64(lp0 + CRAB_RSP_PATH);
    var lsizes   = load64(lp0 + CRAB_RSP_SIZES);
    var lmtimes  = load64(lp0 + CRAB_RSP_MTIMES);
    var lstate   = load64(lp0 + CRAB_RSP_STATE);
    var lmarks   = load64(lp0 + CRAB_RSP_MARKS);
    var sel_l    = load64(lp0 + CRAB_RSP_SEL);
    var scroll_l = load64(lp0 + CRAB_RSP_SCROLL);
    var rbuf     = load64(rp0 + CRAB_RSP_BUF);
    var rn       = load64(rp0 + CRAB_RSP_N);
    var rpath    = load64(rp0 + CRAB_RSP_PATH);
    var rsizes   = load64(rp0 + CRAB_RSP_SIZES);
    var rmtimes  = load64(rp0 + CRAB_RSP_MTIMES);
    var rstate   = load64(rp0 + CRAB_RSP_STATE);
    var rmarks   = load64(rp0 + CRAB_RSP_MARKS);
    var sel_r    = load64(rp0 + CRAB_RSP_SEL);
    var scroll_r = load64(rp0 + CRAB_RSP_SCROLL);
    var active_pane = load64(rs + CRAB_RS_ACTIVE);
    var opname   = load64(rs + CRAB_RS_OPNAME);
    var opdone   = load64(rs + CRAB_RS_OPDONE);
    var optotal  = load64(rs + CRAB_RS_OPTOTAL);
    var oprate   = load64(rs + CRAB_RS_OPRATE);
    var opeta    = load64(rs + CRAB_RS_OPETA);
    var menuopen = load64(rs + CRAB_RS_MENUOPEN);
    var menux    = load64(rs + CRAB_RS_MENUX);
    var menuy    = load64(rs + CRAB_RS_MENUY);
    var menusel  = load64(rs + CRAB_RS_MENUSEL);
    var editopen = load64(rs + CRAB_RS_EDITOPEN);
    var editlabel = load64(rs + CRAB_RS_EDITLBL);
    var pvwant   = load64(rs + CRAB_RS_PVOPEN);
    var pvw      = load64(rs + CRAB_RS_PVW);
    var pvh      = load64(rs + CRAB_RS_PVH);
    # ⚠ INSTALL BEFORE `dh_frame_begin`, and only if nothing is installed — a caller that has set its
    # own arena (a test measuring the spill path, say) keeps it.
    if (dh_frame_arena_get() == 0) { dh_frame_arena_set(crab_frame_arena()); }
    # ⛔⛔ THIS FREES THE PREVIOUS FRAME'S WIDGET TREE AND SCRATCH (0.6.0-dev, dhancha 0.9.15). It is
    # here rather than in `src/main.cyr` so that EVERY caller is correct without remembering — a
    # render loop that forgot it would leak exactly as much as before, silently and with a green suite.
    # ⚠ NO-OP UNLESS AN ARENA IS INSTALLED, so the test harnesses are unaffected.
    # ⚠ IT ALSO CLEARS dhancha's RETAINED WIDGET POINTERS (`_dh_focus` and friends), which is why the
    # toolkit exposes this rather than a bare `arena_reset` — see the ⛔ on `dh_frame_begin`. crab is
    # safe because `crab_pane` re-establishes focus on the active pane every frame, below.
    # ⛔ AFTER THIS LINE, EVERY WIDGET POINTER FROM A PREVIOUS FRAME IS DEAD — including the root
    # still stored on `surf`. Nothing reads it before `dh_surface_set_root` replaces it; do not add
    # anything that does.
    dh_frame_begin();
    var w = dh_surface_width(surf);
    var h = dh_surface_height(surf);
    var root = dh_widget_new(WINDOW);
    dh_widget_set_layout(root, BOX_V);          # panes row on top, status line below
    dh_widget_set_bg(root, dh_theme_bg());     # the desktop void

    var panes = dh_widget_new(BOX);
    dh_widget_set_layout(panes, BOX_H);         # two columns side by side
    # ⭐⭐ THE TRANSFER TRAY (M4, v0.7.3) takes its own reserved band, so the panes shrink by exactly
    # its height rather than the tray floating over rows. `CRAB_TRAY_H` is 0 when nothing is running,
    # which is how the tray costs a still crab no pixels and no widgets at all.
    # ⛔ A STRIP ABOVE THE STATUS LINE, NOT A RIGHT-HAND INSPECTOR COLUMN. The canvas draws the tray
    # in an inspector, but that column is M5 and does not exist yet — lifting its POSITION now would
    # mean building half of M5 to hold one bar. The canvas's own 420px variant already drops the
    # tray's detail line, so a compact form is a drawn variant rather than a compromise.
    var trayh = 0;
    if (crab_tray_wanted(opname) == 1) {
        trayh = CRAB_TRAY_H;
        # ⚠ The band grows by exactly the detail row when there is one, so the line never overlaps
        # the bar — the tray reserves what it draws and nothing more.
        if (oprate >= 0) { trayh = trayh + CRAB_TRAY_DETAIL_H; }
    }
    dh_widget_set_pref(panes, 0, h - 24 - trayh);   # reserve 24px for the status line, + the tray
    # ⭐⭐ ONE PANE OR TWO — the M4 ratification. See `crab_two_panes_fit`.
    # ⛔ IN SOLO MODE THE PANE THAT IS NOT SHOWN GETS NO WIDGETS AND ITS LIST POINTER STAYS 0, which
    # `crab_hit` relies on: it walks parents comparing against `crab_llst` / `crab_rlst`, and its
    # loop condition is `node != 0`, so a 0 list can never match a live node. A pane rendered
    # off-screen instead would still hit-test, and clicks would land in a pane nobody can see.
    # ⭐⭐ THE PREVIEW TAKES ITS WIDTH FIRST, AND THE PANES THEN DIVIDE WHAT IS LEFT — including the
    # decision of whether there are two of them. That order is what makes the layout re-derivable
    # rather than a special case: `crab_two_panes_fit` and `crab_cols_for_width` are asked about the
    # width the panes actually get, not about the window, so no rule needs a "unless the preview is
    # open" clause. ⛔ It also means opening the preview can legitimately collapse two panes into
    # one, which is the same ratified rule answering a narrower window — not a second behaviour.
    var pvon = crab_preview_fit(w, pvwant);
    var availw = w;
    if (pvon == 1) { availw = w - CRAB_PV_W; }
    var twopanes = crab_two_panes_fit(availw);
    var panew = availw - CRAB_PANE_GAP;
    if (twopanes == 1) { panew = (availw - CRAB_PANE_GAP) / 2; }
    # ⚠ HOISTED ABOVE THE PANE BUILD (M5) so the preview column can read the same four arrays the
    # status line does. They describe the ACTIVE pane, which is the one whose selection both surfaces
    # are about — two surfaces answering "what is selected" from different sources is how they drift.
    var abuf = lbuf; var asel = sel_l; var asz = lsizes; var amt = lmtimes; var acnt = ln;
    if (active_pane == 1) { abuf = rbuf; asel = sel_r; asz = rsizes; amt = rmtimes; acnt = rn; }
    var la = 0; if (active_pane == 0) { la = 1; }
    var ra = 0; if (active_pane == 1) { ra = 1; }
    var llst = 0;
    var rlst = 0;
    if (twopanes == 1) {
        llst = crab_pane(panes, 0, panew, lpath, lbuf, ln, lsizes, lmtimes, sel_l, la, lstate, 0, lmarks);
        rlst = crab_pane(panes, 1, panew, rpath, rbuf, rn, rsizes, rmtimes, sel_r, ra, rstate, 0, rmarks);
    } else {
        # ⚠ THE SWITCHER IS THE KEYS crab ALREADY HAS. Left/Right (and h/l) set `active_pane`, which
        # in solo mode changes which pane is drawn rather than which of two is accented. No new
        # binding, and the gesture is the one an operator already knows from the two-pane view.
        if (active_pane == 0) {
            llst = crab_pane(panes, 0, panew, lpath, lbuf, ln, lsizes, lmtimes, sel_l, 1, lstate, 1, lmarks);
        } else {
            rlst = crab_pane(panes, 1, panew, rpath, rbuf, rn, rsizes, rmtimes, sel_r, 1, rstate, 1, rmarks);
        }
    }
    # ⭐ THE PREVIEW IS THE LAST CHILD OF `panes`, so it sits to the RIGHT of whichever panes were
    # built — including in solo mode, where the one pane and the preview split the window between
    # them. ⚠ It is a sibling of the panes rather than a child of one: it describes the ACTIVE
    # pane's selection and the active pane changes, so parenting it to a pane would make it move.
    if (pvon == 1) { crab_preview(panes, h - 24 - trayh, abuf, asel, asz, amt, acnt, pvw, pvh); }
    dh_widget_add_child(root, panes);
    # ⭐ THE TRAY, built between the panes and the status line so it reads as belonging to neither.
    if (trayh > 0) { crab_tray(root, w, opname, opdone, optotal, oprate, opeta); }
    var status = dh_widget_new(LABEL);
    dh_widget_set_bg(status, dh_theme_panel());   # status line
    dh_widget_set_pref(status, 0, 22);
    # ⚠ THE NOTICE OUTRANKS THE ROW. When crab is asking a question ("delete this?") or reporting a
    # refusal, that is the only thing the status line may say — showing the selected file's size
    # underneath a pending confirmation is how the wrong key gets pressed.
    if (crab_notice != 0) { dh_widget_set_text(status, crab_notice); }
    else { dh_widget_set_text(status, crab_status_str(abuf, asel, asz, amt, acnt)); }
    dh_widget_add_child(root, status);

    # ⭐ THE OVERLAY GOES LAST — after the status line and after everything else — because sibling
    # order IS z-order in both the paint and the hit-test. See `crab_overlay`.
    var mcnt = ln; var msel2 = sel_l; var mmk = lmarks; var mbuf = lbuf;
    if (active_pane == 1) { mcnt = rn; msel2 = sel_r; mmk = rmarks; mbuf = rbuf; }
    var misdir = 0;
    var mname = "";
    if (mcnt > 0) {
        misdir = load8(mbuf + msel2 * CRAB_REC_SZ + CRAB_REC_TYPE);
        mname = mbuf + msel2 * CRAB_REC_SZ;
    }
    if ((menuopen != 0) || (editopen != 0)) {
        crab_overlay(root, w, h, menuopen, menux, menuy, menusel, mcnt, misdir,
          crab_mark_count(mmk, mcnt), mname, editopen, editlabel);
    } else { crab_mlst = 0; }

    # ⚠ RECORDED FOR HIT-TESTING, and refreshed here every frame — see the ⛔ on `crab_root`.
    crab_root = root;
    crab_llst = llst;
    crab_rlst = rlst;
    dh_surface_set_root(surf, root);
    dh_layout_apply(root, w, h);

    # ⭐⭐ SCROLL ROUND-TRIPS THROUGH THE APP, and it has to. crab rebuilds the whole widget tree
    # every frame, so a LIST's scroll offset — which lives on the widget — is destroyed and recreated
    # each time. Restoring the previous offset before asking the list to follow the selection is what
    # preserves `dh_list_scroll_to_sel`'s MINIMUM-MOVE rule: with the offset reset to 0 each frame it
    # would still be correct, but every downward step past the viewport would snap the selection to
    # the top edge instead of scrolling by one row.
    # ⚠ THE ORDER IS LOAD-BEARING: `scroll_to_sel` needs the list's laid-out HEIGHT to know what
    # "visible" means, so it must run after the first layout — and the offset it produces moves the
    # rows, so a second layout is required before anything is drawn.
    dh_list_scroll_to(llst, load64(scroll_l));
    dh_list_scroll_to(rlst, load64(scroll_r));
    dh_list_scroll_to_sel(llst);
    dh_list_scroll_to_sel(rlst);
    store64(scroll_l, dh_widget_scroll_y(llst));
    store64(scroll_r, dh_widget_scroll_y(rlst));
    dh_layout_apply(root, w, h);

    return dh_surface_render(surf, font);
}

# Highest selectable index in a pane of `count` entries.
# ⛔ THIS USED TO CLAMP AT `CRAB_ROWS_CAP`, AND THAT WAS NOT A DISPLAY LIMIT — IT WAS A REACHABILITY
# ONE. Down-arrow stopped at row 7, so in a directory of 40 files the other 33 could not be selected,
# entered, or acted on at all. They were not "off screen pending a scrollbar"; they were unreachable.
# With the pane on a scrolling LIST the whole directory is navigable and the cap is gone.
fn crab_maxsel(count): i64 {
    if (count <= 0) { return 0; }
    return count - 1;
}
