[package]
name = "crab"
version = "${file:VERSION}"
description = "crab — sovereign Cyrius-native file manager for AGNOS. Dual-pane GUI on the dhancha/setu desktop stack. PLANNED, NOT SHIPPED: AI semantic find / auto-tag / dedup via daimon's vector store, files-as-memory, sibling to mneme. The hermit crab carries its $HOME and reaches out to grab: a sea-arthropod parity on KDE's Dolphin, wearing Rust's own mascot (Ferris) while replacing the Rust interim (yazi). Roadmap Priority 1 — ship before beta."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
# ⭐ RUN since cyrius 6.6.17: `cyrius test` runs this entry as well as auto-discovering
# `tests/*.tcyr` — measured on 6.6.20, a failing file named here turns it red (rc=1). `tests` is the
# directory the walk already covers, so each `.tcyr` runs once.
test = "tests"
output = "crab"

# ⭐ cyrius 6.6.17's P5-A: a RUN program joins `cyrius coverage`'s corpus. `render_test` is crab's
# RUN program over the laid-out render path (CI runs it), so what it names counts, and its own four
# harness fns stop counting as uncovered source: 344/417 (82 %) → 347/413 (84 %) on 6.6.20, 6.7.9 and
# 6.7.18.
[coverage]
programs = ["src/render_test.cyr"]

[deps]
# ⚠ `chrono` is load-bearing: setu's agnos read path needs it, and `cyrius deps`' own validation
# cannot catch its absence when a sidecar under-reports.
# ⭐ `net` IS GONE (0.10.0). setu dropped TCP at 0.8.4 and crab has pinned past it since 0.4.5, so
# the leaf had been dead for six minor versions while this comment said so and carried it anyway.
# ⚠ RE-MEASURED AT THE CUT RATHER THAN TRUSTED FROM THE NOTE, AND THE NOTE WAS LOOSE. It said
# "measured clean"; the binaries are NOT byte-identical — both grew 16 bytes and 182,246 bytes
# differ, because dropping a leaf from the middle of the list changes the FOLD ORDER and everything
# after it shifts. What IS clean is what matters: no undefined symbol on either target, `cyrius deps`
# resolves, `deny` 0 violations, the suite unchanged at 2451/0.
# ⇒ "Measured clean" and "byte-identical" are different claims and this comment used to blur them.
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "args", "syscalls", "assert", "bench", "hashmap", "fnptr", "tagged", "result", "chrono"]

# ⛔ ORDER MATTERS: sadish (2D vector) THEN rekha (text; references sd_*) THEN dhancha (widgets;
# references both). dhancha's dist references sd_*/rekha_* rather than bundling them, so crab must
# supply them directly.
# ⭐ GIT FIRST SINCE cyrius 6.7.6: a `path = "../sibling"` beside `git` / `tag` is a DEV OVERRIDE,
# read only in local mode (`CYRIUS_LOCAL=1`, `CYRIUS_LOCAL=<dep,dep>` or `--local`). A default build
# builds the TAG and checks its commit pin. Measured on 6.7.9 with four of them live: `hint: 4 deps
# have local checkouts not in use … (this run built the tags)`, and `CYRIUS_LOCAL=1` built the
# siblings into `build/local-deps/` leaving `lib/` and `cyrius.lock` untouched.
# ⛔ They stay COMMENTED in a commit all the same (dhancha's convention). Through 6.7.5 `path` won over
# `tag` — the 2026-09-21 hazard, and at 0.10.5 a tree that had vendored setu 0.8.13 / rupa 0.1.8 /
# kashi 1.2.1 under a manifest declaring older tags — and a consumer reading this manifest on an older
# pin would still meet that rule.

# ⛔ FLOOR: dhancha 0.10.4's `dh_draw_text_ink` calls `sd_flatten_op_begin` / `_end` /
# `sd_flatten_degraded` (per-operation flatten budget, sadish 0.7.x); 0.10.0's floor of >= 0.5.5
# (`sd_alloc_set`, `sd_canvas_blit_at`) stands beneath it.
# ⛔ MOVE sadish AND rekha TOGETHER. rekha's dist is cut against sadish's inline-point `SdPath`;
# two bundles on two sadishes is a link error at best. rekha 1.1.2 names sadish 0.12.1, so the pair
# agrees by tag as well as by code (0.12.0 and 0.12.1 each moved only `sadish_version`'s return).
# ⚠ The bundle is 471,700 B of source (85,815 at 0.5.5). Linked whole it cost +49 % of the binary
# (0.10.2); since 0.10.3 CI and the release build under `CYRIUS_DCE=1` (operator ruling).
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
tag = "0.12.1"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form) — the shared desktop theme-token core. crab reads its tokens through dhancha's
# `dh_theme_*` and names no colour of its own (ADR 0001).
# ⛔ FLOOR >= 0.1.5, HARD: dhancha 0.9.20 binds `dh_theme_on_accent()` to `rupa_theme_on_accent`.
# Against an older pin the toolkit references a function crab's own dep graph does not supply.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# path = "../rupa"
tag = "0.2.1"
modules = ["dist/rupa.cyr"]

# rekha — scalable TrueType outlines. Since 0.9.0 crab draws with it: `crab_face` opens the
# kernel's `/fonts/default.ttf` through `rekha_font_open` and sizes every column by
# `rekha_char_advance_px` / `rekha_units_per_em`; dhancha's fold calls the rest.
# ⛔ FLOOR >= 0.3.6, HARD: dhancha 0.9.27's `dh_text_advance` calls `rekha_char_advance_px`, which
# 0.3.5 does not define. Against an older pin crab fails to link with
# `undefined function 'rekha_char_advance_px'` — measured, not predicted.
# ⛔ It moves with sadish — see the sadish block.
# ⭐ The 1.x line freezes 0.9.0's surface (1.0.0). It has no sidecar (rekha ADR 0010): no stdlib leaf
# reaches crab.
# ⚠ 1.1.2 IS A FULL AUDIT, and it is all of 0.11.1's growth — +12,432 B host / +16,528 B agnos under DCE,
# measured by holding it at 1.1.0. Three out-of-bounds reads fixed, and faces it now refuses. Of crab's
# three direct calls, only `rekha_units_per_em` answers differently — 0 for a `unitsPerEm` outside
# 16..16384 — and crab only prints it on the `crab: font` line. The shipped face's is 2048.
[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
tag = "1.1.2"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system font. dhancha's `dh_draw_text` blits its CP437 8x16 glyphs for
# default (font = 0) text.
# ⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT, and it has a written expiry:
# switch to `modules = ["dist/kashi.cyr"]` the day crab needs runtime font LOADING.
# See docs/adr/0003-kashi-freestanding-core-over-the-library-face.md.
# ⚠ That switch would have FAILED against every kashi through 1.0.8 — `dist/` was gitignored and no
# release attached it, so a `git` + `tag` resolve found no bundle (kashi 1.0.10's own finding).
# 1.0.10 tracks and publishes it; the expiry is executable now.
# ⛔ FLOOR >= 1.1.0, HARD: dhancha 0.10.5's `dh_text_cp437` calls `kashi_cp437_from_unicode`, which
# 1.0.10 does not define. Measured: against 1.0.10 both targets are refused with
# `undefined function 'kashi_cp437_from_unicode'`.
# ⭐ 1.1.1 declares its three glyph buffers in bytes where they reserved u64 slots — 88,576 B of
# zeros out of the image, most of 0.10.5's drop, and the end of the `large static data` advisory.
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# path = "../kashi"
tag = "1.3.0"
modules = ["src/font_data.cyr"]

# dhancha — the widget toolkit: LIST, GRID, PROGRESS, MENU, SHEET, the theme bindings, and the
# per-frame arena crab's render path depends on.
# ⛔ FLOOR >= 0.9.18, HARD: `src/main.cyr` references `POINTER_SCROLL`, which 0.9.17 does not define.
# The host target builds without it and `--agnos` does not — which is why CI builds both.
# ⛔ 0.9.15 IS A CONTRACT: `dh_frame_begin` rewinds the arena AND clears dhancha's retained widget
# pointers. The halves cannot be separated — never call `arena_reset` on a frame arena — and an app
# on a frame arena must re-establish focus every frame, which `crab_pane` does.
# ⛔ 0.9.14 IS A CONTRACT: `dh_surface_render` may return the SAME surface twice. A caller wanting
# two frames at once needs two DhSurfaces; `src/render_test.cyr` is one and guards it.
# ⛔ -6 FROM `dh_client_poll_event` IS FINAL: loop while it is > 0, stop on -6. setu 0.8.11 made a
# dead compositor read as -6 on Linux too (it read as "nothing pending"); `src/main.cyr` stops on it.
# ⚠ The allocation-gate history that used to live here is docs/architecture/001's subject.
[deps.dhancha]
git = "https://github.com/MacCracken/dhancha.git"
# path = "../dhancha"
tag = "0.11.1"
modules = ["dist/dhancha.cyr"]

# setu — the display client transport. On agnos it is the channel band (syscall #97 `chan_op`); it
# reads `AGNOS_CHAN` and does not dial. ⛔ FLOOR: agnos >= 1.56.40.
# ⚠ 0.8.14's sidecar no longer names `net`, so `lib/net.cyr` left crab's tree at 0.10.5; crab never
# declared or called it. 0.8.11 – 0.8.13 changed the present, read and buffer paths crab calls
# (`setu_buf_create` / `_write` / `_close`, `setu_send`, `setu_read_msg`); setu's own consumer audit
# reads crab as compatible, and crab's resize path already created before it closed.
[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# path = "../setu"
tag = "0.9.1"
modules = ["dist/setu.cyr"]

# chitra (चित्र — image) — CPU raster decode (PNG/JPEG/GIF/BMP) for THUMBNAILS only. The preview's
# DIMENSIONS line uses no decoder at all: `crab_img_dims` reads header bytes.
# ⛔⛔ EVERY DECODE IS PERMANENT AND THAT — NOT THE BINARY SIZE — IS THE LIVE CONSTRAINT. chitra makes
# 30 `alloc()` call sites (1.3.1), `chitra_image_free` is a no-op, and cyrius's `alloc` has no `free()`.
# The two budgets that bound it are `CRAB_THUMB_MAX_RGBA` and `CRAB_THUMB_TOTAL_MAX` in `src/app.cyr`,
# and they are the first thing to delete the day the allocator gains a `free()`.
# ⭐ 1.3.1 unfilters a non-interlaced PNG in place, so a decode spends ~2.2x its RGBA where 1.1.3 spent
# ~2.9x (measured; the table is in `src/app.cyr`). 1.3.0 also decodes a PNG past 16 MiB of scanlines,
# which 1.2.x refused as `CHITRA_ERR_INFLATE_LIMIT`. crab's 4 MB budget never got near that size.
# ⚠ Adopting it cost +115 % of the binary, ~399 KB of which is the transitive `sankoch` inflate leaf
# PNG requires. Operator ruling 2026-08-31, taken with the measurements in hand.
# ⭐ SINCE 1.1.0 SANKOCH ARRIVES AS chitra's OWN `[deps.sankoch]` — tag 2.8.9 at 1.3.1, the `zlib` profile
# (`dist/sankoch-zlib.cyr`: inflate, deflate, CRC-32, Adler-32), resolved transitively; the full stdlib
# `sankoch.cyr` and its `thread` / `sync` / `mmap` leaves left `lib/` at 0.11.0. Isolated, that is
# −144,168 B host / −142,120 B agnos — the whole of 0.11.0's drop. ⛔ Do NOT add `sankoch` to
# `[deps] stdlib`: closest-wins, so crab's own leaf would beat the profile and link every codec back.
# ⚠ crab declares none of chitra's stdlib leaves — `dist/chitra.deps` (just `string` at 1.3.1) is
# authoritative.
[deps.chitra]
git = "https://github.com/MacCracken/chitra.git"
tag = "1.3.1"
modules = ["dist/chitra.cyr"]

# daimon (δαίμων) — the AGNOS agent orchestrator, and the intended back end for crab's M7/M8 arc:
# the local index, tags, smart folders (M7) and assisted search (M8). Duplicate detection
# shipped at 0.10.0 without it, which is the rule below working.
#
# ⛔⛔ DECLARED, NOT LINKED, AND THAT IS THE WHOLE SHAPE OF THIS DEPENDENCY. daimon is a BINARY —
# `[build] output = "build/daimon"` — and ships no `dist/`. There is no module for crab to fold in,
# and there must not be: linking an agent orchestrator into a file manager would put its HTTP
# server, its scheduler and its federation code in crab's address space for the sake of a query.
# ⇒ crab TALKS to it, over daimon's HTTP API — daimon 2.3.0's own words: *"crab reaches it over
# HTTP"*. JSON bodies, one request per connection, 64 KB cap, 120 requests/min per source. It binds
# 127.0.0.1:8090, loopback only, on Linux AND, since 2.4.4, on agnos: cyrius 6.6.7 made `sock_bind`
# keep the address, and the listen needs agnos >= 1.57.7 (an older kernel refuses it, closed rather
# than open). daimon's agnos guest client dials 127.0.0.1 too; through 2.4.3 it had to dial the NIC.
# ⛔ THE AF_UNIX SOCKET THIS BLOCK USED TO NAME NO LONGER EXISTS. `agent_ipc_new` → `<dir>/<agent>.sock`
# was REMOVED at daimon 2.3.3 (no caller; its `SO_PEERCRED` check failed open). An agent daimon
# STARTS now gets a channel on fd 3 (`chan_op`#97 on agnos) — that is for daimon's children, not crab.
# ⭐ `modules = []` IS cyrius 6.6.13's SPELLING FOR "DECLARED, NOT LINKED": the tag is cloned and its
# commit pinned in `cyrius.lock`, nothing is vendored, nothing warns. (With NO `modules` key, 6.6.13+
# probes the tag for `dist/daimon.cyr`, finds none, and warns on every build.)
# ⭐ SO THE TOOLCHAIN VERIFIES THIS TAG NOW. Measured on 6.6.20: `tag = "9.9.9"` fails `cyrius deps`
# (rc=1, "Remote branch 9.9.9 not found"). Through 0.10.4 the same phantom passed every gate crab had.
# ⛔ AND crab STILL RUNS WITHOUT IT. The index is an enrichment, not a precondition: a crab on a box
# with no daimon lists, copies, moves and deletes exactly as it does today, and the M7 surfaces
# report that the index is unavailable rather than failing. That is the same rule the preview
# follows for a file it cannot decode — say which kind of nothing this is.
# ✅ IT BUILDS AND RUNS ON AGNOS — re-derived for 2.5.5 on 2026-11-07, not taken from its changelog:
# `cyrius build --agnos` from the tag, 0 errors (4,846,952 B), and every CI job on the 2.5.5 commit
# passed, "AGNOS guest test" among them.
# ⭐⭐ AND SINCE 2.5.4 IT HAS A SURFACE FOR FILES. The build was never the only gate; this one has
# moved. `/v1/files` (daimon ADR-010, `src/api_files.cyr`) answers M7: an index of the files under the
# operator's roots and its state (`none` / `building` / `catching_up` / `paused` / `fresh`), tags and
# ratings per file with counts and suggestions, six smart folders as saved queries, and duplicates by
# a whole-content SHA-256. 2.5.5 answers M8's shape: `GET /v1/files?q=…`, ranked, each result with a
# `why`, the facets and the folders it appears in.
# ⛔ What it is NOT, in daimon's own words (its filing is 🟡, still open at 2.5.5):
#   - it ranks by WORDS, not by meaning — `cost.method` says so, and `receipt` does not find
#     `invoice`. M8's canvas says "vector + name match", and no local embedding model exists;
#   - it is OFF unless the operator runs `serve --index-root DIR`, and reading contents is a second
#     opt-in (`--index-content`), because the API has no caller authentication until 2.6.x;
#   - on agnos it does not pause on battery: the kernel has no power source to read.
# ⛔ And crab has no client for it yet. crab vendors no `net` leaf, so M7's first crab-side step is an
# HTTP client to 127.0.0.1:8090. The filing:
# daimon/docs/development/issues/2026-09-23-crab-needs-a-file-index-tags-and-ranked-search.md
[deps.daimon]
git = "https://github.com/MacCracken/daimon.git"
# path = "../daimon"
tag = "2.5.5"
modules = []
