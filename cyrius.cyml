[package]
name = "crab"
version = "${file:VERSION}"
description = "crab — sovereign Cyrius-native file manager for AGNOS. Dual-pane GUI on the dhancha/setu desktop stack; AI (semantic find / auto-tag / dedup) via daimon's vector store — files-as-memory, sibling to mneme. The hermit crab carries its $HOME and reaches out to grab: a sea-arthropod parity on KDE's Dolphin, wearing Rust's own mascot (Ferris) while replacing the Rust interim (yazi). Roadmap Priority 1 — ship before beta."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.27"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "crab"

[deps]
# The desktop stack (modeled on puka's setu client, minus mabda — on agnos the
# present goes over setu's shared buffer, not a GPU ioctl blit). daimon's vector
# store lands with the AI arc (semantic find / auto-tag / dedup).
# net = setu's TCP client transport; result = net's return type.
# ⛔ That TCP transport is RETIRED (2026-08-03) as the WRONG PRIMITIVE for local display IPC — not
# because it failed: post-`net_src_for` (agnos 1.56.34) crab connected and presented un-rigged
# (QEMU `-smp 1`, 2026-08-02). Replacement: the agnos socket (`anu`) — agnos
# `docs/development/planning/ipc.md` §9/§10. `net` stays until setu moves off TCP.
# ⛔ `chrono` added 2026-08-07 — setu's agnos read path needs it, and crab was missing it while
# building clean: `dist/setu.deps` under-reported 8 of setu's 12 leaves, which switched OFF
# `cyrius deps`' own validation. setu 0.8.2 corrects its sidecar, so the check fires again and this
# gap became a hard error. See setu docs/development/issues/2026-08-07-distlib-deps-sidecar-under-reports.md
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "args", "syscalls", "assert", "bench", "hashmap", "fnptr", "tagged", "result", "net", "chrono"]

# sadish (2D vector) THEN rekha (text; references sd_*) THEN dhancha (widgets;
# references both). setu is the client transport. dhancha's dist references
# sd_*/rekha_* rather than bundling them, so crab deps them directly.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
tag = "0.5.2"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form / appearance) — the shared desktop theme-token core. crab colours
# its panes/rows/status with the active MUDRA / SHANTA theme via dhancha's dh_theme_*,
# which reference rupa's tokens — so crab supplies rupa too. path=../rupa until tagged.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# ⚠ `path` so a local rupa change can be built against before it is pushed — without it a burn
# tests last week's tokens. Every other dep in this stack already carries both.
path = "../rupa"
# ⛔ >= 0.1.3 IS A HARD REQUIREMENT, NOT A FRESHNESS PREFERENCE. dhancha 0.9.6 added per-widget
# motion, so `dist/dhancha.cyr` now references `RupaMotion` / `RupaEase` / `rupa_motion_duration` —
# all of which arrived in rupa 0.1.3 (`src/motion.cyr`). Against the old 0.1.2 pin crab does not
# build at all: `undefined variable 'RupaMotion'`, from a file crab does not own.
tag = "0.1.4"
modules = ["dist/rupa.cyr"]

[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
tag = "0.3.5"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system font. dhancha's dh_draw_text blits its CP437 8x16
# glyphs for default (font=0) text, so crab provides the glyph data.
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# ⚠ `path` — kashi is VENDORED (lib/kashi_font_data.cyr); every other dep in this stack carries both.
path = "../kashi"
tag = "1.0.6"
# ⛔⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT (recorded 2026-08-17, kashi 1.0.6).
# kashi's ADR 0001 says stdlib-linked consumers should take the LIBRARY FACE, and this project links
# the full stdlib — so `src/font_data.cyr` looks like the wrong surface. Two reasons it is not:
#   1. Until kashi 1.0.6 the library face was UNCONSUMABLE. `src/lib.cyr` opens with
#      `include "src/font_data.cyr"`, a kashi-root-relative path that cannot resolve once vendored
#      into this repo's `lib/` — `error: cannot open include file: src/font_data.cyr`. kashi 1.0.6
#      adds `dist/kashi.cyr`, which fixes that, so the choice is now real.
#   2. It is still the core. MEASURED on dhancha: core 364,640 B vs full face 548,000 B —
#      **+183,360 (+50%)** for PSF/BDF/PCF import and a runtime font registry nothing here calls, and
#      `CYRIUS_DCE=1` reclaims NONE of it. This project uses `kashi_font_init` + `kashi_glyph_row`.
# ⇒ Switch to `modules = ["dist/kashi.cyr"]` only when this project needs runtime font LOADING.
modules = ["src/font_data.cyr"]

[deps.dhancha]
git = "https://github.com/MacCracken/dhancha.git"
# ⚠ `path` added 2026-08-16, matching every other dep in this stack: without it crab could only build
# against a PUBLISHED tag, so a local dhancha fix could not be exercised until it was pushed — which is
# how a burn ends up testing last week's library. ⛔ `path` WINS over `tag`, so a green build here is not
# evidence the declared graph resolves; re-verify the tag against dhancha's VERSION at every cut.
path = "../dhancha"
tag    = "0.9.10"
modules = ["dist/dhancha.cyr"]

[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# ⚠ `path` added 2026-08-12 — setu 0.8.5 centralises the rendezvous ($SETU_SOCKET) and a
# tag-only dep could not be built against it locally. Every other dep here carries both.
path = "../setu"
tag = "0.8.7"   # ⭐ channel-band client: no dial, reads AGNOS_CHAN. Floor: agnos >= 1.56.40
modules = ["dist/setu.cyr"]
