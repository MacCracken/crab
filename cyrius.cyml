[package]
name = "crab"
version = "${file:VERSION}"
description = "crab — sovereign Cyrius-native file manager for AGNOS. Dual-pane GUI on the dhancha/setu desktop stack; AI (semantic find / auto-tag / dedup) via daimon's vector store — files-as-memory, sibling to mneme. The hermit crab carries its $HOME and reaches out to grab: a sea-arthropod parity on KDE's Dolphin, wearing Rust's own mascot (Ferris) while replacing the Rust interim (yazi). Roadmap Priority 1 — ship before beta."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.36"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "crab"

[deps]
# The desktop stack (modeled on puka's setu client, minus mabda — on agnos the
# present goes over setu's shared buffer, not a GPU ioctl blit). daimon's vector
# store lands with the AI arc (semantic find / auto-tag / dedup).
# net = setu's TCP client transport; result = net's return type.
# ⛔ That TCP transport is RETIRED (2026-08-03) as the WRONG PRIMITIVE for local display IPC — not
# because it failed: post-`net_src_for` (agnos 1.56.34) crab connected and presented un-rigged
# (QEMU `-smp 1`, 2026-08-02). Replacement: the agnos **channel band** — syscall `#97 chan_op`,
# `VFS_CHAN = 11`, kernel prefix `chan_*` (agnos `docs/development/planning/ipc.md` §9/§10).
# ⛔ This comment said `anu` until 2026-08-26. THE CODENAME IS RETIRED — operator ruling 2026-08-05,
# "a name is a distribution fact", and a band that only ever appears as a prefix inside one kernel has
# no repo boundary to cross. Say `chan_*`; `anu` resolves to nothing in the kernel.
# ⛔ And "`net` stays until setu moves off TCP" was FALSE from 2026-08-07: setu 0.8.4 removed TCP
# (Linux is AF_UNIX/SOCK_SEQPACKET, agnos is the channel band), and crab has pinned past it since
# 0.4.5. The declaration is now REDUNDANT rather than load-bearing — MEASURED 2026-08-26: with `net`
# deleted from this list AND `lib/net.cyr` removed, `cyrius deps` re-creates the leaf (30,092 B) from
# setu's `dist/setu.deps` sidecar and `cyrius build` is OK at the same 377,288 B. ⇒ Dropping it is a
# real cleanup, not a risk — but it is a SEPARATE change and is not bundled into the 0.4.15 bump.
# ⛔ `chrono` added 2026-08-07 — setu's agnos read path needs it, and crab was missing it while
# building clean: `dist/setu.deps` under-reported 8 of setu's 12 leaves, which switched OFF
# `cyrius deps`' own validation. setu 0.8.2 corrects its sidecar, so the check fires again and this
# gap became a hard error. See setu docs/development/issues/2026-08-07-distlib-deps-sidecar-under-reports.md
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "args", "syscalls", "assert", "bench", "hashmap", "fnptr", "tagged", "result", "net", "chrono"]

# sadish (2D vector) THEN rekha (text; references sd_*) THEN dhancha (widgets;
# references both). setu is the client transport. dhancha's dist references
# sd_*/rekha_* rather than bundling them, so crab deps them directly.
[deps.sadish]
git = "https://github.com/MacCracken/sadish.git"
tag = "0.5.2"
modules = ["dist/sadish.cyr"]

# rupa (रूप — form / appearance) — the shared desktop theme-token core. crab colours
# its panes/rows/status with the active MUDRA / SHANTA theme via dhancha's dh_theme_*,
# which reference rupa's tokens — so crab supplies rupa too.
# ⚠ This line read "path=../rupa until tagged" until 2026-08-26. rupa HAS been tagged since 0.1.3;
# the `tag` ten lines below is real and published. The `path` is kept for local iteration, not for
# want of a tag.
[deps.rupa]
git = "https://github.com/MacCracken/rupa.git"
# ⚠ `path` so a local rupa change can be built against before it is pushed — without it a burn
# tests last week's tokens.
# ⛔ This said "every other dep in this stack already carries both" — FALSE. **Four of six** carry
# `path`: rupa, kashi, dhancha, setu. **sadish and rekha are tag-only** and always have been.
path = "../rupa"
# ⛔ >= 0.1.3 IS A HARD REQUIREMENT, NOT A FRESHNESS PREFERENCE. dhancha 0.9.6 added per-widget
# motion, so `dist/dhancha.cyr` now references `RupaMotion` / `RupaEase` / `rupa_motion_duration` —
# all of which arrived in rupa 0.1.3 (`src/motion.cyr`). Against the old 0.1.2 pin crab does not
# build at all: `undefined variable 'RupaMotion'`, from a file crab does not own.
# ⛔ >= 0.1.5 IS THE SAME KIND OF HARD REQUIREMENT. dhancha 0.9.20 binds `dh_theme_on_accent()` to
# `rupa_theme_on_accent`, which arrived in rupa 0.1.5. crab pulls rupa's dist directly, so against an
# older pin the toolkit references a function crab's own dep graph does not supply.
tag = "0.1.5"
modules = ["dist/rupa.cyr"]

[deps.rekha]
git = "https://github.com/MacCracken/rekha.git"
tag = "0.3.5"
modules = ["dist/rekha.cyr"]

# kashi (काशि) — the AGNOS system font. dhancha's dh_draw_text blits its CP437 8x16
# glyphs for default (font=0) text, so crab provides the glyph data.
[deps.kashi]
git = "https://github.com/MacCracken/kashi.git"
# ⚠ `path` — kashi is VENDORED (lib/kashi_font_data.cyr). ⛔ The old tail "every other dep in this
# stack carries both" was FALSE: sadish and rekha are tag-only. Four of six carry `path`.
path = "../kashi"
tag = "1.0.6"
# ⛔⛔ THE FREESTANDING CORE IS A MEASURED CHOICE, NOT A SHORTCUT (recorded 2026-08-17, kashi 1.0.6).
# kashi's ADR 0001 says stdlib-linked consumers should take the LIBRARY FACE, and this project links
# the full stdlib — so `src/font_data.cyr` looks like the wrong surface. Two reasons it is not:
#   1. Until kashi 1.0.6 the library face was UNCONSUMABLE. `src/lib.cyr` opens with
#      `include "src/font_data.cyr"`, a kashi-root-relative path that cannot resolve once vendored
#      into this repo's `lib/` — `error: cannot open include file: src/font_data.cyr`. kashi 1.0.6
#      adds `dist/kashi.cyr`, which fixes that, so the choice is now real.
#   2. It is still the core. MEASURED on dhancha: core 364,640 B vs full face 548,000 B —
#      **+183,360 (+50%)** for PSF/BDF/PCF import and a runtime font registry nothing here calls, and
#      `CYRIUS_DCE=1` reclaims NONE of it. This project uses `kashi_font_init` + `kashi_glyph_row`.
# ⇒ Switch to `modules = ["dist/kashi.cyr"]` only when this project needs runtime font LOADING.
modules = ["src/font_data.cyr"]

[deps.dhancha]
git = "https://github.com/MacCracken/dhancha.git"
# ⚠ `path` added 2026-08-16 (⛔ not "matching every other dep" — sadish and rekha are tag-only, so
# this is four of six): without it crab could only build
# against a PUBLISHED tag, so a local dhancha fix could not be exercised until it was pushed — which is
# how a burn ends up testing last week's library. ⛔ `path` WINS over `tag`, so a green build here is not
# evidence the declared graph resolves; re-verify the tag against dhancha's VERSION at every cut.
path = "../dhancha"
# ⭐ THE PER-FRAME ALLOCATION GATE — CLOSED, in three steps, each measured against `crab_render` at
# 380x220 with 114 entries per pane, and re-confirmed at the 256 CRAB_MAX_ENTRIES ceiling
# (docs/architecture/001):
#   0.9.13 — step 1: `dh_surface_new` no longer allocates a `w*h*4` pixel buffer that nothing in the
#            stack ever wrote or read.                              746,440 -> 412,040 B per frame
#   0.9.14 — step 2: the sadish render target is cached on the DhSurface and reused.
#                                                                   412,040 ->  77,568 B per frame
# ⚠ Step 2 only pays off because crab ALSO stopped minting a DhSurface per frame (`src/ui.cyr`,
# `src/main.cyr`). The dhancha half alone saves crab nothing — a cache on an object thrown away each
# frame is not a cache.
# ⛔ 0.9.14 IS A CONTRACT CHANGE: `dh_surface_render` may return the SAME surface twice. A caller that
# wants two frames at once needs two DhSurfaces — `src/render_test.cyr` is one, and guards it.
#   0.9.15 — step 3: a per-frame ARENA for the widget tree and layout scratch, rewound by
#            `dh_frame_begin`.                                       77,568 ->       0 B per frame
# ⭐ 0.9.16 — the OTHER half of the loop: `dh_setu_poll_event` no longer allocates an 80 B message
#            before it knows whether anything is pending.                 80 ->       0 B per poll
#            ⇒ crab's render/input loop now allocates NOTHING in steady state, which is what makes a
#            self-repainting element affordable. (M2 deferral #09.)
# ⛔ 0.9.15 IS ALSO A CONTRACT ADDITION: `dh_frame_begin` rewinds the arena **and** clears dhancha's
# retained widget pointers (`_dh_focus` and friends). The two halves cannot be separated — never call
# `arena_reset` on a frame arena directly — and an app on a frame arena must re-establish focus every
# frame, which `crab_pane` does.
# ⭐ 0.9.17 — `dh_surface_resize`: the entry point `WINDOW_CONFIGURE` had waited five releases for.
#            Also closes a latent overflow 0.9.13 created (a cached `w*h*4` pixel buffer, safe only
#            while `w`/`h` were immutable) and makes 0.9.14's dormant dimension check live.
# ⭐ 0.9.18 — `POINTER_SCROLL` (kind 14): the mouse wheel reaches apps. Mapped from setu 0.8.8's
#            `SETU_INPUT_PTR_SCROLL`. Also adds `path = "../setu"` to dhancha's own manifest.
# ⛔ THE DECLARED GRAPH MUST CARRY 0.9.18 OR THE REAL TARGET DOES NOT BUILD, AND CI CANNOT SEE IT.
# `src/main.cyr` references `POINTER_SCROLL`, which 0.9.17 does not define. MEASURED 2026-08-27 with
# `path` disabled and a fresh resolve against dhancha 0.9.17:
#     host  build -> **PASS**   ·   agnos build -> **FAIL**: undefined variable 'POINTER_SCROLL'
# crab's event loop is inside `#ifdef CYRIUS_TARGET_AGNOS` and CI builds only the host target
# (roadmap *deferral #15*), so that state goes GREEN through CI while being unable to build what
# ships. #15 is the gate that would have caught it.
# ⛔ VERIFIED FOUR WAYS before this line moved, because `path` wins and a green local build proves
# nothing about the declared graph: sibling `VERSION` = 0.9.17; `git rev-parse 0.9.17` == HEAD in
# `../dhancha` (b297604); `git ls-remote --tags` shows `refs/tags/0.9.17` at that same commit; and —
# the only check that would have caught 0.4.13's manifest naming a library the build never compiled —
# `path` DISABLED so `cyrius deps` actually clones the tag, then comparing SHA-256. The first three
# would each have passed 0.4.13. Re-do all four at every cut. (Automating it: deferral #19.)
# ⚠⚠ AND `lib/dhancha.cyr` IS NOT WHAT COMPILES WHILE `path` IS SET — MEASURED 2026-08-27 by
# appending garbage to it and watching the build succeed, then appending garbage to
# `../dhancha/dist/dhancha.cyr` and watching it fail. The `path` override compiles the SIBLING'S
# `dist/` directly; crab's vendored `lib/dhancha.cyr` is a committed RECORD that `cyrius deps`
# refreshes and `cyrius.lock` hashes, not the artifact. ⇒ A local green says even less than
# "`path` wins" already implied, which is why check four resolves the tag rather than trusting it.
tag    = "0.9.20"
modules = ["dist/dhancha.cyr"]

[deps.setu]
git = "https://github.com/MacCracken/setu.git"
# ⚠ `path` added 2026-08-12 — setu 0.8.5 centralises the rendezvous ($SETU_SOCKET) and a
# tag-only dep could not be built against it locally. ⛔ "Every other dep here carries both" was
# FALSE — sadish and rekha are tag-only.
path = "../setu"
tag = "0.8.8"   # ⭐ channel-band client: no dial, reads AGNOS_CHAN. Floor: agnos >= 1.56.40.
                # 0.8.8 adds `SETU_INPUT_PTR_SCROLL` (kind 12) — the mouse wheel.
modules = ["dist/setu.cyr"]
