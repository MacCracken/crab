# crab fuzz harness — the header parsers, driven with real bytes.
#
# ⛔⛔ THIS FILE WAS A SCAFFOLD THAT READ NONE OF ITS INPUT UNTIL 2026-08-31, AND THAT IS WHY IT IS
# WORTH SAYING SO HERE. `fuzz_main(data, len)` returned 0 without touching a byte of `data`, so
# `cyrius fuzz` reported **PASS against any input whatsoever** — a green gate that could not go red.
# It stood while crab grew a readdir parser, a write layer that deletes trees, and a header parser
# for image files. Roadmap *deferral #12*.
#
# ⭐ AND IT EARNED ITS KEEP IMMEDIATELY. `crab_img_dims` — written the same day — shipped a draft in
# which the JPEG marker walk dereferenced its cursor as an ABSOLUTE ADDRESS rather than an offset
# into the buffer (`load8(p)` for `load8(buf + p)`). Every bounds check in it was correct, because
# the cursor really was compared against the length; only the base was missing. That class of bug is
# invisible to a bounds review and instant to a fuzzer.
#
# ⛔ DETERMINISTIC ON PURPOSE — a fixed seed and an LCG, never a clock or `/dev/urandom`. A fuzz
# failure nobody can reproduce is a rumour, and a harness whose corpus changes per run reports a
# different pass rate every time it is asked. Change `FZ_SEED` to explore; do not make it a variable.

include "src/app.cyr"

enum CrabFuzz {
    FZ_SEED     = 0x5EED1234;
    # ⚠ A modulus that keeps `s * 1103515245` inside i64: 2^31 * 1103515245 ~ 2.4e18, well under the
    # 9.2e18 ceiling. An LCG that silently overflows is a constant generator.
    FZ_MOD      = 2147483648;
    FZ_BUFSZ    = 512;
    FZ_ROUNDS   = 20000;
    # ⚠ The EXIF fixture is ~134 bytes; the rest of this arena is poison, so a value-offset read that
    # strays even slightly past the declared length lands in it. Bigger is a better detector — a
    # wild u32 offset can outrun any arena, but the near misses are the ones a fuzzer will find.
    FZ_EXIF_ARENA = 65536;
    FZ_POISON   = 126;
}

var fz_state = 0;
var fz_fails = 0;
var fz_recognised = 0;
var fz_exif_ok = 0;
var fz_batch_ok = 0;
# ⛔⛔ THE HARNESS MUST COUNT ITS OWN ROUNDS, AND THE REASON IS `render_test`'s. This file printed
# `fuzz: ok` and NOTHING ELSE, so six documents claimed **60,000 rounds** while it drove 100,000 —
# two loops (EXIF, batch-rename) were added mid-cut and no output could contradict the old number.
# A harness whose own report cannot disagree with a stale claim about it is a harness nobody can
# check. ⚠ COUNTED, NOT COMPUTED: `5 * FZ_ROUNDS` would be the same unverifiable claim in code.
# (*Deferral #41*.)
var fz_rounds: i64 = 0;

fn fz_next(): i64 {
    fz_state = (fz_state * 1103515245 + 12345) - ((fz_state * 1103515245 + 12345) / FZ_MOD) * FZ_MOD;
    return fz_state;
}

# ⛔⛔ THE HIGH BITS, NEVER THE LOW ONES — AND THE FIRST DRAFT OF THIS HARNESS GOT IT WRONG IN
# EXACTLY THE TEXTBOOK WAY. An LCG modulo a power of two has period 2^k in its low k bits: `v % 4`
# cycles with period **four**. Combined with the stride between draws in the round-1 loop, the
# format selector `fz_upto(4)` returned **only 1 and 2 across all 20,000 rounds** — so PNG and JPEG
# were NEVER SEEDED, `crab_jpeg_dims` was entered **zero** times, and the harness printed "fuzz: ok"
# having tested half the formats and none of the code it was written for. It was caught by planting
# the known JPEG bug and watching the fuzzer pass.
# ⇒ Dividing first discards the degenerate low bits and samples the high ones, which carry the LCG's
# full period. ⚠ This is the "three tests could not fail in their first draft" lesson (0.6.0) in a
# new costume: **a fuzzer must be shown to catch a bug you plant on purpose**, or its green is a
# statement about its own corpus and nothing else.
fn fz_byte(): i64 { var v = fz_next() / 8192; return v - (v / 256) * 256; }
fn fz_upto(n): i64 { if (n <= 0) { return 0; } var v = fz_next() / 8192; return v - (v / n) * n; }

# ⚠ EVERY ROUND LOOP ADVANCES THROUGH HERE rather than with a bare `round + 1`, so a sixth round
# added later is counted by using the same idiom as the five beside it — and one that is not is
# visibly unlike its neighbours at the point it is written.
fn fz_round(round): i64 {
    fz_rounds = fz_rounds + 1;
    return round + 1;
}

fn fz_fail(msg): i64 {
    fz_fails = fz_fails + 1;
    println(msg);
    return 0;
}

# Seed the buffer with a structurally valid header for one of the four formats, so that mutation
# starts from something the parser will actually walk into rather than reject at byte 0.
# ⛔ A FUZZER WHOSE INPUTS ARE ALL REJECTED AT THE SIGNATURE TESTS NOTHING BUT THE SIGNATURE. Random
# bytes are a PNG about one time in 2^32; the interesting code is everything past the magic.
fn fz_seed_header(buf, which): i64 {
    var i = 0;
    while (i < FZ_BUFSZ) { store8(buf + i, 0); i = i + 1; }
    if (which == 0) {                                   # PNG
        store8(buf, 137); store8(buf + 1, 80); store8(buf + 2, 78); store8(buf + 3, 71);
        store8(buf + 4, 13); store8(buf + 5, 10); store8(buf + 6, 26); store8(buf + 7, 10);
        store8(buf + 12, 73); store8(buf + 13, 72); store8(buf + 14, 68); store8(buf + 15, 82);
        store8(buf + 18, 2); store8(buf + 22, 1);
        return 0;
    }
    if (which == 1) {                                   # GIF89a
        store8(buf, 71); store8(buf + 1, 73); store8(buf + 2, 70);
        store8(buf + 3, 56); store8(buf + 4, 57); store8(buf + 5, 97);
        store8(buf + 6, 64); store8(buf + 8, 200);
        return 0;
    }
    if (which == 2) {                                   # BMP
        store8(buf, 66); store8(buf + 1, 77);
        store8(buf + 14, 40); store8(buf + 18, 4); store8(buf + 22, 2);
        return 0;
    }
    # JPEG — SOI, an APP0 segment, then an SOF0 the walk has to reach.
    store8(buf, 255); store8(buf + 1, 216);
    store8(buf + 2, 255); store8(buf + 3, 224);
    store8(buf + 4, 0); store8(buf + 5, 16);
    store8(buf + 20, 255); store8(buf + 21, 192);
    store8(buf + 22, 0); store8(buf + 23, 17); store8(buf + 24, 8);
    store8(buf + 25, 4); store8(buf + 27, 6);
    return 0;
}

# ⛔ A VALUE CARRYING THE POISON BYTE CAME FROM PAST THE DECLARED LENGTH. That is the whole
# detector: the parser is told the file is `elen` bytes, everything after it is `~`, and a correct
# parser can never return one.
fn fz_check_poison(dst, what): i64 {
    var i = 0;
    while (i < 64) {
        var c = load8(dst + i);
        if (c == 0) { return 0; }
        if (c == FZ_POISON) {
            fz_fails = fz_fails + 1;
            println("FAIL: an EXIF value contains the poison byte -- read past the declared length");
            println(what);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# A real little-endian Exif JPEG: Make/Model in IFD0, DateTimeOriginal in the Exif sub-IFD.
# ⚠ Byte-identical to `t_exif_le` in `tests/crab.tcyr` — the fuzz harness and the suite are separate
# programs and cannot share a helper, so the bytes are duplicated deliberately. ⛔ If one changes,
# change both: a fuzzer seeded from a file the suite no longer considers valid is a fuzzer exploring
# a shape nothing else tests.
fn fz_seed_exif(b): i64 {
    store8(b + 0, 255); store8(b + 1, 216); store8(b + 2, 255); store8(b + 3, 225); store8(b + 4, 0); store8(b + 5, 103); store8(b + 6, 69); store8(b + 7, 120); store8(b + 8, 105); store8(b + 9, 102); store8(b + 10, 0); store8(b + 11, 0);
    store8(b + 12, 73); store8(b + 13, 73); store8(b + 14, 42); store8(b + 15, 0); store8(b + 16, 8); store8(b + 17, 0); store8(b + 18, 0); store8(b + 19, 0); store8(b + 20, 3); store8(b + 21, 0); store8(b + 22, 15); store8(b + 23, 1);
    store8(b + 24, 2); store8(b + 25, 0); store8(b + 26, 3); store8(b + 27, 0); store8(b + 28, 0); store8(b + 29, 0); store8(b + 30, 72); store8(b + 31, 80); store8(b + 32, 0); store8(b + 33, 0); store8(b + 34, 16); store8(b + 35, 1);
    store8(b + 36, 2); store8(b + 37, 0); store8(b + 38, 7); store8(b + 39, 0); store8(b + 40, 0); store8(b + 41, 0); store8(b + 42, 68); store8(b + 43, 0); store8(b + 44, 0); store8(b + 45, 0); store8(b + 46, 105); store8(b + 47, 135);
    store8(b + 48, 4); store8(b + 49, 0); store8(b + 50, 1); store8(b + 51, 0); store8(b + 52, 0); store8(b + 53, 0); store8(b + 54, 50); store8(b + 55, 0); store8(b + 56, 0); store8(b + 57, 0); store8(b + 58, 0); store8(b + 59, 0);
    store8(b + 60, 0); store8(b + 61, 0); store8(b + 62, 1); store8(b + 63, 0); store8(b + 64, 3); store8(b + 65, 144); store8(b + 66, 2); store8(b + 67, 0); store8(b + 68, 20); store8(b + 69, 0); store8(b + 70, 0); store8(b + 71, 0);
    store8(b + 72, 75); store8(b + 73, 0); store8(b + 74, 0); store8(b + 75, 0); store8(b + 76, 0); store8(b + 77, 0); store8(b + 78, 0); store8(b + 79, 0); store8(b + 80, 69); store8(b + 81, 79); store8(b + 82, 83); store8(b + 83, 32);
    store8(b + 84, 82); store8(b + 85, 53); store8(b + 86, 0); store8(b + 87, 50); store8(b + 88, 48); store8(b + 89, 50); store8(b + 90, 54); store8(b + 91, 58); store8(b + 92, 48); store8(b + 93, 55); store8(b + 94, 58); store8(b + 95, 48);
    store8(b + 96, 52); store8(b + 97, 32); store8(b + 98, 49); store8(b + 99, 56); store8(b + 100, 58); store8(b + 101, 50); store8(b + 102, 50); store8(b + 103, 58); store8(b + 104, 51); store8(b + 105, 49); store8(b + 106, 0); store8(b + 107, 255);
    store8(b + 108, 192); store8(b + 109, 0); store8(b + 110, 17); store8(b + 111, 8); store8(b + 112, 0); store8(b + 113, 4); store8(b + 114, 0); store8(b + 115, 8); store8(b + 116, 3); store8(b + 117, 1); store8(b + 118, 17); store8(b + 119, 0);
    store8(b + 120, 2); store8(b + 121, 17); store8(b + 122, 1); store8(b + 123, 3); store8(b + 124, 17); store8(b + 125, 1); store8(b + 126, 255); store8(b + 127, 217);
    return 128;
}

# ⛔ THE INVARIANT, AND IT IS THE WHOLE POINT: a parser over untrusted bytes may answer "no" as often
# as it likes, but when it answers "yes" the answer must be inside the bounds it promises. A fuzzer
# that only checks for crashes misses a header that reports a four-billion-pixel width.
fn fz_check_dims(r, out): i64 {
    if (r == 0) { return 0; }
    if (r != 1) { return fz_fail("FAIL: crab_img_dims returned something other than 0 or 1"); }
    fz_recognised = fz_recognised + 1;
    var w = load64(out + CRAB_IMG_W);
    var h = load64(out + CRAB_IMG_H);
    if (w <= 0) { return fz_fail("FAIL: accepted a width <= 0"); }
    if (h <= 0) { return fz_fail("FAIL: accepted a height <= 0"); }
    if (w > CRAB_IMG_DIM_MAX) { return fz_fail("FAIL: accepted a width past CRAB_IMG_DIM_MAX"); }
    if (h > CRAB_IMG_DIM_MAX) { return fz_fail("FAIL: accepted a height past CRAB_IMG_DIM_MAX"); }
    return 0;
}

fn fuzz_main(data, len) {
    if (len == 0) { return 0; }
    var out = alloc(CRAB_IMG_SZ);
    # ⚠ THE DECLARED LENGTH IS FUZZED SEPARATELY FROM THE CONTENT, and that is deliberate: a caller
    # that hands over a length longer than the buffer is the exact mistake bounds checks exist to
    # survive, and `crab_preview_hdr` derives its length from a `read()` return that a short file
    # makes smaller than the buffer.
    crab_img_dims(data, len, out);
    return 0;
}

fn main() {
    alloc_init();
    fz_state = FZ_SEED;
    var buf = alloc(FZ_BUFSZ);
    var out = alloc(CRAB_IMG_SZ);
    var name = alloc(CRAB_NAME_MAX + 8);

    # ---- round 1: mutate valid headers ------------------------------------------------------
    var round = 0;
    while (round < FZ_ROUNDS) {
        fz_seed_header(buf, fz_upto(4));
        # Between one and eight byte flips, anywhere in the first 64 bytes — the region every one of
        # the four formats keeps its dimensions in.
        var flips = 1 + fz_upto(8);
        var f = 0;
        while (f < flips) { store8(buf + fz_upto(64), fz_byte()); f = f + 1; }
        # ⚠ A LENGTH THAT LIES SHORT is the truncated-file case and must be refused, not read past.
        var len = fz_upto(FZ_BUFSZ + 1);
        fz_check_dims(crab_img_dims(buf, len, out), out);
        round = fz_round(round);
    }

    # ---- round 2: wholly random bytes -------------------------------------------------------
    round = 0;
    while (round < FZ_ROUNDS) {
        var i = 0;
        while (i < 64) { store8(buf + i, fz_byte()); i = i + 1; }
        fz_check_dims(crab_img_dims(buf, fz_upto(65), out), out);
        round = fz_round(round);
    }

    # ---- round 3: degenerate lengths --------------------------------------------------------
    # ⛔ NEGATIVE AND ZERO LENGTHS ARE CALLER BUGS AND MUST BE REFUSED RATHER THAN TREATED AS
    # "plenty of bytes". Every bound in the parser is `< len`, so a negative fails them all — this
    # is what pins that it stays so.
    fz_seed_header(buf, 0);
    fz_check_dims(crab_img_dims(buf, 0, out), out);
    fz_check_dims(crab_img_dims(buf, 0 - 1, out), out);
    fz_check_dims(crab_img_dims(buf, 0 - 999999, out), out);
    if (crab_img_dims(buf, 0 - 1, out) != 0) { fz_fail("FAIL: a negative length was accepted"); }
    if (crab_img_dims(0, 64, out) != 0) { fz_fail("FAIL: a null buffer was accepted"); }
    if (crab_img_dims(buf, 64, 0) != 0) { fz_fail("FAIL: a null output record was accepted"); }

    # ---- round 4: EXIF, the most attacker-controlled parser crab has ------------------------
    # ⛔⛔ EVERY OFFSET IN AN EXIF FILE IS CHOSEN BY THE FILE. `crab_img_dims` reads fields at fixed
    # positions; EXIF is a TIFF directory with a **byte order**, an **entry count** and **value
    # offsets** all supplied by the input. That is three independent ways to make a parser read
    # where the file points instead of where the data is — and `crab_jpeg_dims` already proved that
    # a correct bounds check on an index says nothing about the base it is applied to.
    # ⚠ Seeded from a REAL Exif JPEG so mutation lands past the signature, where the directory walk
    # actually is. Random bytes are an Exif APP1 essentially never.
    # ⛔⛔ A POISON TAIL, BECAUSE AN OUT-OF-BOUNDS READ DOES NOT CRASH HERE. cyrius's allocator is a
    # bump allocator over a large mapped heap, so reading past the end of a fixture lands in
    # ordinary mapped memory and returns garbage rather than faulting. **Four planted bounds bugs —
    # the entry bound, the value-offset bound, and inline values dereferenced as offsets — all
    # survived a first version of this round**, which checked only "returns 0 or 1" and "has a NUL".
    # ⇒ Fill everything past the fixture with a PRINTABLE byte that appears in no fixture, then
    # require that no accepted value contains it. `crab_ex_ifd` filters to printable ASCII, so the
    # poison has to be printable to be copied — a NUL or a control byte would be filtered out and
    # the overread would go unseen. `~` (126) is printable and appears in no fixture.
    var exb = alloc(FZ_EXIF_ARENA);
    var exd = alloc(128);
    round = 0;
    while (round < FZ_ROUNDS) {
        var pi = 0;
        while (pi < FZ_EXIF_ARENA) { store8(exb + pi, FZ_POISON); pi = pi + 1; }
        var exlen = fz_seed_exif(exb);
        var eflips = 1 + fz_upto(12);
        var ef = 0;
        # ⚠ MUTATE ACROSS THE WHOLE FILE, not just a header prefix: the interesting bytes are the
        # IFD entry count, the tag/type/count fields and the value offsets, which sit deep in it.
        # ⛔⛔ THE MUTATOR MUST NOT BE ABLE TO WRITE THE POISON BYTE. It is a uniform 0..255 draw, so
        # it will eventually store `~` INTO the fixture — and a correct parser then returns it,
        # which this round would report as an overread. That false positive fired on unmutated code
        # at round 3723 and cost a real debugging pass. ⇒ The poison value must exist ONLY past the
        # declared length, or it proves nothing about where a byte came from.
        while (ef < eflips) {
            var mb = fz_byte();
            if (mb == FZ_POISON) { mb = 33; }
            store8(exb + fz_upto(exlen), mb);
            ef = ef + 1;
        }
        var elen = fz_upto(exlen + 1);
        # ⛔ THE INVARIANT: whatever the bytes say, the result is 0 or 1, the destination is always a
        # NUL-terminated string inside its capacity, and nothing reads past `elen`.
        var er = crab_exif_str(exb, elen, CRAB_EX_MAKE, exd, 64);
        if (er != 0) { if (er != 1) { fz_fail("FAIL: crab_exif_str returned neither 0 nor 1"); } }
        if (er == 1) {
            fz_exif_ok = fz_exif_ok + 1;
            if (crab_cstr_len(exd, 64) < 0) { fz_fail("FAIL: an accepted EXIF value has no NUL inside its cap"); }
            fz_check_poison(exd, "Make");
        }
        if (crab_exif_str(exb, elen, CRAB_EX_MODEL, exd, 64) == 1) { fz_check_poison(exd, "Model"); }
        if (crab_exif_str(exb, elen, CRAB_EX_DTORIG, exd, 64) == 1) { fz_check_poison(exd, "DateTimeOriginal"); }
        if (crab_exif_str(exb, elen, CRAB_EX_DATETIME, exd, 64) == 1) { fz_check_poison(exd, "DateTime"); }
        # ⚠ And the reshaper, over whatever the parser just produced — including a value the file
        # chose the length and contents of.
        crab_exif_when(exd, exd, 64);
        round = fz_round(round);
    }
    # ⛔⛔ WHAT THE POISON TAIL CATCHES, AND WHAT IT CANNOT — measured by planting six bugs.
    #   CAUGHT here: the value-offset bound widened; inline values dereferenced as offsets; the byte
    #     order inverted. All three put file-chosen bytes into the OUTPUT, which is what poison sees.
    #   CAUGHT by the suite instead: the TIFF magic left unchecked, and the two above as well.
    #   ⛔ NOT CAUGHT BY EITHER — and stated rather than left to be assumed:
    #     • `if (e + 12 > len) { return found; }` in `crab_ex_ifd`. Deleting it reads entry fields
    #       past the buffer — straight into the poison, which then reads as tag 0x7E7E, matches no
    #       tag, and returns nothing. **The overread is real and affects only control flow**, and a
    #       detector that watches the output cannot see a byte that never reaches it. This is the
    #       single most important bound in the parser and it is held by REVIEW, not by a test.
    #     • the `CRAB_EX_MAX_ENTRIES` cap. Removing it is bounded by the line above, so it limits
    #       WORK rather than reach — defence in depth, like `seg < 2` in the segment walker.
    # ⇒ Both are kept. Neither is load-bearing for this harness's green, and saying so is the point.

    # ---- round 5: the batch-rename expander, over arbitrary patterns and records ------------
    # ⛔ THE LAST PARSER OVER NON-AUTHORED BYTES WITH NO FUZZ COVERAGE — finding F3 of the 2026-08-31
    # security audit, which is what put it here. `*` splices in a READDIR NAME and `#` a number, and
    # the result becomes a filename crab CREATES ON DISK. The audit found the splice reading its
    # record with no bound; this is what keeps it bounded.
    # ⚠ HALF THE RECORDS ARE UNTERMINATED, which is the case the bound exists for: the kernel
    # NUL-terminates at <= 62 bytes, and that invariant is the kernel's, not this function's.
    var bp = alloc(CRAB_EDIT_CAP + 8);
    var bo = alloc(CRAB_REC_SZ * 2);
    var bd = alloc(CRAB_EDIT_CAP + 8);
    round = 0;
    while (round < FZ_ROUNDS) {
        var pl2 = fz_upto(CRAB_EDIT_CAP);
        var pi2 = 0;
        while (pi2 < pl2) {
            # ⚠ Bias toward the two metacharacters: a corpus of random bytes contains `*` and `#`
            # about once in 128, so it would spend its whole run testing the literal-copy path.
            var pc = fz_byte();
            var pick = fz_upto(3);
            if (pick == 0) { pc = 42; }
            if (pick == 1) { pc = 35; }
            store8(bp + pi2, pc);
            pi2 = pi2 + 1;
        }
        store8(bp + pl2, 0);
        var ol = fz_upto(CRAB_REC_SZ * 2);
        var oi = 0;
        while (oi < ol) { store8(bo + oi, fz_byte()); oi = oi + 1; }
        if (fz_upto(2) == 0) { store8(bo + ol, 0); }
        else { store8(bo + CRAB_REC_SZ * 2 - 1, 0); }
        var br = crab_batch_name(bd, bp, fz_upto(100000), bo);
        # ⛔ THE INVARIANT: whatever the pattern and whatever the record, the result is a
        # NUL-terminated string inside the cap — because it is about to be passed to `rename`.
        if (br >= 0) {
            if (br > CRAB_EDIT_CAP - 1) { fz_fail("FAIL: crab_batch_name reported a length past its cap"); }
            if (crab_cstr_len(bd, CRAB_EDIT_CAP + 8) < 0) {
                fz_fail("FAIL: an accepted batch name has no NUL inside its cap");
            }
            fz_batch_ok = fz_batch_ok + 1;
        }
        # ⚠ Even a REFUSAL must leave a valid cstring — a caller that ignores -1 gets a bounded
        # string rather than a runaway, the same contract `crab_strcpy_n` keeps.
        if (crab_cstr_len(bd, CRAB_EDIT_CAP + 8) < 0) {
            fz_fail("FAIL: a REFUSED batch name left dst unterminated");
        }
        # ⛔ And whatever comes out still faces the guard between a keypress and `rename`.
        var bok = crab_name_ok(bd);
        if (bok != 0) { if (bok != 1) { fz_fail("FAIL: crab_name_ok returned neither 0 nor 1"); } }
        round = fz_round(round);
    }
    if (fz_batch_ok == 0) {
        fz_fails = fz_fails + 1;
        println("FAIL: the batch corpus never produced a name — the fuzzer tested only refusals");
    }

    # ⛔ NON-VACUITY, and it matters more here than anywhere: an EXIF corpus that never produces a
    # readable tag is a corpus that only ever tested the signature check.
    if (fz_exif_ok == 0) {
        fz_fails = fz_fails + 1;
        println("FAIL: the EXIF corpus never read a single tag — the fuzzer tested only the signature");
    }

    # ---- round 4: the name predicates, over arbitrary bytes ---------------------------------
    # ⛔ `crab_name_ok` GUARDS EVERY WRITE crab MAKES — mkdir, rename, the batch sheet and the
    # recursive copy all pass a name through it, and the batch sheet's `*` splices in a readdir name
    # the operator never typed. It must survive any byte sequence, including one with no NUL inside
    # the buffer at all.
    round = 0;
    while (round < FZ_ROUNDS) {
        var nl = fz_upto(CRAB_NAME_MAX + 4);
        var j = 0;
        while (j < nl) { store8(name + j, fz_byte()); j = j + 1; }
        # ⚠ HALF THE ROUNDS GET NO TERMINATOR, which is the case a bounded scan exists for.
        if (fz_upto(2) == 0) { store8(name + nl, 0); }
        else { store8(name + CRAB_NAME_MAX + 7, 0); }
        var ok = crab_name_ok(name);
        if (ok != 0) { if (ok != 1) { fz_fail("FAIL: crab_name_ok returned neither 0 nor 1"); } }
        var im = crab_is_image(name);
        if (im != 0) { if (im != 1) { fz_fail("FAIL: crab_is_image returned neither 0 nor 1"); } }
        crab_cstr_len(name, CRAB_NAME_MAX);
        round = fz_round(round);
    }

    # ⛔ NON-VACUITY. A harness that rejected every input would report zero failures and prove
    # nothing — which is exactly the state this file was in before today. The corpus MUST reach the
    # accepting paths, so the run fails if it never recognised a single header.
    if (fz_recognised == 0) {
        fz_fails = fz_fails + 1;
        println("FAIL: the corpus never produced a single valid header — the fuzzer tested nothing");
    }

    # ⭐ SAY HOW MUCH WORK WAS DONE, PASS OR FAIL. A green line with no magnitude is what let the
    # docs drift by 40,000 rounds unchallenged.
    syscall(1, 1, "fuzz: rounds ", 13);
    println_int(fz_rounds);
    if (fz_fails == 0) { println("fuzz: ok"); return 0; }
    println("fuzz: FAILED");
    return 1;
}

var r = main();
syscall(60, r);
