# tests/crab.tcyr — crab test suite, HOST.
#
# ⭐⭐ WHAT THIS EXISTS TO GATE: `AE-6`, the agnos `gpu_shader_op #92` op 0x01 premultiplied blend.
# crab is the arc's first client to request `SETU_SURF_PREMULTIPLIED` — UNCONDITIONALLY: `crab_surface_flags`
# (src/main.cyr) is a bare `return SETU_SURF_PREMULTIPLIED;` with no arm, no env var and no #ifdef.
# ⚠ This header claimed the flag was "armed by `CRAB_PREMUL=1`" until 0.5.0. `CRAB_PREMUL` has never
# existed anywhere in the tree; a reader looking for the off switch would have found nothing and had no
# way to tell whether they were misreading the code or the comment. That routing is only CORRECT if crab's pixels satisfy the
# op's precondition. The kernel does not check it and cannot: passing straight alpha to `#92` does not
# error anywhere in the stack — **it renders washed out, silently**.
#
# ⛔ THIS FILE WAS AN 11-LINE STUB (`fn main() { return 0; }`), so `cyrius test` passed crab trivially
# while the arc's docs asserted "crab is alpha-255 clean throughout" as a fact. That claim was TRUE, but
# it was true by inheritance from sadish and nothing pinned it: one translucent element anywhere in the UI
# would have made the premul routing wrong, with no test to say so and no visible error to notice.
# ⇒ The claim is now a measurement over the PRODUCTION render path.
# [[feedback_audit_re_derive_dont_validate_comments]]
#
# THE INVARIANT, and it is the op's actual contract rather than a proxy for it:
#   for every pixel:  a == 255   AND   b <= a  AND  g <= a  AND  r <= a
# `c <= a` is what premultiplied MEANS. At a == 255 it is trivially satisfied, which is exactly why crab
# is a safe first consumer — and asserting the real inequality (not just "a == 255") keeps the test
# honest if crab ever gains a translucent element: it will then fail on the alpha check and have to
# route through `sd_premul()`.
#
# ⭐ And the payoff at a == 255: the blend collapses to `out = src + dst * (1 - 255/255) = src`, so
# `#92` must produce a picture BYTE-IDENTICAL to the opaque `#87` copy. The iron oracle for AE-6 is
# therefore "the panel does not change", which is falsifiable by anything wrong in the shader path.

# ⭐ `app.cyr`, NOT `ui.cyr` (0.6.0). It pulls in `ui.cyr` -> `path.cyr` as before, and ALSO the
# application layer extracted out of `main.cyr` — the readdir parser, the stat layer, descend, ascend
# and the surface flag. None of those were reachable from any test before the extraction, because
# `main.cyr` ends in `_entry();` and including it would run the app.
include "src/app.cyr"

# --- a mock readdir buffer, mirroring src/render_test.cyr's fixture shape ------------------------
# One 64-byte record per entry: NUL-terminated name at +0, type byte at +63.
fn t_entry(buf, i, name, is_dir): i64 {
    var rec = buf + i * 64;
    var k = 0;
    while (load8(name + k) != 0) { store8(rec + k, load8(name + k)); k = k + 1; }
    store8(rec + k, 0);
    store8(rec + 63, is_dir);
    return 0;
}

# Render the REAL dual-pane UI through the production `crab_render`, and return the sadish surface.
# ⚠ Deliberately the production entry point, not a hand-built buffer: a fixture that painted its own
# pixels would assert something about the fixture.
fn t_render(w, h): i64 {
    var lbuf = alloc(16 * 64);
    var rbuf = alloc(16 * 64);
    var a0 = "aethersafha"; t_entry(lbuf, 0, a0, 0);
    var a1 = "puka";        t_entry(lbuf, 1, a1, 0);
    var a2 = "crab";        t_entry(lbuf, 2, a2, 0);
    var b0 = "bin";         t_entry(rbuf, 0, b0, 1);
    var b1 = "boot";        t_entry(rbuf, 1, b1, 1);
    var b2 = "readme.md";   t_entry(rbuf, 2, b2, 0);
    var lp = "/bin";
    var rp = "/";
    var lsizes = alloc(16 * 8);
    var rsizes = alloc(16 * 8);
    store64(lsizes + 0, 14995144); store64(lsizes + 8, 80784); store64(lsizes + 16, 301896);
    store64(rsizes + 0, 4096);     store64(rsizes + 8, 4096);  store64(rsizes + 16, 512);
    var lmt = alloc(16 * 8);
    var rmt = alloc(16 * 8);
    store64(lmt + 0, 1783900800); store64(lmt + 8, 1783900800); store64(lmt + 16, 1783900800);
    store64(rmt + 0, 1783900800); store64(rmt + 8, 1783900800); store64(rmt + 16, 1783900800);
    # left pane active, selection on row 1 — the focus tint and the highlight are both exercised,
    # because a highlight is the most likely place for someone to reach for translucency later.
    # ⚠ Scroll cells (0.4.10): the pane is a dhancha LIST now, and its scroll offset is app state
    # because the tree is rebuilt every frame. Fresh cells here — this harness renders one frame.
    var sl = alloc(8); store64(sl, 0);
    var sr = alloc(8); store64(sr, 0);
    # ⛔ THIS PASSED `rmt` FOR THE LEFT PANE UNTIL 0.5.0, so `lmt` was allocated, filled, and never
    # read — the two panes rendered from ONE mtime array. Both arrays hold the same value here, which
    # is exactly why it survived: the fixture could not tell the bug from the fix.
    # ⚠ A FRESH SURFACE PER CALL, ON PURPOSE. Since dhancha 0.9.14 a DhSurface owns and reuses its
    # sadish render target, so every caller of this helper that wants an independent picture needs its
    # own surface. Sharing one here would make two `t_render()` results alias and any test comparing
    # them would be comparing a frame with itself.
    var surf = dh_surface_new(w, h);
    return crab_render(surf, 0, 0, 1, 0, lbuf, 3, lp, lsizes, lmt, rbuf, 3, rp, rsizes, rmt, sl, sr);
}

# Count pixels violating the `#92` premultiplied contract. Returns the violation count; 0 = compliant.
# `bad_kind`: 1 = alpha not 255, 2 = a channel exceeds alpha (c > a). Reported separately because they
# want different fixes — the first means "route through sd_premul", the second means the premultiply
# was skipped or done wrong.
var t_bad_alpha = 0;
var t_bad_premul = 0;
fn t_scan_premul(pix, n): i64 {
    t_bad_alpha = 0;
    t_bad_premul = 0;
    var i = 0;
    while (i < n) {
        var off = i * 4;
        var b = load8(pix + off + 0);
        var g = load8(pix + off + 1);
        var r = load8(pix + off + 2);
        var a = load8(pix + off + 3);
        if (a != 255) { t_bad_alpha = t_bad_alpha + 1; }
        if (b > a) { t_bad_premul = t_bad_premul + 1; }
        else { if (g > a) { t_bad_premul = t_bad_premul + 1; }
            else { if (r > a) { t_bad_premul = t_bad_premul + 1; } } }
        i = i + 1;
    }
    return t_bad_alpha + t_bad_premul;
}

fn main() {
    alloc_init();

    test_group("crab — AE-6: the #92 premultiplied precondition holds for every pixel");
    var w = 380;
    var h = 220;
    var sds = t_render(w, h);
    assert(sds != 0, "the production crab_render returned a surface");
    var pix = sd_surface_pixels(sds);
    assert(pix != 0, "the surface has pixels");
    var n = w * h;

    assert_eq(t_scan_premul(pix, n), 0, "all 83,600 pixels satisfy a == 255 AND c <= a");
    assert_eq(t_bad_alpha, 0, "no pixel carries a non-opaque alpha");
    assert_eq(t_bad_premul, 0, "no channel exceeds its own alpha (the premultiplied contract)");

    # ⛔ NEGATIVE CONTROLS — the scan must be able to FAIL, in each mode independently. A checker that
    # cannot report a violation is worse than none: it converts an unexamined surface into a green gate.
    # ⚠ A PIXEL IS 4 BYTES: pixel i's byte k lives at i*4 + k. The first version of these controls
    # seeded `pix + 4*3`, which is pixel 3's BLUE channel — so it set a colour byte, left every alpha at
    # 255, and the scan correctly reported no violation. ⭐ The controls caught a bug in the control
    # itself, which is the entire reason they are here.
    store8(pix + 4 * 4 + 3, 128);                  # pixel 4: alpha 128, channels untouched
    assert(t_scan_premul(pix, n) > 0, "seeded non-opaque alpha is CAUGHT");
    assert_eq(t_bad_alpha, 1, "...and attributed to the alpha check, exactly once");
    store8(pix + 4 * 4 + 3, 255);                  # restore

    store8(pix + 8 * 4 + 3, 10);                   # pixel 8: alpha 10 with a bright channel
    store8(pix + 8 * 4 + 2, 200);                  # r = 200 > a = 10  -> straight alpha, not premultiplied
    assert(t_scan_premul(pix, n) > 0, "seeded straight-alpha pixel is CAUGHT");
    assert_eq(t_bad_premul, 1, "...and attributed to the c <= a check, exactly once");

    # ⭐ THE CONSEQUENCE THAT MAKES THE IRON ORACLE WORK, asserted rather than asserted-in-a-comment:
    # at a == 255 the kernel's blend `out = src + dst * (1 - a/255)` has a zero dst term, so #92 and #87
    # must agree bit for bit. This checks the arithmetic on a real pixel value from the render above.
    test_group("crab — AE-6: at alpha 255 the blend collapses to a copy");
    var src = 0xC0;                                 # any channel value
    var dst = 0x37;                                 # whatever was already in the back buffer
    var a = 255;
    var out = src + (dst * (255 - a)) / 255;
    assert_eq(out, src, "out = src + dst*(1 - 255/255) == src, so the picture cannot change");
    var a_half = 128;
    var out_half = src + (dst * (255 - a_half)) / 255;
    assert(out_half != src, "and at alpha 128 it genuinely differs — the identity is alpha-specific");

    # ================================================================
    # 0.5.0 — the P-1 sweep's repairs, pinned so a regression FAILS rather than renders wrong.
    # ================================================================
    test_group("crab — 0.5.0: the size ladder rounds, carries, and cannot overflow");
    var sb = alloc(64);
    # ⛔ Both of these printed a WRONG UNIT before 0.5.0: 1048575 -> "1024K", 1073741824 -> "1024M".
    # A size that reads 1024K when the next byte reads 1M is a comparison hazard in the one
    # application whose job is comparing files.
    crab_size_str(sb, 1048575);
    assert(t_streq(sb, "1M"), "1048575 B carries to 1M, not 1024K");
    crab_size_str(sb, 1073741824);
    assert(t_streq(sb, "1G"), "1 GiB is 1G — the ladder no longer stops at M");
    crab_size_str(sb, 1099511627776);
    assert(t_streq(sb, "1T"), "1 TiB is 1T");
    crab_size_str(sb, 1023);
    assert(t_streq(sb, "1023"), "below 1 KiB stays in bytes");
    crab_size_str(sb, 1024);
    assert(t_streq(sb, "1K"), "exactly 1 KiB is 1K");
    # ⛔ THE OVERFLOW. `(val + 512)` wraps NEGATIVE near i64 max, the ladder exited on its first pass,
    # and the row rendered as a bare "K" with no digits. st_size is a u64 out of a kernel buffer, so
    # a top-bit-set value is a corrupt-filesystem question, not an impossible one.
    crab_size_str(sb, 9223372036854775807);
    assert(t_streq(sb, "8388608T"), "i64-max size renders a bounded number, not a bare unit letter");
    crab_size_str(sb, 0 - 1);
    assert(t_streq(sb, "-"), "an unstattable file is '-' in the PANE, matching the status line");
    crab_u2s(sb, 0 - 7);
    assert(t_streq(sb, "-"), "crab_u2s never returns the empty string, which is what let 'K' through");

    test_group("crab — 0.5.0: the date formatters clamp instead of emitting a NUL");
    var pb = alloc(16);
    # ⛔ `48 + t` for an out-of-range t emits a non-digit, and for a large enough value emits 0 —
    # an embedded NUL that TRUNCATES the status line at that point. The mtime is kernel data.
    crab_pad4(pb, 123456); store8(pb + 4, 0);
    assert(t_streq(pb, "9999"), "an absurd year clamps to 9999 rather than writing a NUL");
    crab_pad2(pb, 0 - 5); store8(pb + 2, 0);
    assert(t_streq(pb, "00"), "a negative field clamps to 00");
    crab_mtime_str(pb, 1750000000);
    assert(t_streq(pb, "2025-06-15 15:06"), "and an ordinary epoch still formats correctly");

    test_group("crab — 0.5.0: a truncated name SAYS it was truncated");
    # ⛔ The column is 13 chars and names run to 62, so two different files rendered as one identical
    # row with no indication either was cut. An operator selects and acts on rows.
    var nm = alloc(80);
    var ni = 0; while (ni < 20) { store8(nm + ni, 97 + ni); ni = ni + 1; } store8(nm + 20, 0);
    # ⛔ THIS ASSERTS AGAINST THE PRODUCTION `crab_row`, NOT A MIRROR OF IT. The first draft of this
    # test reimplemented the name-column loop in the harness and asserted on the copy — so deleting
    # the marker from `crab_row` left the suite GREEN. A test that mirrors the code under test is
    # measuring itself; it is the same defect 0.4.14 records, where counting per-entry trace lines
    # made the diagnostic the thing being measured. Mutation-proven both ways.
    var lst = dh_list_new(26);
    crab_row(lst, nm, 0, 1234);
    var roww = dh_widget_first_child(lst);
    assert(roww != 0, "the row widget was built");
    assert_eq(load8(dh_widget_text(roww) + 12), 126, "a name longer than the column ends in '~'");
    store8(nm + 13, 0);                              # exactly 13 characters — fits
    var lst2 = dh_list_new(26);
    crab_row(lst2, nm, 0, 1234);
    var roww2 = dh_widget_first_child(lst2);
    assert(load8(dh_widget_text(roww2) + 12) != 126, "a name that exactly fits is NOT marked truncated");

    test_group("crab — 0.5.0: the path helpers are BOUNDED (the P1)");
    # ⛔⛔ THIS IS THE 0.5.0 P-1. `crab_strcpy` / `crab_join` took no destination size and checked
    # nothing, while every destination was a fixed alloc(256). Descent depth is unbounded, so the pane
    # path grew by 1 + strlen(name) per Enter with nothing stopping it — and the bump allocator hands
    # out adjacent blocks, so the overrun landed on the OTHER pane's path, then on its readdir records
    # (type byte included), then on the SetuClient fd. Silent, every time. No hostile input: just Enter.
    var pdst = alloc(512);
    var longnm = alloc(80);
    var q = 0; while (q < 62) { store8(longnm + q, 97); q = q + 1; } store8(longnm + 62, 0);
    var deep = alloc(512);
    var dq = 0; while (dq < 252) { store8(deep + dq, 98); dq = dq + 1; } store8(deep + 252, 0);

    # The exact shape that used to overflow: a 252-char path joined with a 62-char name into cap 256.
    assert_eq(crab_join_n(pdst, 256, deep, longnm), 0 - 1, "an over-long join REFUSES (-1) instead of writing past the cap");
    assert(strlen(pdst) < 256, "...and what it did write is still NUL-terminated inside the buffer");

    # A join that fits is unchanged in behaviour — the bound must not cost correctness.
    assert_eq(crab_join_n(pdst, 256, "/", longnm), 63, "a fitting join returns its length");
    assert_eq(load8(pdst), 47, "...starting with the root slash");
    assert_eq(load8(pdst + 1), 97, "...then the name, with the root separator collapsed (no '//')");
    assert_eq(crab_join_n(pdst, 256, "/bin", "ls"), 7, "an ordinary join inserts exactly one separator");
    assert(t_streq(pdst, "/bin/ls"), "...producing /bin/ls");

    # Exact-fit boundary: cap is a BYTE count including the NUL, so 7 chars need cap 8.
    assert_eq(crab_strcpy_n(pdst, "abcdefg", 8), 7, "a string that exactly fits its cap is not truncated");
    assert_eq(crab_strcpy_n(pdst, "abcdefgh", 8), 0 - 1, "one byte more REFUSES");
    assert(t_streq(pdst, "abcdefg"), "...and leaves a valid, NUL-terminated prefix rather than a runaway");
    assert_eq(crab_strcpy_n(pdst, "x", 1), 0 - 1, "cap 1 holds only the NUL, so any content refuses");
    assert_eq(load8(pdst), 0, "...and that NUL is written inside the allocation");

    # ================================================================
    test_group("crab — 0.6.0: ONE surface, reused every frame, and reuse is pixel-identical");
    # ================================================================
    # ⛔⛔ WHAT THIS EXISTS TO GATE. `crab_render` used to mint its own `dh_surface_new` per call and
    # dhancha allocated a fresh `sd_surface_new` inside every `dh_surface_render` — 334,432 B per
    # frame into an allocator with **no `free()`**, retained for the life of the process. crab now
    # holds ONE surface for the whole session (`src/main.cyr`) and dhancha 0.9.14 caches the render
    # target on it. Measured: 746,440 -> 77,568 B per frame.
    # ⚠ THE RISK THE SAVING BUYS is residue: a reused target is not zeroed between frames the way a
    # fresh allocation is, so anything the new frame fails to paint shows the OLD frame through. That
    # is invisible to every other assertion in this file, because they all read one frame.
    # ⇒ Render a frame, keep a byte copy, render a DIFFERENT frame over it, render the first again,
    # and compare all 334,400 bytes. Nothing short of a full-surface compare catches partial residue.
    #
    # ⛔⛔ AND THE OBVIOUS VERSION OF THIS TEST IS VACUOUS — MEASURED, NOT ASSUMED. Deleting
    # `sd_clear` from dhancha's `dh_surface_render` does **not** fail anything below, because
    # `crab_render` gives its root WINDOW an opaque `dh_theme_bg()` and lays it out at the full
    # `w`x`h` — so crab's own tree repaints every pixel whether or not the toolkit cleared first.
    # crab is immune to residue, and it is immune BY A PROPERTY OF ITS OWN UI, not by dhancha's clear.
    # ⇒ So the sentinel check below pins THAT property directly: scribble a value over every byte and
    # prove one render erases all of it. It asks "can residue survive?", not "who erased it".
    # ⚠ MUTATION RESULTS, RECORDED BECAUSE THEY ARE COUNTER-INTUITIVE. The property has TWO
    # independent guarantors — dhancha's `sd_clear` and crab's opaque full-window root — so removing
    # EITHER ONE ALONE leaves this suite green:
    #   · delete `sd_clear` from `dh_surface_render`  -> 45/45 pass (crab's root still covers)
    #   · set crab's root to `bg = -1`                -> 45/45 pass (the clear still covers)
    #   · delete BOTH                                 -> FAILS, 7,744 bytes survive the render
    # That is the correct shape for a property test and NOT a weak one: it fires exactly when the
    # property is broken and stays quiet while any mechanism still upholds it. ⛔ But it does mean
    # **this file does not pin dhancha's clear** — that lives in dhancha's own `programs/draw_test.cyr`,
    # against a tree deliberately built not to cover its surface. Do not read a green suite here as
    # evidence the toolkit still clears.
    var rw = 380;
    var rh = 220;
    var rsurf = dh_surface_new(rw, rh);
    assert(rsurf != 0, "a session surface can be created");

    var rl = alloc(16 * 64); var rr = alloc(16 * 64);
    t_entry(rl, 0, "aethersafha", 0); t_entry(rl, 1, "puka", 0); t_entry(rl, 2, "crab", 0);
    t_entry(rr, 0, "bin", 1);         t_entry(rr, 1, "boot", 1); t_entry(rr, 2, "readme.md", 0);
    var rlz = alloc(16 * 8); var rrz = alloc(16 * 8);
    var rlm = alloc(16 * 8); var rrm = alloc(16 * 8);
    var ri = 0;
    while (ri < 3) {
        store64(rlz + ri * 8, 14995144 + ri); store64(rrz + ri * 8, 4096 + ri);
        store64(rlm + ri * 8, 1783900800);    store64(rrm + ri * 8, 1783900800);
        ri = ri + 1;
    }
    var ra = alloc(8); store64(ra, 0);
    var rb = alloc(8); store64(rb, 0);

    # Frame A: left pane active, selection 0.
    var fa = crab_render(rsurf, 0, 0, 0, 0, rl, 3, "/bin", rlz, rlm, rr, 3, "/", rrz, rrm, ra, rb);
    assert(fa != 0, "frame A rendered into the caller's surface");
    var nbytes = rw * rh * 4;
    var snap = alloc(nbytes);
    var apix = sd_surface_pixels(fa);
    var bi = 0;
    while (bi < nbytes) { store8(snap + bi, load8(apix + bi)); bi = bi + 1; }

    # Frame B: the OTHER pane active, a different selection — a visibly different picture.
    store64(ra, 0); store64(rb, 0);
    var fb = crab_render(rsurf, 0, 1, 2, 1, rl, 3, "/bin", rlz, rlm, rr, 3, "/", rrz, rrm, ra, rb);
    assert_eq(fb, fa, "the surface hands back the SAME render target — this is the reuse");
    var diff = 0;
    bi = 0;
    while (bi < nbytes) {
        if (load8(apix + bi) != load8(snap + bi)) { diff = diff + 1; }
        bi = bi + 1;
    }
    # ⚠ Guard the guard: if frame B looked identical to frame A the residue check below would pass
    # vacuously, proving only that nothing was drawn.
    assert(diff > 0, "frame B really does differ from frame A, so the residue check is not vacuous");

    # Frame A again, into the same reused target. Every byte must match the snapshot.
    store64(ra, 0); store64(rb, 0);
    var fa2 = crab_render(rsurf, 0, 0, 0, 0, rl, 3, "/bin", rlz, rlm, rr, 3, "/", rrz, rrm, ra, rb);
    assert_eq(fa2, fa, "...still the same target on the third render");
    var residue = 0;
    bi = 0;
    while (bi < nbytes) {
        if (load8(apix + bi) != load8(snap + bi)) { residue = residue + 1; }
        bi = bi + 1;
    }
    assert_eq(residue, 0, "re-rendering frame A into the REUSED target is byte-identical to the first");

    # ⭐ THE SENTINEL: nothing that was in this buffer before a render survives it.
    bi = 0;
    while (bi < nbytes) { store8(apix + bi, 0x5A); bi = bi + 1; }
    store64(ra, 0); store64(rb, 0);
    crab_render(rsurf, 0, 0, 0, 0, rl, 3, "/bin", rlz, rlm, rr, 3, "/", rrz, rrm, ra, rb);
    var survived = 0;
    bi = 0;
    while (bi < nbytes) {
        if (load8(apix + bi) != load8(snap + bi)) { survived = survived + 1; }
        bi = bi + 1;
    }
    assert_eq(survived, 0, "a scribbled buffer is fully overpainted — crab's tree covers every pixel");

    # ⚠ AND TWO SURFACES STILL GIVE TWO PICTURES — the escape hatch `src/render_test.cyr` depends on.
    var rsurf2 = dh_surface_new(rw, rh);
    store64(ra, 0); store64(rb, 0);
    var fc = crab_render(rsurf2, 0, 1, 2, 1, rl, 3, "/bin", rlz, rlm, rr, 3, "/", rrz, rrm, ra, rb);
    assert(fc != fa, "a second surface renders into its OWN target, not the first one's");

    # ================================================================
    test_group("crab — 0.6.0: a rendered frame costs the global heap NOTHING");
    # ================================================================
    # ⛔⛔ WHAT THIS EXISTS TO GATE, AND IT IS THE WHOLE POINT OF THE ALLOCATION ARC. crab rebuilds
    # its entire widget tree every frame — that is what makes the toolkit-owned selection and the
    # scroll round-trip work — and `lib/alloc.cyr` is a bump allocator with **no `free()`**. So every
    # tree crab ever built used to be retained for the life of the process: 746,440 B per frame at
    # 380x220 with 114 entries per pane, measured. Steps 1 and 2 (dhancha 0.9.13 / 0.9.14) took that
    # to 77,568 B by killing two full-size pixel buffers. **Step 3 takes it to zero** — `crab_render`
    # calls `dh_frame_begin`, and every per-frame allocation on both sides now draws from an arena
    # that is rewound rather than abandoned.
    # ⚠ THE ASSERTION IS "THE GLOBAL HEAP DOES NOT MOVE", not "an arena is in use". An arena that
    # chained a fresh chunk every frame would satisfy any structural check and leak exactly as much.
    var aw = 380;
    var ah = 220;
    var asurf = dh_surface_new(aw, ah);
    var al = alloc(16 * 64); var ar2 = alloc(16 * 64);
    t_entry(al, 0, "aethersafha", 0); t_entry(al, 1, "puka", 0); t_entry(al, 2, "crab", 0);
    t_entry(ar2, 0, "bin", 1);        t_entry(ar2, 1, "boot", 1); t_entry(ar2, 2, "readme.md", 0);
    var alz = alloc(16 * 8); var arz = alloc(16 * 8);
    var alm = alloc(16 * 8); var arm = alloc(16 * 8);
    var ai = 0;
    while (ai < 3) {
        store64(alz + ai * 8, 14995144 + ai); store64(arz + ai * 8, 4096 + ai);
        store64(alm + ai * 8, 1783900800);    store64(arm + ai * 8, 1783900800);
        ai = ai + 1;
    }
    var asl = alloc(8); var asr = alloc(8);

    # ⭐ crab OWNS ITS ARENA (0.6.0) — `crab_render` creates and installs one on first use, so there
    # is no setup step for `main()` to forget. That is the fix for the coverage gap this file used to
    # have: the arena used to be installed in `main.cyr`, which no test can reach.
    # ⚠ Uninstall first — earlier groups in this file have already rendered, so "nothing is installed
    # yet" would be an assertion about suite ordering rather than about crab.
    dh_frame_arena_set(0);
    assert_eq(dh_frame_arena_get(), 0, "the frame arena can be uninstalled");
    store64(asl, 0); store64(asr, 0);
    crab_render(asurf, 0, 0, 0, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
    assert(dh_frame_arena_get() != 0, "a render installs one BY ITSELF — no step for main() to forget");
    assert_eq(dh_frame_arena_get(), crab_frame_arena(), "...crab's own, not some other arena");

    # ⛔ THE NON-VACUITY GUARD, AND IT HAD TO CHANGE SHAPE. It used to be "render with no arena and
    # watch the heap grow" — impossible now that `crab_render` installs one. Instead: install a
    # deliberately TINY, NON-GROWABLE arena. `dh_falloc` cannot serve from it, falls back to the
    # global allocator (dhancha's documented spill), and the heap grows again. That proves the probe
    # below can still SEE a cost — and it is the only thing in this suite that exercises the fallback
    # at all, which is otherwise a path taken only when an arena is misconfigured.
    var tiny = arena_new(64);
    assert(tiny != 0, "a deliberately tiny arena is created");
    dh_frame_arena_set(tiny);
    store64(asl, 0); store64(asr, 0);
    crab_render(asurf, 0, 0, 0, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
    var n0 = alloc_used();
    store64(asl, 0); store64(asr, 0);
    crab_render(asurf, 0, 0, 0, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
    assert(alloc_used() - n0 > 0,
      "a frame that cannot fit its arena SPILLS to the global heap instead of failing");

    # ⛔⛔ THE ARENA IS DELIBERATELY TIGHT — 8 KiB, NOT THE 256 KiB `src/main.cyr` INSTALLS — AND THE
    # FIRST DRAFT OF THIS GROUP WAS WORTHLESS FOR WANT OF THAT. It used main's 256 KiB against a
    # THREE-entry fixture, so a frame costs a few KiB and twenty of them fit inside the arena with
    # room to spare. Deleting `dh_frame_begin()` from `crab_render` outright — never rewinding at all
    # — left the whole suite green, because an arena that is merely big enough never touches the
    # global heap whether you rewind it or not. Caught by mutation, not by reading.
    # ⇒ Size the arena to about ONE frame, so a missing rewind overflows on the second or third and
    # has to chain — which is a global `alloc()` and therefore visible.
    var farena = arena_new_growable(8192);
    assert(farena != 0, "the per-frame arena is created");
    dh_frame_arena_set(farena);

    # Warm-up: the first arena'd frame establishes what one frame costs.
    store64(asl, 0); store64(asr, 0);
    crab_render(asurf, 0, 0, 0, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
    var one_frame = arena_used(farena);
    assert(one_frame > 0, "the frame really landed in the arena");
    var cap0 = arena_capacity_total(farena);

    var a0 = alloc_used();
    var af = 0;
    while (af < 20) {
        store64(asl, 0); store64(asr, 0);
        crab_render(asurf, 0, 0, 0, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
        af = af + 1;
    }
    # ⭐ THE HEADLINE. `arena_reset` on a GROW arena rewinds to the first chunk and KEEPS the chain,
    # so twenty frames re-walk the same memory and the global bump pointer never moves.
    assert_eq(alloc_used() - a0, 0, "TWENTY rendered frames cost the global heap exactly 0 bytes");

    # ⚠ THE DIRECT FORM OF THE SAME CLAIM, and the one that does not depend on the arena's capacity
    # at all: after twenty identical frames the arena holds exactly ONE frame's worth. The sizes
    # `crab_render` requests are input-independent (fixed 48/96/24-byte scratch, one widget per row),
    # so this is exact rather than approximate — and the loop holds `active_pane` fixed to keep it so.
    assert_eq(arena_used(farena), one_frame, "the arena holds ONE frame after twenty renders");
    assert_eq(arena_capacity_total(farena), cap0, "...and the chunk chain never had to extend");

    # ⛔ AND THE PIXELS ARE STILL RIGHT. A frame whose widgets were freed mid-render would still
    # produce *a* surface; this is the check that it produces the right one.
    store64(asl, 0); store64(asr, 0);
    var asds = crab_render(asurf, 0, 0, 1, 0, al, 3, "/bin", alz, alm, ar2, 3, "/", arz, arm, asl, asr);
    assert(asds != 0, "an arena'd frame still renders");
    t_bad_alpha = 0; t_bad_premul = 0;
    assert_eq(t_scan_premul(sd_surface_pixels(asds), aw * ah), 0,
      "...and every pixel still satisfies the #92 premultiplied contract");

    # Leave crab's own arena installed, which is the state every other caller expects.
    dh_frame_arena_set(crab_frame_arena());

    # ================================================================
    test_group("crab — 0.6.0: the application layer, reachable from a test at last");
    # ================================================================
    # ⛔⛔ EVERY ASSERTION IN THIS GROUP WAS IMPOSSIBLE UNTIL `src/app.cyr` WAS CARVED OUT OF
    # `src/main.cyr`. That file ends in `_entry();`, so including it from a suite runs the app —
    # which meant the readdir parser, the stat layer, descend, ascend and the surface flag had
    # **zero reachable coverage**, in a program whose two shipped defects were both found on iron.
    # `src/path.cyr` was carved out for the same reason at 0.5.0, after a P1 memory-safety repair
    # landed where the suite could not see it. This is that extraction finished.

    # ⭐ AE-6: the flag is UNCONDITIONAL — no arm, no env var, no #ifdef. `state.md` calls that out
    # as load-bearing, and until now nothing checked it.
    assert_eq(crab_surface_flags() & SETU_SURF_PREMULTIPLIED, SETU_SURF_PREMULTIPLIED,
      "the surface is premultiplied, unconditionally");
    assert_eq(crab_surface_flags() & SETU_SURF_FULL_KEYS, SETU_SURF_FULL_KEYS,
      "...and asks for key RELEASES too (FULL_KEYS, M2 #06)");

    # ⛔⛔ ASKING FOR FULL_KEYS WITHOUT GATING ON IT MAKES EVERY KEY ACT TWICE. The compositor carries
    # the burn for exactly this: "three F3 presses produced SIX `theme switched` lines, and the
    # launcher moved its selection twice per keypress". For crab that is two rows per Down, and Enter
    # descending twice — the second descend landing wherever the first left the selection.
    assert_eq(crab_key_acts(1), 1, "a PRESS is acted on (mods = 1)");
    assert_eq(crab_key_acts(0), 0, "a RELEASE is not (mods = 0)");
    # ⚠ THE GATE AND THE FLAG MUST MOVE TOGETHER. On a press-only surface `mods` is 0 for a PRESS, so
    # a client that dropped FULL_KEYS but kept this gate would act on nothing at all. That coupling is
    # why they live side by side in `src/app.cyr` and why these assertions sit together here.
    assert((crab_surface_flags() & SETU_SURF_FULL_KEYS) != 0,
      "...so the gate above is only correct while FULL_KEYS is requested");

    # --- M2 #06 second half: held-key repeat ------------------------------------------------------
    # ⛔ ONLY MOVEMENT REPEATS. Enter descends and Backspace ascends; repeating those walks the
    # operator through the filesystem at ~16 directories a second on one held key, re-readdir'ing and
    # re-stat'ing every step. A pane switch repeating is merely useless — it lands on the same pane.
    assert_eq(crab_key_repeats(0x52), 1, "Up repeats");
    assert_eq(crab_key_repeats(0x51), 1, "Down repeats");
    assert_eq(crab_key_repeats(0x0E), 1, "k repeats");
    assert_eq(crab_key_repeats(0x0D), 1, "j repeats");
    assert_eq(crab_key_repeats(0x28), 0, "Enter does NOT repeat — it would descend on every tick");
    assert_eq(crab_key_repeats(0x2A), 0, "Backspace does NOT repeat — it would ascend on every tick");
    assert_eq(crab_key_repeats(0x50), 0, "Left does not repeat");
    assert_eq(crab_key_repeats(0x4F), 0, "Right does not repeat");

    # ⚠ THE DELAY IS WHAT KEEPS A DELIBERATE TAP FROM BECOMING A BURST. Without it every press moves
    # several rows, which reads as the selection overshooting rather than as repeat working.
    assert_eq(crab_repeat_due(0, 0), 0, "a fresh press does not repeat");
    assert_eq(crab_repeat_due(CRAB_REPEAT_DELAY_MS - 1, 9999), 0, "...nor one just short of the delay");
    assert_eq(crab_repeat_due(CRAB_REPEAT_DELAY_MS, CRAB_REPEAT_INTERVAL_MS), 1, "both thresholds met -> fire");
    assert_eq(crab_repeat_due(9999, CRAB_REPEAT_INTERVAL_MS - 1), 0, "held long enough, but too soon after the last");
    assert_eq(crab_repeat_due(9999, 9999), 1, "held long, idle long -> fire");
    # ⚠ BOTH gates, not either. Held-long-enough alone would fire every idle tick — ~250 rows a second
    # at the measured 0-4 ms `sys_pause` latency.
    assert_eq(crab_repeat_due(CRAB_REPEAT_DELAY_MS - 1, CRAB_REPEAT_INTERVAL_MS), 0, "the delay gate is not optional");

    # --- descend REFUSES rather than truncating, and that path had host assertions only ----------
    # ⛔ A truncated join names a DIFFERENT directory. Descending into it would readdir something the
    # operator did not select while the pane header shows the name they did — which is the shape of
    # the 0.5.0 P1. `state.md` records that `crab_descend`/`crab_ascend` have never been exercised on
    # agnos; this at least makes the refusal path assertable on the host.
    var dpath = alloc(CRAB_PATH_MAX);
    var dbuf  = alloc(4 * CRAB_REC_SZ);
    var dsz   = alloc(4 * 8);
    var dmt   = alloc(4 * 8);
    var dname = alloc(CRAB_NAME_MAX);
    var dscr  = alloc(CRAB_PATH_MAX);
    var dstat = alloc(STAT_BUFSZ);

    t_entry(dbuf, 0, "sub", 1);          # a directory
    t_entry(dbuf, 1, "file.txt", 0);     # a file

    assert_eq(crab_descend(dpath, dbuf, 0, 0, dname, dscr, dsz, dmt, dstat), 0 - 1,
      "descend refuses an empty pane");
    assert_eq(crab_descend(dpath, dbuf, 0 - 1, 2, dname, dscr, dsz, dmt, dstat), 0 - 1,
      "descend refuses a negative selection");
    assert_eq(crab_descend(dpath, dbuf, 2, 2, dname, dscr, dsz, dmt, dstat), 0 - 1,
      "descend refuses a selection past the count");
    crab_strcpy_n(dpath, "/bin", CRAB_PATH_MAX);
    assert_eq(crab_descend(dpath, dbuf, 1, 2, dname, dscr, dsz, dmt, dstat), 0 - 1,
      "descend refuses a FILE — only the type byte says it is a directory");
    assert(t_streq(dpath, "/bin"), "...and a refused descend leaves the path untouched");

    # ⛔ THE REFUSAL THAT MATTERS: a name that cannot be joined within CRAB_PATH_MAX. Fill the path
    # to just under the cap so any child overflows it.
    var brim = alloc(CRAB_PATH_MAX);
    var bi2 = 0;
    while (bi2 < CRAB_PATH_MAX - 4) { store8(brim + bi2, 97); bi2 = bi2 + 1; }   # 'a'
    store8(brim, 47);                                                            # leading '/'
    store8(brim + bi2, 0);
    crab_strcpy_n(dpath, brim, CRAB_PATH_MAX);
    assert_eq(crab_descend(dpath, dbuf, 0, 2, dname, dscr, dsz, dmt, dstat), 0 - 1,
      "descend REFUSES when the joined child path would not fit");
    assert(t_streq(dpath, brim), "...and leaves the pane's path exactly as it was");

    # --- ascend stops at the root and truncates to the parent otherwise -------------------------
    crab_strcpy_n(dpath, "/", CRAB_PATH_MAX);
    assert_eq(crab_ascend(dpath, dbuf, dsz, dmt, dscr, dstat), 0 - 1, "ascend refuses at the root");
    assert(t_streq(dpath, "/"), "...leaving the root path intact");

    crab_strcpy_n(dpath, "/usr/local/bin", CRAB_PATH_MAX);
    crab_ascend(dpath, dbuf, dsz, dmt, dscr, dstat);
    assert(t_streq(dpath, "/usr/local"), "ascend truncates to the parent");
    crab_ascend(dpath, dbuf, dsz, dmt, dscr, dstat);
    assert(t_streq(dpath, "/usr"), "...and again");
    crab_ascend(dpath, dbuf, dsz, dmt, dscr, dstat);
    # ⛔ THE ONE-SEGMENT CASE IS SPECIAL AND IS WHERE AN OFF-BY-ONE WOULD LIVE: truncating at the
    # last '/' would leave the EMPTY string, not "/", and an empty path is not the root.
    assert(t_streq(dpath, "/"), "...and one segment from the root yields '/', not the empty string");
    assert_eq(crab_ascend(dpath, dbuf, dsz, dmt, dscr, dstat), 0 - 1, "...which then refuses");

    # --- the stat layer marks unstattable entries rather than inventing numbers -----------------
    # ⚠ On the host there is no `sys_stat`, so every entry takes the failure default. That is exactly
    # the contract worth pinning: -1, not 0 — `crab_size_str` renders -1 as "-" and 0 as "0".
    store64(dsz, 12345); store64(dmt, 12345);
    crab_stat_all("/bin", dbuf, 2, dsz, dmt, dscr, dstat);
    assert_eq(load64(dsz), 0 - 1, "an unstattable entry's size is -1, not 0");
    assert_eq(load64(dmt), 0 - 1, "...and so is its mtime");
    var sbb = alloc(24);
    crab_size_str(sbb, load64(dsz));
    assert(t_streq(sbb, "-"), "...which the pane renders as '-'");

    # --- M2: the resize policy ------------------------------------------------------------------
    # ⛔ THE DECISION LIVES IN `app.cyr` SO THAT THESE LINES CAN EXIST. The syscall plumbing that
    # acts on it — resize the surface, close and re-create the `#86` slot, re-ATTACH, re-COMMIT —
    # is in `main.cyr` and remains unreachable from here; only a QEMU run covers that half.
    assert_eq(crab_surface_bytes(380, 220), 334400, "the shipping extent sizes to 334,400 B");
    assert_eq(crab_surface_bytes(1, 1), 4, "a 1x1 surface is four bytes");
    assert_eq(crab_surface_bytes(0, 220), 0 - 1, "a zero width is refused, not clamped");
    assert_eq(crab_surface_bytes(380, 0), 0 - 1, "...and a zero height");
    assert_eq(crab_surface_bytes(0 - 4, 220), 0 - 1, "...and a negative one");
    # ⛔ THE CAPS ARE WHAT MAKE OVERFLOW UNREACHABLE, so they are asserted at the boundary rather
    # than trusted. `w * h * 4` runs on compositor-supplied numbers and then sizes a shm slot.
    assert_eq(crab_surface_bytes(CRAB_DIM_MAX + 1, 8), 0 - 1, "an over-wide ask is refused");
    assert_eq(crab_surface_bytes(8, CRAB_DIM_MAX + 1), 0 - 1, "...and an over-tall one");
    assert_eq(crab_surface_bytes(4096, 4096), 0 - 1, "an in-axis extent past the BYTE cap is refused");
    assert_eq(crab_surface_bytes(2896, 2896), 33547264, "...just under the cap is allowed");
    # ⛔ THE CAP IS THE ABSURDITY BOUND, NOT A PROMISE THE KERNEL WILL BACK IT. agnos caps a `#71`
    # pmm slot at **2 MB** and only a real GPU carveout (`#86`) reaches 32 MB — and `setu_buf_create`
    # picks between them at runtime, so a client cannot know which applies. A QEMU run found this the
    # hard way: policy said yes to a maximize, the create failed, and the first draft had already
    # closed its only buffer. ⇒ `main.cyr` now creates before closing and survives a refusal; **a
    # green line here is not evidence the extent is obtainable.**
    assert(crab_surface_bytes(1024, 512) <= 2097152, "a 2 MB-backable extent is comfortably in range");

    assert_eq(crab_resize_wanted(380, 220, 800, 600), 1, "a real new extent is adopted");
    # ⚠ THE NO-OP MATTERS AS MUCH AS THE ADOPT. A compositor may re-send CONFIGURE with the size we
    # already have; adopting it would close and re-create one of 16 system-wide `#86` slots, discard
    # the cached render target and re-ATTACH — every time, for no change on screen.
    assert_eq(crab_resize_wanted(380, 220, 380, 220), 0, "an ask for the CURRENT size is ignored");
    assert_eq(crab_resize_wanted(380, 220, 380, 221), 1, "...but a one-pixel change is not");
    assert_eq(crab_resize_wanted(380, 220, 0, 600), 0, "a degenerate ask is refused, not clamped");
    assert_eq(crab_resize_wanted(380, 220, 99999, 600), 0, "an absurd ask is refused");

    # --- M2: the pointer policy and the hit-test geometry ----------------------------------------
    # ⛔ crab OWNS ITS INTERACTION STATE — pane index and row index, never widget pointers. Operator
    # ruling 2026-08-27: `dh_dispatch` tracks a press by widget pointer, and `dh_frame_begin` rewinds
    # the arena between a press and its release, so the press target would no longer exist. A row
    # index survives a rebuild because it is crab's own model. These assertions are only possible
    # because of that choice — a widget-pointer design would be untestable from a host suite.
    assert_eq(crab_is_double(0, 3, 1000, 0, 3, 1200), 1, "same pane, same row, inside the window");
    assert_eq(crab_is_double(0, 3, 1000, 0, 3, 1000 + CRAB_DOUBLECLICK_MS), 1, "...at the boundary");
    assert_eq(crab_is_double(0, 3, 1000, 0, 3, 1001 + CRAB_DOUBLECLICK_MS), 0, "...one ms past is not");
    assert_eq(crab_is_double(0, 3, 1000, 1, 3, 1100), 0, "the OTHER pane is not a double-click");
    assert_eq(crab_is_double(0, 3, 1000, 0, 4, 1100), 0, "a different ROW is two selections, not a double");
    assert_eq(crab_is_double(0 - 1, 0 - 1, 0, 0, 3, 1100), 0, "the first click of a session is single");
    assert_eq(crab_is_double(0, 3, 1000, 0, 0 - 1, 1100), 0, "a click off any row cannot pair");
    # ⛔ A NEGATIVE INTERVAL IS NEVER A DOUBLE-CLICK. `clock_now_ms` is monotonic on agnos, so this
    # should be unreachable — which is exactly why it is asserted rather than assumed. Guessing
    # "double" on a backwards clock descends into a directory the operator clicked once, and a wrong
    # descend is indistinguishable from a misclick afterwards.
    assert_eq(crab_is_double(0, 3, 2000, 0, 3, 1000), 0, "a backwards clock is never a double-click");

    # --- M2: the wheel (agnos 1.56.49 -> bhumi 1.4.3 -> setu 0.8.8 -> dhancha 0.9.18 -> crab) -----
    # ⛔ THE WHEEL MOVES THE SELECTION, NOT THE VIEW. `crab_render` restores each pane's scroll offset
    # and then calls `dh_list_scroll_to_sel`, so a free-scrolled view is snapped back on the next
    # frame by the machinery keyboard navigation depends on. Moving the selection makes the view
    # follow and fights nothing. ⚠ A detached view-scroll is the other reasonable answer and is a
    # separate change, not a tweak.
    # ⚠ SIGN: positive = wheel-up (away from the user) = toward index 0. A sign error here scrolls the
    # wrong way, which is the single most noticeable way to get a wheel wrong.
    assert_eq(crab_scroll_sel(10, 100, 1), 10 - CRAB_SCROLL_ROWS, "wheel-up moves toward index 0");
    assert_eq(crab_scroll_sel(10, 100, 0 - 1), 10 + CRAB_SCROLL_ROWS, "wheel-down moves away from 0");
    assert_eq(crab_scroll_sel(10, 100, 2), 10 - 2 * CRAB_SCROLL_ROWS, "two detents move twice as far");
    # ⛔ CLAMPED AT BOTH ENDS. An unclamped index is read straight into arrays sized by
    # `CRAB_MAX_ENTRIES` — the same class of out-of-range read the compositor's own titlebar guard
    # exists to prevent one layer up.
    assert_eq(crab_scroll_sel(1, 100, 5), 0, "a big wheel-up clamps at the top");
    assert_eq(crab_scroll_sel(98, 100, 0 - 5), 99, "...and a big wheel-down at the last entry");
    assert_eq(crab_scroll_sel(0, 100, 1), 0, "already at the top stays there");
    assert_eq(crab_scroll_sel(99, 100, 0 - 1), 99, "already at the end stays there");
    # ⚠ AN EMPTY PANE HAS NO SELECTION TO MOVE. `count - 1` would be -1, and -1 indexes before the
    # readdir buffer.
    assert_eq(crab_scroll_sel(0, 0, 1), 0, "an empty pane scrolls to 0, never to -1");
    assert_eq(crab_scroll_sel(5, 0, 0 - 3), 0, "...in either direction");

    # ⭐ THE GEOMETRY, AGAINST A REAL RENDERED TREE — not against arithmetic that mirrors the layout.
    # `crab_hit` walks the widget tree `crab_render` just built, so this exercises the same structure
    # that reaches the screen. ⚠ It must run AFTER a render: the tree and the recorded root live for
    # exactly one frame.
    var hsurf = dh_surface_new(380, 220);
    var hl = alloc(16 * 64); var hrr = alloc(16 * 64);
    t_entry(hl, 0, "alpha", 1); t_entry(hl, 1, "beta", 0); t_entry(hl, 2, "gamma", 0);
    t_entry(hrr, 0, "one", 1);  t_entry(hrr, 1, "two", 0);  t_entry(hrr, 2, "three", 0);
    var hlz = alloc(16 * 8); var hrz = alloc(16 * 8);
    var hlm = alloc(16 * 8); var hrm = alloc(16 * 8);
    var hi = 0;
    while (hi < 3) {
        store64(hlz + hi * 8, 100 + hi); store64(hrz + hi * 8, 200 + hi);
        store64(hlm + hi * 8, 1783900800); store64(hrm + hi * 8, 1783900800);
        hi = hi + 1;
    }
    var hsl = alloc(8); store64(hsl, 0);
    var hsr = alloc(8); store64(hsr, 0);
    crab_render(hsurf, 0, 0, 0, 0, hl, 3, "/bin", hlz, hlm, hrr, 3, "/", hrz, hrm, hsl, hsr);

    var hb = alloc(16);
    # The pane row band starts below the 28px header; rows are 26px tall. Sample the middle of the
    # first row of each pane rather than an edge, so the assertion is about which pane and row a
    # click lands in and not about a boundary pixel.
    var lx = (380 - 6) / 4;                  # a column inside the LEFT pane
    var rx2 = 380 - lx;                      # ...and inside the RIGHT one
    assert_eq(crab_hit(lx, 41, hb), 1, "a click inside the left pane lands somewhere");
    assert_eq(load64(hb), 0, "...and reports the LEFT pane");
    assert_eq(load64(hb + 8), 0, "...on row 0");
    assert_eq(crab_hit(rx2, 41, hb), 1, "a click inside the right pane lands");
    assert_eq(load64(hb), 1, "...and reports the RIGHT pane");
    assert_eq(crab_hit(lx, 67, hb), 1, "a click one row down lands");
    assert_eq(load64(hb + 8), 1, "...and reports row 1 — the rows are distinguished, not lumped");
    # ⛔ THE STATUS LINE IS NOT A PANE. It owns the bottom of the window; a click there that reported
    # a row would select a file the operator never pointed at.
    assert_eq(crab_hit(lx, 220 - 6, hb), 0, "a click on the status line is not in a pane");
    assert_eq(load64(hb), 0 - 1, "...and reports no pane");

    # --- M3 #33: SORTING -------------------------------------------------------------------------
    # ⛔ The pane rendered raw readdir order — ON-DISK order. Everything here is the replacement.

    # Name comparison: case-insensitive, with a raw-byte tiebreak so the order is TOTAL.
    assert(crab_name_cmp("alpha", "beta") < 0, "a sorts before b");
    assert(crab_name_cmp("beta", "alpha") > 0, "...and the reverse");
    assert_eq(crab_name_cmp("same", "same"), 0, "identical names tie");
    # ⚠ CASE-FOLDING IS THE POINT. Byte order puts every capital ahead of every lowercase, so
    # `README.md` lands a hundred rows from `readme.md` — the thing operators notice immediately.
    assert(crab_name_cmp("README.md", "readme.md") != 0, "case still breaks the tie deterministically");
    assert(crab_name_cmp("apple", "Banana") < 0, "lowercase a before uppercase B — folded, not byte order");
    assert(crab_name_cmp("Apple", "banana") < 0, "...and the mirror case");
    # ⚠ A prefix sorts before its extension.
    assert(crab_name_cmp("doc", "document") < 0, "a prefix sorts first");

    # Extension detection. ⛔ A LEADING dot is not an extension — `.bashrc` is a dotfile named
    # `bashrc`, not a file of kind `bashrc`.
    assert_eq(crab_ext_at("a.txt"), 2, "extension starts just past the last dot");
    assert_eq(crab_ext_at("archive.tar.gz"), 12, "the LAST dot wins");
    assert_eq(crab_ext_at("noext"), 5, "no dot -> the name length");
    assert_eq(crab_ext_at(".bashrc"), 7, "a LEADING dot is not an extension");

    # --- the sort itself, over a real record buffer -----------------------------------------------
    var sbuf = alloc(8 * 64);
    var ssz = alloc(8 * 8);
    var smt = alloc(8 * 8);
    # Deliberately worst-case readdir order: file first, dir last, mixed case, an unstattable entry.
    t_entry(sbuf, 0, "zebra.txt", 0);  store64(ssz + 0,  100); store64(smt + 0,  500);
    t_entry(sbuf, 1, "Alpha",     1);  store64(ssz + 8,  0 - 1); store64(smt + 8,  0 - 1);
    t_entry(sbuf, 2, "beta.md",   0);  store64(ssz + 16, 900); store64(smt + 16, 100);
    t_entry(sbuf, 3, "mid.txt",   0);  store64(ssz + 24, 0 - 1); store64(smt + 24, 0 - 1);
    t_entry(sbuf, 4, "yak",       1);  store64(ssz + 32, 0 - 1); store64(smt + 32, 0 - 1);

    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_NAME);
    # ⛔ DIRECTORIES FIRST, and it outranks the key. Interleaving them by name means hunting for the
    # one folder among a hundred files.
    assert_eq(load8(sbuf + 0 * 64 + 63), 1, "row 0 is a directory");
    assert_eq(load8(sbuf + 1 * 64 + 63), 1, "row 1 is a directory");
    assert_eq(load8(sbuf + 2 * 64 + 63), 0, "row 2 is a file — the dirs are exhausted");
    assert(t_streq(sbuf + 0 * 64, "Alpha"), "...dirs sorted among themselves");
    assert(t_streq(sbuf + 1 * 64, "yak"), "...case-folded");
    assert(t_streq(sbuf + 2 * 64, "beta.md"), "files sorted among themselves");
    assert(t_streq(sbuf + 4 * 64, "zebra.txt"), "...to the end");

    # ⛔⛔ THE PARALLEL ARRAYS MOVED WITH THE RECORDS. If they did not, every row would show another
    # file's size and date — and the status line reads the same index, so it would agree with the
    # wrong answer confidently. `beta.md` carried size 900; it must still.
    assert_eq(load64(ssz + 2 * 8), 900, "beta.md kept ITS size through the permutation");
    assert_eq(load64(smt + 2 * 8), 100, "...and its mtime");
    assert_eq(load64(ssz + 4 * 8), 100, "zebra.txt kept its size too");

    # --- size order, and the -1 trap --------------------------------------------------------------
    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_SIZE);
    assert_eq(load8(sbuf + 0 * 64 + 63), 1, "directories still lead, whatever the key");
    assert(t_streq(sbuf + 2 * 64, "beta.md"), "largest file first (900)");
    assert(t_streq(sbuf + 3 * 64, "zebra.txt"), "...then 100");
    # ⚠ THE UNSTATTABLE ENTRY SORTS LAST — but note WHY, because the reason is not the guard in
    # `crab_entry_cmp`. -1 is the smallest value and this order is largest-first, so it sinks on its
    # own; deleting that guard fails nothing here, which mutation testing showed and an earlier
    # comment denied. The guard earns its keep only once a smallest-first order exists (M3 *#32*).
    assert(t_streq(sbuf + 4 * 64, "mid.txt"), "the unstattable file sorts LAST");

    # --- mtime order ------------------------------------------------------------------------------
    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_MTIME);
    assert(t_streq(sbuf + 2 * 64, "zebra.txt"), "newest file first (500)");
    assert(t_streq(sbuf + 3 * 64, "beta.md"), "...then 100");
    assert(t_streq(sbuf + 4 * 64, "mid.txt"), "undated sorts last");

    # --- kind order -------------------------------------------------------------------------------
    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_KIND);
    assert(t_streq(sbuf + 2 * 64, "beta.md"), "by extension: .md before .txt");
    # ⚠ `mid.txt` and `zebra.txt` share an extension, so NAME breaks the tie — never readdir order.
    assert(t_streq(sbuf + 3 * 64, "mid.txt"), "same extension -> name decides");
    assert(t_streq(sbuf + 4 * 64, "zebra.txt"), "...deterministically");

    # --- degenerate inputs -------------------------------------------------------------------------
    assert_eq(crab_sort_entries(sbuf, ssz, smt, 0, CRAB_SORT_NAME), 0, "an empty pane sorts fine");
    assert_eq(crab_sort_entries(sbuf, ssz, smt, 1, CRAB_SORT_NAME), 0, "so does a single entry");
    # ⚠ IDEMPOTENT. Sorting an already-sorted buffer must not permute it — that is what makes the
    # sort safe to run after every listing rather than once.
    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_NAME);
    var firstn = alloc(64);
    crab_strcpy_n(firstn, sbuf, 64);
    crab_sort_entries(sbuf, ssz, smt, 5, CRAB_SORT_NAME);
    assert(t_streq(sbuf, firstn), "sorting twice is the same as sorting once");

    # --- M3 #34: SELECTION MEMORY -----------------------------------------------------------------
    # ⛔ Backspace used to land at the TOP of the parent, so the directory you had just left was
    # somewhere below and you had to find it again. Ascend-then-descend is how you move sideways
    # between siblings, which is what made that expensive.
    var leaf = alloc(CRAB_NAME_MAX);
    assert_eq(crab_leaf_name("/usr/local/bin", leaf, CRAB_NAME_MAX), 3, "the leaf of a deep path");
    assert(t_streq(leaf, "bin"), "...is its last segment");
    assert_eq(crab_leaf_name("/bin", leaf, CRAB_NAME_MAX), 3, "one level down");
    assert(t_streq(leaf, "bin"), "...same answer");
    # ⛔ THE ROOT HAS NO LEAF, and -1 is a real answer rather than an error. `/` is where ascending
    # stops, so there is nothing to return to and the caller must leave the selection alone.
    assert_eq(crab_leaf_name("/", leaf, CRAB_NAME_MAX), 0 - 1, "the root has no leaf");
    assert_eq(crab_leaf_name("", leaf, CRAB_NAME_MAX), 0 - 1, "nor does the empty path");
    # ⚠ The bound is the same one the 0.5.0 P1 was about — a leaf longer than the cap REFUSES.
    assert_eq(crab_leaf_name("/bin", leaf, 2), 0 - 1, "a leaf that will not fit is refused, not truncated");

    var ibuf = alloc(4 * 64);
    t_entry(ibuf, 0, "alpha", 1);
    t_entry(ibuf, 1, "bin", 1);
    t_entry(ibuf, 2, "zulu", 0);
    assert_eq(crab_index_of(ibuf, 3, "bin"), 1, "the remembered directory is found");
    assert_eq(crab_index_of(ibuf, 3, "alpha"), 0, "...wherever it sits");
    assert_eq(crab_index_of(ibuf, 3, "zulu"), 2, "...including the last row");
    # ⛔ -1 IS THE HONEST ANSWER AND THE CALLER HANDLES IT. The directory can genuinely be gone —
    # deleted or renamed between the two readdirs. Falling back to row 0 is right; guessing is not.
    assert_eq(crab_index_of(ibuf, 3, "missing"), 0 - 1, "an absent name reports -1");
    assert_eq(crab_index_of(ibuf, 0, "bin"), 0 - 1, "an empty listing reports -1");
    # ⚠ PREFIXES MUST NOT MATCH. `bi` is not `bin`, and a prefix match would return you to the wrong
    # directory — silently, and only for names that happen to share a stem.
    assert_eq(crab_index_of(ibuf, 3, "bi"), 0 - 1, "a prefix does NOT match");
    assert_eq(crab_index_of(ibuf, 3, "binary"), 0 - 1, "...nor does a longer name");

    # --- the sort mode cycles and wraps -----------------------------------------------------------
    # ⚠ Module state, so restore it: later assertions and `main` itself read the same cell.
    var sm0 = crab_sort_mode_get();
    assert_eq(crab_sort_mode_get(), CRAB_SORT_NAME, "name is the default order");
    assert_eq(crab_sort_cycle(), CRAB_SORT_SIZE, "s -> size");
    assert_eq(crab_sort_cycle(), CRAB_SORT_MTIME, "s -> modified");
    assert_eq(crab_sort_cycle(), CRAB_SORT_KIND, "s -> kind");
    # ⛔ IT MUST WRAP. Without the wrap the mode walks past the last valid value and every later sort
    # falls through every branch to the NAME tiebreak — so the operator sees "name" forever while the
    # counter climbs, which looks like the key stopped working rather than like an overflow.
    assert_eq(crab_sort_cycle(), CRAB_SORT_NAME, "...and wraps back to name");
    assert(t_streq(crab_sort_name(CRAB_SORT_SIZE), "size"), "the mode names itself for the log");
    assert(t_streq(crab_sort_name(CRAB_SORT_NAME), "name"), "...for every mode");
    assert(t_streq(crab_sort_name(CRAB_SORT_KIND), "kind"), "...including kind");
    while (crab_sort_mode_get() != sm0) { crab_sort_cycle(); }

    # --- M3 #11: STARTING PATHS FROM argv ---------------------------------------------------------
    # ⛔ AN UNUSABLE PATH IS REFUSED, NOT REPAIRED. `crab_readdir_into` takes absolute paths; a
    # relative one lists NOTHING, and a pane that is empty with no message reads as a broken
    # filesystem rather than as a rejected argument. `main` announces the refusal and falls back.
    assert_eq(crab_path_usable("/"), 1, "the root is usable");
    assert_eq(crab_path_usable("/bin"), 1, "so is a normal absolute path");
    assert_eq(crab_path_usable("/usr/local/share"), 1, "...at any depth");
    assert_eq(crab_path_usable("bin"), 0, "a relative path is refused");
    assert_eq(crab_path_usable("./bin"), 0, "...including an explicitly relative one");
    # ⚠ Empty is refused by the ABSOLUTE check, not by a guard of its own — "" cannot start with '/'.
    # The assert pins the behaviour; it does not pin a separate line, and there is not one.
    assert_eq(crab_path_usable(""), 0, "the empty path is refused");
    # ⛔ A NULL POINTER IS A REAL INPUT HERE. `argv(n)` past the end yields 0, and the guard runs
    # before the count is trusted — dereferencing it would fault on the operator's first typo.
    assert_eq(crab_path_usable(0), 0, "a null argument is refused, not dereferenced");
    # ⚠ THE CAP IS THE 0.5.0 P1's CAP. `lpath` is CRAB_PATH_MAX bytes and every descent grows the
    # path from the starting one, so a path at the limit cannot be navigated out of.
    var longp = alloc(CRAB_PATH_MAX + 64);
    store8(longp, 47);
    var lpi = 1;
    while (lpi < CRAB_PATH_MAX + 40) { store8(longp + lpi, 97); lpi = lpi + 1; }
    store8(longp + lpi, 0);
    assert_eq(crab_path_usable(longp), 0, "a path past the cap is refused, not truncated");
    # ⚠ And the boundary itself: CRAB_PATH_MAX-1 bytes plus the terminator is exactly the buffer.
    # ⛔ THE BOUNDARY IS OFF-BY-ONE TERRITORY. CRAB_PATH_MAX bytes of text needs CRAB_PATH_MAX+1
    # with the terminator, so it does NOT fit; one byte less does. Both sides are pinned because a
    # `>` for a `>=` here would overrun `lpath` by exactly the terminator.
    store8(longp + CRAB_PATH_MAX, 0);
    assert_eq(crab_path_usable(longp), 0, "a path of exactly the cap does not fit — the terminator");
    store8(longp + CRAB_PATH_MAX - 1, 0);
    assert_eq(crab_path_usable(longp), 1, "...but one byte less exactly fits, and is accepted");

    # --- M3 #03: DEFERRED STATTING ---------------------------------------------------------------
    # ⭐ MEASURED BEFORE BUILT: ~1.1 ms per entry on agnos under QEMU (50 ms / 45 in /bin, 10 ms / 7
    # in /), so a full sweep at the 256-entry cap was ~280 ms of blocking syscalls on the keystroke
    # that descends. The listing now marks entries pending and the event loop drains batches.
    # ⛔ PENDING (-2) IS A DIFFERENT ANSWER FROM UNSTATTABLE (-1). An entry not yet reached must not
    # render as one whose stat FAILED, or a drain that never completes looks like a filesystem fault.
    assert_eq(crab_sz_pending(), 0 - 2, "pending is -2, distinct from -1 (stat failed)");
    var psz = alloc(8 * 8);
    var pmt = alloc(8 * 8);
    var pi = 0;
    while (pi < 8) { store64(psz + pi * 8, 77); store64(pmt + pi * 8, 77); pi = pi + 1; }
    crab_stat_reset(psz, pmt, 5);
    assert_eq(load64(psz), 0 - 2, "reset marks sizes pending");
    assert_eq(load64(pmt), 0 - 2, "...and mtimes too");
    assert_eq(load64(psz + 4 * 8), 0 - 2, "...through the last entry in range");
    # ⚠ AND NOT ONE BYTE PAST THE COUNT. `sizes` is allocated for CRAB_MAX_ENTRIES; writing past
    # `count` would clobber whatever the arena handed out next.
    assert_eq(load64(psz + 5 * 8), 77, "reset stops at count — entry 5 is untouched");

    assert_eq(crab_stat_next_pending(psz, 5, 0), 0, "the first pending entry is found");
    store64(psz, 100);
    assert_eq(crab_stat_next_pending(psz, 5, 0), 1, "...and the scan skips one already stat'd");
    assert_eq(crab_stat_next_pending(psz, 5, 3), 3, "the scan honours its start index");
    # ⛔ A NEGATIVE START MUST CLAMP RATHER THAN READ BEHIND THE ARRAY — and proving that needs the
    # memory in front of it to be CONTROLLED. The obvious version of this assert (`psz`, start -4)
    # passed with the clamp deleted: it read whatever the arena happened to leave in front of `psz`,
    # found no -2 there, and walked forward to the same answer. A test that passes when the code is
    # broken is worthless, so the array here is placed 8 entries INTO a block whose front is filled
    # with the pending marker. Without the clamp the scan finds a -2 behind the array and returns a
    # NEGATIVE index, which would then be used to address a record.
    var gsz = alloc(16 * 8);
    var gmt = alloc(16 * 8);
    var gi = 0;
    while (gi < 16) { store64(gsz + gi * 8, 0 - 2); store64(gmt + gi * 8, 0 - 2); gi = gi + 1; }
    var gs = gsz + 8 * 8;
    var gm = gmt + 8 * 8;
    crab_stat_reset(gs, gm, 5);
    store64(gs, 100);
    assert_eq(crab_stat_next_pending(gs, 5, 0 - 4), 1, "a negative start clamps — it does not scan behind the array");
    crab_stat_reset(psz, pmt, 5);
    store64(psz, 1); store64(psz + 8, 1); store64(psz + 16, 1);
    store64(psz + 24, 1); store64(psz + 32, 1);
    assert_eq(crab_stat_next_pending(psz, 5, 0), 0 - 1, "a fully stat'd listing reports -1");
    assert_eq(crab_stat_next_pending(psz, 0, 0), 0 - 1, "an empty listing reports -1");

    # ⛔ ONLY SIZE AND MTIME NEED THE SWEEP. Dir-ness comes from the READDIR RECORD, not from stat, so
    # directories-first, the `/` marker, NAME order and KIND order all work with no stat data at all.
    # That is the whole reason the deferral is safe, so it is asserted rather than assumed.
    assert_eq(crab_sort_needs_stats(CRAB_SORT_SIZE), 1, "size order needs every size");
    assert_eq(crab_sort_needs_stats(CRAB_SORT_MTIME), 1, "mtime order needs every mtime");
    assert_eq(crab_sort_needs_stats(CRAB_SORT_NAME), 0, "name order needs none");
    assert_eq(crab_sort_needs_stats(CRAB_SORT_KIND), 0, "kind order needs none either");

    # ⚠ ON THE HOST `crab_stat_one` HAS NO SYSCALL, so it resolves every entry to -1 (unstattable).
    # That is exactly what makes the BATCHING testable here: the pending -> resolved transition is
    # observable even though the sizes themselves are not.
    var bbuf = alloc(8 * 64);
    t_entry(bbuf, 0, "a", 0);
    t_entry(bbuf, 1, "b", 0);
    t_entry(bbuf, 2, "c", 0);
    t_entry(bbuf, 3, "d", 0);
    t_entry(bbuf, 4, "e", 0);
    var bscr = alloc(CRAB_PATH_MAX);
    var bstat = alloc(STAT_BUFSZ);
    crab_stat_reset(psz, pmt, 5);
    # ⛔ THE BUDGET MUST BOUND THE WORK — that is the entire point of batching. A batch that ignored
    # its budget would restore the 280 ms keystroke while looking like it had been fixed.
    assert_eq(crab_stat_batch("/bin", bbuf, 5, psz, pmt, bscr, bstat, 2), 2, "a batch stops at its budget");
    assert_eq(load64(psz), 0 - 1, "...and the entries it reached are resolved");
    assert_eq(load64(psz + 8), 0 - 1, "...both of them");
    assert_eq(load64(psz + 16), 0 - 2, "...while the rest stay pending");
    assert_eq(crab_stat_next_pending(psz, 5, 0), 2, "the drain resumes at the first still-pending row");
    assert_eq(crab_stat_batch("/bin", bbuf, 5, psz, pmt, bscr, bstat, 99), 3, "an over-budget batch does what is left");
    # ⛔ AND THEN IT MUST REPORT ZERO. The idle drain redraws when a batch does work; a batch that
    # kept re-statting settled entries would redraw forever and spin the loop on an idle desktop.
    assert_eq(crab_stat_batch("/bin", bbuf, 5, psz, pmt, bscr, bstat, 99), 0, "a settled listing needs no work");
    assert_eq(crab_stat_next_pending(psz, 5, 0), 0 - 1, "...and nothing is left pending");

    # ⚠ A listing whose order needs no stats must not sweep — that is the saving. On the host the
    # sweep is a no-op either way, so the ORACLE IS THE RETURN VALUE, and it is labelled as such.
    crab_stat_reset(psz, pmt, 5);
    assert_eq(crab_stat_for_listing("/bin", bbuf, 5, psz, pmt, bscr, bstat, CRAB_SORT_NAME), 0,
              "a name-ordered listing does NOT sweep");
    assert_eq(load64(psz), 0 - 2, "...so every entry is still pending after it");
    assert_eq(crab_stat_for_listing("/bin", bbuf, 5, psz, pmt, bscr, bstat, CRAB_SORT_SIZE), 1,
              "a size-ordered listing DOES sweep");
    assert_eq(load64(psz), 0 - 1, "...and leaves nothing pending");
    assert_eq(crab_stat_next_pending(psz, 5, 0), 0 - 1, "...for any entry");

    # --- readdir clamps to the cap ---------------------------------------------------------------
    # ⚠ On the host `crab_readdir_into` yields 0 (there is no #81), so this pins the host contract
    # rather than the clamp. Stated because a green line here must not be read as covering the cap.
    assert_eq(crab_readdir_into("/bin", dbuf), 0, "readdir yields 0 on the host — the mock-pane path");

    return assert_summary();
}

# --- 0.5.0 test helpers ---

fn t_streq(a, b): i64 {
    var i = 0;
    while ((load8(a + i) != 0) && (load8(b + i) != 0)) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(a + i) != load8(b + i)) { return 0; }
    return 1;
}

fn _entry(): i64 { var rc = main(); syscall(SYS_EXIT, rc); return 0; }
_entry();
